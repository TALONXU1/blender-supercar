 * (12450.0 / 12550.0)\\n    dn_kmh = up_kmh - 2.3\"","Target":"\"    # 8-speed F1 gearbox ratios (top speed per gear at 12,550 RPM)\\n    # Keeps shifts across ~83..331 km/h squarely inside the 9,800 - 12,550 RPM powerband\\n    v_top_12550 = np.array([85.0, 106.5, 132.0, 162.0, 197.0, 237.5, 284.0, 335.5], dtype=np.float64)\\n    up_kmh = v_top_12550[:-1] * (12430.0 / 12550.0)\\n    dn_kmh = up_kmh - 3.8\""}},{"name":"edit_file","args":{"Path":"\"d:\\\\项目session\\\\blender-supercar\\\\pipeline\\\\synth_sfx.py\"","Replacement":"\"            # True 3D stereo panning mounted on tripod facing pass-by / mid-shot axis:\\n            # Approaching from one speaker, tearing dead-center at pass-by, exiting opposite!\\n            i_closest = int(np.argmin(dist))\\n            i_ref = int(round(0.65 * i_closest + 0.35 * (n_seg // 2)))\\n            apex_dx = px_car[i_ref] - cam_x[i_ref]\\n            apex_dy = py_car[i_ref] - cam_y[i_ref]\\n            apex_norm = max(math.hypot(apex_dx, apex_dy), 1e-6)\\n            f_tripod_x, f_tripod_y = apex_dx / apex_norm, apex_dy / apex_norm\\n            # Tripod right-ear vector = f_tripod x +Z = (f_tripod_y, -f_tripod_x)\\n            right_ear_x, right_ear_y = f_tripod_y, -f_tripod_x\\n            horiz_dist = np.maximum(np.hypot(rx, ry), 1.0)\\n            sin_az = (rx * right_ear_x + ry * right_ear_y) / horiz_dist\\n            pan_curve = np.clip(sin_az * 0.94, -0.86, 0.86)\\n\\n            sig_l, sig_r = stereo_pan_and_itd(car_persp * 1.16, pan_curve, itd_scale=1.0)\"","Target":"\"            # True 3D stereo panning mounted on tripod facing closest-approach apex:\\n            # Approaching from one speaker, tearing dead-center at closest approach, exiting opposite!\\n            i_closest = int(np.argmin(dist))\\n            apex_dx = px_car[i_closest] - cam_x[i_closest]\\n            apex_dy = py_car[i_closest] - cam_y[i_closest]\\n            apex_norm = max(math.hypot(apex_dx, apex_dy), 1e-6)\\n            f_tripod_x, f_tripod_y = apex_dx / apex_norm, apex_dy / apex_norm\\n            # Tripod right-ear vector = f_tripod x +Z = (f_tripod_y, -f_tripod_x)\\n            right_ear_x, right_ear_y = f_tripod_y, -f_tripod_x\\n            horiz_dist = np.maximum(np.hypot(rx, ry), 1.0)\\n            sin_az = (rx * right_ear_x + ry * right_ear_y) / horiz_dist\\n            pan_curve = np.clip(sin_az * 0.92, -0.84, 0.84)\\n\\n            sig_l, sig_r = stereo_pan_and_itd(car_persp, pan_curve, itd_scale=1.0)\""}},{"name":"edit_file","args":{"Path":"\"d:\\\\项目session\\\\blender-supercar\\\\pipeline\\\\synth_sfx.py\"","Replacement":"\"        elif typ in (\\\"heli\\\", \\\"aerial\\\"):\\n            # Elevated helicopter / aerial perspective: air HF rolloff + altitude attenuation + wide reverb\\n            alt = np.maximum(cam_z, 2.0)\\n            alt_gain = np.clip((9.5 / (alt + 9.0)) ** 0.56, 0.28, 0.68)\\n            car_lp = signal.sosfilt(lowpass_sos(3200.0, order=2), car_mono)\\n            car_hp = signal.sosfilt(highpass_sos(115.0, order=1), car_lp)\\n            car_persp = car_hp * alt_gain\\n            pan_curve = 0.22 * np.sin(2.0 * np.pi * 0.18 * t_seg)\\n            sig_l, sig_r = stereo_pan_and_itd(car_persp, pan_curve, itd_scale=0.6)\\n            sig_l, sig_r = add_outdoor_track_reverb(sig_l, sig_r, wet=0.34)\\n\\n        else:\\n            # Chase / Orbit / WheelMacro: punchy rear-exhaust & mechanical presence!\\n            low_punch = signal.sosfilt(lowpass_sos(320.0, order=2), car_mono)\\n            punch_amt = 0.30 if typ == \\\"chase\\\" else (0.24 if typ == \\\"orbit\\\" else 0.22)\\n            car_persp = (0.82 * car_mono + punch_amt * low_punch) * (\\n                np.clip((9.0 / (dist + 3.0)) ** 0.30, 0.72, 1.02)\\n            )\"","Target":"\"        elif typ in (\\\"heli\\\", \\\"aerial\\\"):\\n            # Elevated helicopter / aerial perspective: air HF rolloff + altitude attenuation + wide reverb\\n            alt = np.maximum(cam_z, 2.0)\\n            alt_gain = np.clip((14.0 / (alt + 8.0)) ** 0.46, 0.38, 0.88)\\n            car_lp = signal.sosfilt(lowpass_sos(3400.0, order=2), car_mono)\\n            car_hp = signal.sosfilt(highpass_sos(105.0, order=1), car_lp)\\n            car_persp = car_hp * alt_gain\\n            pan_curve = 0.18 * np.sin(2.0 * np.pi * 0.18 * t_seg)\\n            sig_l, sig_r = stereo_pan_and_itd(car_persp, pan_curve, itd_scale=0.6)\\n            sig_l, sig_r = add_outdoor_track_reverb(sig_l, sig_r, wet=0.28)\\n\\n        else:\\n            # Chase / Orbit / WheelMacro: punchy rear-exhaust & mechanical presence!\\n            low_punch = signal.sosfilt(lowpass_sos(320.0, order=2), car_mono)\\n            punch_amt = 0.30 if typ == \\\"chase\\\" else (0.24 if typ == \\\"orbit\\\" else 0.22)\\n            car_persp = (0.94 * car_mono + punch_amt * low_punch) * (\\n                np.clip((10.0 / (dist + 2.5)) ** 0.28, 0.78, 1.12)\\n            )\""}},{"name":"edit_file","args":{"Path":"\"d:\\\\项目session\\\\blender-supercar\\\\pipeline\\\\synth_sfx.py\"","Replacement":"\"    # Gentle master bus peak control (preserving full pass-by & upshift transient punch!) + normalize to -1.5 dBFS\\n    peak_raw = max(float(np.max(np.abs(out_l))), float(np.max(np.abs(out_r))), 1e-9)\\n    gain_pre = 0.85 / peak_raw\\n    out_l = np.tanh(out_l * gain_pre) / math.tanh(0.85)\\n    out_r = np.tanh(out_r * gain_pre) / math.tanh(0.85)\"","Target":"\"    # Soft master bus peak control + normalize to -1.5 dBFS (0.8414 peak)\\n    peak_raw = max(float(np.max(np.abs(out_l))), float(np.max(np.abs(out_r))), 1e-9)\\n    gain_pre = 1.15 / peak_raw\\n    out_l = np.tanh(out_l * gain_pre) / math.tanh(1.15)\\n    out_r = np.tanh(out_r * gain_pre) / math.tanh(1.15)\""}}]}
