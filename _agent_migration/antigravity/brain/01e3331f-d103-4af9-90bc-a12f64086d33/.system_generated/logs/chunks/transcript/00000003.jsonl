{"step_index":193,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-18T08:29:21Z","content":"Created At: 2026-11-18T16:29:21+08:00\nCompleted At: 2026-11-18T16:29:22+08:00\nShowing lines 750-898 of 898\n750: \n751: # 线性空间三阶阈值（适配 Standard 视图 exposure=0.12：暗部 <0.14，中调 0.14..0.38，高光 >=0.38）\n752: # Impact Frame A (f=312 & f=1698): 反转白底 + 蜘蛛侠深绯红 + 浓墨黑剪影闪裂\n753: imp_col_a = color_ramp(imp_drive, [\n754:     (0.000, (0.90, 0.88, 0.83, 1.0)),\n755:     (0.145, (0.86, 0.015, 0.055, 1.0)),\n756:     (0.380, (0.005, 0.004, 0.010, 1.0)),\n757: ], interp='CONSTANT')\n758: \n759: # Impact Frame B (f=313 & f=1699): 暗夜墨黑底 + 2099 绯红中调 + 惨白高光利刃剪影\n760: imp_col_b = color_ramp(imp_drive, [\n761:     (0.000, (0.005, 0.004, 0.010, 1.0)),\n762:     (0.135, (0.86, 0.015, 0.055, 1.0)),\n763:     (0.365, (0.92, 0.90, 0.86, 1.0)),\n764: ], interp='CONSTANT')\n765: \n766: img_imp1 = mix_rgba('MIX', n_impact_a.outputs[0], img_speed, imp_col_a)\n767: img_final = mix_rgba('MIX', n_impact_b.outputs[0], img_imp1, imp_col_b)\n768: \n769: try:\n770:     comp_out = ng.nodes.new(\"CompositorNodeComposite\")\n771: except Exception:\n772:     comp_out = ng.nodes.new(\"NodeGroupOutput\")\n773:     if not any(s.name == \"Image\" for s in ng.interface.items_tree):\n774:         ng.interface.new_socket(name=\"Image\", in_out='OUTPUT', socket_type='NodeSocketColor')\n775: ng.links.new(img_final, comp_out.inputs['Image'])\n776: \n777: scene.compositing_node_group = ng\n778: scene.use_nodes = True\n779: \n780: # ---------------------------------------------------------------------------\n781: # 6. 逐帧烘焙合成器动态参数（三幕切换、次元撕裂、速度线 12fps 沸腾、Impact 冲击帧）\n782: # ---------------------------------------------------------------------------\n783: PORTAL_GLITCH_FRAMES = {\n784:     788: (15.0, -4.0, 0.85),\n785:     789: (-18.0, 5.0, 1.00),\n786:     790: (11.0, -3.0, 0.65),\n787:     1601: (16.0, 4.5, 0.85),\n788:     1602: (-19.0, -5.5, 1.00),\n789:     1603: (12.0, 3.0, 0.65),\n790: }\n791: IMPACT_A_FRAMES = {312, 1698}\n792: IMPACT_B_FRA\n<truncated 2709 bytes>\n= 1.0 if f in IMPACT_A_FRAMES else 0.0\n860:     n_impact_b.outputs[0].default_value = 1.0 if f in IMPACT_B_FRAMES else 0.0\n861: \n862:     for vn in (n_focus_dist, n_dof_span, n_kuw_size, n_kuw_mix, n_gwen_wash, n_cyber_wash,\n863:                n_split_x, n_split_y, n_glitch_mask, n_car_ink_scale, n_paper_fac,\n864:                n_speed_fac, n_sl_flip_x, n_sl_flip_y, n_impact_a, n_impact_b):\n865:         vn.outputs[0].keyframe_insert(\"default_value\", frame=f)\n866: \n867: if ng.animation_data and ng.animation_data.action:\n868:     for fc in iter_fcurves(ng.animation_data.action):\n869:         is_step_node = any(k in fc.data_path for k in (\"V6_SLFlip\", \"V6_Impact\", \"V6_Glitch\"))\n870:         for kp in fc.keyframe_points:\n871:             kp.interpolation = 'CONSTANT' if is_step_node else 'LINEAR'\n872:         fc.update()\n873: \n874: # 确保所有外部贴图使用绝对路径，保存至 v6_spiderverse/ 目录不丢失相对引用\n875: for _img in bpy.data.images:\n876:     if _img.filepath and _img.filepath.startswith(\"//\"):\n877:         _img.filepath = bpy.path.abspath(_img.filepath)\n878: \n879: scene.frame_set(1)\n880: scene.camera = active_cam_at(1)\n881: bpy.ops.wm.save_as_mainfile(filepath=OUT_BLEND, relative_remap=False)\n882: print(\"V6 ANIM+COMP SAVED:\", OUT_BLEND, flush=True)\n883: \n884: if TEST_FRAMES:\n885:     test_dir = os.path.join(PROJ, \"renders_v6\", \"test\")\n886:     os.makedirs(test_dir, exist_ok=True)\n887:     orig_cam = scene.camera\n888:     scene.render.resolution_x = 1920\n889:     scene.render.resolution_y = 1080\n890:     scene.render.image_settings.file_format = 'JPEG'\n891:     scene.render.image_settings.quality = 95\n892:     for tf in [int(x) for x in str(TEST_FRAMES).split(\",\")]:\n893:         scene.camera = active_cam_at(tf)\n894:         scene.frame_set(tf)\n895:         scene.render.filepath = os.path.join(test_dir, f\"sv_test_{tf:04d}.jpg\")\n896:         bpy.ops.render.render(write_still=True)\n897:         print(\"SV TEST RENDERED:\", tf, scene.camera.name, flush=True)\n898:     scene.camera = orig_cam","truncated_fields":["content"]}
