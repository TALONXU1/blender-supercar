-of\", \"json\", p], capture_output=True, text=True)\n    info = json.loads(pr.stdout)\n    dur = float(info[\"format\"][\"duration\"])\n    st_desc = []\n    for s in info[\"streams\"]:\n        if s[\"codec_type\"] == \"video\":\n            st_desc.append(f\"V:{s['codec_name']} {s['width']}x{s['height']}@{s['r_frame_rate']}({s.get('nb_frames','?')}f)\")\n        elif s[\"codec_type\"] == \"audio\":\n            st_desc.append(f\"A:{s['codec_name']} {s['sample_rate']}Hz {s['channels']}ch\")\n    vr = subprocess.run([FF, \"-hide_banner\", \"-nostats\", \"-i\", p, \"-af\", \"volumedetect,ebur128=peak=true\", \"-f\", \"null\", \"-\"], capture_output=True, text=True)\n    mean_v = max_v = lufs = tp = \"?\"\n    for line in vr.stderr.splitlines():\n        if \"mean_volume:\" in line: mean_v = line.split(\"mean_volume:\")[1].strip()\n        if \"max_volume:\" in line: max_v = line.split(\"max_volume:\")[1].strip()\n        if line.strip().startswith(\"I:\") and \"LUFS\" in line: lufs = line.split(\"I:\")[1].strip()\n        if line.strip().startswith(\"Peak:\") and \"dBFS\" in line: tp = line.split(\"Peak:\")[1].strip()\n    print(f\"{rel:44s} | {sz:10,d} B | dur={dur:7.4f}s | {' + '.join(st_desc)} | mean={mean_v}, max={max_v}, I={lufs}, TP={tp}\")\n'@ | python -","WaitMsBeforeAsync":10000,"toolSummary":"Verify all 6 V6 audio and MP4 deliverables with ffprobe and ebur128"}}]}
