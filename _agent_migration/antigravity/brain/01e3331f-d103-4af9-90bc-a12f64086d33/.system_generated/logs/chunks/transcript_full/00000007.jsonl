{"step_index":217,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-18T08:33:04Z","content":"Created At: 2026-11-18T16:33:04+08:00\nCompleted At: 2026-11-18T16:33:05+08:00\nShowing lines 1-180 of 1757\n1: # -*- coding: utf-8 -*-\n2: \"\"\"\n3: V6 SPIDER-VERSE 3D MEGA-CIRCUIT ANIMATION, 24 BLOCKBUSTER CAMERAS & 2.39:1 COMPOSITOR\n4: =====================================================================================\n5: 赛道数据: track_data/spiderverse_circuit.json\n6:           (Neo-Monaco x Nueva York 2099 Sky-Harbor / 3.72 km / ΔZ=+42.35 m / 17.4° Bank /\n7:            53.3333 s / 96 Beats @ 108 BPM / 1,281 Frames @ 24 fps)\n8: 输入工程: v6_spiderverse/v6_stage_lookdev.blend   (只读输入，100% 隔离 V5)\n9: 输出工程: v6_spiderverse/v6_stage_anim_sv.blend\n10: 相机清单: v6_spiderverse/v6_shots_manifest.json\n11: \n12: 用法:\n13:   python pipeline/v6_sv_comp.py --manifest-only\n14:   blender -b -P pipeline/v6_sv_comp.py\n15:   blender -b -P pipeline/v6_sv_comp.py -- --test 35,282,413,414,635,960,1041,1067,1068,1134\n16: \"\"\"\n17: import json\n18: import math\n19: import os\n20: import sys\n21: from math import sin, cos, pi, radians, degrees, sqrt, exp, atan2\n22: \n23: PROJ = r\"D:\\项目session\\blender-supercar\"\n24: TRACK_JSON = os.path.join(PROJ, \"track_data\", \"spiderverse_circuit.json\")\n25: MANIFEST_OUT = os.path.join(PROJ, \"v6_spiderverse\", \"v6_shots_manifest.json\")\n26: \n27: ARGV = sys.argv[sys.argv.index(\"--\") + 1:] if \"--\" in sys.argv else sys.argv[1:]\n28: \n29: \n30: def argval(flag, default=None):\n31:     if flag in ARGV:\n32:         i = ARGV.index(flag)\n33:         if i + 1 < len(ARGV) and not ARGV[i + 1].startswith(\"--\"):\n34:             return ARGV[i + 1]\n35:         return True\n36:     return default\n37: \n38: \n39: MANIFEST_ONLY = bool(argval(\"--manifest-only\", False))\n40: IN_BLEND = argval(\"--in\", os.path.join(PROJ, \"v6_spiderverse\", \"v6_stage_lookdev.blend\"))\n41: OUT_BLEND = argval(\"--out\", os.path.join(PROJ, \"v6_spiderverse\", \"v6_stage_anim_sv.blend\"))\n42: TEST_FRAMES = argval(\"--test\", None)\n43: \n44: os.makedirs(os.path.dirname(os.path.abspath(OUT_BLEND)), exist_ok=True)\n45: \n46: # ---------------------------------------------------------------------------\n47: # 0. 读取三维高程+倾角赛道数据并构建精确 C2 闭环插值器\n48: # ---------------------------------------------------------------------------\n49: raw = json.load(open(TRACK_JSON, encoding=\"utf-8\"))\n50: META = raw[\"meta\"]\n51: PTS = raw[\"points\"]\n52: N_PTS = len(PTS)\n53: FPS = int(META.get(\"fps\", 24))\n54: BPM = float(META.get(\"bpm\", 108.0))\n55: BEAT_S = 60.0 / BPM\n56: BEAT_F = BEAT_S * FPS                       # 13.3333333 帧/拍\n57: TOTAL_BEATS = int(META.get(\"beats\", 96))\n58: FRAME_END = int(META.get(\"frame_end\", 1281))\n59: LAP_S = float(META[\"sim_lap_s\"])            # 53.3333 s\n60: LAP_LEN = float(META[\"measured_length_km\"]) * 1000.0\n61: HALF_W = float(META.get(\"track_half_width_m\", 7.0))\n62: DT = LAP_S / (FRAME_END - 1)\n63: R_TIRE = 0.357\n64: WHEELBASE = 3.6\n65: \n66: \n67: def _unwrap_deg(arr):\n68:     out = [float(arr[0])]\n69:     for a in arr[1:]:\n70:         d = (float(a) - out[-1] + 180.0) % 360.0 - 180.0\n71:         out.append(out[-1] + d)\n72:     return out\n73: \n74: \n75: # 构造带闭环尾点 (idx = N_PTS, t = LAP_S) 的连续数组，消除 f=1281 接缝误差\n76: _hd_un = _unwrap_deg([p[\"heading_deg\"] for p in PTS] + [PTS[0][\"heading_deg\"]])\n77: T_ARR = [float(p[\"t\"]) for p in PTS] + [LAP_S]\n78: S_ARR = [float(p[\"s\"]) for p in PTS] + [LAP_LEN]\n79: CX_ARR = [float(p[\"xy\"][0]) for p in PTS] + [float(PTS[0][\"xy\"][0])]\n80: CY_ARR = [float(p[\"xy\"][1]) for p in PTS] + [float(PTS[0][\"xy\"][1])]\n81: CZ_ARR = [float(p[\"z\"]) for p in PTS] + [float(PTS[0][\"z\"])]\n82: RX_ARR = [float(p[\"racing_xy\"][0]) for p in PTS] + [float(PTS[0][\"racing_xy\"][0])]\n83: RY_ARR = [float(p[\"racing_xy\"][1]) for p in PTS] + [float(PTS[0][\"racing_xy\"][1])]\n84: RZ_ARR = [float(p[\"racing_z\"]) for p in PTS] + [float(PTS[0][\"racing_z\"])]\n85: OFF_ARR = [float(p[\"racing_offset_m\"]) for p in PTS] + [float(PTS[0][\"racing_offset_m\"])]\n86: PT_ARR = [float(p[\"pitch_deg\"]) for p in PTS] + [float(PTS[0][\"pitch_deg\"])]\n87: BK_ARR = [float(p[\"bank_deg\"]) for p in PTS] + [float(PTS[0][\"bank_deg\"])]\n88: KV_ARR = [float(p[\"curv_1pm\"]) for p in PTS] + [float(PTS[0][\"curv_1pm\"])]\n89: VL_ARR = [float(p[\"v_mps\"]) for p in PTS] + [float(PTS[0][\"v_mps\"])]\n90: TUN_ARR = [bool(p[\"tunnel\"]) for p in PTS] + [bool(PTS[0][\"tunnel\"])]\n91: BRG_ARR = [bool(p[\"bridge\"]) for p in PTS] + [bool(PTS[0][\"bridge\"])]\n92: ZN_ARR = [str(p[\"zone\"]) for p in PTS] + [str(PTS[0][\"zone\"])]\n93: \n94: \n95: def _v_add(a, b):\n96:     return (a[0] + b[0], a[1] + b[1], a[2] + b[2])\n97: \n98: \n99: def _v_sub(a, b):\n100:     return (a[0] - b[0], a[1] - b[1], a[2] - b[2])\n101: \n102: \n103: def _v_mul(a, s):\n104:     return (a[0] * s, a[1] * s, a[2] * s)\n105: \n106: \n107: def _v_len(a):\n108:     return sqrt(a[0] * a[0] + a[1] * a[1] + a[2] * a[2])\n109: \n110: \n111: def _v_norm(a):\n112:     ln = max(1e-12, _v_len(a))\n113:     return (a[0] / ln, a[1] / ln, a[2] / ln)\n114: \n115: \n116: def _v_lerp(a, b, f):\n117:     return (a[0] + (b[0] - a[0]) * f, a[1] + (b[1] - a[1]) * f, a[2] + (b[2] - a[2]) * f)\n118: \n119: \n120: def _v_dot(a, b):\n121:     return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]\n122: \n123: \n124: def ribbon_basis_tuples(h_rad, pt_rad, bk_rad):\n125:     \"\"\"与 @track / @env-2 100% 共享的三维正交路面基底 (T=前向切线, R=倾角右向, U=倾角法向向上)\"\"\"\n126:     ch, sh = cos(h_rad), sin(h_rad)\n127:     cp, sp = cos(pt_rad), sin(pt_rad)\n128:     cb, sb = cos(bk_rad), sin(bk_rad)\n129:     T = _v_norm((cp * ch, cp * sh, sp))\n130:     R0 = (sh, -ch, 0.0)\n131:     U0 = _v_norm((-sp * ch, -sp * sh, cp))\n132:     R = _v_norm((cb * R0[0] - sb * U0[0], cb * R0[1] - sb * U0[1], cb * R0[2] - sb * U0[2]))\n133:     U = _v_norm((sb * R0[0] + cb * U0[0], sb * R0[1] + cb * U0[1], sb * R0[2] + cb * U0[2]))\n134:     return T, R, U\n135: \n136: \n137: def sample_3d(t_sec):\n138:     t_c = max(0.0, min(LAP_S - 1e-7, t_sec))\n139:     lo, hi = 0, N_PTS\n140:     while hi - lo > 1:\n141:         mid = (lo + hi) // 2\n142:         if T_ARR[mid] <= t_c:\n143:             lo = mid\n144:         else:\n145:             hi = mid\n146:     span = max(T_ARR[lo + 1] - T_ARR[lo], 1e-9)\n147:     u = (t_c - T_ARR[lo]) / span\n148:     lerp1 = lambda arr: arr[lo] + (arr[lo + 1] - arr[lo]) * u\n149: \n150:     h_deg = lerp1(_hd_un)\n151:     pt_deg = lerp1(PT_ARR)\n152:     bk_deg = lerp1(BK_ARR)\n153:     T, R, U = ribbon_basis_tuples(radians(h_deg), radians(pt_deg), radians(bk_deg))\n154: \n155:     c_pos = (lerp1(CX_ARR), lerp1(CY_ARR), lerp1(CZ_ARR))\n156:     r_pos = (lerp1(RX_ARR), lerp1(RY_ARR), lerp1(RZ_ARR))\n157:     return dict(\n158:         t=t_c,\n159:         s=lerp1(S_ARR),\n160:         c_pos=c_pos,\n161:         pos=r_pos,\n162:         off=lerp1(OFF_ARR),\n163:         heading_deg=h_deg,\n164:         heading=radians(h_deg),\n165:         pitch_deg=pt_deg,\n166:         pitch=radians(pt_deg),\n167:         bank_deg=bk_deg,\n168:         bank=radians(bk_deg),\n169:         k=lerp1(KV_ARR),\n170:         v=lerp1(VL_ARR),\n171:         tunnel=TUN_ARR[lo if u < 0.5 else lo + 1],\n172:         bridge=BRG_ARR[lo if u < 0.5 else lo + 1],\n173:         zone=ZN_ARR[lo],\n174:         T=T,\n175:         R=R,\n176:         U=U,\n177:     )\n178: \n179: \n180: def sample_at_s(s_query):"}
