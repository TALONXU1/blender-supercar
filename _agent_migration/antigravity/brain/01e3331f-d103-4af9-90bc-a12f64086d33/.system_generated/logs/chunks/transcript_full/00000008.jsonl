8:             wl, wr = stereo_pan_and_itd(0.42 * wake_env * wake_n, pan_c, itd_scale=1.2)\n789:             sig_l += wl\n790:             sig_r += wr\n791:         elif typ == \"orbit\":\n792:             pan_c = np.linspace(-0.38, 0.38, n_seg)\n793:             sig_l, sig_r = stereo_pan_and_itd(mono * 0.92, pan_c, itd_scale=0.6)\n794:         elif typ in (\"wheel\", \"scraper\", \"rail\"):\n795:             # Asphalt-scraping 14mm hero cam / 17.4 deg banked bowl upper-wall rail cam (0.7m from wingtip!):\n796:             # Add visceral close-proximity aero shear & tire/barrier rush!\n797:             prox_rush = 0.24 * ((v_mps / 88.0) ** 1.4) * signal.sosfilt(\n798:                 bp_sos(160.0, 3400.0, order=2), rng.standard_normal(n_seg)\n799:             )\n800:             pan_c = np.full(n_seg, -0.32 if typ == \"rail\" else (0.25 if float(pr.get(\"side\", -2.0)) < 0 else -0.25))\n801:             sig_l, sig_r = stereo_pan_and_itd((mono + prox_rush) * 1.04, pan_c, itd_scale=0.6)\n802:         elif typ == \"aerial\":\n803:             sig_l, sig_r = stereo_pan_and_itd(signal.sosfilt(lp_sos(3500.0), mono * 0.62), np.zeros(n_seg), 0.3)\n804:         else:\n805:             pan_c = np.clip(-0.12 * curv_all[s0:s1] / 0.02, -0.22, 0.22)\n806:             sig_l, sig_r = stereo_pan_and_itd(mono * 0.90, pan_c, itd_scale=0.35)\n807: \n808:         win = np.ones(n_seg, dtype=np.float64)\n809:         if s_idx > 0:\n810:             n_in = min(2 * xfade_half, n_seg)\n811:             win[:n_in] *= np.sin(0.5 * np.pi * np.linspace(0.0, 1.0, n_in))\n812:         if s_idx < n_shots - 1:\n813:             n_out = min(2 * xfade_half, n_seg)\n814:             win[-n_out:] *= np.cos(0.5 * np.pi * np.linspace(0.0, 1.0, n_out))\n815: \n816:         out_l[s0:s1] += sig_l * win\n817:         out_r[s0:s1] += sig_r * win\n818: \n819:     # --- Continuous Set-Piece Physical FX Layers ---\n820:     v_norm = np.clip(v_kmh_all / 341.2, 0.0, 1.0)\n821: \n822:     # A) Golden Titanium Skid-Block Spark Scrape Crackles (Eau-Rouge bottom compression f~282 & >325 km/h bumps!)\n823:     spark_env = np.clip(vert_g_all / 1.35, 0.0, 1.25) + 0.35 * np.clip((v_kmh_all - 322.0) / 18.0, 0.0, 1.0)\n824:     spark_env = signal.sosfilt(lp_sos(14.0, order=1), np.clip(spark_env, 0.0, 1.2))\n825:     scrape_l = signal.sosfilt(bp_sos(2800.0, 9200.0, order=2), rng.standard_normal(n_total))\n826:     scrape_r = signal.sosfilt(bp_sos(2800.0, 9200.0, order=2), rng.standard_normal(n_total))\n827:     sparks_pop_l = np.clip(rng.standard_normal(n_total) - 2.15, 0.0, 5.0) * scrape_l\n828:     sparks_pop_r = np.clip(rng.standard_normal(n_total) - 2.15, 0.0, 5.0) * scrape_r\n829:     out_l += spark_env * (0.14 * scrape_l + 0.24 * sparks_pop_l)\n830:     out_r += spark_env * (0.14 * scrape_r + 0.24 * sparks_pop_r)\n831: \n832:     # B) Sky-Bridge Stay-Cable Supersonic Pass-By Flutter (bridge == True, s % 18m cable spacing!)\n833:     cable_pulse = (np.cos(2.0 * np.pi * (s_m_all / 18.0)) ** 8) * bridge_all * (v_norm ** 1.4)\n834:     cable_whoosh = signal.sosfilt(bp_sos(180.0, 1900.0, order=2), rng.standard_normal(n_total))\n835:     out_l += 0.22 * cable_pulse * cable_whoosh"}
