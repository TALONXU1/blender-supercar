end, f1), typ, pr])\n\n    clean_wins = []\n    for nm, f0, f1, typ, pr in windows:\n        if clean_wins and clean_wins[-1][2] >= frame_end - 2:\n            break\n        s_f0 = 1 if not clean_wins else max(f0, clean_wins[-1][2] + 1)\n        s_f1 = min(frame_end, max(s_f0 + 2, f1))\n        clean_wins.append([nm, s_f0, s_f1, typ, pr])\n    clean_wins[-1][2] = frame_end\n\n    return clean_wins, impact_frames, manifest_cam","Target":"def try_parse_v6_comp_shots(frame_end, lap_s, bpm):\n    \"\"\"\n    Dynamically inspects pipeline/v6_sv_comp.py (read-only AST) if it has been updated\n    for the 1,281-frame 3D circuit, extracting SHOTS & IMPACT_FRAMES when available.\n    Falls back cleanly to a 24-shot 96-beat blockbuster schedule aligned to circuit zones.\n    \"\"\"\n    beat_f = (60.0 / bpm) * FPS  # 13.3333 frames/beat\n    dt_frame = lap_s / float(frame_end - 1)\n\n    parsed_shots = None\n    parsed_impacts = None\n    if os.path.exists(V6_COMP_PY):\n        try:\n            with open(V6_COMP_PY, encoding=\"utf-8\") as f:\n                src = f.read()\n            if \"spiderverse_circuit\" in src:\n                tree = ast.parse(src, filename=V6_COMP_PY)\n                safe_ns = {\"dict\": dict, \"True\": True, \"False\": False, \"None\": None}\n                for node in tree.body:\n                    if isinstance(node, ast.Assign):\n                        for tgt in node.targets:\n                            if isinstance(tgt, ast.Name):\n                                if tgt.id == \"SHOTS\":\n                                    parsed_shots = eval(\n                                        compile(ast.Expression(node.value), \"<SHOTS>\", \"eval\"),\n                                        {\"__builtins__\": {}},\n                                        safe_ns,\n                                    )\n                                elif tgt.id in (\"IMPACT_FRAMES\", \"IMPACT_BEATS\"):\n                                    parsed_impacts = eval(\n                                        compile(ast.Expression(node.value), \"<IMP>\", \"eval\"),\n                                        {\"__builtins__\": {}},\n                                        safe_ns,\n                                    )\n        except Exception:\n            parsed_shots = None\n\n    # Build 24-shot beat-snapped schedule (4 beats = 53.33 frames = 2.22s avg per shot across 96 beats!)\n    # Includes dramatic 3D Doppler whips at Canyon Chicane, Eau-Rouge Crest, Banked Bowl, Tunnel Exit & Harbor Hairpin!\n    default_24_shots = [\n        (\"SV01_CanyonScrape\",    0,  4, \"wheel\",   {\"side\": 2.4, \"back\": -0.8, \"h\": 0.22}),\n        (\"SV02_FPVDropExhaust\",  4,  8, \"chase\",   {\"back\": 6.5, \"side\": 0.0,  \"h\": 1.8}),\n        (\"SV03_ChicaneWhip\",     8, 12, \"fixed\",   {\"f_pass\": 125, \"lead\": -4.0, \"side\": 8.0, \"h\": 0.65}),\n        (\"SV04_CanyonCockpit\",  12, 16, \"onboard\", {\"fwd\": -0.46, \"side\": 0.05, \"h\": 0.89}),\n        (\"SV05_EauRougeEntry\",  16, 20, \"chase\",   {\"back\": 6.2, \"side\": -1.4, \"h\": 0.45}),\n        (\"SV06_SparkScrapeLow\", 20, 24, \"wheel\",   {\"side\": -2.3, \"back\": 1.2, \"h\": 0.20}),\n        (\"SV07_RaidillonClimb\", 24, 28, \"orbit\",   {\"r\": 7.5, \"h\": 1.2}),\n        (\"SV08_CrestMoonTele\",  28, 32, \"fixed\",   {\"f_pass\": 414, \"lead\": -9.0, \"side\": -8.2, \"h\": 1.1}),\n        (\"SV09_BridgeEntry\",    32, 36, \"chase\",   {\"back\": 7.8, \"side\": 1.5,  \"h\": 0.9}),\n        (\"SV10_StayCablePan\",   36, 40, \"fixed\",   {\"f_pass\": 508, \"lead\": 0.0, \"side\": 9.2, \"h\": 1.2}),\n        (\"SV11_SkyBridgeAero\",  40, 45, \"onboard\", {\"fwd\": -0.46, \"side\": -0.05, \"h\": 0.90}),\n        (\"SV12_BowlBankRail\",   45, 50, \"wheel\",   {\"side\": -2.8, \"back\": 0.6, \"h\": 0.55}),\n        (\"SV13_CarouselOrbit\",  50, 54, \"orbit\",   {\"r\": 8.2, \"h\": 1.5}),\n        (\"SV14_CorkscrewDive\",  54, 59, \"chase\",   {\"back\": 6.8, \"side\": 1.2,  \"h\": 1.6}),\n        (\"SV15_PlungeWhip\",     59, 63, \"fixed\",   {\"f_pass\": 830, \"lead\": -5.0, \"side\": -8.4, \"h\": 0.9}),\n        (\"SV16_HarborDrop\",     63, 67, \"chase\",   {\"back\": 7.2, \"side\": -1.1, \"h\": 0.65}),\n        (\"SV17_TunnelPortal\",   67, 71, \"fixed\",   {\"f_pass\": 912, \"lead\": -6.0, \"side\": 7.6, \"h\": 0.85}),\n        (\"SV18_TunnelCockpit\",  71, 75, \"onboard\", {\"fwd\": -0.48, \"side\": 0.04, \"h\": 0.90}),\n        (\"SV19_TunnelWhipOrb\",  75, 78, \"orbit\",   {\"r\": 6.4, \"h\": 0.85}),\n        (\"SV20_TunnelExitSmash\",78, 81, \"fixed\",   {\"f_pass\": 1042, \"lead\": -6.0, \"side\": -8.2, \"h\": 0.80}),\n        (\"SV21_HairpinImpact\",  81, 85, \"fixed\",   {\"f_pass\": 1082, \"lead\": -8.0, \"side\": 8.5, \"h\": 0.95}),\n        (\"SV22_HairpinApex\",    85, 89, \"orbit\",   {\"r\": 7.2, \"h\": 0.95}),\n        (\"SV23_HarborLaunch\",   89, 93, \"chase\",   {\"back\": 6.5, \"side\": 1.0,  \"h\": 0.50}),\n        (\"SV24_FinishHeliOut\",  93, 96, \"aerial\",  {\"back\": 14.0, \"side\": 4.0, \"h\": 6.5}),\n    ]\n\n    windows = []\n    if parsed_shots and isinstance(parsed_shots, (list, tuple)) and len(parsed_shots) >= 12:\n        for item in parsed_shots:\n            if len(item) >= 4:\n                nm = str(item[0])\n                a0, a1 = float(item[1]), float(item[2])\n                typ = str(item[3]).lower()\n                pr = item[4] if (len(item) >= 5 and isinstance(item[4], dict)) else {}\n                # Detect whether a0/a1 are frame numbers, beat numbers, or seconds\n                if max(a0, a1) > 120.0:\n                    f0, f1 = int(round(a0)), int(round(a1))\n                elif max(a0, a1) > 60.0:\n                    f0 = int(round(1.0 + a0 * beat_f))\n                    f1 = int(round(1.0 + a1 * beat_f))\n                else:\n                    f0 = int(round(1.0 + a0 / dt_frame))\n                    f1 = int(round(1.0 + a1 / dt_frame))\n                windows.append([nm, max(1, min(frame_end, f0)), max(2, min(frame_end, f1)), typ, pr])\n\n    if not windows:\n        for nm, b0, b1, typ, pr in default_24_shots:\n            f0 = int(round(1.0 + b0 * beat_f))\n            f1 = int(round(1.0 + b1 * beat_f))\n            windows.append([nm, f0, min(frame_end, f1), typ, pr])\n\n    for i in range(len(windows)):\n        windows[i][1] = max(1, windows[i][1])\n        windows[i][2] = min(frame_end, max(windows[i][1] + 2, windows[i][2]))\n        if i > 0 and windows[i][1] <= windows[i - 1][2]:\n            windows[i][1] = windows[i - 1][2] + 1\n            windows[i][2] = max(windows[i][2], windows[i][1] + 2)\n    windows[-1][2] = frame_end\n\n    # Locked to #33 Impact Frames: f=413..414 (Eau-Rouge +42m Blind Crest) & f=1067..1068 (Harbor Hairpin Slam)\n    impact_frames = [413, 1067]\n    if parsed_impacts and isinstance(parsed_impacts, (list, tuple)):\n        ints = []\n        for x in parsed_impacts:\n            if isinstance(x, (int, float)):\n                ints.append(int(x))\n            elif isinstance(x, (list, tuple)) and x and isinstance(x[0], (int, float)):\n                ints.append(int(x[0]))\n        if ints:\n            impact_frames = sorted(set(ints))\n\n    # If v6_spiderverse/v6_shots_manifest.json exists, load exact per-frame camera world positions & shot windows!\n    manifest_cam = None\n    if os.path.exists(V6_MANIFEST_JSON):\n        try:\n            with open(V6_MANIFEST_JSON, encoding=\"utf-8\") as mf:\n                mdata = json.load(mf)\n            # Extract per-frame 3D camera locs & types if present\n            frames_list = mdata.get(\"frames\") if isinstance(mdata, dict) else (mdata if isinstance(mdata, list) else None)\n            if isinstance(frames_list, list) and len(frames_list) >= frame_end:\n                cam_xyz = np.zeros((frame_end, 3), dtype=np.float64)\n                f_types = []\n                f_names = []\n                for idx_f in range(frame_end):\n                    entry = frames_list[idx_f]\n                    loc = entry.get(\"cam_loc\") or entry.get(\"loc\") or entry.get(\"location\") or entry.get(\"pos\") or [0, 0, 1]\n                    cam_xyz[idx_f] = [float(loc[0]), float(loc[1]), float(loc[2])]\n                    f_types.append(str(entry.get(\"type\") or entry.get(\"shot_type\") or \"chase\").lower())\n                    f_names.append(str(entry.get(\"shot\") or entry.get(\"name\") or entry.get(\"cam\") or f\"Shot_{idx_f}\"))\n                manifest_cam = {\"cam_xyz\": cam_xyz, \"types\": f_types, \"names\": f_names}\n                # Reconstruct exact shot windows from contiguous camera/shot names\n                m_wins = []\n                cur_nm, cur_tp, cur_f0 = f_names[0], f_types[0], 1\n                for idx_f in range(1, frame_end):\n                    if f_names[idx_f] != cur_nm:\n                        m_wins.append([cur_nm, cur_f0, idx_f, cur_tp, {}])\n                        cur_nm, cur_tp, cur_f0 = f_names[idx_f], f_types[idx_f], idx_f + 1\n                m_wins.append([cur_nm, cur_f0, frame_end, cur_tp, {}])\n                if len(m_wins) >= 8:\n                    windows = m_wins\n            elif isinstance(mdata, dict) and isinstance(mdata.get(\"shots\"), list) and len(mdata[\"shots\"]) >= 8:\n                m_wins = []\n                for sh in mdata[\"shots\"]:\n                    nm = str(sh.get(\"name\") or sh.get(\"cam\") or \"Shot\")\n                    sf0 = int(sh.get(\"f0\") or sh.get(\"frame_start\") or 1)\n                    sf1 = int(sh.get(\"f1\") or sh.get(\"frame_end\") or sf0 + 10)\n                    stp = str(sh.get(\"type\") or \"chase\").lower()\n                    m_wins.append([nm, sf0, sf1, stp, sh])\n                    if isinstance(sh.get(\"frames\"), list):\n                        pass\n                windows = m_wins\n        except Exception as exc:\n            print(\"[synth_sfx_sv] Note: manifest parse skipped:\", exc)\n\n    re