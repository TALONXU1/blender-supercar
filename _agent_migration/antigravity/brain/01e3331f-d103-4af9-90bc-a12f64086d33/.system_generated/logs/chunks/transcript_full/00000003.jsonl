eat_state\n433:     rig[\"rear_slip\"] = 1.0\n434:     rig[\"susp_f\"] = -0.004 - 0.014 * max(0.0, -acc) / 12.0\n435:     rig[\"susp_r\"] = -0.004 - 0.016 * max(0.0, acc) / 12.0\n436:     for kk in (\"wheel_spin\", \"steer\", \"drs\", \"brake_heat\", \"rear_slip\", \"susp_f\", \"susp_r\"):\n437:         rig.keyframe_insert(f'[\"{kk}\"]', frame=f)\n438: \n439:     # 刹车盘与卡钳红橙热辉光关键帧\n440:     bh = brake_heat_state\n441:     for kind, einp, minp in brake_disc_emit_inputs:\n442:         if kind == \"glow_sheet\":\n443:             einp.default_value = (bh ** 1.25) * 8.5\n444:             einp.keyframe_insert(\"default_value\", frame=f)\n445:             minp.default_value = min(0.92, (bh ** 0.85) * 0.85)\n446:             minp.keyframe_insert(\"default_value\", frame=f)\n447:         else:\n448:             einp.default_value = (bh ** 1.35) * 5.2\n449:             einp.keyframe_insert(\"default_value\", frame=f)\n450:     for cinp in caliper_emit_inputs:\n451:         cinp.default_value = max(0.0, bh - 0.32) * 1.35\n452:         cinp.keyframe_insert(\"default_value\", frame=f)\n453: \n454:     # FIA 尾部雨灯 / ERS 能量回收灯：重刹或高速收油（acc < -2.5）时 ~6 Hz 高频红闪，其余常亮微光\n455:     if rain_emit_input is not None:\n456:         if acc < -2.5:\n457:             pulse_on = ((fd['t'] * 6.0) % 1.0) < 0.55\n458:             rain_emit_input.default_value = 24.0 if pulse_on else 1.2\n459:         else:\n460:             rain_emit_input.default_value = 2.5\n461:         rain_emit_input.keyframe_insert(\"default_value\", frame=f)\n462: \n463:     # 方向盘换挡提示灯：随档内转速比依次点亮绿 -> 黄 -> 红，升档瞬间闪烁\n464:     rf = fd['rpm_frac']\n465:     if len(shift_led_inputs) == 3:\n466:         shift_led_inputs[0].default_value = 7.5 if rf > 0.28 else 0.35\n467:         shift_led_inputs[1].default_value = 8.5 if rf > 0.58 else 0.25\n468:         shift_led_inputs[2].default_value = (13.0 if shift_flash > 0.5 else 9.5) if rf > 0.82 else 0.20\n469:         for sinp in shift_led_inputs:\n470:             sinp.keyframe_insert(\"