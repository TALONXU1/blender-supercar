mps.append((f, degrees(dh)))\n519: print(\"[check] 最坏横向 %.2f m/s^2 (%.2f g) @ frame %d, t=%.1f s\"\n520:       % (worst['v'] ** 2 * abs(worst['k']), worst['v'] ** 2 * abs(worst['k']) / 9.81,\n521:          int(round(worst['t'] / DT)) + 1, worst['t']))\n522: print(\"[check] 超限帧 %d -> %s\" % (len(over), \"PASS\" if not over else \"FAIL\"))\n523: print(\"[check] 航向跳变帧(>6.9deg) %d -> %s\" % (len(jumps), \"PASS\" if not jumps else str(jumps[:6])))\n524: print(\"[check] v_max %.1f km/h, lap %.2f s, 帧数 %d\" % (max(d['v'] for d in frame_data.values()) * 3.6, LAP_S, FRAME_END))\n525: \n526: # ---------------------------------------------------------------\n527: # 5. 26 机位（无遮挡精调 + V5_CamFocus 广播级景深 + 弯道 G 力微倾与路肩微振）\n528: # ---------------------------------------------------------------\n529: DOF_FOCUS_CAMS = {\n530:     \"Cam_S04_Hairpin\",\n531:     \"Cam_S08_FastPan\",\n532:     \"Cam_S09_WheelMacro\",\n533:     \"Cam_S11_Luffield\",\n534:     \"Cam_S13_WoodcoteTele\",\n535:     \"Cam_S20_StoweTele\",\n536:     \"Cam_S24_Club\",\n537: }\n538: \n539: \n540: def make_cam(name, lens=50, fstop=4.0, use_focus_obj=True):\n541:     cd = bpy.data.cameras.new(name + \"_DATA\")\n542:     cd.lens = lens\n543:     cd.clip_start = 0.5\n544:     cd.clip_end = 9000\n545:     cd.sensor_width = 36\n546:     cd.dof.use_dof = True\n547:     cd.dof.aperture_fstop = fstop\n548:     cd.dof.aperture_blades = 9\n549:     if use_focus_obj:\n550:         cd.dof.focus_object = cam_focus\n551:     ob = bpy.data.objects.new(name, cd)\n552:     _cam_coll.objects.link(ob)\n553:     return ob\n554: \n555: \n556: def cam_look(ob, loc, target, roll_deg=0.0, fstop=None, lens=None):\n557:     loc = Vector(loc)\n558:     tgt = Vector(target)\n559:     d = tgt - loc\n560:     q = d.to_track_quat('-Z', 'Y')\n561:     m = q.to_matrix().to_4x4()\n562:     if abs(roll_deg) > 1e-6:\n563:         m = m @ Matrix.Rotation(radians(roll_deg), 4, 'Z')\n564:     ob.matrix_world = Matrix.Translation(loc) @ m\n565:     if fstop is not None:\n566:         ob.data.dof.aperture_fstop = fstop\n567:         if ob.data.dof.focus_object is None:\n568:             ob.data.dof.focus_distance = d.length\n569:     if lens is not None:\n570:         ob.data.lens = lens\n571: \n572: \n573: def noise(t, seed=0.0, amp=1.0):\n574:     return (sin(t * 2.3 + seed) * 0.55 + sin(t * 5.7 + seed * 2.3) * 0.3\n575:             + sin(t * 11.3 + seed * 4.1) * 0.15) * amp\n576: \n577: \n578: def micro_vib(f, seed, amp):\n579:     \"\"\"确定性高频悬挂/路肩微振（受车速与弯道路肩贴近度缩放，细腻不眩晕）\"\"\"\n580:     return (sin(f * 1.43 + seed) * 0.52\n581:             + sin(f * 2.91 + seed * 1.7) * 0.31\n582:             + sin(f * 5.17 + seed * 3.1) * 0.17) * amp\n583: \n584: \n585: def smooth(t):\n586:     t = max(0.0, min(1.0, t))\n587:     return t * t * (3 - 2 * t)\n588: \n589: \n590: def key_cam(cam, f, loc, tgt, roll=0.0, fstop=4.0, lens=50, lens_key=True):\n591:     cam_look(cam, loc, tgt, roll_deg=roll, fstop=fstop, lens=lens)\n592:     cam.keyframe_insert(\"location\", frame=f)\n593:     cam.keyframe_insert(\"rotation_euler\", frame=f)\n594:     if cam.data.dof.focus_object is None:\n595:         cam.data.dof.keyframe_insert(\"focus_distance\", frame=f)\n596:     cam.data.dof.keyframe_insert(\"aperture_fstop\", frame=f)\n597:     if lens_key:\n598:         cam.data.keyframe_insert(\"lens\", frame=f)\n599: \n600: \n601: def C(fd, back=0.0, side=0.0, h=0.5):\n602:     return fd['pos'] - fd['fwd'] * back + fd['right'] * side + Vector((0, 0, h))\n603: \n604: \n605: def T(fd, ahead=0.0, side=0.0, h=0.45):\n606:     return fd['pos'] + fd['fwd'] * ahead + fd['right'] * side + Vector((0, 0, h))\n607: \n608: \n609: def fixed_point(f, back=0.0, side=0.0, h=0.5):\n610:     fd = frame_data[f]\n611:     return C(fd, back, side, h)\n612: \n613: \n614: CAR_LEN = 4.7\n615: CAR_W = 2.2\n616: SENSOR_W = 36.0\n617: \n618: \n619: def lens_for_framing(dist, frac, cos_a=0.0):\n620:     \"\"\"cos_a: 1=正对车头/车尾, 0=正侧面。按投影宽度算焦距\"\"\""}
