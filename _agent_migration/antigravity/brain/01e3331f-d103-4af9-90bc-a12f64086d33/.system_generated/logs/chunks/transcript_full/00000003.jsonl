rpm_frac = gear_and_rpm_frac(v * 3.6)\n146:     frame_data[f]['accel'] = accel\n147:     frame_data[f]['lat'] = v * v * abs(k) / 9.81          # 无符号 g（供物理自检与侧倾幅值）\n148:     frame_data[f]['lat_signed'] = v * v * k / 9.81        # 有符号 g（+左弯 / -右弯）\n149:     frame_data[f]['gear'] = gear\n150:     frame_data[f]['rpm_frac'] = rpm_frac\n151:     frame_data[f]['kerb_prox'] = min(1.0, abs(k) / 0.0085)\n152: \n153: # 平滑横向 G（用于相机地平线微倾耦合，避免突变）\n154: for f in range(1, FRAME_END + 1):\n155:     w0, w1 = max(1, f - 4), min(FRAME_END, f + 4)\n156:     frame_data[f]['lat_smooth'] = sum(frame_data[j]['lat_signed'] for j in range(w0, w1 + 1)) / (w1 - w0 + 1)\n157: \n158: # ---------------------------------------------------------------\n159: # 2. 打开场景与集合整理（根 Scene Collection 零散落对象）\n160: # ---------------------------------------------------------------\n161: bpy.ops.wm.open_mainfile(filepath=IN)\n162: scene = bpy.context.scene\n163: rig = bpy.data.objects[\"RIG_F1_Race\"]\n164: \n165: # 把 RIG_F1_Race 归入 SCIFI_F1_2035 集合（保持根集合整洁）\n166: _scifi_coll = bpy.data.collections.get(\"SCIFI_F1_2035\")\n167: if _scifi_coll:\n168:     if rig.name not in _scifi_coll.objects:\n169:         _scifi_coll.objects.link(rig)\n170:     if rig.name in scene.collection.objects:\n171:         scene.collection.objects.unlink(rig)\n172: \n173: _lgt_coll = bpy.data.collections.get(\"V5_07_Lighting\")\n174: if not _lgt_coll:\n175:     _lgt_coll = bpy.data.collections.new(\"V5_07_Lighting\")\n176:     scene.collection.children.link(_lgt_coll)\n177: \n178: _cam_coll = bpy.data.collections.get(\"V5_08_Cameras\")\n179: if not _cam_coll:\n180:     _cam_coll = bpy.data.collections.new(\"V5_08_Cameras\")\n181:     scene.collection.children.link(_cam_coll)\n182: \n183: # 发车灯常暗（本圈是飞驰圈，不是静态发车）\n184: _sl = bpy.data.materials.get(\"V5_StartLight\")\n185: if _sl and _sl.node_tree:\n186:     for n in _sl.node_tree.nodes:\n187:         if n.type == 'BSDF_PRINCIPLED' and 'Emission Strength' in n.inputs:\n188:             n.inputs['Emission Strength'].default_value = 0.0\n189: \n190: bone_root = rig.pose.bones[\"Bone_Root\"]\n191: bone_heading = rig.pose.bones[\"Bone_Heading\"]\n192: bone_body = rig.pose.bones[\"Bone_Body\"]\n193: \n194: # 真实 F1 转向传动比（~9.5:1），配合 Bone_Steering_Wheel 驱动器让车载镜头里方向盘转动清晰自然\n195: rig[\"steer_ratio\"] = 9.5\n196: \n197: # --- 动态遥测材质准备 ---\n198: # 1) FIA 尾部雨灯 / ERS 能量回收灯（独立红色发光材质，绝不与排气管/方向盘旋钮共用 Mat_Neon_Orange）\n199: rain_emit_input = None\n200: _rl = bpy.data.objects.get(\"GEO_F1_FIA_RainLight\")\n201: if _rl and hasattr(_rl.data, \"materials\"):\n202:     _m_rain = bpy.data.materials.get(\"Mat_FIA_RainLight\") or bpy.data.materials.new(\"Mat_FIA_RainLight\")\n203:     _m_rain.use_nodes = True\n204:     _rnt = _m_rain.node_tree\n205:     _rnt.nodes.clear()\n206:     _rb = _rnt.nodes.new(\"ShaderNodeBsdfPrincipled\")\n207:     _rb.inputs['Base Color'].default_value = (0.10, 0.005, 0.005, 1.0)\n208:     _rb.inputs['Roughness'].default_value = 0.22\n209:     _rb.inputs['Emission Color'].default_value = (1.0, 0.018, 0.010, 1.0)\n210:     _rb.inputs['Emission Strength'].default_value = 2.4"}
