dtype=np.float64) / SR\n    n_l = rng.standard_normal(n)\n    n_r = rng.standard_normal(n)\n    air_l = signal.sosfilt(bp_sos(3200.0, 11500.0, order=2), n_l) * np.exp(-11.5 * t)\n    air_r = signal.sosfilt(bp_sos(3200.0, 11500.0, order=2), n_r) * np.exp(-11.0 * t)\n    stick = signal.sosfilt(bp_sos(900.0, 3400.0, order=2), 0.5 * (n_l + n_r)) * np.exp(-55.0 * t)\n    return 0.20 * (air_l + 0.6 * stick), 0.20 * (air_r + 0.6 * stick)\n\n\ndef render_2099_cyber_brass_layer(eff_throt_48k, v_kmh_48k, accel_48k, act3_mask):\n    \"\"\"\n    Act III (Earth-928 Spider-2099): Menacing Miguel O'Hara / Prowler-inspired\n    distorted unison sawtooth cyber-brass synth growl in F minor (F1=43.65Hz / F2=87.31Hz / C3=130.81Hz),\n    driven by F1 throttle load & acceleration!\n    \"\"\"\n    i0 = max(0, int(np.argmax(act3_mask > 0.01)) - int(0.2 * SR))\n    n = len(act3_mask) - i0\n    t = np.arange(n, dtype=np.float64) / SR\n\n    throt = eff_throt_48k[i0:]\n    v_kmh = v_kmh_48k[i0:]\n    acc = accel_48k[i0:]\n    mask = act3_mask[i0:]\n\n    # Pitch bends up a menacing minor-second (Gb -> F) on braking/corner transitions + subtle speed tension!\n    brake_tension = np.clip(-acc / 28.0, 0.0, 1.0)\n    semi_bend = 2.0 ** ((0.85 * brake_tension + 0.12 * np.clip((v_kmh - 240.0) / 95.0, 0.0, 1.0)) / 12.0)\n    f_root = 43.6535 * semi_bend  # F1 root locked to After Hours key!\n\n    # 5-voice stereo unison detuned sawtooth/brass voices\n    detunes_l = [-15.0, -5.0, 0.0, +9.0]\n    detunes_r = [-9.0, 0.0, +6.0, +16.0]\n\n    def bandlimited_brass_osc(freq_curve, cents, ph_init):\n        ratio = 2.0 ** (cents / 1200.0)\n        ph = ph_init + np.cumsum(2.0 * np.pi * (freq_curve * ratio) / SR)\n        # Rich brassy harmonic stack (1x..7x)\n        sig = np.zeros_like(ph)\n        for k, amp in ((1, 0.55), (2, 1.00), (3, 0.72), (4, 0.54), (5, 0.38), (6, 0.26), (7, 0.16)):\n            sig += amp * np.sin(k * ph + 0.2 * k)\n        return sig * 0.32\n\n    brass_l = np.zeros(n, dtype=np.float64)\n    brass_r = np.zeros(n, dtype=np.float64)\n    for j, c in enumerate(detunes_l):\n        brass_l += bandlimited_brass_osc(f_root, c, j * 1.1)\n    for j, c in enumerate(detunes_r):\n        brass_r += bandlimited_brass_osc(f_root, c, j * 1.7 + 0.4)\n\n    # Add fifth (C3 = 3 * F1) cyber-horn edge at high speed / full throttle\n    ph_fifth = np.cumsum(2.0 * np.pi * (f_root * 3.0) / SR)\n    fifth_edge = 0.26 * throt * np.tanh(1.8 * np.sin(ph_fifth))\n    brass_l += fifth_edge\n    brass_r += fifth_edge\n\n    # Aggressive asymmetric cyber-tube distortion + split dynamic lowpass/mid-bite filter\n    drive = 1.4 + 1.5 * throt\n    sat_l = np.tanh(drive * brass_l)\n    sat_r = np.tanh(drive * brass_r)\n\n    low_growl_l = signal.sosfilt(bp_sos(72.0, 420.0, order=2), sat_l)\n    low_growl_r = signal.sosfilt(bp_sos(72.0, 420.0, order=2), sat_r)\n    horn_bite_l = signal.sosfilt(bp_sos(420.0, 2350.0, order=2), sat_l)\n    horn_bite_r = signal.sosfilt(bp_sos(420.0, 2350.0, order=2), sat_r)\n\n    # Dynamic swell: roars under acceleration & 300+ km/h WOT, breathes back in mid-corner\n    swell = (0.20 + 0.80 * (throt ** 1.15)) * (0.45 + 0.55 * np.clip(v_kmh / 310.0, 0.0, 1.0))\n    # Gentle 108 BPM eighth-note cyber pulse (3.6 Hz = 2 beats/sec)\n    pulse = 0.86 + 0.14 * np.sin(2.0 * np.pi * (108.0 / 60.0 * 2.0) * t)\n\n    gain = 0.26 * mask * swell * pulse\n    out_l = np.zeros_like(act3_mask)\n    out_r = np.zeros_like(act3_mask)\n    out_l[i0:] = gain * (0.62 * low_growl_l + (0.35 + 0.65 * throt) * horn_bite_l)\n    out_r[i0:] = gain * (0.62 * low_growl_r + (0.35 + 0.65 * throt) * horn_bite_r)\n    return out_l, out_r\n\n\ndef inject_impact_frame_slam(eng_l, eng_r, mus_duck_env, rng, f_impact, is_2099=True):\n    \"\"\"\n    2-Frame Graphic Impact Hit & Colossal Sub-Bass Drop!\n      - f=312..313  (t_vid = 12.9583 s, Act I Village Hairpin heavy braking)\n      - f=1698..1699 (t_vid = 70.7083 s, Act III Stowe 331 km/h heavy braking inside Clip 3!)\n    Performs:\n      1) Pre-impact 0.19s reverse vacuum + Spider-2099 / Prowler warning horn shriek (if is_2099)\n      2) Hard 2-frame (83.33 ms = 4,000 samples) rhythmic 4x grain-stutter on live engine!\n      3) Razor-sharp Crimson Ink-Slash metallic transient + F-minor cyber-brass stab +\n         Seismic Sub-Bass Drop (112 Hz -> 43.65 Hz F1) over 0.62 s!\n    \"\"\"\n    s_hit = (f_impact - 1) * SPF\n    n_stut = 2 * SPF  # Exact 2 frames = 4,000 samples (83.33 ms)\n\n    # 1) Pre-impact warning shriek & vacuum suck (-0.19 s .. 0)\n    n_pre = int(0.19 * SR)\n    s_pre = max(0, s_hit - n_pre)\n    len_pre = s_hit - s_pre\n    if len_pre > 0:\n        u_pre = np.linspace(0.0, 1.0, len_pre, endpoint=False)\n        t_pre = np.arange(len_pre, dtype=np.float64) / SR\n        vac_noise = signal.sosfilt(bp_sos(450.0, 5200.0, order=2), rng.standard_normal(len_pre))\n        vac_env = (u_pre ** 2.8) * (0.55 if is_2099 else 0.38)\n\n        if is_2099:\n            # Signature menacing 2099 / Prowler distorted semitone-glide brass shriek!\n            f_shriek = 622.25 * (0.94387 ** (u_pre ** 1.6))  # Eb5 -> D5 tension bend!\n            ph_s = np.cumsum(2.0 * np.pi * f_shriek / SR)\n            shriek = np.tanh(2.5 * (0.65 * np.sin(ph_s) + 0.45 * np.sin(0.5 * ph_s) + 0.30 * np.sin(1.5 * ph_s)))\n            shriek = signal.sosfilt(bp_sos(260.0, 3800.0, order=2), shriek)\n            eng_l[s_pre:s_hit] += vac_env * (0.68 * shriek + 0.42 * vac_noise)\n            eng_r[s_pre:s_hit] += vac_env * (0.68 * shriek * 0.92 + 0.42 * vac_noise)\n        else:\n            eng_l[s_pre:s_hit] += vac_env * vac_noise\n            eng_r[s_pre:s_hit] += vac_env * vac_noise\n\n        # Micro-vacuum dip right in the last 35 ms before impact so the drop hits 10x harder!\n        n_dip = min(int(0.035 * SR), len_pre)\n        dip_curve = np.linspace(1.0, 0.22, n_dip)\n        eng_l[s_hit - n_dip:s_hit] *= dip_curve\n        eng_r[s_hit - n_dip:s_hit] *= dip_curve\n        mus_duck_env[s_hit - n_dip:s_hit] = np.minimum(mus_duck_env[s_hit - n_dip:s_hit], dip_curve)\n\n    # 2) Exact 2-Frame Rhythmic Stutter on the live engine (4x 1000-sample = 20.8ms machine-gun slices!)\n    if s_hit + n_stut <= len(eng_l):\n        grain_len = SPF // 2  # 1000 samples = 0.5 frame = 20.83 ms\n        grain_l = eng_l[s_hit:s_hit + grain_len].copy()\n        grain_r = eng_r[s_hit:s_hit + grain_len].copy()\n        win_g = np.hanning(grain_len) ** 0.25\n        for rep in range(4):\n            p0 = s_hit + rep * grain_len\n            p1 = p0 + grain_len\n            # Alternate stereo emphasis on each 1/48s stutter chop!\n            gl = 1.25 if (rep % 2 == 0) else 0.55\n            gr = 0.55 if (rep % 2 == 0) else 1.25\n            eng_l[p0:p1] = grain_l * win_g * gl\n            eng_r[p0:p1] = grain_r * win_g * gr\n\n    # 3) Colossal Seismic Sub-Bass Drop + Graphic Crimson Ink-Slash Hit (0 .. +0.64 s)\n    n_drop = min(int(0.64 * SR), len(eng_l) - s_hit)\n    if n_drop > 0:\n        t_d = np.arange(n_drop, dtype=np.float64) / SR\n        u_d = t_d / 0.64\n\n        # Sub-bass pitch sweep: 118 Hz punch -> 43.65 Hz (deep F1 fundamental!)\n        f_sub = 43.6535 + 74.0 * np.exp(-24.0 * t_d)\n        ph_sub = np.cumsum(2.0 * np.pi * f_sub / SR)\n        sub_env = np.sin(np.pi * np.minimum(1.0, t_d / 0.005)) * np.exp(-3.6 * t_d)\n        sub_wave = (0.82 * np.sin(ph_sub) + 0.24 * np.tanh(1.8 * np.sin(2.0 * ph_sub))) * sub_env\n\n        # Razor-sharp metallic ink-slash + distorted 2099 cyber-brass impact stab\n        slash_n_l = rng.standard_normal(n_drop)\n        slash_n_r = rng.standard_normal(n_drop)\n        slash_l = signal.sosfilt(bp_sos(1400.0, 8400.0, order=2), slash_n_l) * np.exp(-42.0 * t_d)\n        slash_r = signal.sosfilt(bp_sos(1400.0, 8400.0, order=2), slash_n_r) * np.exp(-40.0 * t_d)\n\n        stab_mult = 1.0 if is_2099 else 0.72\n        ph_stab = np.cumsum(2.0 * np.pi * (87.307 * np.exp(-1.2 * t_d)) / SR)  # F2 brass stab\n        brass_stab = np.tanh(3.0 * (np.sin(ph_stab) + 0.6 * np.sin(1.5 * ph_stab) + 0.4 * np.sin(2.0 * ph_stab)))\n        brass_stab = signal.sosfilt(bp_sos(130.0, 2600.0, order=2), brass_stab) * np.exp(-9.5 * t_d)\n\n        drop_scale = 0.78 if is_2099 else 0.62\n        eng_l[s_hit:s_hit + n_drop] += drop_scale * (0.82 * sub_wave + 0.42 * slash_l + 0.44 * stab_mult * brass_stab)\n        eng_r[s_hit:s_hit + n_drop] += drop_scale * (0.82 * sub_wave + 0.42 * slash_r + 0.44 * stab_mult * brass_stab)\n\n        # Duck music cleanly during the 2-frame impact & sub transient so it never clips or muddies!\n        duck_d = 1.0 - (0.72 if is_2099 else 0.58) * np.exp(-8.5 * t_d)\n        mus_duck_env[s_hit:s_hit + n_drop] = np.minimum(mus_duck_env[s_hit:s_hit + n_drop], duck_d)\n\n\n# ---------------------------------------------------------------------------\n# Master V6 Build: 90.0417 s Stylized SFX WAV + Master Mix M4A\n# ---------------------------------------------------------------------------\ndef build_spiderverse_master():\n    t0 = time.perf_counter()\n    print(\"[synth_sfx_sv] Reading V5 base engine WAV & Silverstone telemetry (read-only)...\")\n    eng_l, eng_r = read_wav_stereo_float(V5_ENGINE_WAV)\n    tl = v5_sfx.build_timeline_and_cameras(TRACK_JSON, V5_ANIM_PY)\n    pt = v5_sfx.simulate_powertrain(tl)\n\n    t_all = np.arange(N_TOTAL, dtype=np.float64) / SR\n    rpm_48k = np.interp(t_all, pt[\"t_vid\"], pt[\"rpm\"])\n    v_kmh_48k = np.interp(t_all, pt[\"t_vid\"], pt[\"v_kmh\"])\n    accel_48k = np.interp(t_all, pt[\"t_vid\"], pt[\"accel\"])\n    eff_throt_48k = np.interp(t_all, pt[\"t_vid\"], pt[\"eff_throttle\"])\n\n    rng = np.random.default_rng(20991610)\n\n    # Smooth 3-Act Dimensional Masks (crossfading across Portal Cut 1 f=788..791 & Cut 2 f=1601..1604)\n    s_cut1 = (789 - 1) * SPF   # f=789 start = 32.8333 s\n    s_cut2 = (1602 - 1) * SPF  # f=1602 start = 66.7083 s\n    xf = 2 * SPF\n\n    act1_mask = np.clip((s_cut1 + xf // 2 - np.arange(N_TOTAL)) / float(xf), 0.0, 1.0)\n    act3_mask = np.clip((np.arange(N_TOTAL) - (s_cut2 - xf // 2)) / float(xf), 0.0, 1.0)\n    act2_mask = np.clip(1.0 - act1_mask - act3_mask, 0.0, 1.0)\n\n    # --- 1) Act I (f=1..788, Earth-1610 Miles): Graphic Mid-Punch + 12fps On-Twos Pulse + Vinyl Whip Cracks ---\n    mid_snap_l = signal.sosfilt(bp_sos(750.0, 2900.0, order=2), np.tanh(1.6 * eng_l))\n    mid_snap_r = signal.sosfilt(bp_sos(750.0, 2900.0, order=2), np.tanh(1.6 * eng_r))\n    # Subtle 12 Hz \"On-Twos\" comic rhythmic harmonic pulse at high speed\n    twos_pulse = 1.0 + 0.11 * np.clip((v_kmh_48k - 210.0) / 100.0, 0.0, 1.0) * np.sin(2.0 * np.pi * 12.0 * t_all)\n    eng_l += act1_mask * 0.28 * mid_snap_l * twos_pulse\n    eng_r += act1_mask * 0.28 * mid_snap_r * twos_pulse\n\n    # Layer snappy DJ vinyl-scratch & whip-crack transients on Act I upshifts & Act I beat shot-cuts\n    act1_cut_times = [(spec[\"f0\"] - 1) / float(FPS) for spec in tl[\"shot_specs\"] if 1 < spec[\"f0\"] <= 780]\n    whip_events = [(tu, 0.85, ((idx % 3) - 1) * 0.35) for idx, tu in enumerate(pt[\"upshift_times\"]) if tu < 32.6]\n    whip_events += [(tc, 1.05, 0.0) for tc in act1_cut_times]  # Includes f=109 inside Clip 1!\n\n    for t_ev, inten, pan in whip_events:\n        i0 = int(round(t_ev * SR))\n        wl, wr = synth_vinyl_whip_transient(rng, pan=pan, intensity=inten)\n        i1 = min(N_TOTAL, i0 + len(wl))\n        if i1 > i0:\n            eng_l[i0:i1] += wl[:i1 - i0]\n            eng_r[i0:i1] += wr[:i1 - i0]\n\n    # --- 2) Act II (f=789..1601, Earth-65 Gwen): Lush Wide Stereo Chorus + Watercolor Shimmer Tail ---\n    shim_l, shim_r = render_gwen_watercolor_shimmer(eng_l, eng_r, rpm_48k, act2_mask)\n    eng_l += shim_l\n    eng_r += shim_r\n\n    # Gwen punk-kit brush/cymbal splash on Act II beat shot cuts (including f=1335 inside Clip 2!)\n    for spec in tl[\"shot_specs\"]:\n        if 795 < spec[\"f0\"] <= 1595:\n            i0 = (spec[\"f0\"] - 1) * SPF\n            cl, cr = synth_gwen_punk_cymbal_accent(rng)\n            i1 = min(N_TOTAL, i0 + len(cl))\n            if i1 > i0:\n                eng_l[i0:i1] += cl[:i1 - i0]\n                eng_r[i0:i1] += cr[:i1 - i0]\n\n    # --- 3) Act III (f=1602..2161, Earth-928 2099): Distorted F-Minor Cyber-Brass Synth Edge ---\n    brass_l, brass_r = render_2099_cyber_brass_layer(eff_throt_48k, v_kmh_48k, accel_48k, act3_mask)\n    eng_l += brass_l\n    eng_r += brass_r\n\n    # Music bus ducking envelope for Portal Glitches & Impact Frames\n    mus_event_duck = np.ones(N_TOTAL, dtype=np.float64)\n\n    # --- 4) Portal Dimensional Glitches: Cut 1->2 (f=788..791) & Cut 2->3 (f=1601..1604) ---\n    for s_portal, sdir in ((s_cut1, +1.0), (s_cut2, -1.0)):\n        apply_tape_flutter_on_bus(eng_l, eng_r, s_portal, span_frames=4)\n        gl_l, gl_r, n_pre, gl_duck = synth_portal_glitch_event(rng, seed_dir=sdir)\n        p0 = max(0, s_portal - n_pre)\n        p1 = min(N_TOTAL, p0 + len(gl_l))\n        eng_l[p0:p1] += gl_l[:p1 - p0]\n        eng_r[p0:p1] += gl_r[:p1 - p0]\n        mus_event_duck[p0:p1] = np.minimum(mus_event_duck[p0:p1], gl_duck[:p1 - p0])\n\n    # --- 5) Impact Frames: f=312..313 (Village Hairpin) & f=1698..1699 (Stowe 331 km/h Slam in Clip 3!) ---\n    inject_impact_frame_slam(eng_l, eng_r, mus_event_duck, rng, f_impact=312, is_2099=False)\n    inject_impact_frame_slam(eng_l, eng_r, mus_event_duck, rng, f_impact=1698, is_2099=True)\n\n    # Smooth 0.10 s fade-in & 1.50 s end fade-out on stylized SFX stem\n    n_fi = int(0.10 * SR)\n    fi = np.sin(0.5 * np.pi * np.linspace(0.0, 1.0, n_fi))\n    eng_l[:n_fi] *= fi\n    eng_r[:n_fi] *= fi\n\n    n_fo = int(1.50 * SR)\n    fo = np.cos(0.5 * np.pi * np.linspace(0.0, 1.0, n_fo)) ** 1.2\n    eng_l[-n_fo:] *= fo\n    eng_r[-n_fo:] *= fo\n\n    # Remove DC / sub-24 Hz rumble & true-peak limit standalone SFX WAV to -1.50 dBFS\n    eng_l = signal.sosfilt(hp_sos(24.0, order=2), eng_l)\n    eng_r = signal.sosfilt(hp_sos(24.0, order=2), eng_r)\n    sfx_l, sfx_r = brickwall_true_peak_limit(eng_l, eng_r, ceiling_db=-1.50)\n\n    write_wav_16bit(OUT_SV_WAV, sfx_l, sfx_r)\n\n    # --- 6) Build Master Soundtrack + Stylized SFX Mix (renders_v6/audio_v6_sv_mix_90s.m4a) ---\n    print(\"[synth_sfx_sv] Mixing After Hours (108 BPM) + V6 Spider-Verse SFX -> audio_v6_sv_mix_90s.m4a...\")\n    mus_l, mus_r = decode_music_48k_stereo(V5_MUSIC_M4A)\n\n    # Apply matching subtle multiverse tape-flutter on music across Portal Cuts f=788..791 & f=1601..1604!\n    apply_tape_flutter_on_bus(mus_l, mus_r, s_cut1, span_frames=4)\n    apply_tape_flutter_on_bus(mus_l, mus_r, s_cut2, span_frames=4)\n\n    # Carve subtle spectral pocket around 600 Hz & 2.1 kHz on music so F1 V6 + comic transients shine cleanly\n    b_pk1, a_pk1 = signal.iirnotch(600.0, Q=1.4, fs=SR)\n    mus_l = 0.76 * mus_l + 0.24 * signal.lfilter(b_pk1, a_pk1, mus_l)\n    mus_r = 0.76 * mus_r + 0.24 * signal.lfilter(b_pk1, a_pk1, mus_r)\n\n    # Dynamic sidechain ducking from SFX envelope + hard event ducking on Impact Frames & Portals\n    sfx_env = np.sqrt(0.5 * (sfx_l ** 2 + sfx_r ** 2))\n    sfx_env_smooth = signal.sosfilt(lp_sos(7.5, order=2), sfx_env)\n    sc_duck = 1.0 / (1.0 + 1.35 * np.maximum(0.0, sfx_env_smooth - 0.11))\n    total_mus_duck = np.minimum(sc_duck, mus_event_duck)\n\n    # Keep sub-55 Hz on SFX gently controlled except during Impact Drops (f=312 & f=1698)\n    sfx_hp_l = signal.sosfilt(hp_sos(62.0, order=2), sfx_l)\n    sfx_hp_r = signal.sosfilt(hp_sos(62.0, order=2), sfx_r)\n    impact_sub_bypass = np.clip(1.0 - mus_event_duck, 0.0, 1.0)\n    sfx_mix_l = (1.0 - impact_sub_bypass) * sfx_hp_l + impact_sub_bypass * sfx_l\n    sfx_mix_r = (1.0 - impact_sub_bypass) * sfx_hp_r + impact_sub_bypass * sfx_r\n\n    mix_l = 0.50 * mus_l * total_mus_duck + 0.80 * sfx_mix_l\n    mix_r = 0.50 * mus_r * total_mus_duck + 0.80 * sfx_mix_r\n\n    # Smooth fade-in & 1.50 s fade-out at end\n    mix_l[:n_fi] *= fi\n    mix_r[:n_fi] *= fi\n    mix_l[-n_fo:] *= fo\n    mix_r[-n_fo:] *= fo\n\n    # True-peak limit to -1.85 dBFS before AAC 256k encoding so post-AAC True Peak is strictly <= -1.0 dBFS!\n    mix_l, mix_r = brickwall_true_peak_limit(mix_l, mix_r, ceiling_db=-1.85)\n\n    # Encode AAC 256k M4A via temporary WAV in OS temp dir (zero temp files in renders_v6/)\n    fd_tmp, tmp_wav = tempfile.mkstemp(suffix=\"_v6_mix.wav\")\n    os.close(fd_tmp)\n    try:\n        write_wav_16bit(tmp_wav, mix_l, mix_r)\n        subprocess.run(\n            [\n                FFMPEG, \"-hide_banner\", \"-loglevel\", \"warning\", \"-y\",\n                \"-i\", tmp_wav,\n                \"-c:a\", \"aac\", \"-b:a\", \"256k\", \"-ar\", str(SR), \"-ac\", \"2\",\n                \"-movflags\", \"+faststart\", OUT_SV_MIX,\n            ],\n            check=True,\n        )\n    finally:\n        if os.path.exists(tmp_wav):\n            os.remove(tmp_wav)\n\n    dt_el = time.perf_counter() - t0\n    print(f\"[synth_sfx_sv] Done in {dt_el:.2f} s:\")\n    print(f\"  WAV: {OUT_SV_WAV} ({os.path.getsize(OUT_SV_WAV):,} B)\")\n    print(f\"  M4A: {OUT_SV_MIX} ({os.path.getsize(OUT_SV_MIX):,} B)\")\n    return mix_l, mix_r\n\n\ndef build_showcase_reel_12s_wav(out_reel_wav):\n    \"\"\"\n    Builds exact 12.000000 s (576,000 samples @ 48 kHz) showcase reel audio\n    stitching Clip 1 (f=61..156) + Clip 2 (f=1290..1385) + Clip 3 (f=1650..1745)\n    with 2-frame (83.3 ms) equal-power crossfades + Spider-Verse Dimensional Glitch\n    micro-joins at t=4.000s and t=8.000s (zero clicks, True Peak <= -1.5 dBFS).\n    \"\"\"\n    clips_l, clips_r = decode_music_48k_stereo(OUT_SV_MIX)\n    n_clip = 96 * SPF  # 192,000 samples = 4.000000 s\n    starts = [(61 - 1) * SPF, (1290 - 1) * SPF, (1650 - 1) * SPF]\n\n    # Include 1-frame extra tail/head from continuous 90s mix for silky 2-frame (4000-sample) crossfade!\n    xf_half = SPF  # +-1 frame = 2 frames (4,000 samples = 83.33 ms) total micro-join\n    reel_l = np.zeros(3 * n_clip, dtype=np.float64)\n    reel_r = np.zeros(3 * n_clip, dtype=np.float64)\n\n    for idx, st in enumerate(starts):\n        dst0 = idx * n_clip\n        dst1 = (idx + 1) * n_clip\n        pad_pre = xf_half if idx > 0 else 0\n        pad_post = xf_half if idx < 2 else 0\n\n        seg_l = clips_l[st - pad_pre:st + n_clip + pad_post].copy()\n        seg_r = clips_r[st - pad_pre:st + n_clip + pad_post].copy()\n        win = np.ones(len(seg_l), dtype=np.float64)\n\n        if idx > 0:\n            u = np.linspace(0.0, 1.0, 2 * xf_half)\n            win[:2 * xf_half] *= np.sin(0.5 * np.pi * u)\n        if idx < 2:\n            u = np.linspace(0.0, 1.0, 2 * xf_half)\n            win[-2 * xf_half:] *= np.cos(0.5 * np.pi * u)\n\n        reel_l[dst0 - pad_pre:dst1 + pad_post] += seg_l * win\n        reel_r[dst0 - pad_pre:dst1 + pad_post] += seg_r * win\n\n    # Layer compact 2-frame Spider-Verse Dimensional Portal Glitch micro-joins at t=4.000s & t=8.000s!\n    rng = np.random.default_rng(161065928)\n    for j_samp, sdir in ((n_clip, +1.0), (2 * n_clip, -1.0)):\n        apply_tape_flutter_on_bus(reel_l, reel_r, j_samp, span_frames=2)\n        gl_l, gl_r, n_pre, _ = synth_portal_glitch_event(rng, seed_dir=sdir, dur_riser=0.07, dur_tear=0.065)\n        p0 = max(0, j_samp - n_pre)\n        p1 = min(len(reel_l), p0 + len(gl_l))\n        reel_l[p0:p1] += 0.42 * gl_l[:p1 - p0]\n        reel_r[p0:p1] += 0.42 * gl_r[:p1 - p0]\n\n    # Clean 25 ms fade-in at 0.0s & smooth 0.30 s fade-out at 11.70..12.00s\n    n_fi = int(0.025 * SR)\n    fi = np.sin(0.5 * np.pi * np.linspace(0.0, 1.0, n_fi))\n    reel_l[:n_fi] *= fi\n    reel_r[:n_fi] *= fi\n\n    n_fo = int(0.30 * SR)\n    fo = np.cos(0.5 * np.pi * np.linspace(0.0, 1.0, n_fo)) ** 1.15\n    reel_l[-n_fo:] *= fo\n    reel_r[-n_fo:] *= fo\n\n    reel_l, reel_r = brickwall_true_peak_limit(reel_l, reel_r, ceiling_db=-1.85)\n    write_wav_16bit(out_reel_wav, reel_l, reel_r)\n    print(f\"[synth_sfx_sv] Built 12.000s showcase reel audio: {out_reel_wav} ({len(reel_l)/SR:.4f} s)\")\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--reel-wav\", default=None, help=\"Build 12.000s 3-clip showcase WAV at given temp path\")\n    args = ap.parse_args()\n\n    if args.reel_wav:\n        if not os.path.exists(OUT_SV_MIX):\n            build_spiderverse_master()\n        build_showcase_reel_12s_wav(args.reel_wav)\n    else:\n        build_spiderverse_master()\n\n\nif __name__ == \"__main__\":\n    main()\n","Overwrite":true,"Path":"d:\\项目session\\blender-supercar\\pipeline\\synth_sfx_sv.py"}}]}
