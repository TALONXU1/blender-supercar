=789..1601)\")\nstats_window(v6, 789, 1601, \"V6 Act II (f=789..1601 Gwen)\")\nstats_window(v5, 1602, 2161,\"V5 Act III(f=1602..2161)\")\nstats_window(v6, 1602, 2161,\"V6 Act III(f=1602..2161 2099)\")\nstats_window(v6, 786, 793,  \"V6 Portal Cut 1->2 (f=786..793)\")\nstats_window(v6, 1599, 1606,\"V6 Portal Cut 2->3 (f=1599..1606)\")\nstats_window(v5, 1697, 1708,\"V5 Stowe Braking (f=1697..1708)\")\nstats_window(v6, 1697, 1708,\"V6 Stowe IMPACT  (f=1697..1708)\")\nstats_window(v6, 311, 322,  \"V6 Hairpin IMPACT(f=311..322)\")\n\n# Also test --reel-wav builder\nimport subprocess\nfd, tmp = tempfile.mkstemp(suffix=\"_test_reel.wav\")\nos.close(fd)\ntry:\n    subprocess.run([\"python\", r\"D:\\项目session\\blender-supercar\\pipeline\\synth_sfx_sv.py\", \"--reel-wav\", tmp], check=True)\n    rw = load_w(tmp)\n    print(f\"Reel 12s WAV samples={len(rw)} ({len(rw)/sr:.6f}s), peak={20*np.log10(np.max(np.abs(rw))+1e-12):.2f} dBFS\")\nfinally:\n    if os.path.exists(tmp): os.remove(tmp)\n'@ | python -","WaitMsBeforeAsync":10000,"toolSummary":"Audit V6 3-Act sonic signatures, portals, impacts, and 12s reel builder"}}]}
