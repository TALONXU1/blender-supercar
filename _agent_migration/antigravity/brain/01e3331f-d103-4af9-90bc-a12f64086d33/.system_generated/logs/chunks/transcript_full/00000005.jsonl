tereo emphasis on each 1/48s stutter chop!\n            gl = 1.25 if (rep % 2 == 0) else 0.55\n            gr = 0.55 if (rep % 2 == 0) else 1.25\n            eng_l[p0:p1] = grain_l * win_g * gl\n            eng_r[p0:p1] = grain_r * win_g * gr"}},{"name":"edit_file","args":{"Path":"d:\\项目session\\blender-supercar\\pipeline\\synth_sfx_sv.py","Replacement":"        drop_scale = 0.92 if is_2099 else 0.76\n        eng_l[s_hit:s_hit + n_drop] += drop_scale * (0.84 * sub_wave + 0.44 * slash_l + 0.46 * stab_mult * brass_stab)\n        eng_r[s_hit:s_hit + n_drop] += drop_scale * (0.84 * sub_wave + 0.44 * slash_r + 0.46 * stab_mult * brass_stab)","Target":"        drop_scale = 0.78 if is_2099 else 0.62\n        eng_l[s_hit:s_hit + n_drop] += drop_scale * (0.82 * sub_wave + 0.42 * slash_l + 0.44 * stab_mult * brass_stab)\n        eng_r[s_hit:s_hit + n_drop] += drop_scale * (0.82 * sub_wave + 0.42 * slash_r + 0.44 * stab_mult * brass_stab)"}},{"name":"edit_file","args":{"Path":"d:\\项目session\\blender-supercar\\pipeline\\synth_sfx_sv.py","Replacement":"    mix_l = 0.55 * mus_l * total_mus_duck + 0.88 * sfx_mix_l\n    mix_r = 0.55 * mus_r * total_mus_duck + 0.88 * sfx_mix_r\n\n    # Smooth fade-in & 1.50 s fade-out at end\n    mix_l[:n_fi] *= fi\n    mix_r[:n_fi] *= fi\n    mix_l[-n_fo:] *= fo\n    mix_r[-n_fo:] *= fo\n\n    # True-peak limit to -1.70 dBFS before AAC 256k encoding so post-AAC True Peak is strictly <= -1.0 dBFS!\n    mix_l, mix_r = brickwall_true_peak_limit(mix_l, mix_r, ceiling_db=-1.70)","Target":"    mix_l = 0.50 * mus_l * total_mus_duck + 0.80 * sfx_mix_l\n    mix_r = 0.50 * mus_r * total_mus_duck + 0.80 * sfx_mix_r\n\n    # Smooth fade-in & 1.50 s fade-out at end\n    mix_l[:n_fi] *= fi\n    mix_r[:n_fi] *= fi\n    mix_l[-n_fo:] *= fo\n    mix_r[-n_fo:] *= fo\n\n    # True-peak limit to -1.85 dBFS before AAC 256k encoding so post-AAC True Peak is strictly <= -1.0 dBFS!\n    mix_l, mix_r = brickwall_true_peak_limit(mix_l, mix_r, ceiling_db=-1.85)"}}]}
