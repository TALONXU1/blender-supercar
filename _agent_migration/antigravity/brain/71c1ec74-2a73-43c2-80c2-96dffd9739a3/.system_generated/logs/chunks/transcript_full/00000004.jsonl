{"step_index":96,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-18T06:23:37Z","content":"Created At: 2026-11-18T14:23:37+08:00\nCompleted At: 2026-11-18T14:23:37+08:00\nShowing lines 1-188 of 188\n1: # -*- coding: utf-8 -*-\n2: \"\"\"\n3: V5 交付剧照与 Contact Sheet 生成器：\n4: 1) 直接从工程渲染全部 26 个镜头代表帧（1080p / 32 samples）并拼装高清标注版 contact_sheet.jpg：\n5:      blender -b LATEST/v5_stage_anim.blend -P pipeline/v5_stills.py -- --render\n6: 2) 从已有序列帧 renders_v5/frames/f_*.jpg 抽帧并拼图：\n7:      python pipeline/v5_stills.py\n8: 3) 仅根据现有 renders_v5/stills/shot_*.jpg 重新拼装 contact_sheet.jpg：\n9:      python pipeline/v5_stills.py --sheet-only\n10: \"\"\"\n11: import os\n12: import sys\n13: import shutil\n14: import subprocess\n15: \n16: PROJ = r\"D:\\项目session\\blender-supercar\"\n17: FR = os.path.join(PROJ, \"renders_v5\", \"frames\")\n18: OUT = os.path.join(PROJ, \"renders_v5\", \"stills\")\n19: os.makedirs(OUT, exist_ok=True)\n20: \n21: ARGV = sys.argv[sys.argv.index(\"--\") + 1:] if \"--\" in sys.argv else sys.argv[1:]\n22: DO_RENDER = \"--render\" in ARGV\n23: SHEET_ONLY = \"--sheet-only\" in ARGV\n24: \n25: SHOTS = [\n26:     (60, \"01_rear_chase\"),\n27:     (160, \"02_onboard\"),\n28:     (250, \"03_chase_rise\"),\n29:     (350, \"04_hairpin\"),\n30:     (440, \"05_chase_aintree\"),\n31:     (520, \"06_orbit1\"),\n32:     (600, \"07_chase_accel\"),\n33:     (700, \"08_fast_pan\"),\n34:     (760, \"09_wheel_macro\"),\n35:     (820, \"10_chase_fast\"),\n36:     (870, \"11_orbit_brooklands\"),\n37:     (950, \"12_luffield\"),\n38:     (1040, \"13_chase_woodcote\"),\n39:     (1120, \"14_woodcote_tele\"),\n40:     (1200, \"15_heli_drop\"),\n41:     (1300, \"16_orbit_copse\"),\n42:     (1380, \"17_chase_copse\"),\n43:     (1470, \"18_maggotts\"),\n44:     (1560, \"19_chase_rise2\"),\n45:     (1640, \"20_onboard3\"),\n46:     (1730, \"21_stowe_tele\"),\n47:     (1830, \"22_orbit_stowe\"),\n48:     (1920, \"23_chase_low\"),\n49:     (2010, \"24_heli_reveal\"),\n50:     (2090, \"25_club\"),\n51:     (2145, \"26_aerial_out\"),\n52: ]\n53: \n54: \n55: def render_with_blender():\n56:     import bpy\n57:     sc = bpy.context.scene\n58:     if not bpy.data.filepath:\n59:         default_blend = os.path.join(PROJ, \"LATEST\", \"v5_stage_anim.blend\")\n60:         bpy.ops.wm.open_mainfile(filepath=default_blend)\n61:         sc = bpy.context.scene\n62: \n63:     markers = sorted(sc.timeline_markers, key=lambda m: m.frame)\n64: \n65:     def active_cam_for_frame(f):\n66:         cur = sc.camera\n67:         for mk in markers:\n68:             if mk.frame <= f and mk.camera:\n69:                 cur = mk.camera\n70:             elif mk.frame > f:\n71:                 break\n72:         return cur\n73: \n74:     orig_cam = sc.camera\n75:     sc.render.engine = 'BLENDER_EEVEE'\n76:     sc.eevee.taa_render_samples = 32\n77:     sc.eevee.use_raytracing = True\n78:     sc.render.resolution_x = 1920\n79:     sc.render.resolution_y = 1080\n80:     sc.render.resolution_percentage = 100\n81:     sc.render.use_motion_blur = True\n82:     sc.render.image_settings.file_format = 'JPEG'\n83:     sc.render.image_settings.quality = 95\n84: \n85:     meta_lines = []\n86:     for f, name in SHOTS:\n87:         cam = active_cam_for_frame(f)\n88:         sc.camera = cam\n89:         sc.frame_set(f)\n90:         deps = bpy.context.evaluated_depsgraph_get()\n91:         cam_eval = cam.evaluated_get(deps) if cam else None\n92:         lens = cam_eval.data.lens if cam_eval else 0.0\n93:         fstop = cam_eval.data.dof.aperture_fstop if cam_eval else 0.0\n94:         dof_on = (cam_eval.data.dof.use_dof and cam_eval.data.dof.focus_object is not None) if cam_eval else False\n95:         dst = os.path.join(OUT, \"shot_%s.jpg\" % name)\n96:         sc.render.filepath = dst\n97:         bpy.ops.render.render(write_still=True)\n98:         tag = f\"{int(round(lens))}mm f/{fstop:.1f}\" + (\" DOF\" if dof_on else \"\")\n99:         meta_lines.append(f\"{name}|{f}|{tag}\")\n100:         print(f\"RENDERED shot_{name}.jpg (f={f}, {tag})\")\n101: \n102:     sc.camera = orig_cam\n103:     meta_file = os.path.join(OUT, \".stills_meta.txt\")\n104:     with open(meta_file, \"w\", encoding=\"utf-8\") as fp:\n105:         fp.write(\"\\n\".join(meta_lines) + \"\\n\")\n106: \n107: \n108: def build_contact_sheet_pil(made):\n109:     from PIL import Image, ImageDraw, ImageFont\n110: \n111:     meta_map = {}\n112:     meta_file = os.path.join(OUT, \".stills_meta.txt\")\n113:     if os.path.exists(meta_file):\n114:         with open(meta_file, encoding=\"utf-8\") as fp:\n115:             for line in fp:\n116:                 parts = line.strip().split(\"|\")\n117:                 if len(parts) == 3:\n118:                     meta_map[parts[0]] = parts[2]\n119: \n120:     tw, th = 384, 216\n121:     bar_h = 24\n122:     cols = 5\n123:     rows = (len(made) + cols - 1) // cols\n124:     header_h = 36\n125:     sheet = Image.new(\"RGB\", (cols * tw, header_h + rows * (th + bar_h)), (12, 13, 16))\n126:     d = ImageDraw.Draw(sheet)\n127: \n128:     font = None\n129:     title_font = None\n130:     for candidate in (r\"C:\\Windows\\Fonts\\consolab.ttf\", r\"C:\\Windows\\Fonts\\consola.ttf\", r\"C:\\Windows\\Fonts\\arial.ttf\"):\n131:         if os.path.exists(candidate):\n132:             try:\n133:                 font = ImageFont.truetype(candidate, 13)\n134:                 title_font = ImageFont.truetype(candidate, 16)\n135:                 break\n136:             except Exception:\n137:                 pass\n138: \n139:     d.text((14, 9), \"V5 SILVERSTONE FULL LAP  |  26 SHOTS  |  1920x1080 EEVEE (AgX + Broadcast DOF + Telemetry Rig)\",\n140:            fill=(225, 230, 238), font=title_font or font)\n141: \n142:     for i, (f, name, path) in enumerate(made):\n143:         im = Image.open(path).convert(\"RGB\").resize((tw, th), Image.Resampling.LANCZOS)\n144:         x = (i % cols) * tw\n145:         y = header_h + (i // cols) * (th + bar_h)\n146:         sheet.paste(im, (x, y))\n147:         # Subtle cell border\n148:         d.rectangle([x, y, x + tw - 1, y + th + bar_h - 1], outline=(32, 35, 42), width=1)\n149:         cam_tag = meta_map.get(name, \"\")\n150:         label = f\"{name} (f{f})\" + (f\"  [{cam_tag}]\" if cam_tag else \"\")\n151:         d.text((x + 7, y + th + 4), label, fill=(205, 212, 222), font=font)\n152: \n153:     out = os.path.join(OUT, \"contact_sheet.jpg\")\n154:     sheet.save(out, quality=94, subsampling=0)\n155:     print(\"contact sheet:\", out, sheet.size)\n156: \n157: \n158: if DO_RENDER:\n159:     render_with_blender()\n160:     # Build contact sheet via PIL if available here, else invoke system Python cleanly\n161:     try:\n162:         import PIL  # noqa: F401\n163:         made = [(f, name, os.path.join(OUT, f\"shot_{name}.jpg\"))\n164:                 for f, name in SHOTS if os.path.exists(os.path.join(OUT, f\"shot_{name}.jpg\"))]\n165:         build_contact_sheet_pil(made)\n166:     except ImportError:\n167:         env = os.environ.copy()\n168:         env.pop(\"PYTHONHOME\", None)\n169:         env.pop(\"PYTHONPATH\", None)\n170:         res = subprocess.run([\"python\", os.path.abspath(__file__), \"--sheet-only\"], env=env, check=False)\n171:         if res.returncode != 0:\n172:             raise RuntimeError(f\"contact_sheet build failed with code {res.returncode}\")\n173: else:\n174:     made = []\n175:     for f, name in SHOTS:\n176:         dst = os.path.join(OUT, \"shot_%s.jpg\" % name)\n177:         if not SHEET_ONLY:\n178:             src = os.path.join(FR, \"f_%04d.jpg\" % f)\n179:             if os.path.exists(src):\n180:                 shutil.copyfile(src, dst)\n181:             elif not os.path.exists(dst):\n182:                 print(\"MISS\", f)\n183:                 continue\n184:         if os.path.exists(dst):\n185:             made.append((f, name, dst))\n186:     print(\"stills:\", len(made))\n187:     if made:\n188:         build_contact_sheet_pil(made)"}
{"step_index":97,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-18T06:23:37Z","content":"Created At: 2026-11-18T14:23:37+08:00\nCompleted At: 2026-11-18T14:23:38+08:00\nShowing lines 1-223 of 223\n1: # -*- coding: utf-8 -*-\n2: \"\"\"\n3: V5 白模（clay）版本：把所有材质替换成统一灰模，保留光影、景深（DOF）、运动模糊与组件层级。\n4: 输入: LATEST/v5_stage_anim.blend\n5: 输出: LATEST/v5_stage_anim_clay.blend（原文件不动）\n6: \n7: 用法:\n8:   blender -b -P pipeline/v5_clay.py\n9:   blender -b -P pipeline/v5_clay.py -- --render-stills\n10: \"\"\"\n11: import bpy\n12: import os\n13: import sys\n14: \n15: PROJ = r\"D:\\项目session\\blender-supercar\"\n16: ARGV = sys.argv[sys.argv.index(\"--\") + 1:] if \"--\" in sys.argv else []\n17: \n18: \n19: def argval(flag, default=None):\n20:     if flag in ARGV:\n21:         i = ARGV.index(flag)\n22:         if i + 1 < len(ARGV) and not ARGV[i + 1].startswith(\"--\"):\n23:             return ARGV[i + 1]\n24:         return True\n25:     return default\n26: \n27: \n28: SRC = argval(\"--in\", os.path.join(PROJ, \"LATEST\", \"v5_stage_anim.blend\"))\n29: DST = argval(\"--out\", os.path.join(PROJ, \"LATEST\", \"v5_stage_anim_clay.blend\"))\n30: CLAY_STILLS_DIR = os.path.join(PROJ, \"renders_v5\", \"clay_stills\")\n31: \n32: bpy.ops.wm.open_mainfile(filepath=SRC)\n33: scene = bpy.context.scene\n34: rig = bpy.data.objects.get(\"RIG_F1_Race\")\n35: \n36: \n37: def iter_fcurves(action):\n38:     fcs = list(getattr(action, \"fcurves\", []) or [])\n39:     if fcs:\n40:         return fcs\n41:     for layer in getattr(action, \"layers\", []) or []:\n42:         for strip in getattr(layer, \"strips\", []) or []:\n43:             for cb in getattr(strip, \"channelbags\", []) or []:\n44:                 fcs.extend(cb.fcurves)\n45:     return fcs\n46: \n47: \n48: def clay(name, value, rough=0.62, spec=0.08):\n49:     m = bpy.data.materials.get(name) or bpy.data.materials.new(name)\n50:     m.use_nodes = True\n51:     nt = m.node_tree\n52:     nt.nodes.clear()\n53:     b = nt.nodes.new(\"ShaderNodeBsdfPrincipled\")\n54:     b.inputs['Base Color'].default_value = (value, value, value, 1.0)\n55:     b.inputs['Roughness'].default_value = rough\n56:     if 'Specular IOR Level' in b.inputs:\n57:         b.inputs['Specular IOR Level'].default_value = spec\n58:     b.inputs['Metallic'].default_value = 0.0\n59:     out = nt.nodes.new(\"ShaderNodeOutputMaterial\")\n60:     nt.links.new(b.outputs['BSDF'], out.inputs['Surface'])\n61:     return m\n62: \n63: \n64: # 车体浅灰雕塑泥（0.76 避免 Standard 视图高光过曝）+ 环境深中性灰（低镜面防太阳反光楔形）\n65: M_CAR = clay(\"CLAY_Car\", 0.76, rough=0.50, spec=0.12)\n66: M_ENV = clay(\"CLAY_Env\", 0.34, rough=0.76, spec=0.03)\n67: M_ROAD = clay(\"CLAY_Road\", 0.24, rough=0.84, spec=0.02)\n68: \n69: # 天空穹顶：平滑高度渐变中性灰自发光（去掉黄昏色彩且无分层条带）\n70: sky = bpy.data.objects.get(\"V5_SkyDome\")\n71: if sky and hasattr(sky.data, \"materials\"):\n72:     _m = bpy.data.materials.get(\"CLAY_SkyEmit\") or bpy.data.materials.new(\"CLAY_SkyEmit\")\n73:     _m.use_nodes = True\n74:     nt = _m.node_tree\n75:     nt.nodes.clear()\n76:     tc = nt.nodes.new(\"ShaderNodeTexCoord\")\n77:     sep = nt.nodes.new(\"ShaderNodeSeparateXYZ\")\n78:     ramp = nt.nodes.new(\"ShaderNodeValToRGB\")\n79:     ramp.color_ramp.interpolation = 'EASE'\n80:     ramp.color_ramp.elements[0].position = 0.0\n81:     ramp.color_ramp.elements[0].color = (0.19, 0.195, 0.205, 1.0)\n82:     ramp.color_ramp.elements[1].position = 0.55\n83:     ramp.color_ramp.elements[1].color = (0.095, 0.100, 0.112, 1.0)\n84:     e = nt.nodes.new(\"ShaderNodeEmission\")\n85:     e.inputs['Strength'].default_value = 1.0\n86:     o = nt.nodes.new(\"ShaderNodeOutputMaterial\")\n87:     nt.links.new(tc.outputs['Generated'], sep.inputs['Vector'])\n88:     nt.links.new(sep.outputs['Z'], ramp.inputs['Fac'])\n89:     nt.links.new(ramp.outputs['Color'], e.inputs['Color'])\n90:     nt.links.new(e.outputs['Emission'], o.inputs['Surface'])\n91:     if sky.data.materials:\n92:         for i in range(len(sky.data.materials)):\n93:             sky.data.materials[i] = _m\n94:     else:\n95:         sky.data.materials.append(_m)\n96: \n97: \n98: def is_car_object(ob):\n99:     \"\"\"精确区分赛车几何（含 MESH 与 Halo CURVE）与赛道环境（V5_* / EM_* / GEO_Race*）\"\"\"\n100:     if ob.name.startswith((\"V5_\", \"EM_\", \"GEO_Race\")):\n101:         return False\n102:     if rig is not None and ob.parent == rig:\n103:         return True\n104:     if ob.name.startswith((\"GEO_F1_\", \"GEO_MERC_\", \"DEC_\")):\n105:         return True\n106:     for c in ob.users_collection:\n107:         if c.name.startswith((\"01_\", \"02_\", \"03_\", \"04_\", \"05_\", \"06_\", \"07_\", \"08_\",\n108:                               \"Wheel_\", \"Susp_\", \"Steering_\", \"SCIFI_F1\")):\n109:             return True\n110:     return False\n111: \n112: \n113: # 车 vs 环境（覆盖 MESH 与 CURVE，例如 GEO_F1_Halo_Hoop；Empty 组件保持不动）\n114: n_car = n_env = 0\n115: ROAD_PREFIX = (\"V5_Track\", \"V5_RacingLine\", \"V5_Skid\", \"V5_BrakeZone\", \"V5_PitLane\")\n116: for ob in bpy.data.objects:\n117:     if ob.type not in ('MESH', 'CURVE', 'SURFACE', 'FONT'):\n118:         continue\n119:     if ob.name.startswith(\"V5_SkyDome\"):\n120:         continue\n121:     if not hasattr(ob.data, \"materials\"):\n122:         continue\n123:     is_car = is_car_object(ob)\n124:     if is_car:\n125:         mat = M_CAR\n126:         n_car += 1\n127:     else:\n128:         mat = M_ROAD if ob.name.startswith(ROAD_PREFIX) else M_ENV\n129:         n_env += 1\n130:     me = ob.data\n131:     if me.materials:\n132:         for i in range(len(me.materials)):\n133:             me.materials[i] = mat\n134:     else:\n135:         me.materials.append(mat)\n136: \n137: # 白模漫反射率（0.76）远高于深蓝车漆：适度压低随车补光，保留纯粹的主光雕塑立体感并防止高光过曝\n138: for ob in bpy.data.objects:\n139:     if ob.type == 'LIGHT' and ob.name.startswith(\"LGT_V5Car_\"):\n140:         ob.data.energy *= 0.32\n141: \n142: # 世界：中性灰环境底光\n143: world = scene.world\n144: if world:\n145:     world.use_nodes = True\n146:     nt = world.node_tree\n147:     nt.nodes.clear()\n148:     bg = nt.nodes.new(\"ShaderNodeBackground\")\n149:     bg.inputs['Color'].default_value = (0.055, 0.058, 0.064, 1.0)\n150:     bg.inputs['Strength'].default_value = 0.95\n151:     out = nt.nodes.new(\"ShaderNodeOutputWorld\")\n152:     nt.links.new(bg.outputs[0], out.inputs[0])\n153: \n154: # 关掉泛光（白模不需要眩光），但完整保留所有相机的 DOF（V5_CamFocus）与运动模糊\n155: try:\n156:     scene.use_nodes = False\n157: except Exception:\n158:     pass\n159: scene.render.use_motion_blur = True\n160: \n161: # 曝光回到中性 Standard，并同步修正 scene.animation_data 里的曝光关键帧（防止关键帧把曝光顶回 +0.50 导致过曝）\n162: CLAY_EXP = -0.35\n163: CLAY_FADE_EXP = -6.5\n164: try:\n165:     scene.view_settings.view_transform = 'Standard'\n166:     scene.view_settings.look = 'None'\n167:     scene.view_settings.exposure = CLAY_EXP\n168:     scene.view_settings.gamma = 1.0\n169: except Exception:\n170:     pass\n171: \n172: if scene.animation_data and scene.animation_data.action:\n173:     for fc in iter_fcurves(scene.animation_data.action):\n174:         if fc.data_path == \"view_settings.exposure\":\n175:             for kp in fc.keyframe_points:\n176:                 if kp.co.x >= scene.frame_end - 1:\n177:                     kp.co.y = CLAY_FADE_EXP\n178:                 else:\n179:                     kp.co.y = CLAY_EXP\n180:                 kp.interpolation = 'LINEAR'\n181:             fc.update()\n182: \n183: print(\"clay: car geom=%d env geom=%d (DOF & motion blur preserved)\" % (n_car, n_env))\n184: \n185: bpy.ops.wm.save_as_mainfile(filepath=DST)\n186: print(\"CLAY SAVED:\", DST)\n187: \n188: # 可选：直接渲染 6 张代表性 1080p 白模测试剧照（~12 s）\n189: if argval(\"--render-stills\"):\n190:     os.makedirs(CLAY_STILLS_DIR, exist_ok=True)\n191:     markers = sorted(scene.timeline_markers, key=lambda m: m.frame)\n192: \n193:     def _active_cam(frame):\n194:         cur = scene.camera\n195:         for mk in markers:\n196:             if mk.frame <= frame and mk.camera:\n197:                 cur = mk.camera\n198:         return cur\n199: \n200:     orig_cam = scene.camera\n201:     scene.render.resolution_x = 1920\n202:     scene.render.resolution_y = 1080\n203:     scene.render.resolution_percentage = 100\n204:     scene.eevee.taa_render_samples = 20\n205:     scene.render.image_settings.file_format = 'JPEG'\n206:     scene.render.image_settings.quality = 94\n207: \n208:     CLAY_TEST_SHOTS = [\n209:         (60, \"01_rear_chase\"),\n210:         (160, \"02_onboard_cockpit\"),\n211:         (350, \"04_hairpin_dof\"),\n212:         (760, \"09_wheel_macro\"),\n213:         (1120, \"13_woodcote_tele\"),\n214:         (1730, \"20_stowe_tele\"),\n215:     ]\n216:     for f, tag in CLAY_TEST_SHOTS:\n217:         scene.camera = _active_cam(f)\n218:         scene.frame_set(f)\n219:         out_path = os.path.join(CLAY_STILLS_DIR, f\"clay_test_{tag}_f{f:04d}.jpg\")\n220:         scene.render.filepath = out_path\n221:         bpy.ops.render.render(write_still=True)\n222:         print(\"CLAY STILL:\", out_path)\n223:     scene.camera = orig_cam"}
