     if _lob.data.materials:\n788:                 _lob.data.materials[0] = _ml\n789:             else:\n790:                 _lob.data.materials.append(_ml)\n791:     shift_led_inputs.append(_lb.inputs['Emission Strength'])\n792: \n793: # ---------------------------------------------------------------------------\n794: # 4. 烘焙三维车身世界轨迹 (24 fps LINEAR) + 局部 12 fps On-Twos 次级动态\n795: # ---------------------------------------------------------------------------\n796: bone_root = rig.pose.bones[\"Bone_Root\"]\n797: bone_heading = rig.pose.bones[\"Bone_Heading\"]\n798: bone_body = rig.pose.bones[\"Bone_Body\"]\n799: bone_heading.rotation_mode = 'XYZ'\n800: bone_body.rotation_mode = 'XYZ'\n801: \n802: cum_spin = 0.0\n803: prev_dist = 0.0\n804: prev_gear = frame_data[1][\"gear\"]\n805: shift_flash = 0.0\n806: brake_heat_state = 0.0\n807: prev_head_euler = None\n808: \n809: for f in range(1, FRAME_END + 1):\n810:     fd = frame_data[f]\n811:     v, acc, k = fd[\"v\"], fd[\"accel\"], fd[\"k\"]\n812:     v_kmh = v * 3.6\n813:     R_v = Vector(fd[\"R\"])\n814:     T_v = Vector(fd[\"T\"])\n815:     U_v = Vector(fd[\"U\"])\n816:     P_v = Vector(fd[\"pos\"])\n817: \n818:     # 三维世界位置与三维正交姿态矩阵 (R=+X, T=+Y, U=+Z) -> 轮胎零高度误差贴合 17.4° 倾角与 ±14° 坡面\n819:     root_world = P_v + U_v * 0.012\n820:     bone_root.location = root_world\n821:     m_rot = Matrix((R_v, T_v, U_v)).transposed()\n822:     eul = m_rot.to_euler('XYZ', prev_head_euler) if prev_head_euler is not None else m_rot.to_euler('XYZ')\n823:     prev_head_euler = eul\n824:     bone_heading.rotation_euler = eul\n825:     bone_root.keyframe_insert(\"location\", frame=f)\n826:     bone_heading.keyframe_insert(\"rotation_euler\", frame=f)\n827: \n828:     # 景深焦点 Empty 同步锁定车身 + 0.45m 法向高度 (24 fps LINEAR)\n829:     cam_focus.location = P_v + U_v * 0.462\n830:     cam_focus.keyframe_insert(\"location\", frame=f)\n831: \n832:     # 随车柔光三维跟随 (24 fps LINEAR)\n833:     for lo, spec in fill_lights:\n834:         lp = P_v + T_v * spec[\"ahead\"] + R_v * spec[\"side\"] + U_v * spec[\"up\"]\n835:         lo.location = lp\n836:         aim_v = (P_v + U_v * 0.45) - lp\n837:         lo.rotation_euler = aim_v.to_track_quat('-Z', 'Y').to_euler()\n838:         lo.keyframe_insert(\"location\", frame=f)\n839:         lo.keyframe_insert(\"rotation_euler\", frame=f)\n840: \n841:     # 次级动态与遥测（仅在奇数帧与末帧写入 CONSTANT -> 正宗 12 fps On-Twos 手绘动画节奏！）\n842:     cum_spin += (fd[\"dist\"] - prev_dist) / R_TIRE\n843:     prev_dist = fd[\"dist\"]\n844: \n845:     gear = fd[\"gear\"]\n846:     if gear != prev_gear:\n847:         shift_flash = 1.0\n848:         prev_gear = gear\n849:     else:\n850:         shift_flash *= 0.72\n851: \n852:     if acc < -2.0:\n853:         brake_pwr = ((-acc - 2.0) / 24.0) * (0.45 + 0.55 * min(1.0, v / 88.0))\n854:         brake_heat_state = min(1.30, brake_heat_state + brake_pwr * (DT / 0.12))\n855:     else:\n856:         tau_cool = 1.70 - 0.50 * min(1.0, v / 88.0)\n857:         brake_heat_state *= exp(-DT / tau_cool)\n858:         if brake_heat_state < 0.003:\n859:             brake_heat_state = 0.0\n860:     fd[\"brake_heat\"] = brake_heat_state\n861:     fd[\"shift_flash\"] = shift_flash\n862: \n863:     if f % 2 == 1 or f == FRAME_END:\n864:         # 坡底正曲率压缩下沉 + 加减速俯仰 + 弯道净横向 G 侧倾\n865:         comp_squat = -0.009 * max(0.0, fd[\"dpitch_dt\"] / 14.0)\n866:         pitch_body = max(-2.1, min(1.6, acc * 0.088)) - 0.22 * shift_flash\n867:         roll_body = max(-2.4, min(2.4, -fd[\"lat_signed\"] * 0.28))\n868:         heave = -0.005 + comp_squat + 0.0018 * sin(f * 1.41) + 0.0010 * sin(f * 2.89)\n869:         bone_body.location = (0.0, 0.0, heave)\n870:         bone_body.rotation_euler = (radians(pitch_body), radians(roll_body), 0.0)\n871:         bone_body.keyframe_insert(\"location\", frame=f)\n872:         bone_body.keyframe_insert(\"rotation_euler\", frame=f)\n873: \n874:         rig[\"wheel_spin\"] = cum_spin\n875:         rig[\"steer\"] = max(-26.0, min(26.0, degrees(k * WHEELBASE)))\n876:         straight = abs(k) < 0.0022\n877:         rig[\"drs\"] = 1.0 if (straight and v_kmh > 245.0) else (0.0 if abs(k) > 0.005 else 0.5)\n878:         rig[\"brake_heat\"] = brake_heat_state\n879:         rig[\"rear_slip\"] = 1.0\n880:         rig[\"susp_f\"] = -0.004 - 0.015 * max(0.0, -acc) / 14.0 + comp_squat * 0.6\n881:         rig[\"susp_r\"] = -0.004 - 0.016 * max(0.0, acc) / 14.0 + comp_squat * 0.6\n882:         for kk in (\"wheel_spin\", \"steer\", \"drs\", \"brake_heat\", \"rear_slip\", \"susp_f\", \"susp_r\"):\n883:             rig.keyframe_insert(f'[\"{kk}\"]', frame=f)\n884: \n885:         bh = brake_heat_state\n886:         for kind, einp, minp in brake_disc_emit_inputs:\n887:             if kind == \"glow_sheet\":\n888:                 einp.default_value = (bh ** 1.2) * 10.5\n889:                 einp.keyframe_insert(\"default_value\", frame=f)\n890:                 minp.default_value = min(0.95, (bh ** 0.8) * 0.90)\n891:                 minp.keyframe_insert(\"default_value\", frame=f)\n892:             else:\n893:                 einp.default_value = (bh ** 1.3) * 6.8\n894:                 einp.keyframe_insert(\"default_value\", frame=f)\n895:         for cinp in caliper_emit_inputs:\n896:             cinp.default_value = max(0.0, bh - 0.28) * 1.8\n897:             cinp.keyframe_insert(\"default_value\", frame=f)\n898: \n899:         if rain_emit_input is not None:\n900:             if acc < -2.5 or fd[\"tunnel\"]:\n901:                 pulse_on = ((fd[\"t\"] * 6.0) % 1.0) < 0.55\n902:                 rain_emit_input.default_value = 28.0 if pulse_on else (3.5 if fd[\"tunnel\"] else 1.4)\n903:             else:\n904:                 rain_emit_input.default_value = 3.2\n905:             rain_emit_input.keyframe_insert(\"default_value\", frame=f)\n906: \n907:         rf = fd[\"rpm_frac\"]\n908:         if len(shift_led_inputs) == 3:\n909:             shift_led_inputs[0].default_value = 8.5 if rf > 0.26 else 0.4\n910:             shift_led_inputs[1].default_value = 9.5 if rf > 0.56 else 0.3\n911:             shift_led_inputs[2].default_value = (15.0 if shift_flash > 0.45 else 10.5) if rf > 0.80 else 0.25\n912:             for sinp in shift_led_inputs:\n913:                 sinp.keyframe_insert(\"default_value\", frame=f)\n914: \n915: # 设置 RIG 曲线插值：Bone_Root & Bone_Heading 为 LINEAR，其余全部 CONSTANT (12fps On-Twos)\n916: if rig.animation_data and rig.animation_data.action:\n917:     for fc in iter_fcurves(rig.animation_data.action):\n918:         is_world = (\"Bone_Root\" in fc.data_path) or (\"Bone_Heading\" in fc.data_path)\n919:         for kp in fc.keyframe_points:\n920:             kp.interpolation = 'LINEAR' if is_world else 'CONSTANT'\n921:         fc.update()\n922: \n923: for mat in bpy.data.materials:\n924:     if mat.node_tree and mat.node_tree.animation_data and mat.node_tree.animation_data.action:\n925:         for fc in iter_fcurves(mat.node_tree.animation_data.action):\n926:             for kp in fc.keyframe_points:\n927:                 kp.interpolation = 'CONSTANT'\n928:             fc.update()\n929: \n930: # ---------------------------------------------------------------------------\n931: # 5. 驱动 V6_09_ComicFX 三维速度特效（涡流彩带 / 尾焰菱形激波 / 钛合金火花 / 湿胎水雾弧 / 车轮残影）\n932: # ---------------------------------------------------------------------------\n933: fx_coll = bpy.data.collections.get(\"V6_09_ComicFX\")\n934: fx_objs = list(fx_coll.all_objects) if fx_coll else [\n935:     o for o in bpy.data.objects if o.name.startswith((\"V6_FX_\", \"SV_FX_\"))\n936: ]\n937: ONBOARD_WINDOWS = [(f0, f1) for _, f0, f1, typ, _ in windows if typ == \"onboard\"]\n938: \n939: \n940: def _is_onboard_frame(f):\n941:     return any(a <= f <= b for a, b in ONBOARD_WINDOWS)\n942: \n943: \n944: fx_stats = dict(vortex=0, smear=0, exhaust=0, sparks=0, spray=0)\n945: for idx, fob in enumerate(fx_objs):\n946:     if fob.type not in ('MESH', 'CURVE'):\n947:         continue\n948:     if fob.animation_data:\n949:         fob.animation_data_clear()\n950:     nm_low = fob.name.lower()"}
