      loc += Vector((noise(f * 0.06, 11.0, 0.026), noise(f * 0.06, 12.0, 0.026),\r\n501:                            noise(f * 0.09, 13.0, 0.018)))\r\n502:             tgt = T(fd, pr['aim0'] + (pr['aim1'] - pr['aim0']) * e, 0, 0.52)\r\n503:             key_cam(cam, f, loc, tgt,\r\n504:                     roll=pr.get('roll0', 0.0) + (pr.get('roll1', 0.0) - pr.get('roll0', 0.0)) * e\r\n505:                     + noise(f * 0.05, 14.0, 0.5),\r\n506:                     fstop=pr['fstop'],\r\n507:                     lens=pr['lens0'] + (pr['lens1'] - pr['lens0']) * e)\r\n508: \r\n509:     elif typ == \"fixed\":\r\n510:         fr = max(f0, min(f1, int(round(1 + pr['t_pass'] / DT))))\r\n511:         loc = C(frame_data[fr], pr['lead'], pr['side'], pr['h'])\r\n512:         aim = None\r\n513:         for f in range(f0, f1 + 1):\r\n514:             fd = frame_data[f]\r\n515:             tgt = fd['pos'] + Vector((0, 0, 0.34))\r\n516:             aim = tgt if aim is None else aim.lerp(tgt, pr.get('aim_lerp', 0.7))\r\n517:             dv = loc - fd['pos']\r\n518:             d = max(2.0, dv.length)\r\n519:             cos_a = abs(fd['fwd'].dot(dv.normalized()))\r\n520:             key_cam(cam, f, loc, aim, roll=pr.get('roll', 0.0), fstop=pr['fstop'],\r\n521:                     lens=lens_for_framing(d, pr['framing'], cos_a), lens_key=True)\r\n522: \r\n523:     elif typ == \"wheel\":\r\n524:         for f in range(f0, f1 + 1):\r\n525:             e = smooth((f - f0) / span)\r\n526:             fd = frame_data[f]\r\n527:             loc = C(fd, pr['back0'] + (pr['back1'] - pr['back0']) * e,\r\n528:                     pr['side0'] + (pr['side1'] - pr['side0']) * e,\r\n529:                     pr['h0'] + (pr['h1'] - pr['h0']) * e)\r\n530:             loc += Vector((noise(f * 0.17, 81.0, 0.010), noise(f * 0.17, 82.0, 0.010),\r\n531:                            noise(f * 0.21, 83.0, 0.007)))\r\n532:             tgt = fd['pos'] + fd['right'] * 0.72 + fd['fwd'] * (1.35 - 0.5 * e) + Vector((0, 0, 0.34))\r\n533:             key_cam(cam, f, loc, tgt, roll=1.2 - 2.4 * e, fstop=pr['fstop'],\r\n534:                     lens=pr['lens0'] + (pr['lens1'] - pr['lens0']) * e)\r\n535: \r\n536:     elif typ == \"onboard\":\r\n537:         for f in range(f0, f1 + 1):\r\n538:             fd = frame_data[f]\r\n539:             vib = 0.005 + 0.004 * (fd['v'] / 90.0)\r\n540:             loc = fd['pos'] + fd['fwd'] * pr['fwd'] + Vector((0, 0, pr['h']))\r\n541:             loc += Vector((noise(f * 0.95, 31.0, vib), noise(f * 0.95, 32.0, vib),\r\n542:                            noise(f * 1.15, 33.0, vib * 0.6)))\r\n543:             tgt = loc + fd['fwd'] * 22.0 + Vector((0, 0, -0.34))\r\n544:             key_cam(cam, f, loc, tgt, roll=noise(f * 0.3, 34.0, 0.8), fstop=pr['fstop'],\r\n545:                     lens=pr['lens'], lens_key=False)\r\n546: \r\n547:     elif typ == \"orbit\":\r\n548:         for f in range(f0, f1 + 1):\r\n549:             e = smooth((f - f0) / span)\r\n550:             fd = frame_data[f]\r\n551:             ang = radians(pr['a0'] + (pr['a1'] - pr['a0']) * e)\r\n552:             rad = pr['r0'] + (pr['r1'] - pr['r0']) * e\r\n553:             ox = fd['fwd'].x * cos(ang) - fd['right'].x * sin(ang)\r\n554:             oy = fd['fwd'].y * cos(ang) - fd['right'].y * sin(ang)\r\n555:             loc = fd['pos'] + Vector((ox, oy, 0)) * rad + Vector(\r\n556:                 (0, 0, pr['h0'] + (pr['h1'] - pr['h0']) * e))\r\n557:             loc += Vector((noise(f * 0.07, 51.0, 0.035), noise(f * 0.07, 52.0, 0.035),\r\n558:                            noise(f * 0.09, 53.0, 0.018)))\r\n559:             tgt = fd['pos'] + Vector((0, 0, 0.42))\r\n560:             key_cam(cam, f, loc, tgt, roll=pr['roll'] + (pr['roll_end'] - pr['roll']) * e,\r\n561:                     fstop=pr['fstop'], lens=pr['lens'], lens_key=False)\r\n562: \r\n563:     elif typ == \"heli\":\r\n564:         for f in range(f0, f1 + 1):\r\n565:             e = smooth((f - f0) / span)\r\n566:             fd = frame_data[f]\r\n567:             loc = C(fd, pr['back'], 0.0, pr['h0'] + (pr['h1'] - pr['h0']) * e)\r\n568:             loc += Vector((noise(f * 0.03, 71.0, 0.09), noise(f * 0.03, 72.0, 0.09), 0))\r\n569:             tgt = fd['pos'] + fd['fwd'] * 2.0 + Vector((0, 0, 0.6))\r\n570:             key_cam(cam, f, loc, tgt, roll=noise(f * 0.02, 73.0, 1.1), fstop=pr['fstop'],\r\n571:                     lens=pr['lens'], lens_key=False)\r\n572: \r\n573:     elif typ == \"aerial\":\r\n574:         for f in range(f0, f1 + 1):\r\n575:             e = smooth((f - f0) / span)\r\n576:             fd = frame_data[f]\r\n577:             loc = C(fd, pr['back0'] + (pr['back1'] - pr['back0']) * e,\r\n578:                     pr['side0'] + (pr['side1'] - pr['side0']) * e,\r\n579:                     pr['h0'] + (pr['h1'] - pr['h0']) * e)\r\n580:             loc += Vector((noise(f * 0.04, 91.0, 0.03 * (1 - e)), noise(f * 0.04, 92.0, 0.03 * (1 - e)),\r\n581:                            noise(f * 0.05, 93.0, 0.02)))\r\n582:             tgt = fd['pos'] + fd['fwd'] * 1.2 + Vector((0, 0, 0.55))\r\n583:             key_cam(cam, f, loc, tgt, roll=-1.0 + 2.0 * e, fstop=pr['fstop'],\r\n584:                     lens=pr['lens0'] + (pr['lens1'] - pr['lens0']) * e)\r\n585: \r\n586:     print(\"CAM %-24s %4d-%4d  t=%5.2f..%5.2f s  %-8s\" %\r\n587:           (name, f0, f1, frame_data[f0]['t'], frame_data[f1]['t'], typ))\r\n588: \r\n589: \r\n590: # 机位切换\r\n591: scene.timeline_markers.clear()\r\n592: for name, f0 in _markers:\r\n593:     mk = scene.timeline_markers.new(name, frame=f0)\r\n594:     mk.camera = _cams[name]\r\n595: scene.camera = _cams[SHOTS[0][0]]\r\n596: \r\n597: # 收尾淡出：最后 14 帧压曝光\r\n598: scene.view_settings.exposure = 0.50\r\n599: scene.view_settings.keyframe_insert(\"exposure\", frame=FRAME_END - 16)\r\n600: scene.view_settings.exposure = -3.6\r\n601: scene.view_settings.keyframe_insert(\"exposure\", frame=FRAME_END)\r\n602: \r\n603: \r\n604: # ---------------------------------------------------------------\r\n605: # 6. 渲染设置\r\n606: # ---------------------------------------------------------------\r\n607: scene.render.engine = 'BLENDER_EEVEE'\r\n608: scene.eevee.taa_render_samples = 40\r\n609: scene.eevee.use_raytracing = True\r\n610: try:\r\n611:     scene.eevee.ray_tracing_method = 'SCREEN'\r\n612: except Exception:\r\n613:     pass\r\n614: scene.render.resolution_x = 1920\r\n615: scene.render.resolution_y = 1080\r\n616: scene.render.resolution_percentage = 100\r\n617: scene.render.fps = FPS\r\n618: scene.frame_start = 1\r\n619: scene.frame_end = FRAME_END\r\n620: scene.render.use_motion_blur = True\r\n621: scene.render.motion_blur_shutter = 0.17\r\n622: scene.render.motion_blur_position = 'CENTER'\r\n623: scene.render.image_settings.file_format = 'JPEG'\r\n624: scene.render.image_settings.quality = 95\r\n625: scene.render.filepath = os.path.join(FRAMES_DIR, \"f_\")\r\n626: scene.view_settings.view_transform = 'AgX'\r\n627: for look in ('High Contrast', 'AgX - High Contrast', 'Medium High Contrast'):\r\n628:     try:\r\n629:         scene.view_settings.look = look\r\n630:         break\r\n631:     except Exception:\r\n632:         continue\r\n633: scene.view_settings.exposure = 0.50\r\n634: scene.view_settings.gamma = 1.0\r\n635: \r\n636: # 泛光\r\n637: try:\r\n638:     ng = bpy.data.node_groups.new(\"Comp_V5\", 'CompositorNodeTree')\r\n639:     rl = ng.nodes.new(\"CompositorNodeRLayers\")\r\n640:     glare = ng.nodes.new(\"CompositorNodeGlare\")\r\n641:     for val in (\"Bloom\", \"BLOOM\", \"bloom\"):\r\n642:         try:\r\n643:             glare.inputs['Type'].default_value = val\r\n644:             break\r\n645:         except Exception:\r\n646:             continue\r\n647:     for nm, v in ((\"Threshold\", 2.0), (\"Strength\", 0.16), (\"Size\", 6)):\r\n648:         if nm in glare.inputs:\r\n649:             try:\r\n650:                 glare.inputs[nm].default_value = v\r\n651:             except Exception:\r\n652:                 pass\r\n653:     try:\r\n654:         comp = ng.nodes.new(\"CompositorNodeComposite\")\r\n655:     except Exception:\r\n656:         comp = ng.nodes.new(\"NodeGroupOutput\")\r\n657:         if not any(s.name == \"Image\" for s in ng.interface.items_tree):\r\n658:             ng.interface.new_socket(name=\"Image\", in_out='OUTPUT', socket_type='NodeSocketColor')\r\n659:     ng.links.new(rl.outputs['Image'], glare.inputs['Image'])\r\n660:     ng.links.new(glare.outputs['Image'], comp.inputs['Image'])\r\n661:     scene.compositing_node_group = ng\r\n662:     scene.use_nodes = True\r\n663:     print(\"COMPOSITOR OK\")\r\n664: except Exception as e:\r\n665:     print(\"COMPOSITOR FAILED:\", e)\r\n666: \r\n667: bpy.ops.wm.save_as_mainfile(filepath=OUT)\r\n668: print(\"ANIM SAVED:\", OUT)\r\n669: \r\n670: # ---------------------------------------------------------------\r\n671: # 7. 测试渲染\r\n672: # ---------------------------------------------------------------\r\n673: def render_frames(frames, outdir, res=1280, samples=24):\r\n674:     os.makedirs(outdir, exist_ok=True)\r\n675:     scene.render.resolution_x = res\r\n676:     scene.render.resolution_y = int(res * 9 / 16)\r\n677:     scene.eevee.taa_render_samples = samples\r\n678:     for f in frames:\r\n679:         scene.frame_set(f)\r\n680:         scene.render.filepath = os.path.join(outdir, f\"test_{f:04d}.jpg\")\r\n681:         bpy.ops.render.render(write_still=True)\r\n682:         print(\"TEST FRAME\", f)\r\n683: \r\n684: \r\n685: test = argval(\"--test\")\r\n686: if test:\r\n687:     render_frames([int(x) for x in str(test).split(\",\")], os.path.join(PROJ, \"renders_v5\", \"test\"),\r\n688:                   res=1600, samples=24)\r\n689: \r\n690: if argval(\"--render\"):\r\n691:     os.makedirs(FRAMES_DIR, exist_ok=True)\r\n692:     scene.render.resolution_x = 1920\r\n693:     scene.render.resolution_y = 1080\r\n694:     scene.render.filepath = os.path.join(FRAMES_DIR, \"f_\")\r\n695:     bpy.ops.render.render(animation=True)\r\n696:     print(\"RENDER DONE\")\r"}
{"step_index":14,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-18T05:26:27Z","content":"Created At: 2026-11-18T13:26:27+08:00\nCompleted At: 2026-11-18T13:26:28+08:00\nShowing lines 1-268 of 268\n1: # V5 — 真实银石赛道整圈（90 s / 26 机位 / 数据驱动）\r\n2: \r\n3: V4 的问题不是材质也不是运镜，是**赛道是手搓的**：1.8 km 两个弯，车速和曲率各写各的关键帧，弯心速度不受抓地力约束，观众说不出哪里假，但看着就是假。\r\n4: \r\n5: V5 把这一步换掉了：赛道几何、赛车线、每一帧的车速和曲率全部来自真实银石（OpenStreetMap `type=circuit` relation 51160，闭环 2 m 重采样）。车不是\"按节奏摆出来的\"，是**被弯道半径和抓地力上限顶出来的**。\r\n6: \r\n7: ---\r\n8: \r\n9: ## 1. V4 → V5 的改动\r\n10: \r\n11: | 项目 | V4 | V5 |\r\n12: |---|---|---|\r\n13: | 赛道 | 手写曲率关键帧积分，1 779 m，2 个 90° 弯 | 真实银石，5 834 m，**18 个弯**，闭环 |\r\n14: | 驱动变量 | 帧号 | **t（该点被经过的时刻）** |\r\n15: | 朝向 | 位移差反推 + 手写滑移角 | `heading_deg` 直接取，位移差只用于轮速 |\r\n16: | 位置 | 自积分轨迹 | `racing_xy` **赛车线**（不是中心线） |\r\n17: | 交互插值 | LINEAR | LINEAR（保持）+ 全 41 059 个关键帧显式设 LINEAR |\r\n18: | 车头轴向 | 局部 +Y 当 +X 用（横向镜像，弯里偏出路面） | `rotation_z = heading − 90°`，与模型实际朝向一致 |\r\n19: | 片长 | 30 s / 720 帧 | **90.04 s / 2 161 帧**（整圈 1 圈） |\r\n20: | 机位 | 10 个 | **26 个**（追随类 + 固定类 + 车载类） |\r\n21: | 固定机位 | 手填坐标，车跑远就变点 | 按\"投影宽度定焦\"自动变焦，车恒定占画面比例 |\r\n22: | 光照 | 天空强度 0.85 + 曝光 −0.15 → 灰白、无立体 | 定向硬光 + 低环境光 + 手工黄昏穹顶 + 曝光 0.35 |\r\n23: | 路面反光 | 赛车线材质镜面 0.5 → 低角度太阳在地面拉出一条纯白楔形 | 路面系材质镜面 0.00–0.03，楔形消失 |\r\n24: | 环境 | 一条沥青带 + 4 条白线 + 一块灰墙 | 沥青/赛车线橡胶/边线/红白路肩/割草条纹草地/砾石坑/双段护栏+灯带+防护网/6 座看台（人群贴图）/维修楼+维修墙/龙门架/场地灯柱/机库 |\r\n25: | 随车补光 | 两盏 900 W 面光，把地面照出光斑 | 三盏面光 + **light linking 只照车**，地面不再有光池 |\r\n26: \r\n27: ---\r\n28: \r\n29: ## 2. 赛道数据与物理\r\n30: \r\n31: 数据包：`track_data/silverstone_track.json`（2 933 点，2 m 间距，闭环）。\r\n32: \r\n33: | 指标 | 值 |\r\n34: |---|---|\r\n35: | 实测周长 | 5.834 km（官方 5.891，−0.97%） |\r\n36: | 仿真单圈 | **90.34 s**（官方杆位 87.0，+3.84%） |\r\n37: | 平均 / 峰值 / 最低速度 | 232.5 / 331.2 / 54 km/h |\r\n38: | 横向加速度峰值 | 6.39 g（上限模型 `15.0 + 0.00714 v²`，超限点 0） |\r\n39: | 采样 | 2 933 点 × 2 m，拼接缺口 0.00 m |\r\n40: \r\n41: ### 五条硬规则（写进脚本注释，改脚本的人必须先看这段）\r\n42: \r\n43: 1. 位置按 `t` 插值，**不按帧均分** —— 按帧均分等于匀速跑。\r\n44: 2. 朝向取 `heading_deg`，**不用位移差反推** —— 稀疏处会跳变，车头一顿一顿。\r\n45: 3. 位置走 `racing_xy`，**不是 `xy`** —— 压中线跑，弯里像轨道车。\r\n46: 4. 关键帧插值 **LINEAR** —— Bezier 在弯心过冲，冲出去就是\"漂移\"。\r\n47: 5. `v²·κ` 不得超过 `15.0 + 0.00714 v²` —— 超了就是物理上不可能的动作。\r\n48: \r\n49: ### 自检（每次构建自动跑）\r\n50: \r\n51: ```\r\n52: [check] 最坏横向 62.58 m/s² (6.38 g) @ frame 1774, t=74.2 s\r\n53: [check] 超限帧 0 -> PASS\r\n54: [check] 航向跳变帧(>6.9deg) 0 -> PASS\r\n55: [check] v_max 331.2 km/h, lap 90.34 s, 帧数 2161\r\n56: ```\r\n57: \r\n58: 时间轴换算：`dt = 90.34 / (2161 − 1) = 0.041824 s/帧`。整圈正好铺满 2 161 帧，比标称 24 fps 慢 0.4%，肉眼不可见。\r\n59: \r\n60: ---\r\n61: \r\n62: ## 3. 赛道环境怎么长出来的\r\n63: \r\n64: 全部由中心线 + 曲率程序化生成，没有一件手摆：\r\n65: \r\n66: | 部件 | 生成规则 |\r\n67: |---|---|\r\n68: | 路面 | 沿中心线 ±7.0 m 的带（14 m 宽），z=0.010 |\r\n69: | 赛车线橡胶 | 沿 `racing_xy` ±1.7 m，更暗更粗糙（真实赛道被橡胶\"涂\"过的一条） |\r\n70: | 边线 | ±(7.0−0.20…7.0−0.05) 白实线 |\r\n71: | 路肩 | 曲率 > 0.0045 且长度 ≥ 18 m 的 20 段弯道，内外侧都铺；宽 1.35 m，红白每 3.2 m 交替，内高 12 mm / 外高 75 mm |\r\n72: | 草地 | ±(8.35…33) m 缓冲带，含 16 m 一档的割草条纹（机场草坪特征） |\r\n73: | 砾石坑 | 弯心速度 < 180 km/h 的 13 处弯外侧，7 m → 22 m |\r\n74: | 护栏 | ±33 m 连续，0.24 m 混凝土基座 + 上面深色金属板到 1.05 m，顶沿青色灯带，每 12 m 一根防护网立柱 |\r\n75: | 看台 | 6 座（主直道 150 m/13 排 + 5 个弯角），阶梯面贴程序化人群图，顶棚 + 顶棚灯带 |\r\n76: | 维修区 | 主直道内侧 360 m：维修楼 10 m 高、顶沿灯带、维修墙 + 灯带 |\r\n77: | 起终点 | 弧长 40 m 处龙门架 + 方格线 + 5 盏发车灯（本片是飞驰圈，常暗） |\r\n78: | 远景 | 6 座机库、环形灌篱、12 根 16 m 场地灯柱、天空穹顶 4 200 m |\r\n79: \r\n80: 天空不是 HDRI：4 200 m 半径的球体，按顶点 z 分 7 档做黄昏渐变（地平线 0.60/0.30/0.16 → 天顶 0.008/0.020/0.070），自发光材质，`visible_shadow=False`。这样天空颜色和太阳方向可以分开调，不会像 HDRI 那样一动就全变。\r\n81: \r\n82: ---\r\n83: \r\n84: ## 4. 车怎么被驱动\r\n85: \r\n86: 骨架 `RIG_F1_Race` 沿用 V4 的 19 骨分层结构，驱动量全部由赛道数据推出来：\r\n87: \r\n88: | 属性 | 公式 | 说明 |\r\n89: |---|---|---|\r\n90: | `Bone_Root.location` | `racing_xy`（z=0.012） | 轮胎正好落在沥青面 |\r\n91: | `Bone_Heading.rotation_z` | `heading − 90°` | 车模型前方是局部 +Y |\r\n92: | `Bone_Body` 俯仰 | `clamp(acc·0.085, −1.9…1.4)° − 0.16·换挡闪光` | acc 由 v 的中心差分得到 |\r\n93: | `Bone_Body` 侧倾 | `clamp(−lat·0.26, ±2.2)°` | lat = v²κ/g |\r\n94: | `steer` | `deg(κ · 3.6 m)`，限 ±26° | 阿克曼几何，轴距 3.6 m |\r\n95: | `wheel_spin` | `Σ Δs / 0.357 m` | 18 寸胎外径 714 mm |\r\n96: | `drs` | `|κ|<0.0016 且 v>240 km/h → 1`，`|κ|>0.004 → 0`，其间 0.5 | 直道开、弯前关 |\r\n97: | `brake_heat` | `clamp(−acc·0.11, 0…1.3)` | 同时驱动尾灯亮度 |\r\n98: | `susp_f / susp_r` | `−0.004 − 0.014·max(0,−acc)/12` / `−0.004 − 0.016·max(0,acc)/12` | 制动点头 / 加速后坐 |\r\n99: \r\n100: 刹车灯亮度 = `1.0 + brake_heat × 12`，跟着重刹自动亮。\r\n101: \r\n102: ---\r\n103: \r\n104: ## 5. 26 个机位\r\n105: \r\n106: 切点吸附到 108 BPM 拍点（1 拍 = 13.333 帧），片长 162 拍。\r\n107: \r\n108: | # | 机位 | 帧 | t (s) | 类型 | 说明 |\r\n109: |---|---|---|---|---|---|\r\n110: | 1 | S01_RearChase | 1–108 | 0.0–4.6 | 追随 | 车尾 8→11.5 m，38→31 mm，镜头抬起，300 km/h 起步 |\r\n111: | 2 | S02_Onboard | 108–201 | 4.6–8.4 | 车载 | 鼻锥 2.45 m 前 / 0.53 m 高，17 mm |\r\n112: | 3 | S03_ChaseRise | 201–294 | 8.4–12.4 | 追随 | 后方 1.3→4.2 m 升起侧滑，切入 T1 |\r\n113: | 4 | S04_Hairpin | 294–401 | 12.4–16.6 | 固定 | 发夹弯外侧 8.6 m / 0.8 m 高，投影定焦 |\r\n114: | 5 | S05_ChaseAintree | 401–481 | 16.6–20.0 | 追随 | 出弯低跟 |\r\n115: | 6 | S06_Orbit1 | 481–561 | 20.0–23.4 | 环绕 | 104°→52° 绕车 |\r\n116: | 7 | S07_ChaseAccel | 561–641 | 23.4–26.6 | 追随 | 加速段拉开 |\r\n117: | 8 | S08_FastPan | 641–734 | 26.6–30.6 | 固定 | 高速弯外侧 14 m 摇摄，定焦 |\r\n118: | 9 | S09_WheelMacro | 734–788 | 30.6–32.8 | 轮组 | 前轮 3.3 m / 0.44 m，52→42 mm |\r\n119: | 10 | S09b_ChaseFast | 788–841 | 32.8–35.2 | 追随 | 30 mm 广角贴地 |\r\n120: | 11 | S10_OrbitBrooklands | 841–894 | 34.0–37.4 | 环绕 | 98°→44° 绕车 |\r\n121: | 12 | S11_Luffield | 894–1001 | 37.4–41.8 | 固定 | 慢弯外侧 10.5 m，车迎面进弯 |\r\n122: | 13 | S12_ChaseWoodcote | 1001–1081 | 41.8–45.0 | 追随 | 中速弯低跟 |\r\n123: | 14 | S13_WoodcoteTele | 1081–1161 | 45.0–48.4 | 固定 | 前方 95 m / 2.4 m 高长焦压缩 |\r\n124: | 15 | S14_HeliDrop | 1161–1241 | 48.4–52.0 | 直升机 | 46→14 m 俯冲 |\r\n125: | 16 | S15_OrbitCopse | 1241–1334 | 52.0–55.6 | 环绕 | 108°→48° 绕车 |\r\n126: | 17 | S16_ChaseCopse | 1334–1414 | 55.6–59.2 | 追随 | 弯心后跟拍 |\r\n127: | 18 | S17_Maggotts | 1414–1508 | 59.2–63.2 | 固定 | 复合弯内侧 11.5 m 摇摄 |\r\n128: | 19 | S18_ChaseRise2 | 1508–1601 | 63.2–66.8 | 追随 | 1.3→4.6 m 大升起 |\r\n129: | 20 | S19_Onboard3 | 1601–1681 | 66.8–70.4 | 车载 | 20 mm，321 km/h 大直道 |\r\n130: | 21 | S20_StoweTele | 1681–1788 | 70.4–74.8 | 固定 | 前方 130 m / 2.8 m 高，210 mm 起 |\r\n131: | 22 | S21_OrbitStowe | 1788–1881 | 74.8–78.4 | 环绕 | 112°→50° 绕车 |\r\n132: | 23 | S22_ChaseLow | 1881–1961 | 78.4–82.0 | 追随 | 贴地跟拍 |\r\n133: | 24 | S23_HeliReveal | 1961–2054 | 82.0–85.6 | 直升机 | 18→62 m 拉升揭示赛道 |\r\n134: | 25 | S24_Club | 2054–2121 | 85.6–88.4 | 固定 | 最后一弯外侧 9 m |\r\n135: | 26 | S25_AerialOut | 2121–2161 | 88.4–90.3 | 航拍 | 3→11 m 拉升 + 曝光淡出 |\r\n136: \r\n137: **固定机位为什么不会把车拍成点**：镜头按\"车在画面里的投影宽度\"反算焦距——\r\n138: \r\n139: ```\r\n140: w_eff = 2.2 + (4.7 − 2.2)·(1 − |cosθ|)     # θ 是车头方向与视线的夹角\r\n141: f = framing · 36 mm · distance / w_eff      # framing 0.22–0.34\r\n142: ```\r\n143: \r\n144: 车迎面冲来时用 2.2 m 车宽算，侧掠时用 4.7 m 车长算，所以画面里的车尺寸恒定，背景透视在变——电视转播的做法。\r\n145: \r\n146: ---\r\n147: \r\n148: ## 6. 音乐卡点\r\n149: \r\n150: | 项 | 值 |\r\n151: |---|---|\r\n152: | 曲目 | The Weeknd — After Hours |\r\n153: | BPM | 108（自相关实测 107.67，取整 108） |\r\n154: | 1 拍 | 0.5556 s = **13.333 帧 @24 fps** |\r\n155: | 选段 | 240.814 s 起，90.04 s（162 拍），末 1.5 s 淡出 |\r\n156: | 切点 | 全部 `frame = 1 + n × 13.333` |\r\n157: \r\n158: `renders_v5/audio_v5_90s.m4a` 是切好的音轨，`pipeline/mux_v5.sh` 负责合成。\r\n159: \r\n160: ---\r\n161: \r\n162: ## 7. 文件\r\n163: \r\n164: | 文件 | 说明 |\r\n165: |---|---|\r\n166: | `pipeline/v5_env.py` | 环境构建：真实赛道 → 路面/路肩/砾石/护栏/看台/维修区/天空 |\r\n167: | `pipeline/v5_anim.py` | 轨迹采样 + 骨架烘焙 + 26 机位 + 物理自检 |\r\n168: | `pipeline/render_v5.py` | 1080p 终渲（32 samples EEVEE） |\r\n169: | `pipeline/mux_v5.sh` | 帧序列 → H.264 → 混音 |\r\n170: | `pipeline/v5_clay.py` | 白模：把 `LATEST/v5_stage_anim.blend` 的材质换成灰模（车 0.88 / 环境 0.40，`Standard` 视图变换），另存为白模工程，原文件不动 |\r\n171: | `pipeline/render_clay.py` | 白模 2161 帧终渲（约 12 min） |\r\n172: | `pipeline/mux_clay.sh` | 白模帧序列 → H.264（带音乐 / 无音乐两版） |\r\n173: | `pipeline/v5_viewport_fast.py` | 视口快速模式开关：`-- fast` 隐藏重集合、重物件显示包围盒；`-- normal` 恢复。只改 `hide_viewport` / `display_type`，不影响渲染 |\r\n174: | `pipeline/v5_preview.py` | 环境工程低清预览 |\r\n175: | `pipeline/v4_stage_rig.blend` | 管线输入：V4 的模型 + 骨架（无环境无动画） |\r\n176: | `LATEST/v5_stage_env.blend` | 中间产物：模型 + 骨架 + 环境（`v5_env.py` 输出） |\r\n177: | `LATEST/v5_stage_anim.blend` | 交付工程：含整圈动画与全部 26 机位（`v5_anim.py` 输出） |\r\n178: | `LATEST/v5_stage_anim_clay.blend` | 白模工程（`v5_clay.py` 输出） |\r\n179: | `renders_v5/f1_silverstone_lap_1080p.mp4` | 成片（1920×1080 / 24 fps / 90 s / H.264 + AAC） |\r\n180: | `renders_v5/f1_silverstone_clay_1080p.mp4` | 白模成片 |\r\n181: | `renders_v5/stills/shot_*.jpg` | 各机位关键帧 |\r\n182: | `track_data/` | 赛道数据包（Silverstone / Monza + 生成器 + 消费脚本） |\r\n183: \r\n184: ### 复现\r\n185: \r\n186: ```bash\r\n187: B=\"/d/APPs/steam/steamapps/common/Blender/blender.exe\"\r\n188: \"$B\" -b -P pipeline/v5_env.py                 # 环境（约 20 s）\r\n189: \"$B\" -b -P pipeline/v5_anim.py                # 动画 + 机位（约 15 s）\r\n190: \"$B\" -b -P pipeline/render_v5.py              # 2161 帧 1080p（约 30 min）\r\n191: bash pipeline/mux_v5.sh                       # 合成\r\n192: \r\n193: # 白模（可选，依赖上面的 LATEST/v5_stage_anim.blend）\r\n194: \"$B\" -b -P pipeline/v5_clay.py                # → LATEST/v5_stage_anim_clay.blend\r\n195: \"$B\" -b -P pipeline/render_clay.py            # 2161 帧（约 12 min）\r\n196: bash pipeline/mux_clay.sh                     # 合成\r\n197: ```\r\n198: \r\n199: 单帧抽检：\r\n200: \r\n201: ```bash\r\n202: \"$B\" -b -P pipeline/v5_anim.py -- --test 40,330,760,1500\r\n203: ```\r\n204: \r\n205: ---\r\n206: \r\n207: ## 8. 边界与没做的事\r\n208: \r\n209: - **没有高程**：OSM 数据 z=0，银石本身很平，但真实赛道有几十厘米的起伏和路肩倾角，片子里看不到。要做需要另一份 DEM/等高线数据。\r\n210: - **没有轮胎烟/胎痕**：干地光头胎本来也不留，V4 已删，这里也没加。\r\n211: - **车模没动**：V5 只改环境、驱动、机位、光照。车身几何、材质、贴花沿用 V4（贴花亮度整体压了 0.55–0.7，因为新光照下原贴花过曝）。\r\n212: - **只有一台车**：没有对手、没有跟车缠斗，单圈计时赛视角。\r\n213: - **没有引擎声**：片子只有配乐。要加需要 RPM/涡轮/换挡音效层，按 `gear` 和时间轴对齐。\r\n214: - **赛道数据许可**：几何来自 OpenStreetMap，ODbL。公开发布需署名 `© OpenStreetMap contributors`；内部使用不必。\r\n215: - **速度模型是拟合的**，不是官方遥测：横向 `a = 15.0 + 0.00714 v²`、制动 `min(55, 20 + 0.005 v²)`、加速 `min(16, 937/v)`。精度是\"看着完全对\"，不是\"逐帧对齐真实遥测\"。\r\n216: \r\n217: ---\r\n218: \r\n219: ## 9. 这一版踩过的坑（留给下次）\r\n220: \r\n221: | 现象 | 原因 | 处理 |\r\n222: |---|---|---|\r\n223: | 车在弯里朝外偏，压出路面 | 车模型前方是局部 +Y，却按 +X 的朝向公式写 `rotation_z = heading` | `rotation_z = heading − 90°`；`fwd = (cos h, sin h)`、`right = (sin h, −cos h)` |\r\n224: | 路面上出现一条横贯的纯白楔形 | 赛车线材质镜面 0.5、粗糙度 0.36，低角度太阳在沥青上打出一条镜面反射 | 路面系材质 `Specular IOR Level` 0.00–0.03；白线/路肩/砾石一并压掉 |\r\n225: | 车旁边一块方形的亮光斑 | 随车面光把地面也照了 | `light_linking.receiver_collection` 只绑车身集合 |\r\n226: | 40 m 高空俯拍时路面\"变成草地\" | 相机 `clip_start=0.05`、`clip_end=12000`，深度精度不足，地面（z=−0.004）抢在路面（z=0.010）前面 | `clip_start=0.5`、`clip_end=9000` |\r\n227: | 轮胎像浮在路面上 | 车身 z=0，而沥青面在 z=0.010 | 骨架 `Bone_Root.z = 0.012` |\r\n228: | 贴花在夜景下发白、像塑料 | V4 的贴花是按更亮的环境做的 | 贴花图整体压 0.55–0.7，重建场景后重新烘焙 |\r\n229: | 看台在镜头里像一块噪点墙 | 人群贴图 18 m 一循环，人太大了 | 改成 7.5 m 一循环 + 自发光 0.55；并把挡在机位正后方的两座看台挪开 |\r\n230: | 固定机位把车拍成一个点 | 定焦按车长算，车迎面来时投影只有车宽 | 按 `2.2 + 2.5·(1−|cosθ|)` 的投影宽度反算焦距 |\r\n231: | 低角度机位太阳炫光太大 | 太阳高度角 13° 时地面受光只有 sin13°≈0.22 | 抬到 22°，曝光 +0.50 |\r\n232: \r\n233: ---\r\n234: \r\n235: ## 10. 环境增强（本轮：维修区 / 看台 / 赛道道具）\r\n236: \r\n237: 在 V5 基础上又补了三块场景，全部继续走 headless bpy 脚本，车与动画零改动。\r\n238: \r\n239: ### 维修区（pit box，替代原来一整条混凝土盒子）\r\n240: | 部件 | 生成规则 |\r\n241: |---|---|\r\n242: | pit wall | 内侧 −10 m 连续矮墙（1.1 m），顶沿发光队名牌 |\r\n243: | pit lane | 内侧 −10…−19 m 沥青车道（覆盖草地缓冲带），两侧白线 |\r\n244: | pit box 划线 | 每 6 m 一条横向白线（约 56 个车位） |\r\n245: | garage 楼 | 内侧 −22…−36 m、8 m 高混凝土楼体，正面贴 garage 贴图（卷帘门开口 + 随机车队色灯牌，每 6 m 一单元） |\r\n246: | 楼顶主看台 | garage 楼顶 4 排小阶梯（人群贴图）+ 顶沿赞助灯箱 + 围栏发光条 |\r\n247: \r\n248: ### 看台（原来一条阶梯 → 有结构的场馆）\r\n249: - 阶梯按 28 m 分块，块间留 2 m 通道（不再是一条）\r\n250: - 顶棚改为**前低后高斜面**，后支撑柱 + 横向钢梁形成桁架结构\r\n251: - 顶排后侧加 VIP 玻璃发光带\r\n252: - 前沿加安全围栏 + 旗杆（随机色旗）\r\n253: \r\n254: ### 赛道道具\r\n255: | 道具 | 数量 / 规则 |\r\n256: |---|---|\r\n257: | 广告板 | 沿整圈每 60 m 一块（护栏外侧，跳过维修区段），发光赞助板 |\r\n258: | 刹车距离牌 | 3 组慢弯外侧的 150 / 100 / 50 m 牌 |\r\n259: | 大屏 | 2 块（维修区出口内侧 + 赛道中段），发光 LED 屏 |\r\n260: | 人行天桥 | 2 座（横跨路面的钢结构过街桥，车从桥下穿过） |\r\n261: | 裁判点 | 7 个（沿赛道小棚 + 顶灯） |\r\n262: \r\n263: ### 渲染\r\n264: - 对象数 403 → 919（结构件已减半以控制每帧耗时）\r\n265: - EEVEE raytracing 保持，`taa_render_samples = 32`（48 会拖到 2 小时，32 是质量/时间平衡点）\r\n266: - 单帧 1080p 约 2.3 s，整片 2 161 帧实测 30 分钟\r\n267: \r\n268: > 注：本机 Cycles compute device 为 NONE（无 GPU），EEVEE 纯 CPU 渲染；对象数对每帧耗时影响近似线性。\r"}
