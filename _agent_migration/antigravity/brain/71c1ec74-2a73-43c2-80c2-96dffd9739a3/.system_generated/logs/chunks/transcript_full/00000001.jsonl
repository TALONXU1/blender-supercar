de = 1 if SIGNED_K[a] > 0 else -1    # 弯外侧 = 转向的反侧\r\n669:         build_gravel(a, b, side, f\"V5_Gravel_{_gi}\")\r\n670:         _gi += 1\r\n671: print(\"gravel traps:\", _gi)\r\n672: \r\n673: # ---------------------------------------------------------------\r\n674: # 8. 护栏 + 灯带 + 防护网\r\n675: # ---------------------------------------------------------------\r\n676: WALL_OFF = HALF_W + VERGE_W            # 33 m\r\n677: WALL_H = 1.05\r\n678: BASE_H = 0.24\r\n679: \r\n680: \r\n681: def _wall_band(z0, z1, off, mat, name):\r\n682:     wv, wf = [], []\r\n683:     for side in (-1, 1):\r\n684:         base = len(wv)\r\n685:         for i in range(N):\r\n686:             p, h, r, k = at(i)\r\n687:             o = side * off\r\n688:             px, py = p.x + r.x * o, p.y + r.y * o\r\n689:             wv.append((px, py, z0))\r\n690:             wv.append((px, py, z1))\r\n691:         for j in range(N):\r\n692:             aa = base + j * 2\r\n693:             bb = base + ((j + 1) % N) * 2\r\n694:             wf.append((aa, aa + 1, bb + 1, bb))\r\n695:             wf.append((bb, bb + 1, aa + 1, aa))\r\n696:     return mesh_from(name, wv, wf, mat, up=False)\r\n697: \r\n698: \r\n699: _wall_band(0.0, BASE_H, WALL_OFF, M_CONC, \"V5_BarrierBase\")\r\n700: _wall_band(BASE_H, WALL_H, WALL_OFF + 0.04, M_BARRIER, \"V5_Barrier\")\r\n701: \r\n702: # 顶部灯带\r\n703: _sv, _sf = [], []\r\n704: for side in (-1, 1):\r\n705:     base = len(_sv)\r\n706:     for i in range(N):\r\n707:         p, h, r, k = at(i)\r\n708:         o = side * (WALL_OFF - 0.02)\r\n709:         px, py = p.x + r.x * o, p.y + r.y * o\r\n710:         _sv.append((px, py, WALL_H - 0.10))\r\n711:         _sv.append((px, py, WALL_H - 0.02))\r\n712:     for j in range(N):\r\n713:         a = base + j * 2\r\n714:         b = base + ((j + 1) % N) * 2\r\n715:         _sf.append((a, a + 1, b + 1, b))\r\n716:         _sf.append((b, b + 1, a + 1, a))\r\n717: mesh_from(\"V5_BarrierStrip\", _sv, _sf, M_STRIP, up=False)\r\n718: \r\n719: # 防护网立柱（每 12 m 一根薄板柱：沿切线 ±0.07 m 宽 0.14 m，高 3.4 m；全部在一个网格里）\r\n720: _pv, _pf = [], []\r\n721: POST_STEP = 12.0\r\n722: for side in (-1, 1):\r\n723:     s = 0.0\r\n724:     while s < LAP_LEN:\r\n725:         p, h, r, k = at_s(s)\r\n726:         o = side * (WALL_OFF + 0.35)\r\n727:         px, py = p.x + r.x * o, p.y + r.y * o\r\n728:         tx, ty = cos(h), sin(h)                    # 切线方向\r\n729:         base = len(_pv)\r\n730:         for d in (-0.07, 0.07):\r\n731:             _pv.append((px + tx * d, py + ty * d, WALL_H))\r\n732:             _pv.append((px + tx * d, py + ty * d, WALL_H + 3.4))\r\n733:         _pf.append((base, base + 1, base + 3, base + 2))\r\n734:         s += POST_STEP\r\n735: mesh_from(\"V5_FencePosts\", _pv, _pf, M_STEEL, up=False)\r\n736: \r\n737: # ---------------------------------------------------------------\r\n738: # 9. 起跑龙门架 + 发车灯 + 起跑线\r\n739: # ---------------------------------------------------------------\r\n740: SF_S = 40.0                     # 起终点位置（沿中心线弧长）\r\n741: gp, gh, gr, gk = at_s(SF_S)\r\n742: \r\n743: # 路面方格线\r\n744: _gv, _gf = [], []\r\n745: for k in range(2):\r\n746:     _gv.append((gp.x + gr.x * (-HALF_W), gp.y + gr.y * (-HALF_W), 0.016))\r\n747:     _gv.append((gp.x + gr.x * (HALF_W), gp.y + gr.y * (HALF_W), 0.016))\r\n748:     gp2, gh2, gr2, _ = at_s(SF_S + (k + 1) * 0.6)\r\n749:     _gv.append((gp2.x + gr2.x * (-HALF_W), gp2.y + gr2.y * (-HALF_W), 0.016))\r\n750:     _gv.append((gp2.x + gr2.x * (HALF_W), gp2.y + gr2.y * (HALF_W), 0.016))\r\n751: for k in range(2):\r\n752:     a = k * 4\r\n753:     _gf.append((a, a + 1, a + 3, a + 2))\r\n754: mesh_from(\"V5_StartLine\", _gv, _gf, M_WHITE)\r\n755: \r\n756: # 门架（组件 Empty: V5_Gantry，含立柱/横梁/横幅/5 盏发车灯）\r\n757: GANT_H = 7.2\r\n758: _gant_parts = []\r\n759: for sd, nm in ((-1, \"L\"), (1, \"R\")):\r\n760:     px = gp.x + gr.x * sd * (HALF_W + 1.6)\r\n761:     py = gp.y + gr.y * sd * (HALF_W + 1.6)\r\n762:     _gant_parts.append(box(f\"V5_Gantry_Post_{nm}\", (px, py, GANT_H / 2), (0.45, 0.45, GANT_H), M_STEEL, rot_z=gh))\r\n763: _gant_parts.append(box(\"V5_Gantry_Beam\", (gp.x, gp.y, GANT_H), (HALF_W * 2 + 3.6, 0.55, 0.85), M_STEEL, rot_z=gh))\r\n764: _gant_parts.append(box(\"V5_Gantry_Banner\", (gp.x - sin(gh) * 0.32, gp.y + cos(gh) * 0.32, GANT_H),\r\n765:                        (HALF_W * 2 + 2.2, 0.06, 0.6), M_ADPANEL, rot_z=gh))\r\n766: \r\n767: # 5 盏发车灯（红灯；v5_anim 里把材质发光压到 0 = 常暗）\r\n768: M_SLIGHT = new_mat(\"V5_StartLight\", (0.06, 0.004, 0.003), 0.3,\r\n769:                    emission=(1.0, 0.05, 0.02), estrength=18.0)\r\n770: for i in range(5):\r\n771:     ox = -1.6 + i * 0.8\r\n772:     px = gp.x + gr.x * ox\r\n773:     py = gp.y + gr.y * ox\r\n774:     bm = bmesh.new()\r\n775:     bmesh.ops.create_uvsphere(bm, u_segments=16, v_segments=10, radius=0.18)\r\n776:     me = bpy.data.meshes.new(f\"V5_StartLight_{i}\")\r\n777:     bm.to_mesh(me)\r\n778:     bm.free()\r\n779:     ob = bpy.data.objects.new(f\"V5_StartLight_{i}\", me)\r\n780:     COLL.objects.link(ob)\r\n781:     ob.location = (px, py, GANT_H - 0.62)\r\n782:     me.materials.append(M_SLIGHT)\r\n783:     _gant_parts.append(ob)\r\n784: assembly(\"V5_Gantry\", (gp.x, gp.y, 0.0), gh, _gant_parts, size=6.0)\r\n785: \r\n786: # ---------------------------------------------------------------\r\n787: # 10. 看台（含人群贴图）\r\n788: # ---------------------------------------------------------------\r\n789: def grandstand(s_center, side, length, rows=11, dist=30.0, name=\"Stand\"):\r\n790:     \"\"\"一座看台 = 一个 Empty(name) + 子物体:\r\n791:        _Tier{i} 阶梯块 / _Back 后墙 / _VIP 玻璃带 / _Roof 顶棚 / _RoofStrip 灯带 / _Rail 前沿围栏\r\n792:        _Columns 后支撑柱(合并) / _Trusses 顶棚横向钢梁(合并) / _FrontPosts 前立柱(合并)\r\n793:        _Flagpoles 旗杆(合并) / _Flags 旗(合并, 多材质)\"\"\"\r\n794:     p, h, r, k = at_s(s_center)\r\n795:     fwd = Vector((cos(h), sin(h), 0.0))\r\n796:     out = Vector((r.x, r.y, 0.0)) * side\r\n797:     row_d = 0.92\r\n798:     row_h = 0.58\r\n799:     L = length / 2.0\r\n800:     parts = []\r\n801: \r\n802:     # ---- 阶梯分块（每 28 m 一块，块间 2 m 通道，避免一整条）----\r\n803:     block, gap = 28.0, 2.0\r\n804:     spans, x0 = [], -L\r\n805:     while x0 < L - 4:\r\n806:         x1 = min(x0 + block, L)\r\n807:         spans.append((x0, x1))\r\n808:         x0 = x1 + gap\r\n809:     for bi, (x0, x1) in enumerate(spans):\r\n810:         bl = x1 - x0\r\n811:         v, fc, uv = [], [], []\r\n812:         for rr in range(rows + 1):\r\n813:             d0 = dist + rr * row_d\r\n814:             z = rr * row_h\r\n815:             for sd, xs in ((-1, x0), (1, x1)):\r\n816:                 c = p + out * d0 + fwd * xs\r\n817:                 v.append((c.x, c.y, z))\r\n818:                 uv.append((sd * bl / 7.5 + 0.5, rr / float(rows)))\r\n819:         for rr in range(rows):\r\n820:             a = rr * 2\r\n821:             b = (rr + 1) * 2\r\n822:             fc.append((a, a + 1, b + 1, b))     # 座面\r\n823:             fc.append((a, b, b + 1, a + 1))     # 立面\r\n824:         parts.append(mesh_from(f\"{name}_Tier{bi}\", v, fc, M_CROWD, uvs=uv, up=False))\r\n825: \r\n826:     # ---- 后墙 + VIP 玻璃带 ----\r\n827:     back = dist + rows * row_d\r\n828:     parts.append(box(name + \"_Back\", (p.x + out.x * back, p.y + out.y * back, rows * row_h / 2),\r\n829:                      (length, 0.5, rows * row_h), M_CONC, rot_z=h))\r\n830:     gz = (rows - 1) * row_h\r\n831:     parts.append(box(name + \"_VIP\", (p.x + out.x * (back - 0.3), p.y + out.y * (back - 0.3), gz + 0.9),\r\n832:                      (length - 4, 0.12, 1.2), M_STRIP, rot_z=h))\r\n833: \r\n834:     # ---- 斜顶棚（前低后高）+ 支撑 ----\r\n835:     zf = rows * row_h + 3.0\r\n836:     zb = rows * row_h + 5.8\r\n837:     rf = dist - 0.6\r\n838:     rb = back + 1.6\r\n839:     rv = []\r\n840:     for sd in (-1, 1):\r\n841:         cf = p + out * rf + fwd * (L * sd)\r\n842:         cb = p + out * rb + fwd * (L * sd)\r\n843:         rv += [(cf.x, cf.y, zf), (cb.x, cb.y, zb)]\r\n844:     parts.append(mesh_from(name + \"_Roof\", rv, [(0, 1, 3, 2)], M_ROOF, up=False))\r\n845:     # 顶棚下沿灯带\r\n846:     lp = p + out * (rf + 0.1)\r\n847:     parts.append(box(name + \"_RoofStrip\", (lp.x, lp.y, zf - 0.3), (length * 0.96, 0.10, 0.10), M_STRIP, rot_z=h))\r\n848:     # 后支撑柱（每 14 m）-> 一个网格\r\n849:     cols = Parts(name + \"_Columns\")\r\n850:     _n = int(length / 14)\r\n851:     for i in range(_n + 1):\r\n852:         xs = -L + i * 14.0\r\n853:         cph = p + out * rb + fwd * xs\r\n854:         cols.box((cph.x, cph.y, zb / 2), (0.24, 0.24, zb), M_STEEL, rot_z=h)\r\n855:     parts.append(cols.build())\r\n856:     # 顶棚横向钢梁（每 8 m 一根，从顶棚前沿斜拉到后沿，贴在顶棚下 0.12 m）-> 一个网格\r\n857:     trs = Parts(name + \"_Trusses\")\r\n858:     _m = int(length / 8)\r\n859:     for i in range(_m + 1):\r\n860:         xs = -L + i * 8.0\r\n861:         bf = p + out * rf + fwd * xs\r\n862:         bb = p + out * rb + fwd * xs\r\n863:         trs.beam((bf.x, bf.y, zf - 0.12), (bb.x, bb.y, zb - 0.12), fwd, 0.16, 0.16, M_STEEL)\r\n864:     parts.append(trs.build())\r\n865: \r\n866:     # ---- 前立柱 + 前沿围栏 ----\r\n867:     fps = Parts(name + \"_FrontPosts\")\r\n868:     for sd in (-1, 1):\r\n869:         cp = p + out * (dist + 0.4) + fwd * (L * sd * 0.92)\r\n870:         fps.box((cp.x, cp.y, zf / 2), (0.28, 0.28, zf), M_STEEL, rot_z=h)\r\n871:     parts.append(fps.build())\r\n872:     rail = p + out * (dist - 1.5)\r\n873:     parts.append(box(name + \"_Rail\", (rail.x, rail.y, 0.55), (length, 0.06, 0.06), M_STEEL, rot_z=h))\r\n874:     # 旗杆 + 旗（沿前沿，每 40 m）-> 旗杆一个网格、旗一个网格（多材质）\r\n875:     poles = Parts(name + \"_Flagpoles\")\r\n876:     flags = Parts(name + \"_Flags\")\r\n877:     _n = int(length / 40)\r\n878:     for i in range(_n + 1):\r\n879:         xs = -L + i * 40.0\r\n880:         fp = p + out * (dist - 2.2) + fwd * xs\r\n881:         poles.box((fp.x, fp.y, 3.0), (0.08, 0.08, 6.0), M_STEEL, rot_z=h)\r\n882:         col = random.choice(M_FLAGS)\r\n883:         fv = [(fp.x, fp.y, 6.0),\r\n884:               (fp.x + out.x * 1.5, fp.y + out.y * 1.5, 5.65),\r\n885:               (fp.x, fp.y, 5.3)]\r\n886:         flags.poly(fv, [(0, 1, 2)], col)\r\n887:     parts.append(poles.build())\r\n888:     parts.append(flags.build())\r\n889: \r\n890:     # ---- 组件 Empty：放在看台占地中心（地面），X 轴沿赛道 ----\r\n891:     mid = p + out * ((dist - 2.2 + rb) / 2.0)\r\n892:     assembly(name, (mid.x, mid.y, 0.0), h, parts, size=8.0)\r\n893:     return name\r\n894: \r\n895: \r\n896: STANDS = [\r\n897:     (120.0, 1, 150.0, 13, 26.0, \"V5_Stand_Main\"),\r\n898:     (1120.0, -1, 90.0, 11, 30.0, \"V5_Stand_T1\"),\r\n899:     (2600.0, 1, 110.0, 12, 30.0, \"V5_Stand_Mid\"),\r\n900:     (3540.0, -1, 120.0, 12, 30.0, \"V5_Stand_Complex\"),\r\n901:     (4370.0, 1, 95.0, 11, 32.0, \"V5_Stand_South\"),\r\n902:     (5560.0, -1, 100.0, 11, 28.0, \"V5_Stand_Club\"),\r\n903: ]\r\n904: M_FLAGS = [new_mat(f\"V5_Flag_{i}\", c, 0.6, 0.0)\r\n905:            for i, c in enumerate(((200, 30, 30), (20, 60, 200), (240, 240, 240),\r\n906:                                   (255, 160, 0), (20, 140, 90)))]\r\n907: random.seed(11)                     # 旗色可复现（以前未设种子，每次构建旗色都不同）\r\n908: for args in STANDS:\r\n909:     grandstand(*args)\r\n910: print(\"stands:\", len(STANDS))\r\n911: \r\n912: # ---------------------------------------------------------------\r\n913: # 11. 维修区（主直道内侧）：pit wall + pit lane + pit box + garage 楼\r\n914: # ---------------------------------------------------------------\r\n915: PIT_S0, PIT_S1 = 60.0, 420.0\r\n916: _p, _h, _r, _k = at_s((PIT_S0 + PIT_S1) / 2)\r\n917: _pit_fwd = Vector((cos(_h), sin(_h), 0.0))\r\n918: _pit_out = Vector((- _r.x, - _r.y, 0.0))      # 内侧（-right），与 Stand_Main 错开\r\n919: PIT_WALL = -(HALF_W + 3.0)                     # -10 m 处维修墙\r\n920: PIT_LANE = -(HALF_W + 3.0 + 9.0)               # -19 m 处车道内边\r\n921: PIT_FACE = -(HALF_W + 3.0 + 12.0)              # -22 m 处车库楼正面\r\n922: PIT_BACK = -(HALF_W + 3.0 + 26.0)              # -36 m 楼背\r\n923: GAR_H = 8.0\r\n924: PIT_LEN = PIT_S1 - PIT_S0\r\n925: \r\n926: \r\n927: def strip_uv(s0, s1, off_a, off_b, z, mat, name, u_repeat, v_repeat=1.0, step=2.0, up=True):\r\n928:     \"\"\"局部带状（非闭环），u 沿弧长 / v 沿横向\"\"\"\r\n929:     v, fc, uv = [], [], []\r\n930:     ss, s = [], s0\r\n931:     while s <= s1 + 1e-6:\r\n932:         ss.append(s)\r\n933:         s += step\r\n934:     if ss[-1] < s1:\r\n935:         ss.append(s1)\r\n936:     for s in ss:\r\n937:         p, h, r, k = at_s(s)\r\n938:         for (o, vv) in ((off_a, 0.0), (off_b, 1.0)):\r\n939:             v.append((p.x + r.x * o, p.y + r.y * o, z))\r\n940:             uv.append(((s - s0) / u_repeat, vv * v_repeat))\r\n941:     for j in range(len(ss) - 1):\r\n942:         a = j * 2\r\n943:         fc.append((a, a + 1, a + 3, a + 2))\r\n944:     return mesh_from(name, v, fc, mat, uvs=uv, up=up)\r\n945: \r\n946: \r\n947: def wall_uv(s0, s1, off, z0, z1, mat, name, u_repeat, v_repeat=1.0, step=2.0):\r\n948:     \"\"\"局部竖直墙（garage 正面 / 维修墙），u 沿弧长 / v 沿高度\"\"\"\r\n949:     v, fc, uv = [], [], []\r\n950:     ss, s = [], s0\r\n951:     while s <= s1 + 1e-6:\r\n952:         ss.append(s)\r\n953:         s += step\r\n954:     if ss[-1] < s1:\r\n955:         ss.append(s1)\r\n956:     for s in ss:\r\n957:         p, h, r, k = at_s(s)\r\n958:         px, py = p.x + r.x * off, p.y + r.y * off\r\n959:         v.append((px, py, z0))\r\n960:         v.append((px, py, z1))\r\n961:         uv.append(((s - s0) / u_repeat, 0.0))\r\n962:         uv.append(((s - s0) / u_repeat, v_repeat))\r\n963:     for j in range(len(ss) - 1):\r\n964:         a = j * 2\r\n965:         fc.append((a, a + 1, a + 3, a + 2))\r\n966:     return mesh_from(name, v, fc, mat, uvs=uv, up=False)\r\n967: \r\n968: \r\n969: # ① pit lane 沥青车道（覆盖掉草地缓冲带）\r\n970: strip_uv(PIT_S0, PIT_S1, PIT_WALL, PIT_LANE, 0.010, M_ASPHALT, \"V5_PitLane\", PIT_LEN)\r\n971: # ② pit lane 两条白线\r\n972: strip_uv(PIT_S0, PIT_S1, PIT_WALL - 0.25, PIT_WALL - 0.02, 0.014, M_WHITE, \"V5_PitLineIn\", PIT_LEN)\r\n973: strip_uv(PIT_S0, PIT_S1, PIT_LANE + 0.02, PIT_LANE + 0.25, 0.014, M_WHITE, \"V5_PitLineOut\", PIT_LEN)\r\n974: # ③ 维修墙（分段矮墙）+ 顶部队名灯牌\r\n975: wall_uv(PIT_S0, PIT_S1, PIT_WALL, 0.0, 1.10, M_CONC, \"V5_PitWall\", PIT_LEN)\r\n976: strip_uv(PIT_S0, PIT_S1, PIT_WALL - 0.08, PIT_WALL + 0.08, 1.12, M_STRIP, \"V5_PitWallStrip\", PIT_LEN)\r\n977: # ④ pit box 划线：每 6 m 一条横向白线（garage 分格）-> 全部在一个网格 V5_PitBoxLines\r\n978: _bk = 0\r\n979: _s = PIT_S0 + 3.0\r\n980: _pbl = Parts(\"V5_PitBoxLines\")\r\n981: while _s < PIT_S1 - 1.0:\r\n982:     p, h, r, k = at_s(_s)\r\n983:     fwd = Vector((cos(h), sin(h), 0.0))\r\n984:     v = []\r\n985:     for (o, sd) in ((PIT_WALL, -1), (PIT_WALL, 1), (PIT_LANE, 1), (PIT_LANE, -1)):\r\n986:         c = p + r * o + fwd * sd * 0.06\r\n987:         v.append((c.x, c.y, 0.015))\r\n988:     _pbl.poly(v, [(0, 1, 2, 3)], M_WHITE)\r\n989:     _bk += 1\r\n990:     _s += 6.0\r\n991: _pbl.build(up=True)\r\n992: print(\"pit box lines:\", _bk)\r\n993: # ⑤ garage 楼体（混凝土）+ 正面贴图面板\r\n994: _c = _p + _pit_out * ((abs(PIT_FACE) + abs(PIT_BACK)) / 2)\r\n995: _dep = abs(PIT_BACK - PIT_FACE)\r\n996: box(\"V5_PitGarage\", (_c.x, _c.y, GAR_H / 2), (PIT_LEN, _dep, GAR_H), M_CONC, rot_z=_h)\r\n997: wall_uv(PIT_S0, PIT_S1, PIT_FACE, 0.0, GAR_H, M_GARAGE, \"V5_PitGarageFront\", PIT_LEN, v_repeat=GAR_H / 4.0)\r\n998: # ⑥ garage 楼顶赞助灯箱（发光）\r\n999: strip_uv(PIT_S0, PIT_S1, PIT_FACE + 1.0, PIT_BACK - 1.0, GAR_H + 0.05, M_AD, \"V5_PitRoofBanner\", PIT_LEN, up=True)\r\n1000: # ⑦ garage 楼顶主看台（4 排小阶梯，用人群贴图）\r\n1001: for _rr in range(4):\r\n1002:     _o0 = PIT_BACK - 1.5 + _rr * 1.2\r\n1003:     _o1 = _o0 + 1.2\r\n1004:     _z = GAR_H + 0.06 + _rr * 0.55\r\n1005:     strip_uv(PIT_S0, PIT_S1, _o0, _o1, _z, M_CROWD, f\"V5_PitTopTier_{_rr}\", PIT_LEN, up=True)\r\n1006: # 楼顶围栏（发光细条）\r\n1007: strip_uv(PIT_S0, PIT_S1, PIT_BACK + 0.3, PIT_BACK + 0.5, GAR_H + 2.4, M_STRIP, \"V5_PitTopRail\", PIT_LEN)\r\n1008: \r\n1009: # ---------------------------------------------------------------\r\n1010: # 11b. 赛道道具：广告板 / 刹车牌 / 大屏 / 天桥 / 裁判点\r\n1011: # ---------------------------------------------------------------\r\n1012: def ad_board(s, side, w=11.0, hgt=3.6, off=WALL_OFF + 2.5, name=\"\"):\r\n1013:     p, h, r, k = at_s(s)\r\n1014:     base = p + r * (side * off)\r\n1015:     box(name, (base.x, base.y, 1.0 + hgt / 2), (w, 0.12, hgt), M_AD, rot_z=h)\r\n1016: \r\n1017: \r\n1018: def brake_board(s, side, num, poles, off=HALF_W + 2.4, name=\"\"):\r\n1019:     \"\"\"一块刹车牌；两根细杆加进 poles (Parts，整组共用一个网格)。返回 (牌子对象, 底部中心, 航向)\"\"\"\r\n1020:     p, h, r, k = at_s(s)\r\n1021:     base = p + r * (side * off)\r\n1022:     ob = box(name, (base.x, base.y, 1.05), (1.0, 0.08, 1.25), M_BRAKE[num], rot_z=h)\r\n1023:     # 两根细杆：沿切线 ±0.32 m（牌子宽 1.0 m 沿切线）\r\n1024:     tx, ty = cos(h), sin(h)\r\n1025:     for d in (-0.32, 0.32):\r\n1026:         poles.box((base.x + tx * d, base.y + ty * d, 0.5), (0.05, 0.05, 1.0), M_STEEL, rot_z=h)\r\n1027:     return ob, base, h\r\n1028: \r\n1029: \r\n1030: def bigscreen(s, side, off=WALL_OFF + 8.0, w=22.0, hgt=9.0, name=\"V5_Screen\"):\r\n1031:     \"\"\"组件 Empty(name) + _Panel 屏幕 + _Legs 两条腿（一个网格）\"\"\"\r\n1032:     p, h, r, k = at_s(s)\r\n1033:     base = p + r * (side * off)\r\n1034:     panel = box(name + \"_Panel\", (base.x, base.y, 5.5), (w, 0.45, hgt), M_SCREEN, rot_z=h)\r\n1035:     legs = Parts(name + \"_Legs\")\r\n1036:     for dx in (-w / 2 + 0.5, w / 2 - 0.5):\r\n1037:         legs.box((base.x + cos(h) * dx, base.y + sin(h) * dx, 2.0), (0.5, 0.5, 4.0), M_STEEL, rot_z=h)\r\n1038:     assembly(name, (base.x, base.y, 0.0), h, [panel, legs.build()], size=5.0)\r\n1039: \r\n1040: \r\n1041: def footbridge(s, name=\"V5_Bridge\"):\r\n1042:     \"\"\"组件 Empty(name) + _Deck 桥面 + _Piers 两座桥墩（一个网格）+ _Rails 两条发光栏杆（一个网格）\"\"\"\r\n1043:     p, h, r, k = at_s(s)\r\n1044:     fwd = Vector((cos(h), sin(h), 0.0))\r\n1045:     off = HALF_W + 7.0\r\n1046:     # 桥面：横跨赛道，宽（沿 fwd）4.5 m，高 6.0 m\r\n1047:     a = p - r * off - fwd * 2.25\r\n1048:     b = p + r * off - fwd * 2.25\r\n1049:     c = p + r * off + fwd * 2.25\r\n1050:     d = p - r * off + fwd * 2.25\r\n1051:     v = [(a.x, a.y, 6.0), (b.x, b.y, 6.0), (c.x, c.y, 6.0), (d.x, d.y, 6.0),\r\n1052:          (a.x, a.y, 5.4), (b.x, b.y, 5.4), (c.x, c.y, 5.4), (d.x, d.y, 5.4)]\r\n1053:     fc = [(0, 1, 2, 3), (4, 5, 6, 7), (0, 4, 5, 1), (1, 5, 6, 2),\r\n1054:           (2, 6, 7, 3), (3, 7, 4, 0)]\r\n1055:     deck = mesh_from(name + \"_Deck\", v, fc, M_STEEL, up=False)\r\n1056:     # 桥墩\r\n1057:     piers = Parts(name + \"_Piers\")\r\n1058:     for sd in (-1, 1):\r\n1059:         bp = p + r * (sd * off)\r\n1060:         piers.box((bp.x, bp.y, 2.8), (0.6, 0.6, 5.6), M_CONC)\r\n1061:     # 栏杆（桥面两侧发光细条）\r\n1062:     rails = Parts(name + \"_Rails\")\r\n1063:     for sd in (-1, 1):\r\n1064:         rr = fwd * (2.25 * sd)\r\n1065:         mid = p + rr\r\n1066:         rails.box((mid.x, mid.y, 6.5), (0.1, off * 2, 0.1), M_STRIP, rot_z=h)\r\n1067:     assembly(name, (p.x, p.y, 0.0), h, [deck, piers.build(), rails.build()], size=5.0)\r\n1068: \r\n1069: \r\n1070: # ① 广告板：沿整圈每 60 m 一块（护栏外侧；跳过维修区主直道段，避免与车库楼/看台穿插）\r\n1071: _ad_i = 0\r\n1072: _s = 30.0\r\n1073: while _s < LAP_LEN - 5:\r\n1074:     side = 1 if _ad_i % 2 == 0 else -1\r\n1075:     if not (PIT_S0 - 10 < _s < PIT_S1 + 10):\r\n1076:         ad_board(_s, side, name=f\"V5_Ad_{_ad_i}\")\r\n1077:         _ad_i += 1\r\n1078:     _s += 60.0\r\n1079: print(\"ad boards:\", _ad_i)\r\n1080: \r\n1081: # ② 刹车距离牌：慢弯（vmin<130）外侧，弯前 150/100/50 m；每组一个 Empty V5_Brake_{i}\r\n1082: _bi = 0\r\n1083: for (a, b) in _runs:\r\n1084:     vmin = min(VEL[a:b + 1]) * 3.6\r\n1085:     if vmin < 130 and (b - a) > 15 and _bi < 3:\r\n1086:         apex_s = (S[a] + S[b]) / 2\r\n1087:         side = 1 if SIGNED_K[a] > 0 else -1\r\n1088:         _poles = Parts(f\"V5_Brake_{_bi}_Poles\")\r\n1089:         _boards, _bases, _hs = [], [], []\r\n1090:         for dist_, num in ((150, \"150\"), (100, \"100\"), (50, \"50\")):\r\n1091:             _ob, _bs, _hh = brake_board(apex_s - dist_, side, num, _poles, name=f\"V5_Brake_{_bi}_{num}\")\r\n1092:             _boards.append(_ob)\r\n1093:             _bases.append(_bs)\r\n1094:             _hs.append(_hh)\r\n1095:         _ctr = Vector(((min(b.x for b in _bases) + max(b.x for b in _bases)) / 2,\r\n1096:                        (min(b.y for b in _bases) + max(b.y for b in _bases)) / 2, 0.0))\r\n1097:         assembly(f\"V5_Brake_{_bi}\", (_ctr.x, _ctr.y, 0.0), _hs[1], _boards + [_poles.build()], size=3.0)\r\n1098:         _bi += 1\r\n1099: print(\"brake boards:\", _bi * 3)\r\n1100: \r\n1101: # ③ 大屏：维修区出口内侧 + 赛道中段（避开车库楼遮挡）\r\n1102: bigscreen(560.0, -1, name=\"V5_Screen_A\")\r\n1103: bigscreen(2600.0, -1, name=\"V5_Screen_B\")\r\n1104: \r\n1105: # ④ 人行天桥：两条直道\r\n1106: footbridge(950.0, \"V5_Bridge_A\")\r\n1107: footbridge(2950.0, \"V5_Bridge_B\")\r\n1108: \r\n1109: # ⑤ 裁判点小棚（沿赛道每 ~830 m 一个）；每个一个 Empty V5_Marshal_{i}\r\n1110: for i in range(7):\r\n1111:     sp = LAP_LEN * i / 7.0\r\n1112:     p, h, r, k = at_s(sp)\r\n1113:     side = 1 if i % 2 == 0 else -1\r\n1114:     bp = p + r * (side * (HALF_W + 5.0))\r\n1115:     _hut = box(f\"V5_Marshal_{i}_Hut\", (bp.x, bp.y, 0.7), (1.6, 1.1, 1.4), M_CONC, rot_z=h)\r\n1116:     _lamp = box(f\"V5_Marshal_{i}_Lamp\", (bp.x, bp.y, 1.55), (0.25, 0.25, 0.12), M_STRIP, rot_z=h)\r\n1117:     assembly(f\"V5_Marshal_{i}\", (bp.x, bp.y, 0.0), h, [_hut, _lamp], size=2.0)\r\n1118: print(\"marshal posts:\", 7)\r\n1119: \r\n1120: \r\n1121: # ---------------------------------------------------------------\r\n1122: # 12. 场地外围：机库 / 树线 / 灯柱\r\n1123: # ---------------------------------------------------------------\r\n1124: random.seed(23)\r\n1125: for i in range(6):\r\n1126:     a = random.uniform(0, 2 * pi)\r\n1127:     rad = random.uniform(700, 1250)\r\n1128:     bx = _cx + cos(a) * rad\r\n1129:     by = _cy + sin(a) * rad\r\n1130:     w = random.uniform(40, 90)\r\n1131:     d = random.uniform(30, 60)\r\n1132:     hgt = random.uniform(9, 18)\r\n1133:     box(f\"V5_Hangar_{i}\", (bx, by, hgt / 2), (w, d, hgt), M_HANGAR, rot_z=random.uniform(0, pi))\r\n1134: \r\n1135: # 场地边界：低矮灌篱 + 围网（远景轮廓，不做树）\r\n1136: _tree_mat = new_mat(\"V5_Tree\", (0.016, 0.030, 0.013), 0.9)\r\n1137: _tv, _tf = [], []\r\n1138: _hedge_v = []\r\n1139: for i in range(240):\r\n1140:     a = 2 * pi * i / 240.0\r\n1141:     rad = 1150.0 + 220.0 * sin(a * 2.3 + 0.7) + 90.0 * sin(a * 5.1)\r\n1142:     bx = _cx + cos(a) * rad\r\n1143:     by = _cy + sin(a) * rad\r\n1144:     hgt = 2.4 + 1.6 * (0.5 + 0.5 * sin(a * 7.0))\r\n1145:     _hedge_v.append((bx, by, hgt))\r\n1146: for i in range(239):\r\n1147:     a = len(_tv)\r\n1148:     x0, y0, h0 = _hedge_v[i]\r\n1149:     x1, y1, h1 = _hedge_v[i + 1]\r\n1150:     _tv += [(x0, y0, 0), (x1, y1, 0), (x1, y1, h1), (x0, y0, h0)]\r\n1151:     _tf.append((a, a + 1, a + 2, a + 3))\r\n1152: mesh_from(\"V5_HedgeRing\", _tv, _tf, _tree_mat, up=False)\r\n1153: \r\n1154: # 场地灯柱（12 根，沿赛道每 480 m）\r\n1155: _lv, _lf = [], []\r\n1156: for i in range(12):\r\n1157:     sp = LAP_LEN * i / 12.0\r\n1158:     p, h, r, k = at_s(sp)\r\n1159:     side = 1 if i % 2 == 0 else -1\r\n1160:     o = side * (HALF_W + 42.0)\r\n1161:     px, py = p.x + r.x * o, p.y + r.y * o\r\n1162:     base = len(_lv)\r\n1163:     _lv += [(px - 0.12, py - 0.12, 0), (px + 0.12, py - 0.12, 0), (px + 0.12, py + 0.12, 0),\r\n1164:             (px - 0.12, py + 0.12, 0), (px - 0.12, py - 0.12, 16), (px + 0.12, py - 0.12, 16),\r\n1165:             (px + 0.12, py + 0.12, 16), (px - 0.12, py + 0.12, 16)]\r\n1166:     _lf += [(base + 0, base + 1, base + 5, base + 4), (base + 1, base + 2, base + 6, base + 5),\r\n1167:             (base + 2, base + 3, base + 7, base + 6), (base + 3, base + 0, base + 4, base + 7)]\r\n1168:     # 灯头\r\n1169:     hb = len(_lv)\r\n1170:     _lv += [(px - 0.9, py - 0.25, 15.6), (px + 0.9, py - 0.25, 15.6),\r\n1171:             (px + 0.9, py + 0.25, 15.6), (px - 0.9, py + 0.25, 15.6)]\r\n1172:     _lf += [(hb, hb + 1, hb + 2, hb + 3)]\r\n1173: mesh_from(\"V5_FieldMasts\", _lv, _lf, M_STEEL, up=False)\r\n1174: \r\n1175: print(\"ENV BUILD DONE\")\r\n1176: print(\"objects:\", len(bpy.data.objects), \"materials:\", len(bpy.data.materials))\r\n1177: \r\n1178: \r\n1179: # ---------------------------------------------------------------\r\n1180: # 13. 工程整理：原点归位 + 组件 Empty 父子 + 集合分组（让场景在 Blender 里能手工编辑）\r\n1181: # ---------------------------------------------------------------\r\n1182: _GROUPS = {\r\n1183:     \"V5_01_Road\": (\"V5_Track\", \"V5_RacingLine\", \"V5_Line_\", \"V5_Kerb_\",\r\n1184:                    \"V5_StartLine\", \"V5_PitLane\", \"V5_PitLine\", \"V5_PitBoxLine\"),\r\n1185:     \"V5_02_Terrain\": (\"V5_Ground\", \"V5_Verge_\", \"V5_Gravel_\", \"V5_HedgeRing\", \"V5_SkyDome\"),\r\n1186:     \"V5_03_Barriers\": (\"V5_Barrier\", \"V5_FencePosts\"),\r\n1187:     \"V5_04_Stands\": (\"V5_Stand_\",),\r\n1188:     \"V5_05_Pit\": (\"V5_PitWall\", \"V5_PitGarage\", \"V5_PitRoof\", \"V5_PitTop\"),\r\n1189:     \"V5_06_Props\": (\"V5_Ad_\", \"V5_Brake_\", \"V5_Screen_\", \"V5_Bridge_\",\r\n1190:                     \"V5_Marshal_\", \"V5_FieldMasts\", \"V5_Hangar_\",\r\n1191:                     \"V5_Gantry\", \"V5_StartLight\"),\r\n1192:     \"V5_07_Lighting\": (\"LGT_V5\",),\r\n1193: }\r\n1194: \r\n1195: # 13a. 原点归位：只处理\"网格烘焙在世界坐标里\"的对象（location/rotation 为 0、scale 为 1）。\r\n1196: #      box()/球体等本来就以自身中心为原点（location 已是世界位置），不动。\r\n1197: #      注意：新建对象在 depsgraph 更新前 matrix_world 是单位阵——旧版就是读了它，\r\n1198: #      把 441 个 box 对象的 location 改成了 (0,0,0)，全堆在世界原点。这里先 update，\r\n1199: #      并且只用 matrix_basis（不依赖 depsgraph）判断。\r\n1200: bpy.context.view_layer.update()\r"}
