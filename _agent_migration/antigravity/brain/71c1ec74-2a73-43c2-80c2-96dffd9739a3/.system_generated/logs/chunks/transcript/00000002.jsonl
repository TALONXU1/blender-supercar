     (2090, \"25_club\"),\n51:     (2145, \"26_aerial_out\"),\n52: ]\n53: \n54: \n55: def render_with_blender():\n56:     import bpy\n57:     sc = bpy.context.scene\n58:     if not b\n<truncated 3563 bytes>\nmage.Resampling.LANCZOS)\n144:         x = (i % cols) * tw\n145:         y = header_h + (i // cols) * (th + bar_h)\n146:         sheet.paste(im, (x, y))\n147:         # Subtle cell border\n148:         d.rectangle([x, y, x + tw - 1, y + th + bar_h - 1], outline=(32, 35, 42), width=1)\n149:         cam_tag = meta_map.get(name, \"\")\n150:         label = f\"{name} (f{f})\" + (f\"  [{cam_tag}]\" if cam_tag else \"\")\n151:         d.text((x + 7, y + th + 4), label, fill=(205, 212, 222), font=font)\n152: \n153:     out = os.path.join(OUT, \"contact_sheet.jpg\")\n154:     sheet.save(out, quality=94, subsampling=0)\n155:     print(\"contact sheet:\", out, sheet.size)\n156: \n157: \n158: if DO_RENDER:\n159:     render_with_blender()\n160:     # Build contact sheet via PIL if available here, else invoke system Python cleanly\n161:     try:\n162:         import PIL  # noqa: F401\n163:         made = [(f, name, os.path.join(OUT, f\"shot_{name}.jpg\"))\n164:                 for f, name in SHOTS if os.path.exists(os.path.join(OUT, f\"shot_{name}.jpg\"))]\n165:         build_contact_sheet_pil(made)\n166:     except ImportError:\n167:         env = os.environ.copy()\n168:         env.pop(\"PYTHONHOME\", None)\n169:         env.pop(\"PYTHONPATH\", None)\n170:         res = subprocess.run([\"python\", os.path.abspath(__file__), \"--sheet-only\"], env=env, check=False)\n171:         if res.returncode != 0:\n172:             raise RuntimeError(f\"contact_sheet build failed with code {res.returncode}\")\n173: else:\n174:     made = []\n175:     for f, name in SHOTS:\n176:         dst = os.path.join(OUT, \"shot_%s.jpg\" % name)\n177:         if not SHEET_ONLY:\n178:             src = os.path.join(FR, \"f_%04d.jpg\" % f)\n179:             if os.path.exists(src):\n180:                 shutil.copyfile(src, dst)\n181:             elif not os.path.exists(dst):\n182:                 print(\"MISS\", f)\n183:                 continue\n184:         if os.path.exists(dst):\n185:             made.append((f, name, dst))\n186:     print(\"stills:\", len(made))\n187:     if made:\n188:         build_contact_sheet_pil(made)","truncated_fields":["content"]}
{"step_index":97,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-18T06:23:37Z","content":"Created At: 2026-11-18T14:23:37+08:00\nCompleted At: 2026-11-18T14:23:38+08:00\nShowing lines 1-223 of 223\n1: # -*- coding: utf-8 -*-\n2: \"\"\"\n3: V5 白模（clay）版本：把所有材质替换成统一灰模，保留光影、景深（DOF）、运动模糊与组件层级。\n4: 输入: LATEST/v5_stage_anim.blend\n5: 输出: LATEST/v5_stage_anim_clay.blend（原文件不动）\n6: \n7: 用法:\n8:   blender -b -P pipeline/v5_clay.py\n9:   blender -b -P pipeline/v5_clay.py -- --render-stills\n10: \"\"\"\n11: import bpy\n12: import os\n13: import sys\n14: \n15: PROJ = r\"D:\\项目session\\blender-supercar\"\n16: ARGV = sys.argv[sys.argv.index(\"--\") + 1:] if \"--\" in sys.argv else []\n17: \n18: \n19: def argval(flag, default=None):\n20:     if flag in ARGV:\n21:         i = ARGV.index(flag)\n22:         if i + 1 < len(ARGV) and not ARGV[i + 1].startswith(\"--\"):\n23:             return ARGV[i + 1]\n24:         return True\n25:     return default\n26: \n27: \n28: SRC = argval(\"--in\", os.path.join(PROJ, \"LATEST\", \"v5_stage_anim.blend\"))\n29: DST = argval(\"--out\", os.path.join(PROJ, \"LATEST\", \"v5_stage_anim_clay.blend\"))\n30: CLAY_STILLS_DIR = os.path.join(PROJ, \"renders_v5\", \"clay_stills\")\n31: \n32: bpy.ops.wm.open_mainfile(filepath=SRC)\n33: scene = bpy.context.scene\n34: rig = bpy.data.objects.get(\"RIG_F1_Race\")\n35: \n36: \n37: def iter_fcurves(action):\n38:     fcs = list(getattr(action, \"fcurves\", []) or [])\n39:     if fcs:\n40:         return fcs\n41:     for layer in getattr(action, \"layers\", []) or []:\n42:         for strip in getattr(layer, \"strips\", []) or []:\n43:             for cb in getattr(strip, \"channelbags\", []) or []:\n44:                 fcs.extend(cb.fcurves)\n45:     return fcs\n46: \n47: \n48: def clay(name, value, rough=0.62, spec=0.08):\n49:     m = bpy.data.materials.get(name) or bpy.data.materials.new(name)\n50:     m.use_nodes = True\n51:     nt = m.node_tree\n52:     nt.nodes.clear()\n53:     b = nt.nodes.new(\"ShaderNodeBsdfPrincipled\")\n54:     b.inputs['Base Color'].default_value = (value, value, value, 1.0)\n55:     b.inputs['Roughness'].default\n<truncated 5063 bytes>\n173:     for fc in iter_fcurves(scene.animation_data.action):\n174:         if fc.data_path == \"view_settings.exposure\":\n175:             for kp in fc.keyframe_points:\n176:                 if kp.co.x >= scene.frame_end - 1:\n177:                     kp.co.y = CLAY_FADE_EXP\n178:                 else:\n179:                     kp.co.y = CLAY_EXP\n180:                 kp.interpolation = 'LINEAR'\n181:             fc.update()\n182: \n183: print(\"clay: car geom=%d env geom=%d (DOF & motion blur preserved)\" % (n_car, n_env))\n184: \n185: bpy.ops.wm.save_as_mainfile(filepath=DST)\n186: print(\"CLAY SAVED:\", DST)\n187: \n188: # 可选：直接渲染 6 张代表性 1080p 白模测试剧照（~12 s）\n189: if argval(\"--render-stills\"):\n190:     os.makedirs(CLAY_STILLS_DIR, exist_ok=True)\n191:     markers = sorted(scene.timeline_markers, key=lambda m: m.frame)\n192: \n193:     def _active_cam(frame):\n194:         cur = scene.camera\n195:         for mk in markers:\n196:             if mk.frame <= frame and mk.camera:\n197:                 cur = mk.camera\n198:         return cur\n199: \n200:     orig_cam = scene.camera\n201:     scene.render.resolution_x = 1920\n202:     scene.render.resolution_y = 1080\n203:     scene.render.resolution_percentage = 100\n204:     scene.eevee.taa_render_samples = 20\n205:     scene.render.image_settings.file_format = 'JPEG'\n206:     scene.render.image_settings.quality = 94\n207: \n208:     CLAY_TEST_SHOTS = [\n209:         (60, \"01_rear_chase\"),\n210:         (160, \"02_onboard_cockpit\"),\n211:         (350, \"04_hairpin_dof\"),\n212:         (760, \"09_wheel_macro\"),\n213:         (1120, \"13_woodcote_tele\"),\n214:         (1730, \"20_stowe_tele\"),\n215:     ]\n216:     for f, tag in CLAY_TEST_SHOTS:\n217:         scene.camera = _active_cam(f)\n218:         scene.frame_set(f)\n219:         out_path = os.path.join(CLAY_STILLS_DIR, f\"clay_test_{tag}_f{f:04d}.jpg\")\n220:         scene.render.filepath = out_path\n221:         bpy.ops.render.render(write_still=True)\n222:         print(\"CLAY STILL:\", out_path)\n223:     scene.camera = orig_cam","truncated_fields":["content"]}
