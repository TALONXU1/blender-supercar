\\\"--\\\") + 1:] if \\\"--\\\" in sys.argv else sys.argv[1:]\\nDO_RENDER = \\\"--render\\\" in ARGV\\nSHEET_ONLY = \\\"--sheet-only\\\" in ARGV\\n\\nSHOTS = [\\n    (60, \\\"01_rear_chase\\\"),\\n    (160, \\\"02_onboard\\\"),\\n    (250, \\\"03_chase_rise\\\"),\\n    (350, \\\"04_hairpin\\\"),\\n    (440, \\\"05_chase_aintree\\\"),\\n    (520, \\\"06_orbit1\\\"),\\n    (600, \\\"07_chase_accel\\\"),\\n    (700, \\\"08_fast_pan\\\"),\\n    (760, \\\"09_wheel_macro\\\"),\\n    (820, \\\"10_chase_fast\\\"),\\n    (870, \\\"11_orbit_brooklands\\\"),\\n    (950, \\\"12_luffield\\\"),\\n    (1040, \\\"13_chase_woodcote\\\"),\\n    (1120, \\\"14_woodcote_tele\\\"),\\n    (1200, \\\"15_heli_drop\\\"),\\n    (1300, \\\"16_orbit_copse\\\"),\\n    (1380, \\\"17_chase_copse\\\"),\\n    (1470, \\\"18_maggotts\\\"),\\n    (1560, \\\"19_chase_rise2\\\"),\\n    (1640, \\\"20_onboard3\\\"),\\n    (1730, \\\"21_stowe_tele\\\"),\\n    (1830, \\\"22_orbit_stowe\\\"),\\n    (1920, \\\"23_chase_low\\\"),\\n    (2010, \\\"24_heli_reveal\\\"),\\n    (2090, \\\"25_club\\\"),\\n    (2145, \\\"26_aerial_out\\\"),\\n]\\n\\n\\ndef act_info(frame):\\n    if frame <= 788:\\n        return \\\"E-1610\\\", (235, 42, 78)     # Miles Crimson\\n    elif frame <= 1601:\\n        return \\\"E-65\\\", (36, 214, 198)      # Gwen Teal-Aqua\\n    return \\\"E-\n<truncated 13929 bytes>","Overwrite":"true","Path":"\"d:\\\\项目session\\\\blender-supercar\\\\pipeline\\\\v6_sv_stills.py\""}}],"truncated_fields":["tool_calls"]}
