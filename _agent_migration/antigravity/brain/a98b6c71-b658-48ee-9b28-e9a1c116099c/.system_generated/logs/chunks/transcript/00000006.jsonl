{"step_index":307,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-18T08:38:26Z","content":"Created At: 2026-11-18T16:38:26+08:00\nCompleted At: 2026-11-18T16:38:27+08:00\nShowing lines 1-47 of 47\n1: # -*- coding: utf-8 -*-\n2: import os, sys, glob\n3: import numpy as np\n4: from PIL import Image\n5: \n6: def audit_sv_image(path):\n7:     im = Image.open(path).convert(\"RGB\")\n8:     w, h = im.size\n9:     arr = np.asarray(im, dtype=np.float32)\n10:     r, g, b = arr[..., 0], arr[..., 1], arr[..., 2]\n11:     lum = 0.2126 * r + 0.7152 * g + 0.0722 * b\n12:     mx = arr.max(axis=-1)\n13:     mn = arr.min(axis=-1)\n14:     sat = np.where(mx > 5.0, (mx - mn) / np.maximum(mx, 1.0), 0.0)\n15: \n16:     mean_l = float(lum.mean())\n17:     p05, p50, p95 = [float(x) for x in np.percentile(lum, [5, 50, 95])]\n18:     clip_pct = float((mx >= 253.0).mean() * 100.0)\n19:     mean_sat = float(sat.mean() * 100.0)\n20: \n21:     # Sharpness: center car ROI vs upper background ROI\n22:     gy, gx = np.gradient(lum)\n23:     edge = np.hypot(gx, gy)\n24:     car_sharp = float(edge[int(h * 0.36):int(h * 0.82), int(w * 0.26):int(w * 0.74)].mean())\n25:     bg_sharp = float(edge[int(h * 0.12):int(h * 0.36), int(w * 0.08):int(w * 0.92)].mean())\n26: \n27:     # CMYK Red-Cyan misregistration fringe in upper/outer background edges\n28:     bg_rb_diff = float(np.abs(r[:int(h * 0.40), :] - b[:int(h * 0.40), :]).mean())\n29: \n30:     # Impact tri-tone percentages (white / crimson / black)\n31:     white_pct = float(((r > 225) & (g > 220) & (b > 210)).mean() * 100.0)\n32:     crimson_pct = float(((r > 180) & (g < 65) & (b < 95)).mean() * 100.0)\n33:     black_pct = float((mx < 22).mean() * 100.0)\n34: \n35:     print(f\"{os.path.basename(path):30s} {w}x{h} MeanL={mean_l:5.1f} P05/50/95={p05:4.1f}/{p50:5.1f}/{p95:5.1f} \"\n36:           f\"Sat={mean_sat:4.1f}% Clip={clip_pct:4.2f}% Sharp(car/bg)={car_sharp:4.2f}/{bg_sharp:4.2f} \"\n37:           f\"BgRBDiff={bg_rb_diff:4.1f} Tri(W/Crim/Blk)={white_pct:4.1f}/{crimson_pct:4.1f}/{black_pct:4.1f}%\")\n38: \n39: if __name__ == \"__main__\":\n40:     files = []\n41:     for pat in sys.argv[1:]:\n42:         if os.path.isdir(pat):\n43:             files.extend(sorted(glob.glob(os.path.join(pat, \"*.jpg\"))))\n44:         else:\n45:             files.extend(sorted(glob.glob(pat)))\n46:     for f in files:\n47:         audit_sv_image(f)"}
