{"step_index":404,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-18T08:55:50Z","content":"Created At: 2026-11-18T16:55:50+08:00\nCompleted At: 2026-11-18T16:55:51+08:00\nShowing lines 360-440 of 1057\n360:     cam_focus = bpy.data.objects.new(\"V5_CamFocus\", None)\n361:     cam_focus.empty_display_type = 'PLAIN_AXES'\n362:     cam_focus.empty_display_size = 0.6\n363:     _cam_coll.objects.link(cam_focus)\n364: \n365: # ---------------------------------------------------------------\n366: # 3. 逐帧烘焙（物理姿态 + 热力学刹车盘 + 6Hz 雨灯 + 换挡灯 + 焦点追踪）\n367: # ---------------------------------------------------------------\n368: cum_spin = 0.0\n369: prev_dist = 0.0\n370: prev_gear = frame_data[1]['gear']\n371: shift_flash = 0.0\n372: brake_heat_state = 0.0\n373: \n374: print(\"BAKE START: %d frames, dt=%.5f s, lap=%.2f s\" % (FRAME_END, DT, LAP_S))\n375: for f in range(1, FRAME_END + 1):\n376:     fd = frame_data[f]\n377:     v, acc, lat, k = fd['v'], fd['accel'], fd['lat'], fd['k']\n378:     v_kmh = v * 3.6\n379: \n380:     # --- 位置 / 偏航（硬规则 1,2,3 + Bone_Root.z = 0.012）---\n381:     yaw = fd['heading'] - pi / 2\n382:     bone_root.location = (fd['pos'].x, fd['pos'].y, 0.012)\n383:     bone_heading.rotation_euler = (0.0, 0.0, yaw)\n384:     bone_root.keyframe_insert(\"location\", frame=f)\n385:     bone_heading.keyframe_insert(\"rotation_euler\", frame=f)\n386: \n387:     # --- 景深焦点 Empty 同步锁定 Bone_Root + 0.45m Z ---\n388:     cam_focus.location = (fd['pos'].x, fd['pos'].y, 0.012 + 0.45)\n389:     cam_focus.keyframe_insert(\"location\", frame=f)\n390: \n391:     # --- 车身姿态：俯仰 / 有符号侧倾 / 升沉 ---\n392:     gear = fd['gear']\n393:     if gear != prev_gear:\n394:         shift_flash = 1.0\n395:         prev_gear = gear\n396:     else:\n397:         shift_flash *= 0.72\n398: \n399:     pitch = max(-1.9, min(1.4, acc * 0.085)) - 0.16 * shift_flash\n400:     roll = max(-2.2, min(2.2, -fd['lat_signed'] * 0.26))\n401:     heave = -0.006 + 0.0016 * sin(f * 1.31) + 0.0009 * sin(f * 2.77)\n402:     fd['body_pitch_deg'] = pitch\n403:     fd['body_roll_deg'] = roll\n404:     fd['body_heave'] = heave\n405: \n406:     bone_body.location = (0.0, 0.0, heave)\n407:     bone_body.rotation_euler = (radians(pitch), radians(roll), 0.0)\n408:     bone_body.keyframe_insert(\"location\", frame=f)\n409:     bone_body.keyframe_insert(\"rotation_euler\", frame=f)\n410: \n411:     # --- 机械驱动 + 碳陶刹车盘热惯性模型 ---\n412:     cum_spin += (fd['dist'] - prev_dist) / R_TIRE\n413:     prev_dist = fd['dist']\n414:     rig[\"wheel_spin\"] = cum_spin\n415: \n416:     steer_deg = degrees(k * WHEELBASE)                   # 阿克曼转角\n417:     rig[\"steer\"] = max(-26.0, min(26.0, steer_deg))\n418: \n419:     straight = abs(k) < 0.0016\n420:     rig[\"drs\"] = 1.0 if (straight and v_kmh > 240) else (0.0 if abs(k) > 0.004 else 0.5)\n421: \n422:     # 重刹快速升温，松刹后按导风管对流时间常数（1.25..1.75 s）平滑退火至弯心与出弯\n423:     if acc < -1.8:\n424:         brake_pwr = ((-acc - 1.8) / 25.0) * (0.42 + 0.58 * min(1.0, v / 85.0))\n425:         brake_heat_state = min(1.25, brake_heat_state + brake_pwr * (DT / 0.13))\n426:     else:\n427:         tau_cool = 1.75 - 0.50 * min(1.0, v / 85.0)\n428:         brake_heat_state *= exp(-DT / tau_cool)\n429:         if brake_heat_state < 0.003:\n430:             brake_heat_state = 0.0\n431: \n432:     rig[\"brake_heat\"] = brake_heat_state\n433:     rig[\"rear_slip\"] = 1.0\n434:     rig[\"susp_f\"] = -0.004 - 0.014 * max(0.0, -acc) / 12.0\n435:     rig[\"susp_r\"] = -0.004 - 0.016 * max(0.0, acc) / 12.0\n436:     for kk in (\"wheel_spin\", \"steer\", \"drs\", \"brake_heat\", \"rear_slip\", \"susp_f\", \"susp_r\"):\n437:         rig.keyframe_insert(f'[\"{kk}\"]', frame=f)\n438: \n439:     # 刹车盘与卡钳红橙热辉光关键帧\n440:     bh = brake_heat_state"}
