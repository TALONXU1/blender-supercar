{"step_index":388,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-18T08:54:24Z","content":"Created At: 2026-11-18T16:54:24+08:00\nCompleted At: 2026-11-18T16:54:27+08:00\nShowing lines 940-1050 of 1636\n940: \n941:     # ① 起终点赛博龙门架 (s ~ 24m) + Neo-Monaco 赛博维修区车库长廊 (s = 36..228m, 右侧外立面)\n942:     f_sf = frame_at_s(24.0)\n943:     for sgn in (-1.0, 1.0):\n944:         c_leg = f_sf[\"pos\"] + f_sf[\"right\"] * (sgn * (BARRIER_OFF + 0.8)) + f_sf[\"up\"] * 4.2\n945:         arch_bm.add_oriented_box(c_leg, f_sf[\"fwd\"], f_sf[\"right\"], f_sf[\"up\"], 0.7, 0.7, 8.4, MAT_STEEL)\n946:     c_beam = f_sf[\"pos\"] + f_sf[\"up\"] * 8.2\n947:     arch_bm.add_oriented_box(c_beam, f_sf[\"right\"], f_sf[\"fwd\"], f_sf[\"up\"], (BARRIER_OFF + 1.2) * 2.0, 0.9, 1.2, MAT_STEEL)\n948:     arch_bm.add_oriented_box(c_beam - f_sf[\"fwd\"] * 0.52, f_sf[\"right\"], f_sf[\"fwd\"], f_sf[\"up\"], HALF_W * 2.0, 0.10, 0.95, MAT_AD)\n949: \n950:     for k_pit in range(6):\n951:         fp = frame_at_s(52.0 + k_pit * 30.0)\n952:         cp = fp[\"pos\"] + fp[\"right\"] * (BARRIER_OFF + 5.8) + fp[\"up\"] * 3.8\n953:         arch_bm.add_oriented_box(cp, fp[\"fwd\"], fp[\"right\"], fp[\"up\"], 28.5, 6.2, 7.6, MAT_GARAGE, uv_tile=(1.0, 1.0))\n954:         arch_bm.add_oriented_box(cp + fp[\"up\"] * 3.95 - fp[\"right\"] * 3.15, fp[\"fwd\"], fp[\"right\"], fp[\"up\"], 28.5, 0.22, 0.22, MAT_NEON_CYAN)\n955: \n956:     def _in_moon_sightline(bx, by):\n957:         dx = bx - _crest_f[\"pos\"].x\n958:         dy = by - _crest_f[\"pos\"].y\n959:         along = dx * _crest_fwd_xy.x + dy * _crest_fwd_xy.y\n960:         lat = abs(dx * _crest_rgt_xy.x + dy * _crest_rgt_xy.y)\n961:         return (-40.0 < along < 1750.0) and (lat < 165.0)\n962: \n963:     # ② 峡谷摩天楼群 & Eau-Rouge 爬坡天际线（紧贴护栏外 14..46m，高 55..225m，严格验证绝不侵入任何赛段与次元月走廊！）\n964:     placed_towers = []\n965:     for idx in range(0, N, 14):   # 每 28 m 沿线两侧尝试生成紧贴峡谷的摩天楼\n966:         fr = FRAMES[idx]\n967:         if fr[\"bridge\"]:\n968:             continue\n969:         for sgn in (-1.0, 1.0):\n970:             w = rng.uniform(18.0, 30.0)\n971:             d = rng.uniform(18.0, 30.0)\n972:             half_diag = 0.5 * hypot(w, d)\n973:             pit_pad = 9.5 if (sgn > 0 and 30.0 <= fr[\"s\"] <= 245.0) else 0.0\n974:             dist_out = BARRIER_OFF + half_diag + pit_pad + rng.uniform(4.5, 18.0)\n975:             bx = fr[\"pos\"].x + fr[\"right\"].x * (sgn * dist_out)\n976:             by = fr[\"pos\"].y + fr[\"right\"].y * (sgn * dist_out)\n977:             if _in_moon_sightline(bx, by):\n978:                 continue\n979:             # 安全净距检查：距全圈任意赛道中心线 XY >= BARRIER_OFF + half_diag + 3.0m，且不与已放塔楼重叠\n980:             if min_xy_dist_to_track(bx, by, step=2) < (BARRIER_OFF + half_diag + 3.0):\n981:                 continue\n982:             if any(hypot(bx - ox, by - oy) < (half_diag + odiag - 2.0) for ox, oy, odiag in placed_towers):\n983:                 continue\n984:             placed_towers.append((bx, by, half_diag))\n985: \n986:             hgt = rng.uniform(75.0, 225.0) if fr[\"zone\"] in (\"canyon_grid\", \"eau_rouge_climb\") else rng.uniform(55.0, 165.0)\n987:             base_z = -5.0\n988:             total_h = (fr[\"pos\"].z + hgt) - base_z\n989:             center_b = Vector((bx, by, base_z + total_h * 0.5))\n990:             ax_f = Vector((cos(fr[\"h\"]), sin(fr[\"h\"]), 0.0))\n991:             ax_r = Vector((sin(fr[\"h\"]), -cos(fr[\"h\"]), 0.0))\n992:             ax_u = Vector((0.0, 0.0, 1.0))\n993: \n994:             city_bm.add_oriented_box(center_b, ax_f, ax_r, ax_u, w, d, total_h, MAT_FACADE,\n995:                                      uv_tile=(max(1.0, round(w / 18.0)), max(1.0, round(total_h / 55.0))))\n996:             # 塔冠退台霓虹边框\n997:             crown_c = Vector((bx, by, base_z + total_h + 1.2))\n998:             n_mat = MAT_NEON_CYAN if (len(placed_towers) % 3 == 0) else (MAT_NEON_MAG if len(placed_towers) % 3 == 1 else MAT_NEON_GOLD)\n999:             city_bm.add_oriented_box(crown_c, ax_f, ax_r, ax_u, w * 0.92, d * 0.92, 0.65, n_mat)\n1000: \n1001:             # 面向赛道的巨幅竖向赛博漫画霓虹招牌\n1002:             sign_h = min(46.0, hgt * 0.52)\n1003:             sign_c = Vector((\n1004:                 bx - fr[\"right\"].x * (sgn * (d * 0.5 + 0.45)),\n1005:                 by - fr[\"right\"].y * (sgn * (d * 0.5 + 0.45)),\n1006:                 fr[\"pos\"].z + 8.0 + sign_h * 0.5,\n1007:             ))\n1008:             slot = len(placed_towers) % 4\n1009:             sign_bm.add_oriented_box(sign_c, ax_f, ax_r, ax_u, 4.4, 0.35, sign_h, MAT_SIGNS,\n1010:                                      uv_tile=(0.24, 0.96), uv_off=(slot * 0.25 + 0.005, 0.02))\n1011: \n1012:     # 外围远景天际线环（填满 360° 视野，同时留空次元巨月视线走廊！）\n1013:     for k_ring in range(44):\n1014:         ang = 2.0 * pi * k_ring / 44.0 + rng.uniform(-0.04, 0.04)\n1015:         rad = rng.uniform(520.0, 880.0)\n1016:         rx = _cx + cos(ang) * rad\n1017:         ry = _cy + sin(ang) * rad\n1018:         if _in_moon_sightline(rx, ry) or min_xy_dist_to_track(rx, ry, step=4) < 95.0:\n1019:             continue\n1020:         rw, rd = rng.uniform(36.0, 68.0), rng.uniform(36.0, 68.0)\n1021:         rh = rng.uniform(95.0, 260.0)\n1022:         ax_f = Vector((-sin(ang), cos(ang), 0.0))\n1023:         ax_r = Vector((cos(ang), sin(ang), 0.0))\n1024:         far_city_bm.add_oriented_box(Vector((rx, ry, -5.0 + rh * 0.5)), ax_f, ax_r, Vector((0, 0, 1)),\n1025:                                      rw, rd, rh, MAT_FACADE, uv_tile=(2.0, max(1.0, round(rh / 65.0))))\n1026: \n1027:     # 城市峡谷段跨街赛博过街天桥拱门（净高 8.8 m，绝不挡任何镜头）\n1028:     canyon_idxs = [i for i, f in enumerate(FRAMES) if f[\"zone\"] == \"canyon_grid\"]\n1029:     for step_a in canyon_idxs[::55][:3]:\n1030:         fa = FRAMES[step_a]\n1031:         for sgn in (-1.0, 1.0):\n1032:             pl = fa[\"pos\"] + fa[\"right\"] * (sgn * (BARRIER_OFF + 1.1)) + fa[\"up\"] * 4.6\n1033:             arch_bm.add_oriented_box(pl, fa[\"fwd\"], fa[\"right\"], fa[\"up\"], 1.8, 0.9, 9.2, MAT_CONCRETE)\n1034:         top_a = fa[\"pos\"] + fa[\"up\"] * 9.0\n1035:         arch_bm.add_oriented_box(top_a, fa[\"right\"], fa[\"fwd\"], fa[\"up\"], (BARRIER_OFF + 1.6) * 2.0, 2.2, 1.1, MAT_STEEL)\n1036:         arch_bm.add_oriented_box(top_a - fa[\"up\"] * 0.62, fa[\"right\"], fa[\"fwd\"], fa[\"up\"], HALF_W * 2.1, 0.25, 0.16, MAT_NEON_CYAN)\n1037: \n1038:     # ③ 跨海斜拉天空大桥 (sky_bridge)：双 115m 巨型 H 型索塔 + 发光青/金扇形斜拉索网 + 桥下钢箱梁桥墩\n1039:     bridge_idxs = [i for i, f in enumerate(FRAMES) if f[\"bridge\"] or f[\"zone\"] == \"sky_bridge\"]\n1040:     for idx in range(0, N, 20):\n1041:         fb = FRAMES[idx]\n1042:         if fb[\"pos\"].z > 6.5 and not fb[\"tunnel\"]:\n1043:             # 高架混凝土双柱桥墩直插海面 Z=-5m\n1044:             pier_top = fb[\"pos\"] - fb[\"up\"] * 1.1\n1045:             pier_h = pier_top.z - (-5.0)\n1046:             if pier_h > 2.0:\n1047:                 for sgn in (-1.0, 1.0):\n1048:                     pxy = pier_top + fb[\"right\"] * (sgn * 4.8)\n1049:                     brdg_bm.add_oriented_box(Vector((pxy.x, pxy.y, -5.0 + pier_h * 0.5)),\n1050:                                              Vector((cos(fb[\"h\"]), sin(fb[\"h\"]), 0.0)),"}
