1, _typ, _pr in _windows:\n893:     _cam_ob = _cams[_name]\n894:     for _f in range(_f0, _f1 + 1, 2):\n895:         scene.frame_set(_f)\n896:         _deps.update()\n897:         _ce = _cam_ob.evaluated_get(_deps)\n898:         _re = rig.evaluated_get(_deps)\n899:         _cpos = _ce.matrix_world.translation.copy()\n900:         _min_cam_z = min(_min_cam_z, _cpos.z)\n901:         if _typ == \"onboard\":\n902:             # 车载镜头验证视线前方 12m 无赛道外建筑/灌木穿模，且距方向盘 > clip_start (0.5m)\n903:             _pb_sw = _re.pose.bones.get(\"Bone_Steering_Wheel\")\n904:             if _pb_sw:\n905:                 _sw_pos = (_re.matrix_world @ _pb_sw.matrix).translation\n906:                 _sw_d = (_sw_pos - _cpos).length\n907:                 if _sw_d <= _ce.data.clip_start + 0.02:\n908:                     _occ_hits.append((_f, _name, f\"SteeringWheelNearClip({_sw_d:.2f}m)\"))\n909:             _fwd_dir = (-_ce.matrix_world.col[2].xyz).normalized()\n910:             _hit, _loc, _nrm, _idx, _hob, _ = scene.ray_cast(_deps, _cpos + _fwd_dir * 2.2, _fwd_dir, distance=12.0)\n911:             if _hit and _hob and _hob.name not in _car_names and not _hob.name.startswith((\"V5_Track\", \"V5_RacingLine\", \"V5_Line_\", \"V5_Kerb_\", \"V5_SkyDome\", \"V5_Ground\", \"V5_Verge\", \"V5_Skid\", \"V5_BrakeZone\")):\n912:                 _occ_hits.append((_f, _name, _hob.name))\n913:             continue\n914: \n915:         _tpos = (_re.matrix_world @ _re.pose.bones[\"Bone_Root\"].matrix).translation + Vector((0.0, 0.0, 0.48))\n916:         _vec = _tpos - _cpos\n917:         _dist = _vec.length\n918:         if _dist > 0.8:\n919:             _dir = _vec.normalized()\n920:             _cur = _cpos + _dir * 0.5\n921:             _rem = _dist - 1.1\n922:             while _rem > 0.05:\n923:                 _hit, _loc, _nrm, _idx, _hob, _ = scene.ray_cast(_deps, _cur, _dir, distance=_rem)\n924:                 if not _hit or _hob is None:\n925:                     break\n926:                 if _hob.name in _car_names or _hob.name == \"V5_SkyDome\":\n927:                     _step = (_loc - _cur).length + 0.05\n928:                     _cur = _loc + _dir * 0.05\n929:                     _rem -= _step\n930:                     continue\n931:                 _occ_hits.append((_f, _name, _hob.name))\n932:                 break\n933: \n934: scene.frame_set(1)\n935: _root_stranded = [o.name for o in scene.collection.objects]\n936: print(\"[check] camera occlusion: %d blocked frames (min_cam_z=%.2f m) -> %s\"\n937:       % (len(_occ_hits), _min_cam_z, \"PASS\" if (not _occ_hits and _min_cam_z >= 0.18) else str(_occ_hits[:8])))\n938: print(\"[check] root Scene Collection direct objects: %d -> %s\"\n939:       % (len(_root_stranded), \"PASS\" if not _root_stranded else str(_root_stranded)))\n940: \n941: # ---------------------------------------------------------------\n942: # 6. 渲染设置\n943: # ---------------------------------------------------------------\n944: scene.render.engine = 'BLENDER_EEVEE'\n945: scene.eevee.taa_render_samples = 32\n946: scene.eevee.use_raytracing = True\n947: try:\n948:     scene.eevee.ray_tracing_method = 'SCREEN'\n949: except Exception:\n950:     pass\n951: scene.render.resolution_x = 1920\n952: scene.render.resolution_y = 1080\n953: scene.render.resolution_percentage = 100\n954: scene.render.fps = FPS\n955: scene.frame_start = 1\n956: scene.frame_end = FRAME_END\n957: scene.render.use_motion_blur = True\n958: scene.render.motion_blur_shutter = 0.17\n959: scene.render.motion_blur_position = 'CENTER'\n960: scene.render.image_settings.file_format = 'JPEG'\n961: scene.render.image_settings.quality = 95\n962: scene.render.filepath = os.path.join(FRAMES_DIR, \"f_\")\n963: scene.view_settings.view_transform = 'AgX'\n964: for look in ('High Contrast', 'AgX - High Contrast', 'Medium High Contrast'):\n965:     try:\n966:         scene.view_settings.look = look\n967:         break\n968:     except Exception:\n969:         continue\n970: scene.view_settings.exposure = 0.50\n971: scene.view_settings.gamma = 1.0\n972: \n973: # 泛光\n974: try:\n975:     ng = bpy.data.node_groups.get(\"Comp_V5\") or bpy.data.node_groups.new(\"Comp_V5\", 'CompositorNodeTree')\n976:     ng.nodes.clear()\n977:     rl = ng.nodes.new(\"CompositorNodeRLayers\")\n978:     glare = ng.nodes.new(\"CompositorNodeGlare\")\n979:     for val in (\"Bloom\", \"BLOOM\", \"bloom\"):\n980:         try:\n981:             glare.inputs['Type'].default_value = val\n982:             break\n983:         except Exception:\n984:             continue\n985:     for nm, v in ((\"Threshold\", 2.0), (\"Strength\", 0.16), (\"Size\", 6)):\n986:         if nm in glare.inputs:\n987:             try:\n988:                 glare.inputs[nm].default_value = v\n989:             except Exception:\n990:                 pass\n991:     try:\n992:         comp = ng.nodes.new(\"CompositorNodeComposite\")\n993:     except Exception:\n994:         comp = ng.nodes.new(\"NodeGroupOutput\")\n995:         if not any(s.name == \"Image\" for s in ng.interface.items_tree):\n996:             ng.interface.new_socket(name=\"Image\", in_out='OUTPUT', socket_type='NodeSocketColor')\n997:     ng.links.new(rl.outputs['Image'], glare.inputs['Image'])\n998:     ng.links.new(glare.outputs['Image'], comp.inputs['Image'])\n999:     scene.compositing_node_group = ng\n1000:     scene.use_nodes = True\n1001:     print(\"COMPOSITOR OK\")\n1002: except Exception as e:\n1003:     print(\"COMPOSITOR FAILED:\", e)\n1004: \n1005: bpy.ops.wm.save_as_mainfile(filepath=OUT, remap_relative=False)\n1006: print(\"ANIM SAVED:\", OUT, flush=True)\n1007: \n1008: \n1009: # ---------------------------------------------------------------\n1010: # 7. 测试渲染（自动按时间轴标记切换对应机位）\n1011: # ---------------------------------------------------------------\n1012: def active_cam_at(frame):\n1013:     cur = scene.camera\n1014:     for name, f0 in _markers:\n1015:         if f0 <= frame:\n1016:             cur = _cams[name]\n1017:     return cur\n1018: \n1019: \n1020: def render_frames(frames, outdir, res=1600, samples=24):\n1021:     os.makedirs(outdir, exist_ok=True)\n1022:     orig_cam = scene.camera\n1023:     orig_rx, orig_ry = scene.render.resolution_x, scene.render.resolution_y\n1024:     orig_smp = scene.eevee.taa_render_samples\n1025:     scene.render.resolution_x = res\n1026:     scene.render.resolution_y = int(res * 9 / 16)\n1027:     scene.eevee.taa_render_samples = samples\n1028:     for f in frames:\n1029:         scene.camera = active_cam_at(f)\n1030:         scene.frame_set(f)\n1031:         scene.render.filepath = os.path.join(outdir, f\"test_{f:04d}.jpg\")\n1032:         bpy.ops.render.render(write_still=True)\n1033:         print(\"TEST FRAME\", f, \"CAM\", scene.camera.name)\n1034:     scene.camera = orig_cam\n1035:     scene.render.resolution_x, scene.render.resolution_y = orig_rx, orig_ry\n1036:     scene.eevee.taa_render_samples = orig_smp\n1037: \n1038: \n1039: test = argval(\"--test\")\n1040: if test:\n1041:     render_frames([int(x) for x in str(test).split(\",\")], os.path.join(PROJ, \"renders_v5\", \"test\"),\n1042:                   res=1600, samples=24)\n1043: \n1044: if argval(\"--render\"):\n1045:     os.makedirs(FRAMES_DIR, exist_ok=True)\n1046:     scene.render.resolution_x = 1920\n1047:     scene.render.resolution_y = 1080\n1048:     scene.render.filepath = os.path.join(FRAMES_DIR, \"f_\")\n1049:     bpy.ops.render.render(animation=True)\n1050:     print(\"RENDER DONE\")"}
