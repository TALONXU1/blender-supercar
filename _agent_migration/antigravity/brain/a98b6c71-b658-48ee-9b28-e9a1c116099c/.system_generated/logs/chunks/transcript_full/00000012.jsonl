mean_l:5.1f} P05/50/95={p05:4.1f}/{p50:5.1f}/{p95:5.1f} \"\n          f\"Sat={mean_sat:4.1f}% Clip={clip_pct:4.2f}% Sharp(car/bg)={car_sharp:4.2f}/{bg_sharp:4.2f} \"\n          f\"BgRB={bg_rb_diff:4.1f} Tri(W/Cr/Bk)={white_pct:4.1f}/{crimson_pct:4.1f}/{black_pct:4.1f}%\")\n\nif __name__ == \"__main__\":\n    files = []\n    for pat in sys.argv[1:]:\n        if os.path.isdir(pat):\n            files.extend(sorted(glob.glob(os.path.join(pat, \"*.jpg\"))))\n        else:\n            files.extend(sorted(glob.glob(pat)))\n    for f in files:\n        audit_sv_image(f)\n","Overwrite":true,"Path":"C:\\Users\\86052\\.gemini\\antigravity\\brain\\a98b6c71-b658-48ee-9b28-e9a1c116099c\\scratch\\verify_v6_sv_metrics.py"}},{"name":"swarm_wait","args":{"since":33}}]}
