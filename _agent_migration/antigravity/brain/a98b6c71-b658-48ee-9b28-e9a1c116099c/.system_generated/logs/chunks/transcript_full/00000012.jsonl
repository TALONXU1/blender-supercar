, s_pr in SHOTS:\n389:     f0 = beat_frame(b0)\n390:     f1 = beat_frame(b1)\n391:     windows.append([s_name, f0, f1, s_typ, s_pr])\n392: \n393: for i in range(len(windows)):\n394:     windows[i][1] = max(1, windows[i][1])\n395:     if i > 0 and windows[i][1] <= windows[i - 1][2]:\n396:         windows[i][1] = windows[i - 1][2] + 1\n397:     windows[i][2] = min(FRAME_END, max(windows[i][2], windows[i][1] + 2))\n398: windows[-1][2] = FRAME_END\n399: \n400: # 预计算每一帧相机世界位置/目标点/滚转角/焦距/光圈（同时导出给 @sfx 的 3D 多普勒引擎）\n401: cam_traj = {}\n402: manifest_shots = []\n403: \n404: for s_name, f0, f1, s_typ, pr in windows:\n405:     span = max(1, f1 - f0)\n406:     fixed_loc, fixed_up = (None, None)\n407:     if s_typ == \"fixed\":\n408:         fixed_loc, fixed_up = fixed_cl_pos(pr[\"s_cam\"], pr[\"cl_side\"], pr[\"h\"])\n409:     aim_prev = None\n410: \n411:     for f in range(f0, f1 + 1):\n412:         e = smooth01((f - f0) / span)\n413:         fd = frame_data[f]\n414:         v_fac = fd[\"v\"] / 90.0\n415:         kerb = fd[\"kerb_prox\"]\n416: \n417:         if s_typ == \"chase\":\n418:             back = pr[\"back0\"] + (pr[\"back1\"] - pr[\"back0\"]) * e\n419:             side = pr[\"side0\"] + (pr[\"side1\"] - pr[\"side0\"]) * e\n420:             up = pr[\"h0\"] + (pr[\"h1\"] - pr[\"h0\"]) * e\n421:             loc = safe_track_cam_pos(fd, back=back, rel_side=side, up=up, max_