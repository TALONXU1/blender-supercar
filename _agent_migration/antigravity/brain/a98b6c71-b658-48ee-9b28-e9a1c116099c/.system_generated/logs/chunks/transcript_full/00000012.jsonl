{"step_index":318,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-18T08:40:30Z","content":"Created At: 2026-11-18T16:40:30+08:00\nCompleted At: 2026-11-18T16:40:31+08:00\nShowing lines 170-620 of 1757\n170:         v=lerp1(VL_ARR),\n171:         tunnel=TUN_ARR[lo if u < 0.5 else lo + 1],\n172:         bridge=BRG_ARR[lo if u < 0.5 else lo + 1],\n173:         zone=ZN_ARR[lo],\n174:         T=T,\n175:         R=R,\n176:         U=U,\n177:     )\n178: \n179: \n180: def sample_at_s(s_query):\n181:     s_c = s_query % LAP_LEN\n182:     lo, hi = 0, N_PTS\n183:     while hi - lo > 1:\n184:         mid = (lo + hi) // 2\n185:         if S_ARR[mid] <= s_c:\n186:             lo = mid\n187:         else:\n188:             hi = mid\n189:     span = max(S_ARR[lo + 1] - S_ARR[lo], 1e-9)\n190:     u = (s_c - S_ARR[lo]) / span\n191:     t_q = T_ARR[lo] + (T_ARR[lo + 1] - T_ARR[lo]) * u\n192:     return sample_3d(t_q)\n193: \n194: \n195: # ---------------------------------------------------------------------------\n196: # 1. 预计算全部 1,281 帧三维运动学与遥测状态\n197: # ---------------------------------------------------------------------------\n198: GEAR_TOPS_KMH = [96.0, 134.0, 170.0, 204.0, 236.0, 267.0, 298.0, 348.0]\n199: \n200: \n201: def gear_and_rpm(v_kmh):\n202:     for gi, top in enumerate(GEAR_TOPS_KMH):\n203:         if v_kmh <= top or gi == 7:\n204:             low = 55.0 if gi == 0 else GEAR_TOPS_KMH[gi - 1] * 0.80\n205:             frac = max(0.0, min(1.0, (v_kmh - low) / max(top - low, 1.0)))\n206:             return gi + 1, frac\n207:     return 8, 1.0\n208: \n209: \n210: frame_data = {}\n211: cum_dist = 0.0\n212: prev_p = None\n213: for f in range(1, FRAME_END + 1):\n214:     fd = sample_3d((f - 1) * DT)\n215:     if prev_p is not None:\n216:         cum_dist += _v_len(_v_sub(fd[\"pos\"], prev_p))\n217:     prev_p = fd[\"pos\"]\n218:     fd[\"dist\"] = cum_dist\n219:     frame_data[f] = fd\n220: \n221: for f in range(1, FRAME_END + 1):\n222:     f0, f1 = max(1, f - 2), min(FRAME_END, f + 2)\n223:     dt_span = (f1 - f0) * DT\n224:     fd = frame_data[f]\n225:     fd[\"accel\"] = (frame_data[f1][\"v\"] - frame_data[f0][\"v\"]) / dt_span\n226:     fd[\"dpitch_dt\"] = (frame_data[f1][\"pitch_deg\"] - frame_data[f0][\"pitch_deg\"]) / dt_span\n227:     v, k, bk = fd[\"v\"], fd[\"k\"], fd[\"bank\"]\n228:     # 倾角抵消部分横向 G 力后的车体净横向 G（+左弯，-右弯）\n229:     net_lat_mps2 = v * v * k - 9.81 * sin(-bk)\n230:     fd[\"lat_signed\"] = net_lat_mps2 / 9.81\n231:     fd[\"lat\"] = abs(fd[\"lat_signed\"])\n232:     g, rf = gear_and_rpm(v * 3.6)\n233:     fd[\"gear\"] = g\n234:     fd[\"rpm_frac\"] = rf\n235:     fd[\"kerb_prox\"] = max(min(1.0, abs(k) / 0.010), min(1.0, max(0.0, abs(fd[\"off\"]) - 3.2) / 1.8))\n236: \n237: for f in range(1, FRAME_END + 1):\n238:     w0, w1 = max(1, f - 4), min(FRAME_END, f + 4)\n239:     frame_data[f][\"lat_smooth\"] = sum(frame_data[j][\"lat_signed\"] for j in range(w0, w1 + 1)) / (w1 - w0 + 1)\n240: \n241: \n242: # ---------------------------------------------------------------------------\n243: # 2. 24 个大片级超强冲击力机位（96 拍 = 1,281 帧，全部约束在 ±8.2m 护栏与封闭隧道内部！）\n244: # ---------------------------------------------------------------------------\n245: def beat_frame(b):\n246:     return max(1, min(FRAME_END, int(round(1.0 + b * BEAT_F))))\n247: \n248: \n249: def smooth01(u):\n250:     u = max(0.0, min(1.0, u))\n251:     return u * u * (3.0 - 2.0 * u)\n252: \n253: \n254: def micro_vib(f, seed, amp):\n255:     return (sin(f * 1.53 + seed) * 0.52\n256:             + sin(f * 3.17 + seed * 1.7) * 0.31\n257:             + sin(f * 5.83 + seed * 3.1) * 0.17) * amp\n258: \n259: \n260: def safe_track_cam_pos(fd, back=0.0, rel_side=0.0, up=0.5, max_cl=6.3):\n261:     \"\"\"在三维赛道局部标架中定位相机，并严格限制在中线 ±max_cl 米与隧道拱顶内，杜绝穿墙！\"\"\"\n262:     # P_race = C_pos - off * R => 赛车相对中线在 +R 方向的坐标为 -off\n263:     car_r = -fd[\"off\"]\n264:     in_tun = fd[\"tunnel\"] or (2622.0 <= fd[\"s\"] <= 3182.0)\n265:     lim_r = min(max_cl, 5.6) if in_tun else max_cl\n266:     cl_r = max(-lim_r, min(lim_r, car_r + rel_side))\n267:     safe_up = max(0.20, min(3.75, up) if in_tun else up)\n268:     base = _v_add(fd[\"c_pos\"], _v_mul(fd[\"R\"], cl_r))\n269:     base = _v_sub(base, _v_mul(fd[\"T\"], back))\n270:     base = _v_add(base, _v_mul(fd[\"U\"], safe_up))\n271:     return base\n272: \n273: \n274: def fixed_cl_pos(s_cam, cl_side, up):\n275:     fd_s = sample_at_s(s_cam)\n276:     in_tun = fd_s[\"tunnel\"] or (2622.0 <= fd_s[\"s\"] <= 3182.0)\n277:     lim_r = 5.6 if in_tun else 6.4\n278:     cl_r = max(-lim_r, min(lim_r, cl_side))\n279:     safe_up = max(0.22, min(3.75, up) if in_tun else up)\n280:     base = _v_add(fd_s[\"c_pos\"], _v_mul(fd_s[\"R\"], cl_r))\n281:     return _v_add(base, _v_mul(fd_s[\"U\"], safe_up)), fd_s[\"U\"]\n282: \n283: \n284: def lens_for_framing(dist, frac, cos_a=0.0, lo=16.0, hi=300.0):\n285:     w_eff = 2.2 + (4.7 - 2.2) * (1.0 - abs(cos_a))\n286:     return max(lo, min(hi, frac * 36.0 * max(dist, 1.2) / max(w_eff, 0.5)))\n287: \n288: \n289: SHOTS = [\n290:     # ==================== ACT I: EARTH-1610 MILES (Beats 0..32, f=1..427) ====================\n291:     # 1. FPV 摩天楼垂直俯冲直扑扩散器尾焰 (Canyon Start)\n292:     (\"Cam_S01_CanyonFPVDrop\", 0, 4, \"chase\",\n293:      dict(back0=13.5, back1=4.8, side0=-2.2, side1=0.6, h0=15.5, h1=0.44,\n294:           aim0=1.2, aim1=3.2, lens0=24, lens1=15, fstop=3.2, roll0=-15.0, roll1=3.5)),\n295:     # 2. 15mm 贴地 22cm 擦湿滑霓虹路面反向仰拍前翼+摩天楼群 (15° 荷兰角倾斜)\n296:     (\"Cam_S02_ScraperFrontWing\", 4, 8, \"scraper\",\n297:      dict(back0=-4.6, back1=-3.4, side0=1.75, side1=1.45, h0=0.23, h1=0.26,\n298:           aim_back=0.2, aim_h=0.46, lens0=15, lens1=16, fstop=2.8, roll0=15.0, roll1=11.0)),\n299:     # 3. 峡谷 S 弯贴护栏极近距甩镜摇摄 (Chicane Apex f=125)\n300:     (\"Cam_S03_ChicaneWhipPan\", 8, 12, \"fixed\",\n301:      dict(s_cam=406.0, cl_side=-5.9, h=0.58, framing=0.33, fstop=2.8, aim_lerp=0.76, roll=-5.0, max_lens=135)),\n302:     # 4. Halo 座舱超广角：实时 12fps 方向盘修舵 