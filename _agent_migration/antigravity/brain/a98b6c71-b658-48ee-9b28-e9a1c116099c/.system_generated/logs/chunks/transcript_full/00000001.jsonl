{"step_index":15,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-18T05:26:16Z","content":"Created At: 2026-11-18T13:26:16+08:00\nCompleted At: 2026-11-18T13:26:16+08:00\nShowing lines 801-1276 of 1276\n801: \r\n802:     # ---- 阶梯分块（每 28 m 一块，块间 2 m 通道，避免一整条）----\r\n803:     block, gap = 28.0, 2.0\r\n804:     spans, x0 = [], -L\r\n805:     while x0 < L - 4:\r\n806:         x1 = min(x0 + block, L)\r\n807:         spans.append((x0, x1))\r\n808:         x0 = x1 + gap\r\n809:     for bi, (x0, x1) in enumerate(spans):\r\n810:         bl = x1 - x0\r\n811:         v, fc, uv = [], [], []\r\n812:         for rr in range(rows + 1):\r\n813:             d0 = dist + rr * row_d\r\n814:             z = rr * row_h\r\n815:             for sd, xs in ((-1, x0), (1, x1)):\r\n816:                 c = p + out * d0 + fwd * xs\r\n817:                 v.append((c.x, c.y, z))\r\n818:                 uv.append((sd * bl / 7.5 + 0.5, rr / float(rows)))\r\n819:         for rr in range(rows):\r\n820:             a = rr * 2\r\n821:             b = (rr + 1) * 2\r\n822:             fc.append((a, a + 1, b + 1, b))     # 座面\r\n823:             fc.append((a, b, b + 1, a + 1))     # 立面\r\n824:         parts.append(mesh_from(f\"{name}_Tier{bi}\", v, fc, M_CROWD, uvs=uv, up=False))\r\n825: \r\n826:     # ---- 后墙 + VIP 玻璃带 ----\r\n827:     back = dist + rows * row_d\r\n828:     parts.append(box(name + \"_Back\", (p.x + out.x * back, p.y + out.y * back, rows * row_h / 2),\r\n829:                      (length, 0.5, rows * row_h), M_CONC, rot_z=h))\r\n830:     gz = (rows - 1) * row_h\r\n831:     parts.append(box(name + \"_VIP\", (p.x + out.x * (back - 0.3), p.y + out.y * (back - 0.3), gz + 0.9),\r\n832:                      (length - 4, 0.12, 1.2), M_STRIP, rot_z=h))\r\n833: \r\n834:     # ---- 斜顶棚（前低后高）+ 支撑 ----\r\n835:     zf = rows * row_h + 3.0\r\n836:     zb = rows * row_h + 5.8\r\n837:     rf = dist - 0.6\r\n838:     rb = back + 1.6\r\n839:     rv = []\r\n840:     for sd in (-1, 1):\r\n841:         cf = p + out * rf + fwd * (L * sd)\r\n842:         cb = p + out * rb + fwd * (L * sd)\r\n843:         rv += [(cf.x, cf.y, zf), (cb.x, cb.y, zb)]\r\n844:     parts.append(mesh_from(name + \"_Roof\", rv, [(0, 1, 3, 2)], M_ROOF, up=False))\r\n845:     # 顶棚下沿灯带\r\n846:     lp = p + out * (rf + 0.1)\r\n847:     parts.append(box(name + \"_RoofStrip\", (lp.x, lp.y, zf - 0.3), (length * 0.96, 0.10, 0.10), M_STRIP, rot_z=h))\r\n848:     # 后支撑柱（每 14 m）-> 一个网格\r\n849:     cols = Parts(name + \"_Columns\")\r\n850:     _n = int(length / 14)\r\n851:     for i in range(_n + 1):\r\n852:         xs = -L + i * 14.0\r\n853:         cph = p + out * rb + fwd * xs\r\n854:         cols.box((cph.x, cph.y, zb / 2), (0.24, 0.24, zb), M_STEEL, rot_z=h)\r\n855:     parts.append(cols.build())\r\n856:     # 顶棚横向钢梁（每 8 m 一根，从顶棚前沿斜拉到后沿，贴在顶棚下 0.12 m）-> 一个网格\r\n857:     trs = Parts(name + \"_Trusses\")\r\n858:     _m = int(length / 8)\r\n859:     for i in range(_m + 1):\r\n860:         xs = -L + i * 8.0\r\n861:         bf = p + out * rf + fwd * xs\r\n862:         bb = p + out * rb + fwd * xs\r\n863:         trs.beam((bf.x, bf.y, zf - 0.12), (bb.x, bb.y, zb - 0.12), fwd, 0.16, 0.16, M_STEEL)\r\n864:     parts.append(trs.build())\r\n865: \r\n866:     # ---- 前立柱 + 前沿围栏 ----\r\n867:     fps = Parts(name + \"_FrontPosts\")\r\n868:     for sd in (-1, 1):\r\n869:         cp = p + out * (dist + 0.4) + fwd * (L * sd * 0.92)\r\n870:         fps.box((cp.x, cp.y, zf / 2), (0.28, 0.28, zf), M_STEEL, rot_z=h)\r\n871:     parts.append(fps.build())\r\n872:     rail = p + out * (dist - 1.5)\r\n873:     parts.append(box(name + \"_Rail\", (rail.x, rail.y, 0.55), (length, 0.06, 0.06), M_STEEL, rot_z=h))\r\n874:     # 旗杆 + 旗（沿前沿，每 40 m）-> 旗杆一个网格、旗一个网格（多材质）\r\n875:     poles = Parts(name + \"_Flagpoles\")\r\n876:     flags = Parts(name + \"_Flags\")\r\n877:     _n = int(length / 40)\r\n878:     for i in range(_n + 1):\r\n879:         xs = -L + i * 40.0\r\n880:         fp = p + out * (dist - 2.2) + fwd * xs\r\n881:         poles.box((fp.x, fp.y, 3.0), (0.08, 0.08, 6.0), M_STEEL, rot_z=h)\r\n882:         col = random.choice(M_FLAGS)\r\n883:         fv = [(fp.x, fp.y, 6.0),\r\n884:               (fp.x + out.x * 1.5, fp.y + out.y * 1.5, 5.65),\r\n885:               (fp.x, fp.y, 5.3)]\r\n886:         flags.poly(fv, [(0, 1, 2)], col)\r\n887:     parts.append(poles.build())\r\n888:     parts.append(flags.build())\r\n889: \r\n890:     # ---- 组件 Empty：放在看台占地中心（地面），X 轴沿赛道 ----\r\n891:     mid = p + out * ((dist - 2.2 + rb) / 2.0)\r\n892:     assembly(name, (mid.x, mid.y, 0.0), h, parts, size=8.0)\r\n893:     return name\r\n894: \r\n895: \r\n896: STANDS = [\r\n897:     (120.0, 1, 150.0, 13, 26.0, \"V5_Stand_Main\"),\r\n898:     (1120.0, -1, 90.0, 11, 30.0, \"V5_Stand_T1\"),\r\n899:     (2600.0, 1, 110.0, 12, 30.0, \"V5_Stand_Mid\"),\r\n900:     (3540.0, -1, 120.0, 12, 30.0, \"V5_Stand_Complex\"),\r\n901:     (4370.0, 1, 95.0, 11, 32.0, \"V5_Stand_South\"),\r\n902:     (5560.0, -1, 100.0, 11, 28.0, \"V5_Stand_Club\"),\r\n903: ]\r\n904: M_FLAGS = [new_mat(f\"V5_Flag_{i}\", c, 0.6, 0.0)\r\n905:            for i, c in enumerate(((200, 30, 30), (20, 60, 200), (240, 240, 240),\r\n906:                                   (255, 160, 0), (20, 140, 90)))]\r\n907: random.seed(11)                     # 旗色可复现（以前未设种子，每次构建旗色都不同）\r\n908: for args in STANDS:\r\n909:     grandstand(*args)\r\n910: print(\"stands:\", len(STANDS))\r\n911: \r\n912: # ---------------------------------------------------------------\r\n913: # 11. 维修区（主直道内侧）：pit wall + pit lane + pit box + garage 楼\r\n914: # ---------------------------------------------------------------\r\n915: PIT_S0, PIT_S1 = 60.0, 420.0\r\n916: _p, _h, _r, _k = at_s((PIT_S0 + PIT_S1) / 2)\r\n917: _pit_fwd = Vector((cos(_h), sin(_h), 0.0))\r\n918: _pit_out = Vector((- _r.x, - _r.y, 0.0))      # 内侧（-right），与 Stand_Main 错开\r\n919: PIT_WALL = -(HALF_W + 3.0)                     # -10 m 处维修墙\r\n920: PIT_LANE = -(HALF_W + 3.0 + 9.0)               # -19 m 处车道内边\r\n921: PIT_FACE = -(HALF_W + 3.0 + 12.0)              # -22 m 处车库楼正面\r\n922: PIT_BACK = -(HALF_W + 3.0 + 26.0)              # -36 m 楼背\r\n923: GAR_H = 8.0\r\n924: PIT_LEN = PIT_S1 - PIT_S0\r\n925: \r\n926: \r\n927: def strip_uv(s0, s1, off_a, off_b, z, mat, name, u_repeat, v_repeat=1.0, step=2.0, up=True):\r\n928:     \"\"\"局部带状（非闭环），u 沿弧长 / v 沿横向\"\"\"\r\n929:     v, fc, uv = [], [], []\r\n930:     ss, s = [], s0\r\n931:     while s <= s1 + 1e-6:\r\n932:         ss.append(s)\r\n933:         s += step\r\n934:     if ss[-1] < s1:\r\n935:         ss.append(s1)\r\n936:     for s in ss:\r\n937:         p, h, r, k = at_s(s)\r\n938:         for (o, vv) in ((off_a, 0.0), (off_b, 1.0)):\r\n939:             v.append((p.x + r.x * o, p.y + r.y * o, z))\r\n940:             uv.append(((s - s0) / u_repeat, vv * v_repeat))\r\n941:     for j in range(len(ss) - 1):\r\n942:         a = j * 2\r\n943:         fc.append((a, a + 1, a + 3, a + 2))\r\n944:     return mesh_from(name, v, fc, mat, uvs=uv, up=up)\r\n945: \r\n946: \r\n947: def wall_uv(s0, s1, off, z0, z1, mat, name, u_repeat, v_repeat=1.0, step=2.0):\r\n948:     \"\"\"局部竖直墙（garage 正面 / 维修墙），u 沿弧长 / v 沿高度\"\"\"\r\n949:     v, fc, uv = [], [], []\r\n950:     ss, s = [], s0\r\n951:     while s <= s1 + 1e-6:\r\n952:         ss.append(s)\r\n953:         s += step\r\n954:     if ss[-1] < s1:\r\n955:         ss.append(s1)\r\n956:     for s in ss:\r\n957:         p, h, r, k = at_s(s)\r\n958:         px, py = p.x + r.x * off, p.y + r.y * off\r\n959:         v.append((px, py, z0))\r\n960:         v.append((px, py, z1))\r\n961:         uv.append(((s - s0) / u_repeat, 0.0))\r\n962:         uv.append(((s - s0) / u_repeat, v_repeat))\r\n963:     for j in range(len(ss) - 1):\r\n964:         a = j * 2\r\n965:         fc.append((a, a + 1, a + 3, a + 2))\r\n966:     return mesh_from(name, v, fc, mat, uvs=uv, up=False)\r\n967: \r\n968: \r\n969: # ① pit lane 沥青车道（覆盖掉草地缓冲带）\r\n970: strip_uv(PIT_S0, PIT_S1, PIT_WALL, PIT_LANE, 0.010, M_ASPH