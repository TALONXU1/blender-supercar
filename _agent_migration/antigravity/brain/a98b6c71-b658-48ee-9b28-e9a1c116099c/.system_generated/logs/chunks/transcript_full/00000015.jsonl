wnm, wb, wx, wy, wz in (\n1531:         (\"V6_FX_WheelSmear_FL\", \"Bone_Wheel_FL\", -1.084, 1.45, 0.351),\n1532:         (\"V6_FX_WheelSmear_FR\", \"Bone_Wheel_FR\", 1.084, 1.45, 0.351),\n1533:         (\"V6_FX_WheelSmear_RL\", \"Bone_Wheel_RL\", -1.080, -1.55, 0.336),\n1534:         (\"V6_FX_WheelSmear_RR\", \"Bone_Wheel_RR\", 1.080, -1.55, 0.336),\n1535:     ):\n1536:         vs, fs, uvs = [], [], []\n1537:         for a0, spn, ri, ro in ((18.0, 122.0, 0.215, 0.288), (195.0, 112.0, 0.245, 0.320)):\n1538:             b = len(vs)\n1539:             for k in range(13):\n1540:                 u = k / 12.0; ang = radians(a0 + spn * u)\n1541:                 vs += [(wx, wy + cos(ang) * ri, wz + sin(ang) * ri), (wx, wy + cos(ang) * ro, wz + sin(ang) * ro)]\n1542:                 uvs += [(u, 0.0), (u, 1.0)]\n1543:             for k in range(12):\n1544:                 a = b + k * 2; fs.append((a, a + 1, a + 3, a + 2))\n1545:         _new_fx(wnm, vs, fs, uvs, m_smr, wb)\n1546: \n1547: \n1548: build_high_impact_car_fx()\n1549: \n1550: # 清理孤立数据块并保存 v6_stage_lookdev.blend\n1551: try:\n1552:     bpy.ops.outliner.orphans_purge(do_local_ids=True, do_linked_ids=True, do_recursive=True)\n1553: except Exception:\n1554:     pass\n1555: \n1556: scene[\"sv_dimension\"] = 0.0\n1557: bpy.ops.wm.save_as_mainfile(filepath=OUT_BLEND)\n1558: if os.path.exists(OUT_BLEND + \"1\"):\n1559:     try:\n1560:         os.remove(OUT_BLEND + \"1\")"}
