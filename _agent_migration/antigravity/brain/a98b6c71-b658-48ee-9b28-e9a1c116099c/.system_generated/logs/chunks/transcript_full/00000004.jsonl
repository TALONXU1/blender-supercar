ast.Assign):\n50:             for tgt in node.targets:\n51:                 if isinstance(tgt, ast.Name):\n52:                     if tgt.id == \"TOTAL_BEATS\" and isinstance(node.value, ast.Constant):\n53:                         total_beats = int(node.value.value)\n54:                     elif tgt.id == \"SHOTS\":\n55:                         safe_ns = {\"dict\": dict, \"True\": True, \"False\": False, \"None\": None}\n56:                         shots = eval(\n57:                             compile(ast.Expression(node.value), \"<SHOTS>\", \"eval\"),\n58:                             {\"__builtins__\": {}},\n59:                             safe_ns,\n60:                         )\n61:     if not shots:\n62:         raise RuntimeError(f\"Could not parse SHOTS from {anim_path}\")\n63:     return shots, bpm, total_beats\n64: \n65: \n66: # ---------------------------------------------------------------------------\n67: # 2. Reconstruct Exact Car Telemetry & 26 Camera Trajectories (Matching v5_anim.py)\n68: # ---------------------------------------------------------------------------\n69: def build_timeline_and_cameras(track_path, anim_path):\n70:     with open(track_path, encoding=\"utf-8\") as f:\n71:         data = json.load(f)\n72: \n73:     meta = data[\"meta\"]\n74:     pts = data[\"points\"]\n75:     n_pts = len(pts)\n76:     lap_s = float(meta[\"sim_lap_s\"])  # 90.34 s\n77: \n78:     shots, bpm, total_beats = load_shots_from_anim(anim_path)\n79:     beat_s = 60.0 / bpm\n80:     beat_f = beat_s * FPS\n81:     frame_end = int(round(1 + total_beats * beat_f))  # 2161\n82:     dt_frame = lap_s / (frame_end - 1)                # 90.34 / 2160\n83: \n84:     t_arr = np.array([p[\"t\"] for p in pts], dtype=np.float64)\n85:     rx_arr = np.array([p[\"racing_xy\"][0] for p in pts], dtype=np.float64)\n86:     ry_arr = np.array([p[\"racing_xy\"][1] for p in pts], dtype=np.float64)\n87:     hd_deg = np.array([p[\"heading_deg\"] for p in pts], dtype=np.float64)\n88:     hd_rad_unwrapped = np.unwrap(np.radians(hd_deg))\n89:     v_arr = np.array([p[\"v_mps\"] for p in pts], dtype=np.float64)\n90:     k_abs_arr = np.array([abs(p[\"curv_1pm\"] or 0.0) for p in pts], dtype=np.float64)\n91:     s_arr = np.array([p[\"s\"] for p in pts], dtype=np.float64)\n92: \n93:     span_idx = 4\n94:     signs = np.array(\n95:         [\n96:             1.0 if (hd_rad_unwrapped[(i + span_idx) % n_pts] - hd_rad_unwrapped[(i - span_idx) % n_pts]) >= 0 else -1.0\n97:             for i in range(n_pts)\n98:         ],\n99:         dtype=np.float64,\n100:     )\n101:     ks_arr = signs * k_abs_arr\n102: \n103:     def sample_track(t_q):\n104:         t_c = np.clip(t_q, 0.0, lap_s - 1e-6)\n105:         px = np.interp(t_c, t_arr, rx_arr)\n106:         py = np.interp(t_c, t_arr, ry_arr)\n107:         hd = np.interp(t_c, t_arr, hd_rad_unwrapped)\n108:         vv = np.interp(t_c, t_arr, v_arr)\n109:         kk = np.interp(t_c, t_arr, ks_arr)\n110:         ss = np.interp(t_c, t_arr, s_arr)\n111:         return px, py, hd, vv, kk, ss\n112: \n113:     # Frame-level data (1-indexed 1..frame_end to match v5_anim.py)\n114:     f_indices = np.arange(frame_end, dtype=np.float64)\n115:     t_frames = f_indices * dt_frame\n116:     px_f, py_f, hd_f, v_f, k_f, s_f = sample_track(t_frames)\n117: \n118:     frame_data = {}\n119:     for idx in range(frame_end):\n120:         f = idx + 1\n121:         h = float(hd_f[idx])\n122:         frame_data[f] = {\n123:             \"t\": float(t_frames[idx]),\n124:             \"pos\": np.array([px_f[idx], py_f[idx], 0.0], dtype=np.float64),\n125:             \"heading\": h,\n126:             \"v\": float(v_f[idx]),\n127:             \"k\": float(k_f[idx]),\n128:             \"s\": float(s_f[idx]),\n129:             \"fwd\": np.array([cos(h), sin(h), 0.0], dtype=np.float64),\n130:             \"right\": np.array([sin(h), -cos(h), 0.0], dtype=np.float64),\n131:         }\n132: \n133:     def tf_snap(t_sec):\n134:         f = 1.0 + t_sec / dt_frame\n135:         k_beat = round((f - 1.0) / beat_f)\n136:         return max(1, min(frame_end, int(round(1.0 + k_beat * beat_f))))\n137: \n138:     windows = []\n139:     for name, t0, t1, typ, pr in shots:\n140:         windows.append([name, tf_snap(t0), tf_snap(t1), typ, pr])\n141: \n142:     for i in range(len(windows)):\n143:         windows[i][1] = max(windows[i][1], 1)\n144:         windows[i][2] = min(frame_end, max(windows[i][2], windows[i][1] + 2))\n145:         if i and windows[i][1] <= windows[i - 1][2]:\n146:             windows[i][1] = windows[i - 1][2] + 1\n147:             windows[i][2] = max(windows[i][2], windows[i][1] + 2)\n148:     windows[-1][2] = frame_end\n149: \n150:     def smooth01(u):\n151:         u = max(0.0, min(1.0, u))\n152:         return u * u * (3.0 - 2.0 * u)\n153: \n154:     def car_rel(fd, back=0.0, side=0.0, h=0.5):\n155:         return fd[\"pos\"] - fd[\"fwd\"] * back + fd[\"right\"] * side + np.array([0.0, 0.0, h])\n156: \n157:     def car_aim(fd, ahead=0.0, side=0.0, h=0.45):\n158:         return fd[\"pos\"] + fd[\"fwd\"] * ahead + fd[\"right\"] * side + np.array([0.0, 0.0, h])\n159: \n160:     # Precompute camera positions & aim targets for each shot (with 2-frame pad for crossfades)\n161:     shot_specs = []\n162:     for s_idx, (name, f0, f1, typ, pr) in enumerate(windows):\n163:         span = max(1, f1 - f0)\n164:         f_pad0 = max(1, f0 - 3)\n165:         f_pad1 = min(frame_end, f1 + 3)\n166:         frames_slice = np.arange(f_pad0, f_pad1 + 1, dtype=int)\n167:         cam_locs = np.zeros((len(frames_slice), 3), dtype=np.float64)\n168:         cam_aims = np.zeros((len(frames_slice), 3), dtype=np.float64)\n169: \n170:         fixed_loc = None\n171:         if typ == \"fixed\":\n172:             fr = max(f0, min(f1, int(round(1.0 + pr[\"t_pass\"] / dt_frame))))\n173:             fixed_loc = car_rel(frame_data[fr], pr[\"lead\"], pr[\"side\"], pr[\"h\"])\n174: \n175:         aim_prev = None\n176:         for j, f in enumerate(frames_slice):\n177:             e = smooth01((f - f0) / span)\n178:             fd = frame_data[int(f)]\n179:             if typ == \"chase\":\n180:                 loc = car_rel("}
