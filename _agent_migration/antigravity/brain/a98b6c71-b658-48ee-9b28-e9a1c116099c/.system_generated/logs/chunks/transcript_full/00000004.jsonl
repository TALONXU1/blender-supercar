poles=2,volume=-3.2dB,asplit=2[sfx_sc][sfx_mix];[mus][sfx_sc]sidechaincompress=threshold=0.14:ratio=2.6:attack=12:release=190:makeup=1[mus_duck];[mus_duck][sfx_mix]amix=inputs=2:normalize=0,afade=t=in:st=0:d=0.08,afade=t=out:st=88.541667:d=1.5:curve=qsin,alimiter=limit=0.81:attack=4:release=45:level=disabled[outa]\" \\\n38:   -map \"[outa]\" -c:a aac -b:a 256k -ar 48000 -ac 2 \\\n39:   -movflags +faststart \"$SFX_MIX\"\n40: \n41: # 4) 正片 + F1 引擎音效混音版\n42: \"$FF\" -hide_banner -loglevel warning -y -i \"$SILENT\" -i \"$SFX_MIX\" \\\n43:   -map 0:v -map 1:a -c:v copy -c:a copy -shortest \\\n44:   -movflags +faststart \"$OUT_SFX\"\n45: \n46: ls -la \"$SILENT\" \"$OUT\" \"$SFX_MIX\" \"$OUT_SFX\""}
