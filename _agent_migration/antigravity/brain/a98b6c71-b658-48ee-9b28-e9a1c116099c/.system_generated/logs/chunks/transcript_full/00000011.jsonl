{"step_index":290,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-18T08:33:28Z","content":"Created At: 2026-11-18T16:33:28+08:00\nCompleted At: 2026-11-18T16:33:34+08:00\nShowing lines 1-89 of 89\n1: # -*- coding: utf-8 -*-\n2: \"\"\"\n3: V6 SPIDER-VERSE RENDERER — 支持分段并行渲染与全片 2161 帧渲染\n4: 输入: v6_spiderverse/v6_stage_anim_sv.blend\n5: \n6: 用法:\n7:   blender -b -P pipeline/render_v6_sv.py -- --range 61-156 --outdir renders_v6/clips_frames/clip1_miles_1610\n8:   blender -b -P pipeline/render_v6_sv.py -- --range 1290-1385 --outdir renders_v6/clips_frames/clip2_gwen_65\n9:   blender -b -P pipeline/render_v6_sv.py -- --range 1650-1745 --outdir renders_v6/clips_frames/clip3_2099_impact\n10:   blender -b -P pipeline/render_v6_sv.py -- --all\n11: \"\"\"\n12: import bpy\n13: import os\n14: import sys\n15: import time\n16: \n17: PROJ = r\"D:\\项目session\\blender-supercar\"\n18: ARGV = sys.argv[sys.argv.index(\"--\") + 1:] if \"--\" in sys.argv else []\n19: \n20: \n21: def argval(flag, default=None):\n22:     if flag in ARGV:\n23:         i = ARGV.index(flag)\n24:         if i + 1 < len(ARGV) and not ARGV[i + 1].startswith(\"--\"):\n25:             return ARGV[i + 1]\n26:         return True\n27:     return default\n28: \n29: \n30: BLEND = argval(\"--blend\", os.path.join(PROJ, \"v6_spiderverse\", \"v6_stage_anim_sv.blend\"))\n31: RANGE_STR = argval(\"--range\", None)\n32: DO_ALL = bool(argval(\"--all\", False))\n33: SAMPLES = int(argval(\"--samples\", 16))\n34: OVERWRITE = bool(argval(\"--overwrite\", True))\n35: \n36: if not os.path.isabs(BLEND):\n37:     BLEND = os.path.join(PROJ, BLEND)\n38: \n39: bpy.ops.wm.open_mainfile(filepath=BLEND)\n40: sc = bpy.context.scene\n41: \n42: if DO_ALL and not RANGE_STR:\n43:     f_start, f_end = 1, sc.frame_end\n44:     outdir = argval(\"--outdir\", os.path.join(PROJ, \"renders_v6\", \"frames\"))\n45: elif RANGE_STR:\n46:     parts = str(RANGE_STR).split(\"-\")\n47:     f_start, f_end = int(parts[0]), int(parts[1])\n48:     outdir = argval(\"--outdir\", os.path.join(PROJ, \"renders_v6\", \"frames\"))\n49: else:\n50:     raise SystemExit(\"Specify --range START-END [--outdir DIR] or --all\")\n51: \n52: if not os.path.isabs(outdir):\n53:     outdir = os.path.join(PROJ, outdir)\n54: os.makedirs(outdir, exist_ok=True)\n55: \n56: # 确保从任意中间帧起渲时，初始活动相机与最近的前置 Timeline Marker 严格一致\n57: markers = sorted(sc.timeline_markers, key=lambda m: m.frame)\n58: init_cam = sc.camera\n59: for mk in markers:\n60:     if mk.frame <= f_start and mk.camera:\n61:         init_cam = mk.camera\n62:     elif mk.frame > f_start:\n63:         break\n64: if init_cam:\n65:     sc.camera = init_cam\n66: \n67: sc.render.engine = 'BLENDER_EEVEE'\n68: sc.eevee.use_raytracing = False\n69: sc.eevee.taa_render_samples = SAMPLES\n70: sc.render.resolution_x = 1920\n71: sc.render.resolution_y = 1080\n72: sc.render.resolution_percentage = 100\n73: sc.render.fps = 24\n74: sc.frame_start = f_start\n75: sc.frame_end = f_end\n76: sc.render.use_motion_blur = True\n77: sc.render.motion_blur_shutter = 0.07\n78: sc.render.image_settings.file_format = 'JPEG'\n79: sc.render.image_settings.quality = 95\n80: sc.render.filepath = os.path.join(outdir, \"f_\")\n81: sc.render.use_overwrite = OVERWRITE\n82: sc.render.use_placeholder = not OVERWRITE\n83: \n84: t0 = time.time()\n85: print(f\"V6 RENDER START: frames {f_start}..{f_end} ({f_end - f_start + 1}f) -> {outdir} (init_cam={sc.camera.name if sc.camera else None})\", flush=True)\n86: bpy.ops.render.render(animation=True)\n87: elapsed = time.time() - t0\n88: n_frames = max(1, f_end - f_start + 1)\n89: print(f\"V6 RENDER DONE: {n_frames} frames in {elapsed:.1f}s ({elapsed / n_frames:.2f} s/frame)\", flush=True)"}
{"step_index":291,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-18T08:33:28Z","content":"Created At: 2026-11-18T16:33:28+08:00\nCompleted At: 2026-11-18T16:33:34+08:00\nShowing lines 1-359 of 359\n1: # -*- coding: utf-8 -*-\n2: \"\"\"\n3: V6 SPIDER-VERSE STILLS & COMIC-BOOK MULTI-PANEL PAGE POSTER GENERATOR\n4: 输入: v6_spiderverse/v6_stage_anim_sv.blend\n5: 输出:\n6:   - renders_v6/stills/shot_01_*.jpg .. shot_26_*.jpg  (26 张 1080p 风格化剧照)\n7:   - renders_v6/stills/contact_sheet_v6.jpg            (三幕平行宇宙色标总览图)\n8:   - renders_v6/stills/comic_page_sheet.jpg            (蜘蛛侠平行宇宙斜切分镜漫画海报页)\n9: \n10: 用法:\n11:   blender -b -P pipeline/v6_sv_stills.py -- --render\n12:   python pipeline/v6_sv_stills.py --sheet-only\n13: \"\"\"\n14: import math\n15: import os\n16: import subprocess\n17: import sys\n18: \n19: PROJ = r\"D:\\项目session\\blender-supercar\"\n20: BLEND_DEFAULT = os.path.join(PROJ, \"v6_spiderverse\", \"v6_stage_anim_sv.blend\")\n21: OUT = os.path.join(PROJ, \"renders_v6\", \"stills\")\n22: os.makedirs(OUT, exist_ok=True)\n23: \n24: ARGV = sys.argv[sys.argv.index(\"--\") + 1:] if \"--\" in sys.argv else sys.argv[1:]\n25: DO_RENDER = \"--render\" in ARGV\n26: SHEET_ONLY = \"--sheet-only\" in ARGV\n27: \n28: SHOTS = [\n29:     (60, \"01_rear_chase\"),\n30:     (160, \"02_onboard\"),\n31:     (250, \"03_chase_rise\"),\n32:     (350, \"04_hairpin\"),\n33:     (440, \"05_chase_aintree\"),\n34:     (520, \"06_orbit1\"),\n35:     (600, \"07_chase_accel\"),\n36:     (700, \"08_fast_pan\"),\n37:     (760, \"09_wheel_macro\"),\n38:     (820, \"10_chase_fast\"),\n39:     (870, \"11_orbit_brooklands\"),\n40:     (950, \"12_luffield\"),\n41:     (1040, \"13_chase_woodcote\"),\n42:     (1120, \"14_woodcote_tele\"),\n43:     (1200, \"15_heli_drop\"),\n44:     (1300, \"16_orbit_copse\"),\n45:     (1380, \"17_chase_copse\"),\n46:     (1470, \"18_maggotts\"),\n47:     (1560, \"19_chase_rise2\"),\n48:     (1640, \"20_onboard3\"),\n49:     (1730, \"21_stowe_tele\"),\n50:     (1830, \"22_orbit_stowe\"),\n51:     (1920, \"23_chase_low\"),\n52:     (2010, \"24_heli_reveal\"),\n53:     (2090, \"25_club\"),\n54:     (2145, \"26_aerial_out\"),\n55: ]\n56: \n57: \n58: def act_info(frame):\n59:     if frame <= 788:\n60:         return \"E-1610\", (235, 42, 78)     # Miles Crimson\n61:     elif frame <= 1601:\n62:         return \"E-65\", (36, 214, 198)      # Gwen Teal-Aqua\n63:     return \"E-928\", (188, 72, 255)         # 2099 Ultraviolet\n64: \n65: \n66: def render_with_blender():\n67:     import bpy\n68:     if not bpy.data.filepath or \"v6_stage_anim_sv\" not in os.path.basename(bpy.data.filepath):\n69:         bpy.ops.wm.open_mainfile(filepath=BLEND_DEFAULT)\n70:     sc = bpy.context.scene\n71: \n72:     markers = sorted(sc.timeline_markers, key=lambda m: m.frame)\n73: \n74:     def active_cam_for_frame(f):\n75:         cur = sc.camera\n76:         for mk in markers:\n77:             if mk.frame <= f and mk.camera:\n78:                 cur = mk.camera\n79:             elif mk.frame > f:\n80:                 break\n81:         return cur\n82: \n83:     orig_cam = sc.camera\n84:     sc.render.engine = 'BLENDER_EEVEE'\n85:     sc.eevee.use_raytracing = False\n86:     sc.eevee.taa_render_samples = 20\n87:     sc.render.resolution_x = 1920\n88:     sc.render.resolution_y = 1080\n89:     sc.render.resolution_percentage = 100\n90:     sc.render.use_motion_blur = True\n91:     sc.render.motion_blur_shutter = 0.07\n92:     sc.render.image_settings.file_format = 'JPEG'\n93:     sc.render.image_settings.quality = 95\n94: \n95:     for f, name in SHOTS:\n96:         sc.camera = active_cam_for_frame(f)\n97:         sc.frame_set(f)\n98:         dst = os.path.join(OUT, f\"shot_{name}.jpg\")\n99:         sc.render.filepath = dst\n100:         bpy.ops.render.render(write_still=True)\n101:         print(f\"V6 STILL RENDERED: shot_{name}.jpg (f={f}, {act_info(f)[0]})\", flush=True)\n102: \n103:     # Also ensure Impact Frame f=1698 preview exists for the comic page inset\n104:     clip_impact = os.path.join(PROJ, \"renders_v6\", \"clips_frames\", \"clip3_2099_impact\", \"f_1698.jpg\")\n105:     aux_impact = os.path.join(OUT, \"_impact_f1698.jpg\")\n106:     if not os.path.exists(clip_impact):\n107:         sc.camera = active_cam_for_frame(1698)\n108:         sc.frame_set(1698)\n109:         sc.render.filepath = aux_impact\n110:         bpy.ops.render.render(write_still=True)\n111:         print(\"V6 IMPACT INSET RENDERED: _impact_f1698.jpg\", flush=True)\n112: \n113:     sc.camera = orig_cam\n114: \n115: \n116: def _load_fonts():\n117:     from PIL import ImageFont\n118:     f_small = f_med = f_big = f_hero = None\n119:     bold_candidates = (\n120:         r\"C:\\Windows\\Fonts\\impact.ttf\",\n121:         r\"C:\\Windows\\Fonts\\arialbd.ttf\",\n122:         r\"C:\\Windows\\Fonts\\consolab.ttf\",\n123:     )\n124:     mono_candidates = (\n125:         r\"C:\\Windows\\Fonts\\consolab.ttf\",\n126:         r\"C:\\Windows\\Fonts\\arialbd.ttf\",\n127:     )\n128:     for c in mono_candidates:\n129:         if os.path.exists(c):\n130:             try:\n131:                 f_small = ImageFont.truetype(c, 13)\n132:                 f_med = ImageFont.truetype(c, 18)\n133:                 break\n134:             except Exception:\n135:                 pass\n136:     for c in bold_candidates:\n137:         if os.path.exists(c):\n138:             try:\n139:                 f_big = ImageFont.truetype(c, 28)\n140:                 f_hero = ImageFont.truetype(c, 54)\n141:                 break\n142:             except Exception:\n143:                 pass\n144:     return f_small, f_med, f_big, f_hero\n145: \n146: \n147: def build_contact_sheet_v6(made):\n148:     from PIL import Image, ImageDraw\n149: \n150:     f_small, f_med, f_big, _ = _load_fonts()\n151:     tw, th = 384, 216\n152:     bar_h = 26\n153:     cols = 5\n154:     rows = (len(made) + cols - 1) // cols\n155:     header_h = 46\n156:     sheet = Image.new(\"RGB\", (cols * tw, header_h + rows * (th + bar_h)), (14, 13, 22))\n157:     d = ImageDraw.Draw(sheet)\n158: \n159:     # Top multiverse accent stripe\n160:     d.rectangle([0, 0, 640, 5], fill=(235, 42, 78))\n161:     d.rectangle([640, 0, 1280, 5], fill=(36, 214, 198))\n162:     d.rectangle([1280, 0, cols * tw, 5], fill=(188, 72, 255))\n163:     d.text((16, 13), \"V6 SPIDER-VERSE EDITION  //  26-SHOT MULTIVERSE COLOR SCRIPT  (E-1610 MILES | E-65 GWEN | E-928 2099)\",\n164:            fill=(242, 240, 248), font=f_med or f_small)\n165: \n166:     for i, (f, name, path) in enumerate(made):\n167:         im = Image.open(path).convert(\"RGB\").resize((tw, th), Image.Resampling.LANCZOS)\n168:         x = (i % cols) * tw\n169:         y = header_h + (i // cols) * (th + bar_h)\n170:         sheet.paste(im, (x, y))\n171:         tag, badge_col = act_info(f)\n172:         d.rectangle([x, y + th, x + tw - 1, y + th + bar_h - 1], fill=(20, 19, 30))\n173:         d.rectangle([x + 6, y + th + 5, x + 64, y + th + bar_h - 5], fill=badge_col)\n174:         d.text((x + 11, y + th + 6), tag, fill=(12, 12, 18), font=f_small)\n175:         d.text((x + 72, y + th + 6), f\"{name} (f{f})\", fill=(228, 232, 242), font=f_small)\n176:         d.rectangle([x, y, x + tw - 1, y + th + bar_h - 1], outline=(42, 40, 58), width=1)\n177: \n178:     out_path = os.path.join(OUT, \"contact_sheet_v6.jpg\")\n179:     sheet.save(out_path, quality=95, subsampling=0)\n180:     print(\"V6 CONTACT SHEET:\", out_path, sheet.size)\n181: \n182: \n183: def _paste_polygon_panel(page, img_path, poly, shadow_col=(24, 210, 230), shadow_off=(10, 10), border_w=7):\n184:     from PIL import Image, ImageDraw\n185: \n186:     xs = [p[0] for p in poly]\n187:     ys = [p[1] for p in poly]\n188:     x0, y0, x1, y1 = min(xs), min(ys), max(xs), max(ys)\n189:     bw, bh = max(1, x1 - x0), max(1, y1 - y0)\n190: \n191:     src = Image.open(img_path).convert(\"RGB\")\n192:     sw, sh = src.size\n193:     scale = max(bw / sw, bh / sh) * 1.03\n194:     nw, nh = int(round(sw * scale)), int(round(sh * scale))\n195:     resized = src.resize((nw, nh), Image.Resampling.LANCZOS)\n196:     cx = (nw - bw) // 2\n197:     cy = (nh - bh) // 2\n198:     cropped = resized.crop((cx, cy, cx + bw, cy + bh))\n199: \n200:     mask = Image.new(\"L\", (bw, bh), 0)\n201:     md = ImageDraw.Draw(mask)\n202:     local_poly = [(px - x0, py - y0) for px, py in poly]\n203:     md.polygon(local_poly, fill=255)\n204: \n205:     d = ImageDraw.Draw(page)\n206:     # Offset CMYK graphic shadow block\n207:     sh_poly = [(px + shadow_off[0], py + shadow_off[1]) for px, py in poly]\n208:     d.polygon(sh_poly, fill=shadow_col)\n209:     # Black ink backing behind shadow\n210:     ink_sh = [(px + shadow_off[0] + 4, py + shadow_off[1] + 4) for px, py in poly]\n211:     d.polygon(ink_sh, outline=(14, 12, 22), width=3)\n212: \n213:     page.paste(cropped, (x0, y0), mask)\n214: \n215:     # Crisp comic double-inked border\n216:     d.line(poly + [poly[0]], fill=(250, 248, 242), width=border_w + 4, joint=\"curve\")\n217:     d.line(poly + [poly[0]], fill=(14, 12, 20), width=border_w, joint=\"curve\")\n218: \n219: \n220: def _draw_halftone_corner(draw, cx, cy, radius, dot_step, max_r, color):\n221:     for gx in range(cx - radius, cx + radius + 1, dot_step):\n222:         for gy in range(cy - radius, cy + radius + 1, dot_step):\n223:             dist = math.hypot(gx - cx, gy - cy)\n224:             if dist < radius:\n225:                 r = max_r * (1.0 - dist / radius) ** 1.3\n226:                 if r >= 1.1:\n227:                     draw.ellipse([gx - r, gy - r, gx + r, gy + r], fill=color)\n228: \n229: \n230: def _draw_caption_box(draw, x, y, w, h, text, bg_col=(255, 214, 42), fg_col=(14, 12, 20), font=None):\n231:     # Angled comic caption box with ink shadow\n232:     skew = 10\n233:     pts = [(x + skew, y), (x + w + skew, y), (x + w, y + h), (x, y + h)]\n234:     sh = [(px + 5, py + 5) for px, py in pts]\n235:     draw.polygon(sh, fill=(14, 12, 20))\n236:     draw.polygon(pts, fill=bg_col)\n237:     draw.line(pts + [pts[0]], fill=(14, 12, 20), width=4)\n238:     draw.text((x + 16, y + (h - 20) // 2), text, fill=fg_col, font=font)\n239: \n240: \n241: def build_comic_page_poster(still_map):\n242:     from PIL import Image, ImageDraw\n243:     import numpy as np\n244: \n245:     _, f_med, f_big, f_hero = _load_fonts()\n246:     W, H = 2200, 3100\n247:     # Aged warm comic stock paper with subtle fiber grain\n248:     rng = np.random.default_rng(2099)\n249:     base = np.empty((H, W, 3), dtype=np.uint8)\n250:     noise = rng.integers(-5, 6, size=(H, W, 1), dtype=np.int16)\n251:     paper_rgb = np.array([[[245, 240, 229]]], dtype=np.int16) + noise\n252:     base[:] = np.clip(paper_rgb, 0, 255).astype(np.uint8)\n253:     page = Image.fromarray(base, mode=\"RGB\")\n254:     d = ImageDraw.Draw(page)\n255: \n256:     # Halftone Ben-Day corner accents\n257:     _draw_halftone_corner(d, 90, 210, 340, 18, 6.5, (235, 42, 78))\n258:     _draw_halftone_corner(d, W - 80, 1480, 380, 18, 6.5, (36, 214, 198))\n259:     _draw_halftone_corner(d, 110, H - 100, 360, 18, 6.5, (188, 72, 255))\n260: \n261:     # Print registration marks (+) in outer margins\n262:     for rx, ry in ((38, 38), (W - 38, 38), (38, H - 38), (W - 38, H - 38)):\n263:         d.ellipse([rx - 12, ry - 12, rx + 12, ry + 12], outline=(20, 20, 26), width=2)\n264:         d.line([(rx - 18, ry), (rx + 18, ry)], fill=(20, 20, 26), width=2)\n265:         d.line([(rx, ry - 18), (rx, ry + 18)], fill=(20, 20, 26), width=2)\n266: \n267:     # Top Comic Issue Masthead Banner\n268:     d.polygon([(70, 58), (W - 70, 58), (W - 92, 168), (70, 168)], fill=(16, 14, 26))\n269:     d.polygon([(70, 162), (790, 162), (782, 174), (70, 174)], fill=(235, 42, 78))\n270:     d.polygon([(790, 162), (1490, 162), (1482, 174), (782, 174)], fill=(36, 214, 198))\n271:     d.polygon([(1490, 162), (W - 92, 162), (W - 96, 174), (1482, 174)], fill=(188, 72, 255))\n272: \n273:     d.text((102, 78), \"SILVERSTONE: ACROSS THE APEX\", fill=(252, 248, 240), font=f_hero or f_big)\n274:     # Issue stamp box on right\n275:     d.rectangle([W - 430, 74, W - 118, 148], fill=(255, 214, 42), outline=(14, 12, 20), width=4)\n276:     d.text((W - 410, 84), \"ISSUE #06 // V6 EDITION\", fill=(14, 12, 20), font=f_med)\n277:     d.text((W - 410, 114), \"12 FPS ON-TWOS | 3 UNIVERSES\", fill=(190, 18, 48), font=f_med)\n278: \n279:     def pick(*keys):\n280:         for k in keys:\n281:             if k in still_map and os.path.exists(still_map[k]):\n282:                 return still_map[k]\n283:         return next(iter(still_map.values()))\n284: \n285:     # Panel 1: Top Wide Diagonal Hero Slash (Act I — Earth-1610)\n286:     p1 = [(76, 204), (2124, 204), (2124, 765), (76, 845)]\n287:     _paste_polygon_panel(page, pick(\"06_orbit1\", \"01_rear_chase\"), p1, shadow_col=(235, 42, 78), shadow_off=(11, 11))\n288:     _draw_caption_box(d, 108, 228, 590, 48, \"ACT I // EARTH-1610 — BROOKLYN DUSK COMIC INK\",\n289:                       bg_col=(255, 214, 42), font=f_med)\n290: \n291:     # Panel 2 (Left Angled) & Panel 3 (Right Angled): Cockpit Steering + Wheel Macro\n292:     p2 = [(76, 882), (1145, 838), (1075, 1425), (76, 1455)]\n293:     p3 = [(1182, 835), (2124, 798), (2124, 1395), (1112, 1423)]\n294:     _paste_polygon_panel(page, pick(\"02_onboard\"), p2, shadow_col=(32, 208, 245), shadow_off=(-9, 10))\n295:     _paste_polygon_panel(page, pick(\"09_wheel_macro\", \"04_hairpin\"), p3, shadow_col=(255, 208, 38), shadow_off=(10, 10))\n296:     _draw_caption_box(d, 104, 1378, 470, 44, \"HALO COCKPIT // LIVE STEER & SHIFT LEDS\",\n297:                       bg_col=(36, 214, 198), font=f_med)\n298:     _draw_caption_box(d, 1540, 826, 545, 44, \"BEN-DAY HALFTONE // WHEEL SMEAR ARCS\",\n299:                       bg_col=(255, 214, 42), font=f_med)\n300: \n301:     # Panel 4: Center Full-Width Diagonal Splash (Act II — Earth-65 Gwen Watercolor)\n302:     p4 = [(76, 1492), (2124, 1432), (2124, 2125), (76, 2195)]\n303:     _paste_polygon_panel(page, pick(\"16_orbit_copse\", \"11_orbit_brooklands\", \"12_luffield\"),\n304:                          p4, shadow_col=(36, 214, 198), shadow_off=(12, 12))\n305:     _draw_caption_box(d, 108, 1520, 680, 48, \"ACT II // EARTH-65 — KUWAHARA WATERCOLOR WASH @ COPSE\",\n306:                       bg_col=(255, 92, 186), fg_col=(14, 12, 20), font=f_med)\n307: \n308:     # Panel 5 (Bottom Left) & Panel 6 (Bottom Right): Act III — Earth-928 2099\n309:     p5 = [(76, 2232), (1195, 2190), (1110, 2995), (76, 2995)]\n310:     p6 = [(1232, 2188), (2124, 2160), (2124, 2995), (1148, 2995)]\n311:     _paste_polygon_panel(page, pick(\"20_onboard3\", \"21_stowe_tele\"), p5, shadow_col=(188, 72, 255), shadow_off=(-10, 11))\n312:     _paste_polygon_panel(page, pick(\"25_club\", \"22_orbit_stowe\"), p6, shadow_col=(235, 32, 72), shadow_off=(11, 11))\n313:     _draw_caption_box(d, 104, 2918, 520, 46, \"ACT III // EARTH-928 — 331 KM/H HANGAR BLAST\",\n314:                       bg_col=(188, 72, 255), fg_col=(250, 248, 255), font=f_med)\n315:     _draw_caption_box(d, 1515, 2918, 575, 46, \"CMYK PRINT SPLIT // CLUB CORNER FINALE\",\n316:                       bg_col=(235, 42, 78), fg_col=(252, 248, 242), font=f_med)\n317: \n318:     # Panel 7: Overlapping Tilted Action Inset — 2-Frame Graphic Impact Slam (f=1698)\n319:     clip_imp = os.path.join(PROJ, \"renders_v6\", \"clips_frames\", \"clip3_2099_impact\", \"f_1698.jpg\")\n320:     aux_imp = os.path.join(OUT, \"_impact_f1698.jpg\")\n321:     imp_path = clip_imp if os.path.exists(clip_imp) else (aux_imp if os.path.exists(aux_imp) else pick(\"21_stowe_tele\"))\n322:     p7 = [(855, 2065), (1505, 2025), (1455, 2425), (805, 2465)]\n323:     # White starburst backing around impact inset\n324:     d.polygon([(835, 2045), (1525, 2005), (1475, 2445), (785, 2485)], fill=(252, 248, 240))\n325:     _paste_polygon_panel(page, imp_path, p7, shadow_col=(235, 28, 62), shadow_off=(9, 9), border_w=8)\n326:     _draw_caption_box(d, 855, 2418, 495, 42, \"IMPACT FRAME // f1698 STOWE SLAM!\",\n327:                       bg_col=(255, 214, 42), font=f_med)\n328: \n329:     # Outer page framing rule\n330:     d.rectangle([52, 42, W - 52, H - 42], outline=(18, 16, 26), width=5)\n331: \n332:     out_poster = os.path.join(OUT, \"comic_page_sheet.jpg\")\n333:     page.save(out_poster, quality=95, subsampling=0)\n334:     print(\"V6 COMIC PAGE POSTER:\", out_poster, page.size)\n335: \n336: \n337: if DO_RENDER:\n338:     render_with_blender()\n339:     try:\n340:         import PIL  # noqa: F401\n341:         made = [(f, name, os.path.join(OUT, f\"shot_{name}.jpg\"))\n342:                 for f, name in SHOTS if os.path.exists(os.path.join(OUT, f\"shot_{name}.jpg\"))]\n343:         build_contact_sheet_v6(made)\n344:         build_comic_page_poster({name: path for _, name, path in made})\n345:     except ImportError:\n346:         env = os.environ.copy()\n347:         env.pop(\"PYTHONHOME\", None)\n348:         env.pop(\"PYTHONPATH\", None)\n349:         res = subprocess.run([\"python\", os.path.abspath(__file__), \"--sheet-only\"], env=env, check=False)\n350:         if res.returncode != 0:\n351:             raise RuntimeError(f\"v6_sv_stills sheet generation failed with code {res.returncode}\")\n352:         # Clean up temporary impact helper if clip3 wasn't rendered yet\n353: else:\n354:     made = [(f, name, os.path.join(OUT, f\"shot_{name}.jpg\"))\n355:             for f, name in SHOTS if os.path.exists(os.path.join(OUT, f\"shot_{name}.jpg\"))]\n356:     print(\"v6 stills found:\", len(made))\n357:     if made:\n358:         build_contact_sheet_v6(made)\n359:         build_comic_page_poster({name: path for _, name, path in made})"}
