e) or bpy.data.materials.new(_mname)\n769:     _ml.use_nodes = True\n770:     if _ml.node_tree.animation_data:\n771:         _ml.node_tree.animation_data_clear()\n772:     _lnt = _ml.node_tree\n773:     _lnt.nodes.clear()\n774:     _lb = _lnt.nodes.new(\"ShaderNodeBsdfPrincipled\")\n775:     _lb.inputs['Base Color'].default_value = (_col[0] * 0.1, _col[1] * 0.1, _col[2] * 0.1, 1.0)\n776:     _lb.inputs['Roughness'].default_value = 0.25\n777:     _lb.inputs['Emission Color'].default_value = (*_col, 1.0)\n778:     _lb.inputs['Emission Strength'].default_value = 0.5\n779:     _lout = _lnt.nodes.new(\"ShaderNodeOutputMaterial\")\n780:     _lnt.links.new(_lb.outputs['BSDF'], _lout.inputs['Surface'])\n781:     for _idx in _rng:\n782:         _lob = bpy.data.objects.get(f\"GEO_F1_ShiftLED_{_idx:02d}\")\n783:         if _lob and hasattr(_lob.data, \"materials\"):\n784:             if _lob.data.materials:\n785:                 _lob.data.materials[0] = _ml\n786:             else:\n787:                 _lob.data.materials.append(_ml)\n788:     shift_led_inputs.append(_lb.inputs['Emission Strength'])\n789: \n790: # ---------------------------------------------------------------------------\n791: # 4. 烘焙三维车身世界轨迹 (24 fps LINEAR) + 局部 12 fps On-Twos 次级动态\n792: # ---------------------------------------------------------------------------\n793: bone_root = rig.pose.bones[\"Bone_Root\"]\n794: bone_heading = rig.pose.bones[\"Bone_Heading\"]\n795: bone_body = rig.pose.bones[\"Bone_Body\"]\n796: bone_heading.rotation_mode = 'XYZ'\n797: bone_body.rotation_mode = 'XYZ'\n798: \n799: cum_spin = 0.0\n800: prev_dist = 0.0\n801: prev_gear = frame_data[1][\"gear\"]\n802: shift_flash = 0.0\n803: brake_heat_state = 0.0\n804: prev_head_euler = None\n805: \n806: for f in range(1, FRAME_END + 1):\n807:     fd = frame_data[f]\n808:     v, acc, k = fd[\"v\"], fd[\"accel\"], fd[\"k\"]\n809:     v_kmh = v * 3.6\n810:     R_v = Vector(fd[\"R\"])\n811:     T_v = Vector(fd[\"T\"])\n812:     U_v = Vector(fd[\"U\"])\n813:     P_v = Vector(fd[\"pos\"])\n814: \n815:     # 三维世界位置与三维正交姿态矩阵 (R=+X, T=+Y, U=+Z) -> 轮胎零高度误差贴合 17.4° 倾角与 ±14° 坡面\n816:     root_world = P_v + U_v * 0.012\n817:     bone_root.location = root_world\n818:     m_rot = Matrix((R_v, T_v, U_v)).transposed()\n819:     eul = m_rot.to_euler('XYZ', prev_head_euler) if prev_head_euler is not None else m_rot.to_euler('XYZ')\n820:     prev_head_euler = eul\n821:     bone_heading.rotation_euler = eul\n822:     bone_root.keyframe_insert(\"location\", frame=f)\n823:     bone_heading.keyframe_insert(\"rotation_euler\", frame=f)\n824: \n825:     # 景深焦点 Empty 同步锁定车身 + 0.45m 法向高度 (24 fps LINEAR)\n826:     cam_focus.location = P_v + U_v * 0.462\n827:     cam_focus.keyframe_insert(\"location\", frame=f)\n828: \n829:     # 随车柔光三维跟随 (24 fps LINEAR)\n830:     for lo, spec in fill_lights:\n831:         lp = P_v + T_v * spec[\"ahead\"] + R_v * spec[\"side\"] + U_v * spec[\"up\"]\n832:         lo.location = lp\n833:         aim_v = (P_v + U_v * 0.45) - lp\n834:         lo.rotation_euler = aim_v.to_track_quat('-Z', 'Y').to_euler()\n835:         lo.keyframe_insert(\"location\", frame=f)\n836:         lo.keyframe_insert(\"rotation_euler\", frame=f)\n837: \n838:     # 次级动态与遥测（仅在奇数帧与末帧写入 CONSTANT -> 正宗 12 fps On-Twos 手绘动画节奏！）\n839:     cum_spin += (fd[\"dist\"] - prev_dist) / R_TIRE\n840:     prev_dist = fd[\"dist\"]\n841: \n842:     gear = fd[\"gear\"]\n843:     if gear != prev_gear:\n844:         shift_flash = 1.0\n845:         prev_gear = gear\n846:     else:\n847:         shift_flash *= 0.72\n848: \n849:     if acc < -2.0:\n850:         brake_pwr = ((-acc - 2.0) / 24.0) * (0.45 + 0.55 * min(1.0, v / 88.0))\n851:         brake_heat_state = min(1.30, brake_heat_state + brake_pwr * (DT / 0.12))\n852:     else:\n853:         tau_cool = 1.70 - 0.50 * min(1.0, v / 88.0)\n854:         brake_heat_state *= exp(-DT / tau_cool)\n855:         if brake_heat_state < 0.003:\n856:             brake_heat_state = 0.0\n857:     fd[\"brake_heat\"] = brake_heat_state\n858:     fd[\"shift_flash\"] = shift_flash\n859: \n860:     if f % 2 == 1 or f == FRAME_END:\n861:         # 坡底正曲率压缩下沉 + 加减速俯仰 + 弯道净横向 G 侧倾\n862:         comp_squat = -0.009 * max(0.0, fd[\"dpitch_dt\"] / 14.0)\n863:         pitch_body = max(-2.1, min(1.6, acc * 0.088)) - 0.22 * shift_flash\n864:         roll_body = max(-2.4, min(2.4, -fd[\"lat_signed\"] * 0.28))\n865:         heave = -0.005 + comp_squat + 0.0018 * sin(f * 1.41) + 0.0010 * sin(f * 2.89)\n866:         bone_body.location = (0.0, 0.0, heave)\n867:         bone_body.rotation_euler = (radians(pitch_body), radians(roll_body), 0.0)\n868:         bone_body.keyframe_insert(\"location\", frame=f)\n869:         bone_body.keyframe_insert(\"rotation_euler\", frame=f)\n870: \n871:         rig[\"wheel_spin\"] = cum_spin\n872:         rig[\"steer\"] = max(-26.0, min(26.0, degrees(k * WHEELBASE)))\n873:         straight = abs(k) < 0.0022\n874:         rig[\"drs\"] = 1.0 if (straight and v_kmh > 245.0) else (0.0 if abs(k) > 0.005 else 0.5)\n875:         rig[\"brake_heat\"] = brake_heat_state\n876:         rig[\"rear_slip\"] = 1.0\n877:         rig[\"susp_f\"] = -0.004 - 0.015 * max(0.0, -acc) / 14.0 + comp_squat * 0.6\n878:         rig[\"susp_r\"] = -0.004 - 0.016 * max(0.0, acc) / 14.0 + comp_squat * 0.6\n879:         for kk in (\"wheel_spin\", \"steer\", \"drs\", \"brake_heat\", \"rear_slip\", \"susp_f\", \"susp_r\"):\n880:             rig.keyframe_insert(f'[\"{kk}\"]', frame=f)\n881: \n882:         bh = brake_heat_state\n883:         for kind, einp, minp in brake_disc_emit_inputs:\n884:             if kind == \"glow_sheet\":\n885:                 einp.default_value = (bh ** 1.2) * 10.5\n886:                 einp.keyframe_insert(\"default_value\", frame=f)\n887:                 minp.default_value = min(0.95, (bh ** 0.8) * 0.90)\n888:                 minp.keyframe_insert(\"default_value\", frame=f)\n889:             else:\n890:                 einp.default_value = (bh ** 1.3) * 6.8\n891:                 einp.keyframe_insert(\"default_value\", frame=f)\n892:         for cinp in caliper_emit_inputs:\n893:             cinp.default_value = max(0.0, bh - 0.28) * 1.8\n894:             cinp.keyframe_insert(\"default_value\", frame=f)\n895: \n896:         if rain_emit_input is not None:\n897:             if acc < -2.5 or fd[\"tunnel\"]:\n898:                 pulse_on = ((fd[\"t\"] * 6.0) % 1.0) < 0.55\n899:                 rain_emit_input.default_value = 28.0 if pulse_on else (3.5 if fd[\"tunnel\"] else 1.4)\n900:             else:\n901:                 rain_emit_input.default_value = 3.2\n902:             rain_emit_input.keyframe_insert(\"default_value\", frame=f)\n903: \n904:         rf = fd[\"rpm_frac\"]\n905:         if len(shift_led_inputs) == 3:\n906:             shift_led_inputs[0].default_value = 8.5 if rf > 0.26 else 0.4\n907:             shift_led_inputs[1].default_value = 9.5 if rf > 0.56 else 0.3\n908:             shift_led_inputs[2].default_value = (15.0 if shift_flash > 0.45 else 10.5) if rf > 0.80 else 0.25\n909:             for sinp in shift_led_inputs:\n910:                 sinp.keyframe_insert(\"default_value\", frame=f)\n911: \n912: # 设置 RIG 曲线插值：Bone_Root & Bone_Heading 为 LINEAR，其余全部 CONSTANT (12fps On-Twos)\n913: if rig.animation_data and rig.animation_data.action:\n914:     for fc in iter_fcurves(rig.animation_data.action):\n915:         is_world = (\"Bone_Root\" in fc.data_path) or (\"Bone_Heading\" in fc.data_path)\n916:         for kp in fc.keyframe_points:\n917:             kp.interpolation = 'LINEAR' if is_world else 'CONSTANT'\n918:         fc.update()\n919: \n920: for mat in bpy.data.materials:\n921:     if mat.node_tree and mat.node_tree.animation_data and mat.node_tree.animation_data.action:\n922:         for fc in iter_fcurves(mat.node_tree.animation_data.action):\n923:             for kp in fc.keyframe_points:\n924:                 kp.interpolation = 'CONSTANT'\n925:             fc.update()\n926: \n927: # ---------------------------------------------------------------------------\n928: # 5. 驱动 V6_09_ComicFX 三维速度特效（涡流彩带 / 尾焰菱形激波 / 钛合金火花 / 湿胎水雾弧 / 车轮残影）\n929: # ---------------------------------------------------------------------------\n930: fx_coll = bpy.data.collections.get(\"V6_09_ComicFX\")\n931: fx_objs = list(fx_coll.all_objects) if fx_coll else [\n932:     o for o in bpy.data.objects if o.name.startswith((\"V6_FX_\", \"SV_FX_\"))\n933: ]\n934: ONBOARD_WINDOWS = [(f0, f1) for _, f0, f1, typ, _ in windows if typ == \"onboard\"]\n935: \n936: \n937: def _is_onboard_frame(f):\n938:     return any(a <= f <= b for a, b in ONBOARD_WINDOWS)\n939: \n940: \n941: fx_stats = dict(vortex=0, smear=0, exhaust=0, sparks=0, spray=0)\n942: for idx, fob in enumerate(fx_objs):\n943:     if fob.type not in ('MESH', 'CURVE'):\n944:         continue\n945:     if fob.animation_data:\n946:         fob.animation_data_clear()\n947:     nm_low = fob.name.lower()\n948:     base_s = tuple(fob.scale)\n949:     base_r = tuple(fob.rotation_euler)\n950: \n951:     is_wheel = any(k in nm_low for k in (\"wheel\", \"smear\", \"rim\"))\n952:     is_exhaust = any(k in nm_low for k in (\"exhaust\", \"shock\", \"diamond\", \"afterburn\", \"burst\", \"cone\", \"flame\"))\n953:     is_spark = any(k in nm_low for k in (\"spark\", \"plank\", \"titanium\", \"scrape\", \"slash\"))\n954:     is_spray = any(k in nm_low for k in (\"spray\", \"rooster\", \"mist\", \"wake\", \"water\"))\n955:     is_front = any(k in nm_low for k in (\"front\", \"fw_\", \"_fl\", \"_fr\", \"nose\"))\n956: \n957:     if is_wheel:\n958:         fx_stats[\"smear\"] += 1\n959:     elif is_exhaust:\n960:         fx_stats[\"exhaust\"] += 1\n961:     elif is_spark:\n962:         fx_stats[\"sparks\"] += 1\n963:     elif is_spray:\n964:         fx_stats[\"spray\"] += 1\n965:     else:\n966:         fx_stats[\"vortex\"] += 1\n967: \n968:     for f in range(1, FRAME_END + 1, 2):\n969:         fd = frame_data[f]\n970:         v_kmh = fd[\"v\"] * 3.6\n971:         if is_wheel:\n972:             gate = max(0.0, min(1.0, (v_kmh - 80.0) / 60.0))\n973:             if gate <= 0.02:\n974:                 fob.scale = (0.001, 0.001, 0.001)\n975:             else:\n976:                 jit = 0.88 + 0.25 * abs(sin(f * 2.3 + idx * 1.4))\n977:                 fob.scale = (base_s[0], base_s[1] * gate * jit, base_s[2] * gate * jit)\n978:                 fob.rotation_euler = (base_r[0] + 0.45 * sin(f * 3.3 + idx * 2.0), base_r[1], base_r[2])\n979:                 fob.keyframe_insert(\"rotation_euler\", frame=f)\n980:         elif is_exhaust:\n981:             # 换挡爆震、重刹降档回火、以及隧道/坡道全油门加速时喷出双排气管激波菱形火舌!\n982:             full_pull = (v_kmh > 285.0 and fd[\"accel\"] > -0.5 and ((f // 2 + idx) % 2 == 0))\n983:             pop = (fd[\"shift_flash\"] > 0.35) or (fd[\"accel\"] < -5.5 and ((f // 2) % 2 == 0))\n984:             if pop or full_pull:\n985:                 amp = 1.38 if fd[\"shift_flash\"] > 0.45 else (1.05 + 0.32 * abs(sin(f * 3.7 + idx)))\n986:                 fob.scale = (base_s[0] * amp, base_s[1] * amp * 1.2, base_s[2] * amp)\n987:             else:\n988:                 fob.scale = (0.001, 0.001, 0.001)\n989:         elif is_spark:\n990:             # Eau-Rouge 坡底压缩 (f=268..318)、Corkscrew 坡底拉平 (f=840..880)、>305km/h 极速颠簸或压路肩时狂飙金色钛合金火花!\n991:             compression_zone = (266 <= f <= 324) or (406 <= f <= 422) or (838 <= f <= 885)\n992:             kerb_hit = (fd[\"kerb_prox\"] > 0.48 and v_kmh > 110.0 and ((f // 2 + idx) % 2 == 0))\n993:             high_v_scrape = (v_kmh > 302.0 and ((f // 2 + idx) % 2 == 0))\n994:             if compression_zone or kerb_hit or high_v_scrape:\n995:                 amp = (1.45 if compression_zone else 1.10) * (0.85 + 0.35 * abs(sin(f * 2.9 + idx)))\n996:                 fob.scale = (base_s[0] * amp, base_s[1] * amp * 1.25, base_s[2] * amp)\n997:             else:\n998:                 fob.scale = (0.001, 0.001, 0.001)\n999:         elif is_spray:\n1000:             gate = max(0.0, min(1.25, (v_kmh - 135.0) / 140.0))\n1001:             if gate <= 0.03 or (_is_onboard_frame(f) and is_front):\n1002:                 fob.scale = (0.001, 0.001, 0.001)\n1003:             else:\n1004:                 fl = 0.88 + 0.26 * abs(cos(f * 2.7 + idx))\n1005:                 fob.scale = (base_s[0] * fl, base_s[1] * gate, base_s[2] * gate * fl)\n1006:         else:\n1007:             drs_b = 1.32 if (abs(fd[\"k\"]) < 0.0022 and v_kmh > 245.0) else 1.0\n1008:             gate = max(0.0, min(1.0, (v_kmh - 205.0) / 55.0)) * drs_b\n1009:             if gate <= 0.02 or (_is_onboard_frame(f) and is_front):\n1010:                 fob.scale = (0.001, 0.001, 0.001)\n1011:             else:\n1012:                 fx_w = 1.0 + 0.18 * sin(f * 2.5 + idx * 1.7)\n1013:                 fz_w = 1.0 + 0.22 * cos(f * 3.1 + idx * 2.3)\n1014:                 fob.scale = (base_s[0] * fx_w, base_s[1] * min(1.5, gate), base_s[2] * fz_w)\n1015:         fob.keyframe_insert(\"scale\", frame=f)\n1016: \n1017:     if fob.animation_data and fob.animation_data.action:\n1018:         for fc in iter_fcurves(fob.animation_data.action):\n1019:             for kp in fc.keyframe_points:\n1020:                 kp.interpolation = 'CONSTANT'\n1021:             fc.update()\n1022: \n1023: for mat in bpy.data.materials:\n1024:     if mat.name.startswith(\"MAT_SV_\") and mat.node_tree:\n1025:         fl_node = mat.node_tree.nodes.get(\"SV_FlutterPhase\")\n1026:         if fl_node and fl_node.outputs:\n1027:             if mat.node_tree.animation_data:\n1028:                 mat.node_tree.animation_data_clear()\n1029:             for f in range(1, FRAME_END + 1, 2):\n1030:                 fl_node.outputs[0].default_value = float((f // 2) * 0.41)\n1031:                 fl_node.outputs[0].keyframe_insert(\"default_value\", frame=f)\n1032:             if mat.node_tree.animation_data and mat.node_tree.animation_data.action:\n1033:                 for fc in iter_fcurves(mat.node_tree.animation_data.action):\n1034:                     