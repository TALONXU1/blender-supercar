icro_vib(f, 57.0, 0.25)\n451:             lens = pr[\"lens0\"] + (pr[\"lens1\"] - pr[\"lens0\"]) * e\n452:             up_vec = fd[\"U\"]\n453: \n454:         elif s_typ == \"orbit\":\n455:             ang = radians(pr[\"a0\"] + (pr[\"a1\"] - pr[\"a0\"]) * e)\n456:             rad = pr[\"r0\"] + (pr[\"r1\"] - pr[\"r0\"]) * e\n457:             up = pr[\"h0\"] + (pr[\"h1\"] - pr[\"h0\"]) * e\n458:             # 沿赛道切向 cos(ang) 与法平面右向 -sin(ang) 环绕，并自动约束在护栏/隧道内\n459:             back = -rad * cos(ang)\n460:             side = -rad * sin(ang)\n461:             loc = safe_track_cam_pos(fd, back=back, rel_side=side, up=up, max_cl=5.6 if fd[\"tunnel\"] else 6.3)\n462:             tgt = _v_add(fd[\"pos\"], _v_mul(fd[\"U\"], 0.45))\n463:             roll = pr[\"roll\"] + (pr[\"roll_end\"] - pr[\"roll\"]) * e\n464:             lens = pr[\"lens\"]\n465:             up_vec = _v_norm(_v_lerp(fd[\"U\"], (0.0, 0.0, 1.0), 0.25))\n466: \n467:         elif s_typ == \"fixed\":\n468:             loc = fixed_loc\n469:             tgt_raw = _v_add(fd[\"pos\"], _v_mul(fd[\"U\"], 0.44))\n470:             aim_prev = tgt_raw if aim_prev is None else _v_lerp(aim_prev, tgt_raw, pr.get(\"aim_lerp\", 0.72))\n471:             tgt = aim_prev\n472:             dv = _v_sub(loc, fd[\"pos\"])\n473:             d = max(2.0, _v_len(dv))\n474:             cos_a = abs(_v_dot(fd[\"T\"], _v_norm(dv)))\n475:             lens = lens_for_framing(d, pr[\"framing\"], cos_a, lo=18.0, hi=pr.get(\"max_lens\", 280.0))\n476:             roll = pr.get(\"roll\", 0.0)\n477:             up_vec = _v_norm(_v_lerp(fixed_up, (0.0, 0.0, 1.0), 0.5))\n478: \n479:         elif s_typ == \"onboard\":\n480:             vib = 0.0014 + 0.0022 * v_fac + 0.0025 * kerb\n481:             lx = pr.get(\"side\", 0.0) + micro_vib(f, 71.0, vib * 0.7)\n482:             ly = pr[\"fwd\"] + micro_vib(f, 72.0, vib * 0.4)\n483:             lz = pr[\"h\"] + micro_vib(f, 73.0, vib)\n484:             loc = _v_add(fd[\"pos\"], _v_add(_v_mul(fd[\"R\"], lx