ion = 'CENTER'\r\n634: scene.render.image_settings.file_format = 'JPEG'\r\n635: scene.render.image_settings.quality = 95\r\n636: scene.render.filepath = os.path.join(FRAMES_DIR, \"f_\")\r\n637: scene.view_settings.view_transform = 'AgX'\r\n638: for look in ('High Contrast', 'AgX - High Contrast', 'Medium High Contrast'):\r\n639:     try:\r\n640:         scene.view_settings.look = look\r\n641:         break\r\n642:     except Exception:\r\n643:         continue\r\n644: scene.view_settings.exposure = 0.50\r\n645: scene.view_settings.gamma = 1.0\r\n646: \r\n647: # 泛光\r\n648: try:\r\n649:     ng = bpy.data.node_groups.new(\"Comp_V5\", 'CompositorNodeTree')\r\n650:     rl = ng.nodes.new(\"CompositorNodeRLayers\")\r\n651:     glare = ng.nodes.new(\"CompositorNodeGlare\")\r\n652:     for val in (\"Bloom\", \"BLOOM\", \"bloom\"):\r\n653:         try:\r\n654:             glare.inputs['Type'].default_value = val\r\n655:             break\r\n656:         except Exception:\r\n657:             continue\r\n658:     for nm, v in ((\"Threshold\", 2.0), (\"Strength\", 0.16), (\"Size\", 6)):\r\n659:         if nm in glare.inputs:\r\n660:             try:\r\n661:                 glare.inputs[nm].default_value = v\r\n662:             except Exception:\r\n663:                 pass\r\n664:     try:\r\n665:         comp = ng.nodes.new(\"CompositorNodeComposite\")\r\n666:     except Exception:\r\n667:         comp = ng.nodes.new(\"NodeGroupOutput\")\r\n668:         if not any(s.name == \"Image\" for s in ng.interface.items_tree):\r\n669:             ng.interface.new_socket(name=\"Image\", in_out='OUTPUT', socket_type='NodeSocketColor')\r\n670:     ng.links.new(rl.outputs['Image'], glare.inputs['Image'])\r\n671:     ng.links.new(glare.outputs['Image'], comp.inputs['Image'])\r\n672:     scene.compositing_node_group = ng\r\n673:     scene.use_nodes = True\r\n674:     print(\"COMPOSITOR OK\")\r\n675: except Exception as e:\r\n676:     print(\"COMPOSITOR FAILED:\", e)\r\n677: \r\n678: bpy.ops.w