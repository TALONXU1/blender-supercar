lar_factor = 0.0        # 核心关键：压零太阳镜面分量，湿滑沥青只反射建筑霓虹/斜拉索/车灯，零太阳白楔！\\nadd_dim_driver(_sl, \\\"energy\\\", \\\"5.4 + 1.2*max(0.0, 1.0-abs(dim-1.0)) + 0.4*max(0.0, dim-1.0)\\\")\\nadd_dim_driver(_sl, \\\"color\\\", \\\"1.0 if dim < 1.0 else 0.82\\\", 0)\\nadd_dim_driver(_sl, \\\"color\\\", \\\"0.84 - 0.18*max(0.0, dim-1.0)\\\", 1)\\nadd_dim_driver(_sl, \\\"color\\\", \\\"0.75 + 0.25*min(1.0, max(0.0, dim))\\\", 2)\\n_sun_ob = bpy.data.objects.new(\\\"LGT_V6Sun\\\", _sl)\\nCOLLS[\\\"V6_07_Lighting\\\"].objects.link(_sun_ob)\\n_sun_ob.rotation_euler = Euler((radians(90.0 - 20.0), 0.0, _sun_az - pi / 2.\n<truncated 53452 bytes>","Path":"\"D:\\\\项目session\\\\blender-supercar\\\\pipeline\\\\v6_sv_env.py\""}}],"truncated_fields":["tool_calls"]}
