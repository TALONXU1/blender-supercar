ise.inputs['Scale'].default_value = 2.8\n506:         c_noise.inputs['Detail'].default_value = 5.0\n507:         c_noise.inputs['Distortion'].default_value = 1.4\n508:         snt.links.new(c_scale.outputs['Vector'], c_noise.inputs['Vector'])\n509:         c_step = snt.nodes.new('ShaderNodeValToRGB')\n510:         c_step.color_ramp.interpolation = 'CONSTANT'\n511:         c_step.color_ramp.elements[0].position = 0.0\n512:         c_step.color_ramp.elements[0].color = (0.0, 0.0, 0.0, 1.0)\n513:         c_step.color_ramp.elements[1].position = 0.62\n514:         c_step.color_ramp.elements[1].color = (0.16, 0.12, 0.20, 1.0)\n515:         snt.links.new(c_noise.outputs['Fac'], c_step.inputs[0])\n516: \n517:         add_sun = snt.nodes.new('ShaderNodeMixRGB')\n518:         add_sun.blend_type = 'ADD'\n519:         add_sun.inputs['Factor'].default_value = 0.75\n520:         snt.links.new(m123.outputs['Color'], add_sun.inputs['Color1'])\n521:         snt.links.new(sun_rings.outputs['Color'], add_sun.inputs['Color2'])\n522: \n523:         add_cld = snt.nodes.new('ShaderNodeMixRGB')\n524:         add_cld.blend_type = 'SCREEN'\n525:         add_cld.inputs['Factor'].default_value = 0.45\n526:         snt.links.new(add_sun.outputs['Color'], add_cld.inputs['Color1'])\n527:         snt.links.new(c_step.outputs['Color'], add_cld.inputs['Color2'])\n528: \n529:         snt.links.new(add_cld.outputs['Color'], sem.inputs['Color'])\n530:         snt.links.new(sem.outputs['Emission'], sout.inputs['Surface'])\n531: \n532: \n533: upgrade_sky_and_lights()\n534: \n535: \n536: # ---------------------------------------------------------------\n537: # 3. 赛车与赛道材质全面转化为蜘蛛侠漫画着色器（严格保留动态发光动画曲线！）\n538: # ---------------------------------------------------------------\n539: def apply_comic_to_mat(mat, base_rgb=None, rim=0.85, ht_scale=96.0, ht_str=0.52, hc_str=0.50, swap_img=None):\n540:     if not mat or not mat.use_nodes:\n541:         return\n542:     nt = mat.node_tree\n543:     # 若该材质本身带有动画曲线（刹车热辉光