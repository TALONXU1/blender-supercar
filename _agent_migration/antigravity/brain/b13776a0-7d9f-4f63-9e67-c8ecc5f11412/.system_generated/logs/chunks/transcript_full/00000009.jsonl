[1])\n586:             nt.links.new(grp.outputs['Shader'], mx.inputs[2])\n587:             nt.links.new(mx.outputs['Shader'], out.inputs['Surface'])\n588:             return\n589:     else:\n590:         grp.inputs['Base Color'].default_value = (*base_rgb, 1.0)\n591: \n592:     nt.links.new(grp.outputs['Shader'], out.inputs['Surface'])\n593: \n594: \n595: # A) 替换赛道漫画贴图材质（维修车库 / 广告牌 / 大屏 / 刹车牌 / DRS 牌）\n596: _TEX_SWAPS = {\n597:     \"V5_PitGarage\": (\"sv_pit_garage.png\", 0.35),\n598:     \"V5_AdBoard\": (\"sv_ad_boards.png\", 0.55),\n599:     \"V5_BigScreen\": (\"sv_bigscreen.png\", 0.95),\n600:     \"V5_DRSBoard\": (\"sv_drs_board.png\", 0.45),\n601:     \"V5_Brake150\": (\"sv_brake_150.png\", 0.35),\n602:     \"V5_Brake100\": (\"sv_brake_100.png\", 0.35),\n603:     \"V5_Brake50\": (\"sv_brake_50.png\", 0.35),\n604: }\n605: for _mn, (_fn, _em_boost) in _TEX_SWAPS.items():\n606:     _m = bpy.data.materials.get(_mn)\n607:     _fp = os.path.join(TEX_SV, _fn)\n608:     if _m and os.path.exists(_fp):\n609:         _nt = _m.node_tree\n610:         _nt.nodes.clear()\n611:         _img = bpy.data.images.load(_fp, check_existing=True)\n612:         _tn = _nt.nodes.new('ShaderNodeTexImage')\n613:         _tn.image = _img\n614:         _tn.extension = 'REPEAT'\n615:         _grp = _nt.nodes.new('ShaderNodeGroup')\n616:         _grp.node_tree = NG_COMIC\n617:         _grp.inputs['Rim Strength'].default_value = 0.08\n618:         _grp.inputs['Halftone Strength'].default_value = 0.30\n619:         _grp.inputs['Hatch Strength'].default_value = 0.25\n620:         _nt.links.new(_tn.outputs['Color'], _grp.inputs['Base Color'])\n621:         _em = _nt.nodes.new('ShaderNodeEmission')\n622:         _em.inputs['Strength'].default_value = _em_boost\n623:         _nt.links.new(_tn.outputs['Color'], _em.inputs['Color'])\n624:         _add = _nt.nodes.new('ShaderNodeAddShader')\n625:         _nt.links.new(_grp.outputs['Shader'], _add.inputs[0])\n626:         _nt.links.new(_em.outputs['Emission'], _add.inputs[1])\n627:         _out = _nt.nodes.new('ShaderNodeOutputMaterial')\n628:         _nt.links.new(_add.outputs['Shader'], _out.inputs['Surface'])\n629: \n630: # B) 赛道地面系漫画材质：手绘笔刷流线沥青、高饱和红白青漫画路肩、色块草坪（全部零高光防炫光！）\n631: def style_track_surfaces():\n632:     # 沥青：深蓝紫漫画底色 + 沿赛道高速手绘笔刷流线 + 本戴网点\n633:     m_asp = bpy.data.materials.get(\"V5_Asphalt\")\n634:     if m_asp:\n635:         nt = m_asp.node_tree\n636:         nt.nodes.clear()\n637:         out = nt.nodes.new('ShaderNodeOutputMaterial')\n638:         grp = nt.nodes.new('ShaderNodeGroup')\n639:         grp.node_tree = NG_COMIC\n640:         grp.inputs['Rim Strength'].default_value = 0.0\n641:         grp.inputs['Halftone Scale'].default_value = 84.0\n642:         grp.inputs['Halftone Strength'].default_value = 0.42\n643:         grp.inputs['Hatch Strength'].default_value = 0.48\n644:         uv = nt.nodes.new('ShaderNodeUVMap'); uv.uv_map = \"UVMap\"\n645:         sep = nt.nodes.new('ShaderNodeSeparateXYZ'); nt.links.new(uv.outputs['UV'], sep.inputs['Vector'])\n646:         comb = nt.nodes.new('ShaderNodeCombineXYZ')\n647:         mx = nt.nodes.new('ShaderNodeMath'); mx.operation = 'MULTIPLY'; mx.inputs[1].default_value = 26.0\n648:         my = nt.nodes.new('ShaderNodeMath'); my.operation = 'MULTIPLY'; my.inputs[1].default_value = 0.45\n649:         nt.links.new(sep.outputs['X'], mx.inputs[0]); nt.links.new(sep.outputs['Y'], my.inputs[0])\n650:         nt.links.new(mx.outputs['Value'], comb.inputs['X']); nt.links.new(my.outputs['Value'], comb.inputs['Y'])\n651:         ns = nt.nodes.new('ShaderNodeTexNoise'); ns.inputs['Scale'].default_value = 3.2; ns.inputs['Detail'].default_value = 4.0\n652:         nt.links.new(comb.outputs['Vector'], ns.inputs['Vector'])\n653:         cr = nt.nodes.new('ShaderNodeValToRGB'); cr.color_ramp.interpolation = 'CONSTANT'\n654:         cr.color_ramp.elements[0].position = 0.0; cr.color_ramp.elements[0].color = (0.048, 0.045, 0.088, 1.0)\n655:         e1 = cr.color_ram