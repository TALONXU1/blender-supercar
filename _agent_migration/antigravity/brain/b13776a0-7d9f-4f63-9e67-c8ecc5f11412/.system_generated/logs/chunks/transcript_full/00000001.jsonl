: for (a, b) in _runs:\r\n1084:     vmin = min(VEL[a:b + 1]) * 3.6\r\n1085:     if vmin < 130 and (b - a) > 15 and _bi < 3:\r\n1086:         apex_s = (S[a] + S[b]) / 2\r\n1087:         side = 1 if SIGNED_K[a] > 0 else -1\r\n1088:         _poles = Parts(f\"V5_Brake_{_bi}_Poles\")\r\n1089:         _boards, _bases, _hs = [], [], []\r\n1090:         for dist_, num in ((150, \"150\"), (100, \"100\"), (50, \"50\")):\r\n1091:             _ob, _bs, _hh = brake_board(apex_s - dist_, side, num, _poles, name=f\"V5_Brake_{_bi}_{num}\")\r\n1092:             _boards.append(_ob)\r\n1093:             _bases.append(_bs)\r\n1094:             _hs.append(_hh)\r\n1095:         _ctr = Vector(((min(b.x for b in _bases) + max(b.x for b in _bases)) / 2,\r\n1096:                        (min(b.y for b in _bases) + max(b.y for b in _bases)) / 2, 0.0))\r\n1097:         assembly(f\"V5_Brake_{_bi}\", (_ctr.x, _ctr.y, 0.0), _hs[1], _boards + [_poles.build()], size=3.0)\r\n1098:         _bi += 1\r\n1099: print(\"brake boards:\", _bi * 3)\r\n1100: \r\n1101: # ③ 大屏：维修区出口内侧 + 赛道中段（避开车库楼遮挡）\r\n1102: bigscreen(560.0, -1, name=\"V5_Screen_A\")\r\n1103: bigscreen(2600.0, -1, name=\"V5_Screen_B\")\r\n1104: \r\n1105: # ④ 人行天桥：两条直道\r\n1106: footbridge(950.0, \"V5_Bridge_A\")\r\n1107: footbridge(2950.0, \"V5_Bridge_B\")\r\n1108: \r\n1109: # ⑤ 裁判点小棚（沿赛道每 ~830 m 一个）；每个一个 Empty V5_Marshal_{i}\r\n1110: for i in range(7):\r\n1111:     sp = LAP_LEN * i / 7.0\r\n1112:     p, h, r, k = at_s(sp)\r\n1113:     side = 1 if i % 2 == 0 else -1\r\n1114:     bp = p + r * (side * (HALF_W + 5.0))\r\n1115:     _hut = box(f\"V5_Marshal_{i}_Hut\", (bp.x, bp.y, 0.7), (1.6, 1.1, 1.4), M_CONC, rot_z=h)\r\n1116:     _lamp = box(f\"V5_Marshal_{i}_Lamp\", (bp.x, bp.y, 1.55), (0.25, 0.25, 0.12), M_STRIP, rot_z=h)\r\n1117:     assembly(f\"V5_Marshal_{i}\", (bp.x, bp.y, 0.0), h, [_hut, _lamp], size=2.0)\r\n1118: print(\"marshal posts:\", 7)\r\n1119: \r\n1120: \r\n1121: # ---------------------------------------------------------------\r\n1122: # 12. 场地外围：机库 / 树线 / 灯柱\r\n1123: # ---------------------------------------------------------------\r\n1124: random.seed(23)\r\n1125: for i in range(6):\r\n1126:     a = random.uniform(0, 2 * pi)\r\n1127:     rad = random.uniform(700, 1250)\r\n1128:     bx = _cx + cos(a) * rad\r\n1129:     by = _cy + sin(a) * rad\r\n1130:     w = random.uniform(40, 90)\r\n1131:     d = random.uniform(30, 60)\r\n1132:     hgt = random.uniform(9, 18)\r\n1133:     box(f\"V5_Hangar_{i}\", (bx, by, hgt / 2), (w, d, hgt), M_HANGAR, rot_z=random.uniform(0, pi))\r\n1134: \r\n1135: # 场地边界：低矮灌篱 + 围网（远景轮廓，不做树）\r\n1136: _tree_mat = new_mat(\"V5_Tree\", (0.016, 0.030, 0.013), 0.9)\r\n1137: _tv, _tf = [], []\r\n1138: _hedge_v = []\r\n1139: for i in range(240):\r\n1140:     a = 2 * pi * i / 240.0\r\n1141:     rad = 1150.0 + 220.0 * sin(a * 2.3 + 0.7) + 90.0 * sin(a * 5.1)\r\n1142:     bx = _cx + cos(a) * rad\r\n1143:     by = _cy + sin(a) * rad\r\n1144:     hgt = 2.4 + 1.6 * (0.5 + 0.5 * sin(a * 7.0))\r\n1145:     _hedge_v.append((bx, by, hgt))\r\n1146: for i in range(239):\r\n1147:     a = len(_tv)\r\n1148:     x0, y0, h0 = _hedge_v[i]\r\n1149:     x1, y1, h1 = _hedge_v[i + 1]\r\n1150:     _tv += [(x0, y0, 0), (x1, y1, 0), (x1, y1, h1), (x0, y0, h0)]\r\n1151:     _tf.append((a, a + 1, a + 2, a + 3))\r\n1152: mesh_from(\"V5_HedgeRing\", _tv, _tf, _tree_mat, up=False)\r\n1153: \r\n1154: # 场地灯柱（12 根，沿赛道每 480 m）\r\n1155: _lv, _lf = [], []\r\n1156: for i in range(12):\r\n1157:     sp = LAP_LEN * i / 12.0\r\n1158:     p, h, r, k = at_s(sp)\r\n1159:     side = 1 if i % 2 == 0 else -1\r\n1160:     o = side * (HALF_W + 42.0)\r\n1161:     px, py = p.x + r.x * o, p.y + r.y * o\r\n1162:     base = len(_lv)\r\n1163:     _lv += [(px - 0.12, py - 0.12, 0), (px + 0.12, py - 0.12, 0), (px + 0.12, py + 0.12, 0),\r\n1164:             (px - 0.12, py + 0.12, 0), (px - 0.12, py - 0.12, 16), (px + 0.12, py - 0.12, 16),\r\n1165:             (px + 0.12, py + 0.12, 16), (px - 0.12, py + 0.12, 16)]\r\n1166:     _lf += [(base + 0, base + 1, base + 5, base + 4), (base + 1, base + 2, base + 6, base + 5),\r\n1167:             (base + 2, base + 3, base + 7, base + 6), (base + 3, base + 0, base + 4, base + 7)]\r\n1168:     # 灯头\r\n1169:     hb = len(_lv)\r\n1170:     _lv += [(px - 0.9, py - 0.25, 15.6), (px + 0.9, py - 0.25, 15.6),\r\n1171:             (px + 0.9, py + 0.25, 15.6), (px - 0.9, py + 0.25, 15.6)]\r\n1172:     _lf += [(hb, hb + 1, hb + 2, hb + 3)]\r\n1173: mesh_from(\"V5_FieldMasts\", _lv, _lf, M_STEEL, up=False)\r\n1174: \r\n1175: print(\"ENV BUILD DONE\")\r\n1176: print(\"objects:\", len(bpy.data.objects), \"materials:\", len(bpy.data.materials))\r\n1177: \r\n1178: \r\n1179: # ---------------------------------------------------------------\r\n1180: # 13. 工程整理：原点归位 + 组件 Empty 父子 + 集合分组（让场景在 Blender 里能手工编辑）\r\n1181: # ---------------------------------------------------------------\r\n1182: _GROUPS = {\r\n1183:     \"V5_01_Road\": (\"V5_Track\", \"V5_RacingLine\", \"V5_Line_\", \"V5_Kerb_\",\r\n1184:                    \"V5_StartLine\", \"V5_PitLane\", \"V5_PitLine\", \"V5_PitBoxLine\"),\r\n1185:     \"V5_02_Terrain\": (\"V5_Ground\", \"V5_Verge_\", \"V5_Gravel_\", \"V5_HedgeRing\", \"V5_SkyDome\"),\r\n1186:     \"V5_03_Barriers\": (\"V5_Barrier\", \"V5_FencePosts\"),\r\n1187:     \"V5_04_Stands\": (\"V5_Stand_\",),\r\n1188:     \"V5_05_Pit\": (\"V5_PitWall\", \"V5_PitGarage\", \"V5_PitRoof\", \"V5_PitTop\"),\r\n1189:     \"V5_06_Props\": (\"V5_Ad_\", \"V5_Brake_\", \"V5_Screen_\", \"V5_Bridge_\",\r\n1190:                     \"V5_Marshal_\", \"V5_FieldMasts\", \"V5_Hangar_\",\r\n1191:                     \"V5_Gantry\", \"V5_StartLight\"),\r\n1192:     \"V5_07_Lighting\": (\"LGT_V5\",),\r\n1193: }\r\n1194: \r\n1195: # 13a. 原点归位：只处理\"网格烘焙在世界坐标里\"的对象（location/rotation 为 0、scale 为 1）。\r\n1196: #      box()/球体等本来就以自身中心为原点（location 已是世界位置），不动。\r\n1197: #      注意：新建对象在 depsgraph 更新前 matrix_world 是单位阵——旧版就是读了它，\r\n1198: #      把 441 个 box 对象的 location 改成了 (0,0,0)，全堆在世界原点。这里先 update，\r\n1199: #      并且只用 matrix_basis（不依赖 depsgraph）判断。\r\n1200: bpy.context.view_layer.update()\r\n1201: _moved = 0\r\n1202: _I4 = Matrix.Identity(4)\r\n1203: for _ob in list(bpy.data.objects):\r\n1204:     if _ob.type != 'MESH' or not _ob.name.startswith(\"V5_\") or _ob.parent is not None:\r\n1205:         continue\r\n1206:     if not _ob.data.vertices:\r\n1207:         continue\r\n1208:     _mb = _ob.matrix_basis\r\n1209:     if any(abs(_mb[i][j] - _I4[i][j]) > 1e-9 for i in range(4) for j in range(4)):\r\n1210:         continue                                   # 已有自身变换 = 已以几何中心为原点\r\n1211:     _xs = [_v.co.x for _v in _ob.data.vertices]\r\n1212:     _ys = [_v.co.y for _v in _ob.data.vertices]\r\n1213:     _zs = [_v.co.z for _v in _ob.data.vertices]\r\n1214:     _c = Vector(((min(_xs) + max(_xs)) / 2, (min(_ys) + max(_ys)) / 2, (min(_zs) + max(_zs)) / 2))\r\n1215:     _ob.data.transform(Matrix.Translation(-_c))\r\n1216:     _ob.data.update()\r\n1217:     _ob.location = _c\r\n1218:     _moved += 1\r\n1219: bpy.context.view_layer.update()\r\n1220: \r\n1221: # 13b. 组件 Empty 父子：保持世界变换（child.matrix_basis = parent⁻¹ · child_world，parent_inverse = I），\r\n1222: #      这样子物体的 location 直接读作\"相对组件中心\"的坐标，移动/旋转 Empty 整个组件跟着走。\r\n1223: _parented = 0\r\n1224: for _em, _parts in ASSEMBLIES:\r\n1225:     _inv = _em.matrix_basis.inverted()\r\n1226:     for _ob in _parts:\r\n1227:         _mw = _ob.matrix_basis.copy()             # 未挂父时 matrix_basis == 世界变换\r\n1228:         _ob.parent = _em\r\n1229:         _ob.matrix_parent_inverse = Matrix.Identity(4)\r\n1230:         _ob.matrix_basis = _inv @ _mw\r\n1231:         _parented += 1\r\n1232: bpy.context.view_layer.update()\r\n1233: print(\"assemblies: %d empties, %d parented parts\" % (len(ASSEMBLIES), _parented))\r\n1234: \r\n1235: _root = scene.collection\r\n1236: _cols = {}\r\n1237: for _g in _GROUPS:\r\n1238:     _cc = bpy.data.collections.get(_g) or bpy.data.collections.new(_g)\r\n1239:     if _cc.name not in _root.children:\r\n1240:         _root.children.link(_cc)\r\n1241:     _cols[_g] = _cc\r\n1242: \r\n1243: \r\n1244: def _bucket(nm):\r\n1245:     for _g, _ps in _GROUPS.items():\r\n1246:         for _p in _ps:\r\n1247:             if nm.startswith(_p):\r\n1248:                 return _g\r\n1249:     return None\r\n1250: \r\n1251: \r\n1252: _reg = 0\r\n1253: for _ob in list(bpy.data.objects):\r\n1254:     _g = _bucket(_ob.name)\r\n1255:     if not _g:\r\n1256:         continue\r\n1257:     for _c in list(_ob.users_collection):\r\n1258:         _c.objects.unlink(_ob)\r\n1259:     _cols[_g].objects.link(_ob)\r\n1260:     _reg += 1\r\n1261: print(\"organize: origin_to_geometry=%d  regrouped=%d\" % (_moved, _reg))\r\n1262: \r\n1263: # 13c. 清掉空的杂乱集合（v4 遗留：09_Studio_Stage_Rig、WheelSpokes_*，都是 0 对象 0 子集合）\r\n1264: _dropped = []\r\n1265: for _c in list(bpy.data.collections):\r\n1266:     if (_c.name == \"09_Studio_Stage_Rig\" or _c.name.startswith(\"WheelSpokes_\")) \\\r\n1267:             and len(_c.all_objects) == 0 and len(_c.children) == 0:\r\n1268:         _dropped.append(_c.name)\r\n1269:         bpy.data.collections.remove(_c)\r\n1270: print(\"removed empty collections:\", _dropped)\r\n1271: print(\"FINAL objects:\", len(bpy.data.objects),\r\n1272:       \"| V5 meshes:\", sum(1 for o in bpy.data.objects if o.type == 'MESH' and o.name.startswith(\"V5_\")),\r\n1273:       \"| empties:\", sum(1 for o in bpy.data.objects if o.type == 'EMPTY'))\r\n1274: \r\n1275: bpy.ops.wm.save_as_mainfile(filepath=OUT)\r\n1276: print(\"ENV SAVED:\", OUT)\r"}
