def noise(t, seed=0.0, amp=1.0):\r\n341:     return (sin(t * 2.3 + seed) * 0.55 + sin(t * 5.7 + seed * 2.3) * 0.3\r\n342:             + sin(t * 11.3 + seed * 4.1) * 0.15) * amp\r\n343: \r\n344: \r\n345: def smooth(t):\r\n346:     t = max(0.0, min(1.0, t))\r\n347:     return t * t * (3 - 2 * t)\r\n348: \r\n349: \r\n350: def key_cam(cam, f, loc, tgt, roll=0.0, fstop=4.0, lens=50, lens_key=True):\r\n351:     cam_look(cam, loc, tgt, roll_deg=roll, fstop=fstop, lens=lens)\r\n352:     cam.keyframe_insert(\"location\", frame=f)\r\n353:     cam.keyframe_insert(\"rotation_euler\", frame=f)\r\n354:     cam.data.dof.keyframe_insert(\"focus_distance\", frame=f)\r\n355:     cam.data.dof.keyframe_insert(\"aperture_fstop\", frame=f)\r\n356:     if lens_key:\r\n357:         cam.data.keyframe_insert(\"lens\", frame=f)\r\n358: \r\n359: \r\n360: def F(beat):\r\n361:     return 1 + int(round(beat * BEAT_F))\r\n362: \r\n363: \r\n364: # 车体坐标系里的机位\r\n365: def C(fd, back=0.0, side=0.0, h=0.5):\r\n366:     return fd['pos'] - fd['fwd'] * back + fd['right'] * side + Vector((0, 0, h))\r\n367: \r\n368: \r\n369: def T(fd, ahead=0.0, side=0.0, h=0.45):\r\n370:     return fd['pos'] + fd['fwd'] * ahead + fd['right'] * side + Vector((0, 0, h))\r\n371: \r\n372: \r\n373: def fixed_point(f, back=0.0, side=0.0, h=0.5):\r\n374:     \"\"\"以某帧车体为参考，固定在世界的机位\"\"\"\r\n375:     fd = frame_data[f]\r\n376:     return C(fd, back, side, h)\r\n377: \r\n378: \r\n379: CAR_LEN = 4.7          # 定焦用：让车在画面里的宽度占比稳定（侧面投影 = 车长）\r\n380: CAR_W = 2.2            # 正面投影 = 车宽\r\n381: SENSOR_W = 36.0\r\n382: \r\n383: \r\n384: def lens_for_framing(dist, frac, cos_a=0.0):\r\n385:     \"\"\"cos_a: 1=正对车头/车尾, 0=正侧面。按投影宽度算焦距\"\"\"\r\n386:     w_eff = CAR_W + (CAR_LEN - CAR_W) * (1.0 - abs(cos_a))\r\n387:     return max(20.0, min(320.0, frac * SENSOR_W * max(dist, 1.0) / max(w_eff, 0.5)))\r\n388: \r\n389: \r\n390: SHOTS = [\r\n391:     # (名字, t0, t1, 类型, 参数)  —— t 为赛道时间（秒），切点吸附 108 BPM 拍点\r\n392:     (\"Cam_S01_RearChase\", 0.0, 4.6, \