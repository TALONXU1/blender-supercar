g` to verify exposure/contrast/no white road wedge/smooth sky gradient.\\n5) Post a concise summary of changes, object count, build time, and exact brake/car material/object names for `@anim`, tagging `@anim`!\",\"time\":\"2026-11-18 13:28:21\",\"kind\":\"brief\",\"request_id\":\"b3512b9e-b886-4279-8327-0361b0a2c295\"}],\"head\":8}\n(no newline at end of file)"}
{"step_index":11,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-18T05:29:01Z","content":"Created At: 2026-11-18T13:29:01+08:00\nCompleted At: 2026-11-18T13:29:02+08:00\nShowing lines 1-106 of 106\n1: # -*- coding: utf-8 -*-\r\n2: \"\"\"\r\n3: V5 白模（clay）版本：把所有材质替换成统一灰模，保留光影与动画。\r\n4: 输入: LATEST/v5_stage_anim.blend\r\n5: 输出: LATEST/v5_stage_anim_clay.blend（原文件不动）\r\n6: \r\n7: 用法: blender -b -P pipeline/v5_clay.py\r\n8: \"\"\"\r\n9: import bpy\r\n10: import os\r\n11: \r\n12: PROJ = r\"D:\\项目session\\blender-supercar\"\r\n13: SRC = os.path.join(PROJ, \"LATEST\", \"v5_stage_anim.blend\")\r\n14: DST = os.path.join(PROJ, \"LATEST\", \"v5_stage_anim_clay.blend\")\r\n15: \r\n16: bpy.ops.wm.open_mainfile(filepath=SRC)\r\n17: scene = bpy.context.scene\r\n18: \r\n19: \r\n20: def clay(name, value, rough=0.62):\r\n21:     m = bpy.data.materials.get(name) or bpy.data.materials.new(name)\r\n22:     m.use_nodes = True\r\n23:     nt = m.node_tree\r\n24:     nt.nodes.clear()\r\n25:     b = nt.nodes.new(\"ShaderNodeBsdfPrincipled\")\r\n26:     b.inputs['Base Color'].default_value = (value, value, value, 1.0)\r\n27:     b.inputs['Roughness'].default_value = rough\r\n28:     b.inputs['Specular IOR Level'].default_value = 0.12\r\n29:     b.inputs['Metallic'].default_value = 0.0\r\n30:     out = nt.nodes.new(\"ShaderNodeOutputMaterial\")\r\n31:     nt.links.new(b.outputs['BSDF'], out.inputs['Surface'])\r\n32:     return m\r\n33: \r\n34: \r\n35: M_CAR = clay(\"CLAY_Car\", 0.88, 0.52)\r\n36: M_ENV = clay(\"CLAY_Env\", 0.40, 0.72)\r\n37: M_SKY = clay(\"CLAY_Sky\", 0.22, 0.9)\r\n38: \r\n39: # 天空穹顶：换成中性灰自发光，避免保留黄昏配色\r\n40: sky = bpy.data.objects.get(\"V5_SkyDome\")\r\n41: if sky and sky.data.materials:\r\n42:     _m = bpy.data.materials.get(\"CLAY_SkyEmit\")\r\n43:     if not _m:\r\n44:         _m = bpy.data.materials.new(\"CLAY_SkyEmit\")\r\n45:         _m.use_nodes = True\r\n46:         nt = _m.node_tree\r\n47:         nt.nodes.clear()\r\n48:         e = nt.nodes.new(\"ShaderNodeEmission\")\r\n49:         e.inputs['Color'].default_value = (0.145, 0.150, 0.160, 1.0)\r\n50:         e.inputs['Strength'].default_value = 1.0\r\n51:         o = nt.nodes.new(\"ShaderNodeOutputMaterial\")\r\n52:         nt.links.new(e.outputs['Emission'], o.inputs['Surface'])\r\n53:     for i in range(len(sky.data.materials)):\r\n54:         sky.data.materials[i] = _m\r\n55: \r\n56: # 车 vs 环境\r\n57: n_car = n_env = 0\r\n58: for ob in bpy.data.objects:\r\n59:     if ob.type != 'MESH':\r\n60:         continue\r\n61:     if ob.name.startswith(\"V5_SkyDome\"):\r\n62:         continue\r\n63:     is_car = (not ob.name.startswith(\"V5_\")) and (not ob.name.startswith(\"GEO_Race\"))\r\n64:     mat = M_CAR if is_car else M_ENV\r\n65:     me = ob.data\r\n66:     if me.materials:\r\n67:         for i in range(len(me.materials)):\r\n68:             me.materials[i] = mat\r\n69:     else:\r\n70:         me.materials.append(mat)\r\n71:     if is_car:\r\n72:         n_car += 1\r\n73:     else:\r\n74:         n_env += 1\r\n75: \r\n76: # 世界：中性灰，去掉色彩\r\n77: world = scene.world\r\n78: if world:\r\n79:     world.use_nodes = True\r\n80:     nt = world.node_tree\r\n81:     nt.nodes.clear()\r\n82:     bg = nt.nodes.new(\"ShaderNodeBackground\")\r\n83:     bg.inputs['Color'].default_value = (0.05, 0.052, 0.058, 1.0)\r\n84:     bg.inputs['Strength'].default_value = 1.0\r\n85:     out = nt.nodes.new(\"ShaderNodeOutputWorld\")\r\n86:     nt.links.new(bg.outputs[0], out.inputs[0])\r\n87: \r\n88: # 关掉泛光（白模不需要）\r\n89: try:\r\n90:     scene.use_nodes = False\r\n91: except Exception:\r\n92:     pass\r\n93: \r\n94: # 曝光回到中性\r\n95: try:\r\n96:     scene.view_settings.view_transform = 'Standard'\r\n97:     scene.view_settings.look = 'None'\r\n98:     scene.view_settings.exposure = 0.20\r\n99:     scene.view_settings.gamma = 1.0\r\n100: except Exception:\r\n101:     pass\r\n102: \r\n103: print(\"clay: car meshes=%d env meshes=%d\" % (n_car, n_env))\r\n104: \r\n105: bpy.ops.wm.save_as_mainfile(filepath=DST)\r\n106: print(\"CLAY SAVED:\", DST)\r"}
{"step_index":12,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-18T05:29:01Z","content":"Created At: 2026-11-18T13:29:01+08:00\nCompleted At: 2026-11-18T13:29:02+08:00\nShowing lines 1-49 of 49\n1: # -*- coding: utf-8 -*-\n2: \"\"\"\n3: 视口加速开关：把重物件在视口里降级，渲染完全不受影响。\n4: \n5: 用法:\n6:   blender -b LATEST/v5_stage_anim.blend -P pipeline/v5_viewport_fast.py -- fast\n7:   blender -b LATEST/v5_stage_anim.blend -P pipeline/v5_viewport_fast.py -- normal\n8: \n9: fast   : 看台/道具集合视口隐藏 + 重物件只显示包围盒（BOUNDS）\n10: normal : 恢复实体显示\n11: \n12: 注意：改的是 hide_viewport / display_type，都是视口专属属性，\n13: 渲染（F12）不受任何影响。保存后重开仍然有效。\n14: \"\"\"\n15: import bpy\n16: import sys\n17: \n18: ARGV = sys.argv[sys.argv.index(\"--\") + 1:] if \"--\" in sys.argv else []\n19: MODE = (ARGV[0] if ARGV else \"fast\").lower()\n20: \n21: HEAVY_COLLS = (\"V5_04_Stands\", \"V5_06_Props\", \"V5_02_Terrain\")\n22: HEAVY_OBJ_PREFIX = (\"V5_Stand_\", \"V5_Ad_\", \"V5_Brake_\", \"V5_Marshal_\",\n23:                     \"V5_Screen_\", \"V5_Bridge_\", \"V5_Hangar_\", \"V5_Gantry\")\n24: \n25: fast = MODE.startswith(\"fast\")\n26: \n27: # 1) 集合视口显隐\n28: for c in bpy.data.collections:\n29:     if c.name in HEAVY_COLLS:\n30:         c.hide_viewport = fast\n31: \n32: # 2) 重物件显示模式\n33: changed = 0\n34: for ob in bpy.data.objects:\n35:     if not ob.name.startswith(HEAVY_OBJ_PREFIX):\n36:         continue\n37:     ob.display_type = 'BOUNDS' if fast else 'TEXTURED'\n38:     changed += 1\n39: \n40: # 3) 视口采样（只影响视口，不影响渲染）\n41: sc = bpy.context.scene\n42: try:\n43:     sc.eevee.taa_samples = 8 if fast else 16\n44: except Exception:\n45:     pass\n46: \n47: print(\"viewport mode = %s | display_type changed = %d | collections hidden = %s\"\n48:       % (MODE, changed, [c.name for c in bpy.data.collections\n49:                          if c.name in HEAVY_COLLS and c.hide_viewport]))"}
{"step_index":13,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-18T05:29:02Z","content":"Created At: 2026-11-18T13:29:02+08:00\nCompleted At: 2026-11-18T13:29:02+08:00\nShowing lines 1-300 of 696\n1: # -*- coding: utf-8 -*-\r\n2: \"\"\"\r\n3: V5 ANIM — 真实赛道整圈（Silverstone / 90.34 s / 162 拍 / 2161 帧）\r\n4: 输入: LATEST/v5_stage_env.blend\r\n5: 输出: LATEST/v5_stage_anim.blend\r\n6: 运行:\r\n7:   blender -b -P pipeline/v5_anim.py -- --test 60,300,700,1500\r\n8:   blender -b -P pipeline/v5_anim.py -- --render\r\n9: \r\n10: 五条硬规则（来自 track_data/TRACK_SPEC.md）\r\n11:   1. 位置按 t 插值，不按帧均分\r\n12:   2. 朝向取 heading_deg，不用位移差反推\r\n13:   3. 位置走 racing_xy，不是 xy\r\n14:   4. 关键帧 LINEAR，禁 Bezier\r\n15:   5. v^2 * curv 不得超过 15.0 + 0.00714 v^2\r\n16: \"\"\"\r\n17: import bpy, json, math, os, sys, random\r\n18: from mathutils import Vector, Matrix, Euler\r\n19: from math import sin, cos, pi, radians, degrees, sqrt\r\n20: \r\n21: PROJ = r\"D:\\项目session\\blender-supercar\"\r\n22: IN = os.path.join(PROJ, \"LATEST\", \"v5_stage_env.blend\")\r\n23: OUT = os.path.join(PROJ, \"LATEST\", \"v5_stage_anim.blend\")\r\n24: TRACK = os.path.join(PROJ, \"track_data\", \"silverstone_track.json\")\r\n25: FRAMES_DIR = os.path.join(PROJ, \"renders_v5\", \"frames\")\r\n26: STILLS_DIR = os.path.join(PROJ, \"renders_v5\", \"stills\")\r\n27: \r\n28: ARGV = sys.argv[sys.argv.index(\"--\") + 1:] if \"--\" in sys.argv else []\r\n29: \r\n30: \r\n31: def argval(flag, default=None):\r\n32:     if flag in ARGV:\r\n33:         i = ARGV.index(flag)\r\n34:         if i + 1 < len(ARGV) and not ARGV[i + 1].startswith(\"--\"):\r\n35:             return ARGV[i + 1]\r\n36:         return True\r\n37:     return default\r\n38: \r\n39: \r\n40: # ---------------------------------------------------------------\r\n41: # 0. 参数\r\n42: # ---------------------------------------------------------------\r\n43: FPS = 24\r\n44: BEAT = 60.0 / 108.0                 # After Hours 108 BPM -> 0.5556 s\r\n45: BEAT_F = BEAT * FPS                 # 13.3333 帧\r\n46: TOTAL_BEATS = 162\r\n47: FRAME_END = int(round(1 + TOTAL_BEATS * BEAT_F))    # 2161\r\n48: R_TIRE = 0.357\r\n49: WHEELBASE = 3.6\r\n50: \r\n51: data = json.load(open(TRACK, encoding=\"utf-8\"))\r\n52: META = data[\"meta\"]\r\n53: P = data[\"points\"]\r\n54: N = len(P)\r\n55: LAP_S = META[\"sim_lap_s\"]           # 90.34\r\n56: DT = LAP_S / (FRAME_END - 1)        # 每帧时间步（保证整圈正好铺满）\r\n57: \r\n58: T_ARR = [p[\"t\"] for p in P]\r\n59: RX_ARR = [Vector((p[\"racing_xy\"][0], p[\"racing_xy\"][1], 0.0)) for p in P]\r\n60: HD_ARR = [p[\"heading_deg\"] for p in P]\r\n61: V_ARR = [p[\"v_mps\"] for p in P]\r\n62: K_ARR = [abs(p[\"curv_1pm\"] or 0.0) for p in P]\r\n63: \r\n64: \r\n65: def _unwrap(deg_list):\r\n66:     out = [deg_list[0]]\r\n67:     for a in deg_list[1:]:\r\n68:         d = (a - out[-1] + 180.0) % 360.0 - 180.0\r\n69:         out.append(out[-1] + d)\r\n70:     return out\r\n71: \r\n72: \r\n73: _HD_UN = _unwrap(HD_ARR)\r\n74: _SPAN = 4\r\n75: _SDS = 2 * _SPAN * (META[\"measured_length_km\"] * 1000.0 / N)\r\n76: \r\n77: \r\n78: def _ssign(i):\r\n79:     a = _HD_UN[(i - _SPAN) % N]\r\n80:     b = _HD_UN[(i + _SPAN) % N]\r\n81:     return 1.0 if (b - a) >= 0 else -1.0\r\n82: \r\n83: \r\n84: KS_ARR = [_ssign(i) * K_ARR[i] for i in range(N)]\r\n85: \r\n86: \r\n87: def sample(t):\r\n88:     \"\"\"t -> (位置, 航向[rad, CCW from +X], 速度 m/s, 有符号曲率)\"\"\"\r\n89:     t = max(0.0, min(LAP_S - 1e-6, t))\r\n90:     lo, hi = 0, N - 1\r\n91:     while hi - lo > 1:\r\n92:         m = (lo + hi) // 2\r\n93:         if T_ARR[m] <= t:\r\n94:             lo = m\r\n95:         else:\r\n96:             hi = m\r\n97:     span = max(T_ARR[lo + 1] - T_ARR[lo], 1e-9)\r\n98:     f = (t - T_ARR[lo]) / span\r\n99:     pos = RX_ARR[lo].lerp(RX_ARR[lo + 1], f)\r\n100:     a = radians(HD_ARR[lo])\r\n101:     b = radians(HD_ARR[lo + 1])\r\n102:     d = (b - a + pi) % (2 * pi) - pi\r\n103:     return pos, a + d * f, V_ARR[lo] + (V_ARR[lo + 1] - V_ARR[lo]) * f, \\\r\n104:         KS_ARR[lo] + (KS_ARR[lo + 1] - KS_ARR[lo]) * f\r\n105: \r\n106: \r\n107: # ---------------------------------------------------------------\r\n108: # 1. 每帧姿态\r\n109: # ---------------------------------------------------------------\r\n110: frame_data = {}\r\n111: dist = 0.0\r\n112: prev_pos = None\r\n113: for f in range(1, FRAME_END + 1):\r\n114:     t = (f - 1) * DT\r\n115:     pos, h, v, k = sample(t)\r\n116:     if prev_pos is not None:\r\n117:         dist += (pos - prev_pos).length\r\n118:     prev_pos = pos\r\n119:     fwd = Vector((cos(h), sin(h), 0.0))\r\n120:     right = Vector((sin(h), -cos(h), 0.0))\r\n121:     frame_data[f] = dict(t=t, pos=pos, heading=h, v=v, k=k, dist=dist, fwd=fwd, right=right)\r\n122: \r\n123: # 纵向加速度 / 横向加速度\r\n124: for f in range(1, FRAME_END + 1):\r\n125:     f0 = max(1, f - 2)\r\n126:     f1 = min(FRAME_END, f + 2)\r\n127:     dv = frame_data[f1]['v'] - frame_data[f0]['v']\r\n128:     accel = dv / ((f1 - f0) * DT)\r\n129:     v = frame_data[f]['v']\r\n130:     k = frame_data[f]['k']\r\n131:     frame_data[f]['accel'] = accel\r\n132:     frame_data[f]['lat'] = v * v * abs(k) / 9.81          # g\r\n133:     frame_data[f]['gear'] = min(8, max(1, int((v * 3.6 - 60) / 40.0) + 1))\r\n134: \r\n135: # ---------------------------------------------------------------\r\n136: # 2. 打开场景\r\n137: # ---------------------------------------------------------------\r\n138: bpy.ops.wm.open_mainfile(filepath=IN)\r\n139: scene = bpy.context.scene\r\n140: rig = bpy.data.objects[\"RIG_F1_Race\"]\r\n141: \r\n142: # 发车灯常暗（这圈是飞驰圈，不是发车）\r\n143: _sl = bpy.data.materials.get(\"V5_StartLight\")\r\n144: if _sl:\r\n145:     for n in _sl.node_tree.nodes:\r\n146:         if n.type == 'BSDF_PRINCIPLED' and 'Emission Strength' in n.inputs:\r\n147:             n.inputs['Emission Strength'].default_value = 0.0\r\n148: \r\n149: bone_root = rig.pose.bones[\"Bone_Root\"]\r\n150: bone_heading = rig.pose.bones[\"Bone_Heading\"]\r\n151: bone_body = rig.pose.bones[\"Bone_Body\"]\r\n152: \r\n153: # 尾部雨灯（刹车时增亮）\r\n154: brake_light = None\r\n155: _rl = bpy.data.objects.get(\"GEO_F1_FIA_RainLight\")\r\n156: if _rl and _rl.data.materials:\r\n157:     _m = _rl.data.materials[0]\r\n158:     if _m and _m.node_tree:\r\n159:         for _n in _m.node_tree.nodes:\r\n160:             if _n.type == 'BSDF_PRINCIPLED' and 'Emission Strength' in _n.inputs:\r\n161:                 brake_light = _n\r\n162:                 break\r\n163:             if _n.type == 'EMISSION':\r\n164:                 brake_light = _n\r\n165:                 break\r\n166: \r\n167: # 随车柔光\r\n168: # 随车三点补光：左前冷光 / 右前暖光 / 后方轮廓光\r\n169: _FILL = [\r\n170:     dict(ahead=5.5, side=-6.0, up=4.0, energy=260.0, size=18.0, color=(0.60, 0.74, 1.0)),\r\n171:     dict(ahead=5.5, side=6.0, up=4.0, energy=260.0, size=18.0, color=(1.0, 0.90, 0.78)),\r\n172:     dict(ahead=-7.0, side=2.4, up=2.4, energy=320.0, size=10.0, color=(0.85, 0.92, 1.0)),\r\n173: ]\r\n174: # 只照车的补光：用 light linking 把地面/环境排除在接收端之外\r\n175: _car_coll = bpy.data.collections.new(\"V5_CarLightReceivers\")\r\n176: for _ob in bpy.data.objects:\r\n177:     if _ob.type == 'MESH' and not _ob.name.startswith((\"V5_\", \"GEO_\")):\r\n178:         _car_coll.objects.link(_ob)\r\n179: \r\n180: fill_lights = []\r\n181: for i, spec in enumerate(_FILL):\r\n182:     fd_l = bpy.data.lights.new(f\"LGT_V5Car_{i}\", 'AREA')\r\n183:     fd_l.energy = spec['energy']\r\n184:     fd_l.size = spec['size']\r\n185:     fd_l.color = spec['color']\r\n186:     fo = bpy.data.objects.new(f\"LGT_V5Car_{i}\", fd_l)\r\n187:     scene.collection.objects.link(fo)\r\n188:     try:\r\n189:         fo.light_linking.receiver_collection = _car_coll\r\n190:         fo.light_linking.link_state = 'INCLUDE'\r\n191:     except Exception as _e:\r\n192:         print(\"light linking unavailable:\", _e)\r\n193:     fill_lights.append((fo, spec))\r\n194: \r\n195: # ---------------------------------------------------------------\r\n196: # 3. 逐帧烘焙\r\n197: # ---------------------------------------------------------------\r\n198: cum_spin = 0.0\r\n199: prev_dist = 0.0\r\n200: prev_gear = 1\r\n201: shift_flash = 0.0\r\n202: \r\n203: print(\"BAKE START: %d frames, dt=%.5f s, lap=%.2f s\" % (FRAME_END, DT, LAP_S))\r\n204: for f in range(1, FRAME_END + 1):\r\n205:     fd = frame_data[f]\r\n206:     v, acc, lat, k = fd['v'], fd['accel'], fd['lat'], fd['k']\r\n207:     v_kmh = v * 3.6\r\n208: \r\n209:     # --- 位置 / 偏航（车模型前方 = 局部 +Y → rotation_z = heading - 90°）---\r\n210:     yaw = fd['heading'] - pi / 2\r\n211:     bone_root.location = (fd['pos'].x, fd['pos'].y, 0.012)   # 轮胎落在沥青面上\r\n212:     bone_heading.rotation_euler = (0.0, 0.0, yaw)\r\n213:     bone_root.keyframe_insert(\"location\", frame=f)\r\n214:     bone_heading.keyframe_insert(\"rotation_euler\", frame=f)\r\n215: \r\n216:     # --- 车身姿态：俯仰 / 侧倾 / 升沉 ---\r\n217:     gear = fd['gear']\r\n218:     if gear != prev_gear:\r\n219:         shift_flash = 1.0\r\n220:         prev_gear = gear\r\n221:     else:\r\n222:         shift_flash *= 0.72\r\n223: \r\n224:     pitch = max(-1.9, min(1.4, acc * 0.085)) - 0.16 * shift_flash\r\n225:     roll = max(-2.2, min(2.2, -lat * 0.26))\r\n226:     heave = -0.006 + 0.0016 * sin(f * 1.31) + 0.0009 * sin(f * 2.77)\r\n227:     bone_body.location = (0.0, 0.0, heave)\r\n228:     bone_body.rotation_euler = (radians(pitch), radians(roll), 0.0)\r\n229:     bone_body.keyframe_insert(\"location\", frame=f)\r\n230:     bone_body.keyframe_insert(\"rotation_euler\", frame=f)\r\n231: \r\n232:     # --- 机械驱动 ---\r\n233:     cum_spin += (fd['dist'] - prev_dist) / R_TIRE\r\n234:     prev_dist = fd['dist']\r\n235:     rig[\"wheel_spin\"] = cum_spin\r\n236: \r\n237:     steer_deg = degrees(k * WHEELBASE)                   # 阿克曼转角\r\n238:     rig[\"steer\"] = max(-26.0, min(26.0, steer_deg))\r\n239: \r\n240:     straight = abs(k) < 0.0016\r\n241:     rig[\"drs\"] = 1.0 if (straight and v_kmh > 240) else (0.0 if abs(k) > 0.004 else 0.5)\r\n242:     rig[\"brake_heat\"] = max(0.0, min(1.3, -acc * 0.11))\r\n243:     rig[\"rear_slip\"] = 1.0\r\n244:     rig[\"susp_f\"] = -0.004 - 0.014 * max(0.0, -acc) / 12.0\r\n245:     rig[\"susp_r\"] = -0.004 - 0.016 * max(0.0, acc) / 12.0\r\n246:     for kk in (\"wheel_spin\", \"steer\", \"drs\", \"brake_heat\", \"rear_slip\", \"susp_f\", \"susp_r\"):\r\n247:         rig.keyframe_insert(f'[\"{kk}\"]', frame=f)\r\n248: \r\n249:     if brake_light and 'Strength' in brake_light.inputs:\r\n250:         brake_light.inputs['Strength'].default_value = 1.0 + rig[\"brake_heat\"] * 12.0\r\n251:         brake_light.inputs['Strength'].keyframe_insert(\"default_value\", frame=f)\r\n252: \r\n253:     # 随车柔光\r\n254:     for fo, spec in fill_lights:\r\n255:         lp = fd['pos'] + fd['fwd'] * spec['ahead'] + fd['right'] * spec['side']             + Vector((0, 0, spec['up']))\r\n256:         fo.location = lp\r\n257:         aim = (fd['pos'] + Vector((0, 0, 0.45))) - lp\r\n258:         fo.rotation_euler = aim.to_track_quat('-Z', 'Y').to_euler()\r\n259:         fo.keyframe_insert(\"location\", frame=f)\r\n260:         fo.keyframe_insert(\"rotation_euler\", frame=f)\r\n261: \r\n262: print(\"BAKE DONE\")\r\n263: \r\n264: \r\n265: def iter_fcurves(action):\r\n266:     \"\"\"Blender 5.x: Action 有 layered/slotted 结构，fcurves 在 channelbag 里\"\"\"\r\n267:     fcs = list(getattr(action, \"fcurves\", []) or [])\r\n268:     if fcs:\r\n269:         return fcs\r\n270:     for layer in getattr(action, \"layers\", []) or []:\r\n271:         for strip in getattr(layer, \"strips\", []) or []:\r\n272:             for cb in getattr(strip, \"channelbags\", []) or []:\r\n273:                 fcs.extend(cb.fcurves)\r\n274:     return fcs\r\n275: \r\n276: \r\n277: # 所有关键帧 LINEAR\r\n278: ad = rig.animation_data\r\n279: if ad and ad.action:\r\n280:     _n = 0\r\n281:     for fc in iter_fcurves(ad.action):\r\n282:         for kp in fc.keyframe_points:\r\n283:             kp.interpolation = 'LINEAR'\r\n284:             _n += 1\r\n285:     print(\"LINEAR keyframes:\", _n)\r\n286: \r\n287: # ---------------------------------------------------------------\r\n288: # 4. 物理自检（横向加速度上限 + 赛道内 + 航向连续）\r\n289: # ---------------------------------------------------------------\r\n290: VMAX = META[\"limits\"][\"v_max_mps\"]\r\n291: LIM = 15.0 + 0.00714 * VMAX ** 2\r\n292: worst = max(frame_data.values(), key=lambda d: d['v'] ** 2 * abs(d['k']))\r\n293: over = [f for f, d in frame_data.items() if d['v'] ** 2 * abs(d['k']) > LIM + 0.5]\r\n294: jumps = []\r\n295: for f in range(2, FRAME_END + 1):\r\n296:     d0, d1 = frame_data[f - 1], frame_data[f]\r\n297:     dh = abs((d1['heading'] - d0['heading'] + pi) % (2 * pi) - pi)\r\n298:     if dh > 0.12:\r\n299:         jumps.append((f, degrees(dh)))\r\n300: print(\"[check] 最坏横向 %.2f m/s^2 (%.2f g) @ frame %d, t=%.1f s\"\r"}
