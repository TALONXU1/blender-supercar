ut='INPUT', socket_type='NodeSocketColor')\nng.interface.new_socket(name='Rim Strength', in_out='INPUT', socket_type='NodeSocketFloat')\nng.interface.new_socket(name='Shader', in_out='OUTPUT', socket_type='NodeSocketShader')\ngi = ng.nodes.new('NodeGroupInput')\ngo = ng.nodes.new('NodeGroupOutput')\ndiff = ng.nodes.new('ShaderNodeBsdfDiffuse')\ns2r = ng.nodes.new('ShaderNodeShaderToRGB')\nem = ng.nodes.new('ShaderNodeEmission')\nng.links.new(gi.outputs['Base Color'], diff.inputs['Color'])\nng.links.new(diff.outputs['BSDF'], s2r.inputs['Shader'])\nng.links.new(s2r.outputs['Color'], em.inputs['Color'])\nng.links.new(em.outputs['Emission'], go.inputs['Shader'])\nm = bpy.data.materials.new('MTest')\nm.use_nodes = True\ng = m.node_tree.nodes.new('ShaderNodeGroup')\ng.node_tree = ng\nout = next(n for n in m.node_tree.nodes if n.type == 'OUTPUT_MATERIAL')\nm.node_tree.links.new(g.outputs['Shader'], out.inputs['Surface'])\nprint('NODEGROUP SHADER_TO_RGB OK! inputs:', [i.name for i in g.inputs])\n\"","WaitMsBeforeAsync":10000,"toolSummary":"Verify NG_SV_ComicSurface ShaderToRGB node group in Blender 5.3"}}]}
