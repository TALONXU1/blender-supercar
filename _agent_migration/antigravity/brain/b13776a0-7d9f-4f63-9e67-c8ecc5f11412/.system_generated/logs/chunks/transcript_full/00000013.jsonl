e[\"sv_dimension\"] = float(sdim)\n1587:         scene.keyframe_insert('[\"sv_dimension\"]', frame=idx_shot)\n1588:         # 将赛车摆到该 3D 坡度+倾角姿态以检验车漆反射与 3D 特效！\n1589:         car_pos = fr[\"rpos\"] + fr[\"up\"] * 0.012\n1590:         # 局部 X=right, Y=fwd, Z=up (与 RIG_F1_Race +Y 车头严格一致！)\n1591:         rot_m = Matrix((\n1592:             (fr[\"right\"].x, fr[\"fwd\"].x, fr[\"up\"].x),\n1593:             (fr[\"right\"].y, fr[\"fwd\"].y, fr[\"up\"].y),\n1594:             (fr[\"right\"].z, fr[\"fwd\"].z, fr[\"up\"].z),\n1595:         )).to_4x4()\n1596:         pb_root.location = car_pos\n1597:         pb_head.rotation_mode = 'XYZ'\n1598:         pb_head.rotation_euler = rot_m.to_euler('XYZ')\n1599:         pb_root.keyframe_insert(\"location\", frame=idx_shot)\n1600:         pb_head.keyframe_insert(\"rotation_euler\", frame=idx_shot)\n1601: \n1602:         scene.frame_set(idx_shot)\n1603:         bpy.context.view_layer.update()\n1604:         c_loc = car_pos + fr[\"fwd\"] * cam_rel[0] + fr[\"right\"] * cam_rel[1] + fr[\"up\"] * cam_rel[2]\n1605:         c_tgt = car_pos + fr[\"fwd\"] * tgt_rel[0] + fr[\"right\"] * tgt_rel[1] + fr[\"up\"] * tgt_rel[2]\n1606:         q = (c_tgt - c_loc).to_track_quat('-Z', 'Y')\n1607:         m_cam = q.to_matrix().to_4x4() @ Matrix.Rotation(radians(roll_d), 4, 'Z')\n1608:         cam_p.matrix_world = Matrix.Translation(c_loc) @ m_cam\n1609:         cd.lens = flens\n1610:         scene.render.filepath = os.path.join(PREV_DIR, sname + \".jpg\")\n1611:         t0 = time.time()\n1612:         bpy.ops.render.render(write_still=True)\n1613:         print(f\"PREVIEW {sname} (dim={sdim}, z={fr['pos'].z:.1f}m, bank={math.degrees(fr['b_eff']):.1f}deg): {time.time() - t0:.2f} s\")"}
