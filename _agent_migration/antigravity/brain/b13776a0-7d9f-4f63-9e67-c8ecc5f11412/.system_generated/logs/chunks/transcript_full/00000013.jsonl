V6_HarborWater\")\n772:     w_me.from_pydata([\n773:         (_cx - w_sz, _cy - w_sz, -5.0), (_cx + w_sz, _cy - w_sz, -5.0),\n774:         (_cx + w_sz, _cy + w_sz, -5.0), (_cx - w_sz, _cy + w_sz, -5.0),\n775:     ], [], [(0, 1, 2, 3)])\n776:     w_me.update()\n777:     w_me.materials.append(MAT_WATER)\n778:     w_ob = bpy.data.objects.new(\"V6_HarborWater\", w_me)\n779:     COLLS[\"V6_03_SkyBridge_Bowl\"].objects.link(w_ob)\n780: \n781: \n782: build_skydome_and_moon()\n783: \n784: \n785: # ---------------------------------------------------------------\n786: # 6. 3D 倾角赛道主体 + 贴身 ±8.2m 赛博护栏 + 霓虹路肩（彻底告别 33m 空旷草坪！）\n787: # ---------------------------------------------------------------\n788: BARRIER_OFF = HALF_W + 1.2     # ±8.2 m 紧贴赛道，强烈摩纳哥街道/2099 速度压迫感！\n789: BARRIER_H = 1.18\n790: \n791: \n792: def build_3d_track_and_barriers():\n793:     # A) 主路面厚板（上表面 5 段湿滑镜面沥青 + 下腹板钢箱梁包边，仰拍/航拍绝不穿帮薄片！）\n794:     cols = (-HALF_W - 1.25, -HALF_W, -3.5, 0.0, 3.5, HALF_W, HALF_W + 1.25)\n795:     nc = len(cols)\n796:     tv, tfc, tuv, tmat = [], [], [], []\n797:     idxs = list(range(N)) + [0]\n798:     for k_i, idx in enumerate(idxs):\n799:         fr = FRAMES[idx]\n800:         p, r, u = fr[\"pos\"], fr[\"right\"], fr[\"up\"]\n801:         s_uv = (fr[\"s\"] if k_i < N else LAP_LEN) / 10.0\n802:         for ci, off in enumerate(cols):\n803:             pt3 = p + r * off + u * 0.010\n804:             tv.append((pt3.x, pt3.y, pt3.z))\n805:             tuv.append((ci / float(nc - 1), s_uv))\n806:         # 下腹板底边两列（厚 0.95 m）\n807:         b_l = p - r * (HALF_W + 1.25) - u * 0.95\n808:         b_r = p + r * (HALF_W + 1.25) - u * 0.95\n809:         tv.append((b_l.x, b_l.y, b_l.z)); tuv.append((0.0, s_uv))\n810:         tv.append((b_r.x, b_r.y, b_r.z)); tuv.append((1.0, s_uv))\n811: \n812:     stride = nc + 2\n813:     for j in range(len(idxs) - 1):\n814:         b0 = j * stride\n815:         b1 = (j + 1) * stride\n816:         for ci in range(nc - 1):\n817:             tfc.append((b0 + ci, 