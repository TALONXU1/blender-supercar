{"step_index":301,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-18T08:36:14Z","content":"Created At: 2026-11-18T16:36:14+08:00\nCompleted At: 2026-11-18T16:36:14+08:00\nShowing lines 920-1028 of 1633\n920: # 7. 五大蜘蛛侠史诗级奇观场景 (5 Monumental Spider-Verse Set-Pieces)\n921: # ---------------------------------------------------------------\n922: def min_xy_dist_to_track(x, y, step=3):\n923:     return min(hypot(x - FRAMES[k][\"pos\"].x, y - FRAMES[k][\"pos\"].y) for k in range(0, N, step))\n924: \n925: \n926: def build_five_setpieces():\n927:     city_bm = BatchMesh(\"V6_Megacity_Skyscrapers\", \"V6_02_Megacity\")\n928:     sign_bm = BatchMesh(\"V6_Megacity_NeonSigns\", \"V6_02_Megacity\")\n929:     arch_bm = BatchMesh(\"V6_Canyon_ViaductArches\", \"V6_02_Megacity\")\n930:     brdg_bm = BatchMesh(\"V6_SkyBridge_Structure\", \"V6_03_SkyBridge_Bowl\")\n931:     cabl_bm = BatchMesh(\"V6_SkyBridge_StayCables\", \"V6_03_SkyBridge_Bowl\")\n932:     bowl_bm = BatchMesh(\"V6_BankedBowl_NeonWall\", \"V6_03_SkyBridge_Bowl\")\n933:     tunn_bm = BatchMesh(\"V6_StrobeTunnel_Vault\", \"V6_04_StrobeTunnel_Harbor\")\n934:     ribs_bm = BatchMesh(\"V6_StrobeTunnel_LaserRibs\", \"V6_04_StrobeTunnel_Harbor\")\n935:     harb_bm = BatchMesh(\"V6_Harbor_PropsGantries\", \"V6_04_StrobeTunnel_Harbor\")\n936:     gray_bm = BatchMesh(\"V6_FauxVolumetric_GodRays\", \"V6_05_Atmosphere_GodRays\")\n937: \n938:     rng = random.Random(2099)\n939: \n940:     # ① 起终点赛博龙门架 (s ~ 24m) + Neo-Monaco 赛博维修区车库长廊 (s = 36..228m, 右侧外立面)\n941:     f_sf = frame_at_s(24.0)\n942:     for sgn in (-1.0, 1.0):\n943:         c_leg = f_sf[\"pos\"] + f_sf[\"right\"] * (sgn * (BARRIER_OFF + 0.8)) + f_sf[\"up\"] * 4.2\n944:         arch_bm.add_oriented_box(c_leg, f_sf[\"fwd\"], f_sf[\"right\"], f_sf[\"up\"], 0.7, 0.7, 8.4, MAT_STEEL)\n945:     c_beam = f_sf[\"pos\"] + f_sf[\"up\"] * 8.2\n946:     arch_bm.add_oriented_box(c_beam, f_sf[\"right\"], f_sf[\"fwd\"], f_sf[\"up\"], (BARRIER_OFF + 1.2) * 2.0, 0.9, 1.2, MAT_STEEL)\n947:     arch_bm.add_oriented_box(c_beam - f_sf[\"fwd\"] * 0.52, f_sf[\"right\"], f_sf[\"fwd\"], f_sf[\"up\"], HALF_W * 2.0, 0.10, 0.95, MAT_AD)\n948: \n949:     for k_pit in range(6):\n950:         fp = frame_at_s(52.0 + k_pit * 30.0)\n951:         cp = fp[\"pos\"] + fp[\"right\"] * (BARRIER_OFF + 5.8) + fp[\"up\"] * 3.8\n952:         arch_bm.add_oriented_box(cp, fp[\"fwd\"], fp[\"right\"], fp[\"up\"], 28.5, 6.2, 7.6, MAT_GARAGE, uv_tile=(1.0, 1.0))\n953:         arch_bm.add_oriented_box(cp + fp[\"up\"] * 3.95 - fp[\"right\"] * 3.15, fp[\"fwd\"], fp[\"right\"], fp[\"up\"], 28.5, 0.22, 0.22, MAT_NEON_CYAN)\n954: \n955:     def _in_moon_sightline(bx, by):\n956:         dx = bx - _crest_f[\"pos\"].x\n957:         dy = by - _crest_f[\"pos\"].y\n958:         along = dx * _crest_fwd_xy.x + dy * _crest_fwd_xy.y\n959:         lat = abs(dx * _crest_rgt_xy.x + dy * _crest_rgt_xy.y)\n960:         return (-40.0 < along < 1750.0) and (lat < 165.0)\n961: \n962:     # ② 峡谷摩天楼群 & Eau-Rouge 爬坡天际线（紧贴护栏外 14..46m，高 55..225m，严格验证绝不侵入任何赛段与次元月走廊！）\n963:     placed_towers = []\n964:     for idx in range(0, N, 14):   # 每 28 m 沿线两侧尝试生成紧贴峡谷的摩天楼\n965:         fr = FRAMES[idx]\n966:         if fr[\"bridge\"]:\n967:             continue\n968:         for sgn in (-1.0, 1.0):\n969:             w = rng.uniform(18.0, 30.0)\n970:             d = rng.uniform(18.0, 30.0)\n971:             half_diag = 0.5 * hypot(w, d)\n972:             pit_pad = 9.5 if (sgn > 0 and 30.0 <= fr[\"s\"] <= 245.0) else 0.0\n973:             dist_out = BARRIER_OFF + half_diag + pit_pad + rng.uniform(4.5, 18.0)\n974:             bx = fr[\"pos\"].x + fr[\"right\"].x * (sgn * dist_out)\n975:             by = fr[\"pos\"].y + fr[\"right\"].y * (sgn * dist_out)\n976:             if _in_moon_sightline(bx, by):\n977:                 continue\n978:             # 安全净距检查：距全圈任意赛道中心线 XY >= BARRIER_OFF + half_diag + 3.0m，且不与已放塔楼重叠\n979:             if min_xy_dist_to_track(bx, by, step=2) < (BARRIER_OFF + half_diag + 3.0):\n980:                 continue\n981:             if any(hypot(bx - ox, by - oy) < (half_diag + odiag - 2.0) for ox, oy, odiag in placed_towers):\n982:                 continue\n983:             placed_towers.append((bx, by, half_diag))\n984: \n985:             hgt = rng.uniform(75.0, 225.0) if fr[\"zone\"] in (\"canyon_grid\", \"eau_rouge_climb\") else rng.uniform(55.0, 165.0)\n986:             base_z = -5.0\n987:             total_h = (fr[\"pos\"].z + hgt) - base_z\n988:             center_b = Vector((bx, by, base_z + total_h * 0.5))\n989:             ax_f = Vector((cos(fr[\"h\"]), sin(fr[\"h\"]), 0.0))\n990:             ax_r = Vector((sin(fr[\"h\"]), -cos(fr[\"h\"]), 0.0))\n991:             ax_u = Vector((0.0, 0.0, 1.0))\n992: \n993:             city_bm.add_oriented_box(center_b, ax_f, ax_r, ax_u, w, d, total_h, MAT_FACADE,\n994:                                      uv_tile=(max(1.0, round(w / 18.0)), max(1.0, round(total_h / 55.0))))\n995:             # 塔冠退台霓虹边框\n996:             crown_c = Vector((bx, by, base_z + total_h + 1.2))\n997:             n_mat = MAT_NEON_CYAN if (len(placed_towers) % 3 == 0) else (MAT_NEON_MAG if len(placed_towers) % 3 == 1 else MAT_NEON_GOLD)\n998:             city_bm.add_oriented_box(crown_c, ax_f, ax_r, ax_u, w * 0.92, d * 0.92, 0.65, n_mat)\n999: \n1000:             # 面向赛道的巨幅竖向赛博漫画霓虹招牌\n1001:             sign_h = min(46.0, hgt * 0.52)\n1002:             sign_c = Vector((\n1003:                 bx - fr[\"right\"].x * (sgn * (d * 0.5 + 0.45)),\n1004:                 by - fr[\"right\"].y * (sgn * (d * 0.5 + 0.45)),\n1005:                 fr[\"pos\"].z + 8.0 + sign_h * 0.5,\n1006:             ))\n1007:             slot = len(placed_towers) % 4\n1008:             sign_bm.add_oriented_box(sign_c, ax_f, ax_r, ax_u, 4.4, 0.35, sign_h, MAT_SIGNS,\n1009:                                      uv_tile=(0.24, 0.96), uv_off=(slot * 0.25 + 0.005, 0.02))\n1010: \n1011:     # 外围远景天际线环（填满 360° 视野，同时留空次元巨月视线走廊！）\n1012:     for k_ring in range(44):\n1013:         ang = 2.0 * pi * k_ring / 44.0 + rng.uniform(-0.04, 0.04)\n1014:         rad = rng.uniform(520.0, 880.0)\n1015:         rx = _cx + cos(ang) * rad\n1016:         ry = _cy + sin(ang) * rad\n1017:         if _in_moon_sightline(rx, ry) or min_xy_dist_to_track(rx, ry, step=4) < 95.0:\n1018:             continue\n1019:         rw, rd = rng.uniform(36.0, 68.0), rng.uniform(36.0, 68.0)\n1020:         rh = rng.uniform(95.0, 260.0)\n1021:         ax_f = Vector((-sin(ang), cos(ang), 0.0))\n1022:         ax_r = Vector((cos(ang), sin(ang), 0.0))\n1023:         city_bm.add_oriented_box(Vector((rx, ry, -5.0 + rh * 0.5)), ax_f, ax_r, Vector((0, 0, 1)),\n1024:                                  rw, rd, rh, MAT_FACADE, uv_tile=(2.0, max(1.0, round(rh / 65.0))))\n1025: \n1026:     # 城市峡谷段跨街赛博过街天桥拱门（净高 8.8 m，绝不挡任何镜头）\n1027:     canyon_idxs = [i for i, f in enumerate(FRAMES) if f[\"zone\"] == \"canyon_grid\"]\n1028:     for step_a in canyon_idxs[::55][:3]:"}
