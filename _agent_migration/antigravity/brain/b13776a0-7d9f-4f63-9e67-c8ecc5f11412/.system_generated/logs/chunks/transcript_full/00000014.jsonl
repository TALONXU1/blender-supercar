   s0b = s0a + fb0[\"up\"] * 0.18\n                s1a = w1_b + fb1[\"right\"] * inw + fb1[\"up\"] * h_str\n                s1b = s1a + fb1[\"up\"] * 0.18\n                bowl_bm.add_quad(s0a, s1a, s1b, s0b, smat)\n                bowl_bm.add_quad(s1a, s0a, s0b, s1b, smat)","Target":"    # ④ 18° 倾角巨碗弯外侧弧形霓虹透明防护高墙 (banked_bowl_plunge: 为贴墙轨道机位提供极致参照物！)\n    for i in range(N - 1):\n        fb0, fb1 = FRAMES[i], FRAMES[(i + 1) % N]\n        if abs(degrees_b := math.degrees(fb0[\"b_eff\"])) > 6.5:\n            # 弯外侧即抬高的一侧：b_eff > 0 时 +right 抬高，b_eff < 0 时 -right 抬高\n            out_sgn = 1.0 if fb0[\"b_eff\"] > 0 else -1.0\n            w0_b = fb0[\"pos\"] + fb0[\"right\"] * (out_sgn * (BARRIER_OFF + 0.25)) + fb0[\"up\"] * BARRIER_H\n            w0_t = w0_b + fb0[\"up\"] * 4.2\n            w1_b = fb1[\"pos\"] + fb1[\"right\"] * (out_sgn * (BARRIER_OFF + 0.25)) + fb1[\"up\"] * BARRIER_H\n            w1_t = w1_b + fb1[\"up\"] * 4.2\n            bowl_bm.add_quad(w0_b, w1_b, w1_t, w0_t, MAT_BARRIER if (i % 4 == 0) else MAT_STEEL)\n            for h_str, smat in ((1.4, MAT_NEON_CYAN), (2.8, MAT_NEON_MAG), (4.1, MAT_NEON_GOLD)):\n                s0a = w0_b + fb0[\"up\"] * h_str\n                s0b = s0a + fb0[\"up\"] * 0.16\n                s1a = w1_b + fb1[\"up\"] * h_str\n                s1b = s1a + fb1[\"up\"] * 0.16\n                bowl_bm.add_quad(s0a, s1a, s1b, s0b, smat)"}},{"name":"edit_file","args":{"Path":"D:\\项目session\\blender-supercar\\pipeline\\v6_sv_env.py","Replacement":"        uo = nt.nodes.new('ShaderNodeMath'); uo.name = \"SV_FlutterAdd\"; uo.operation = 'ADD'\n        nt.links.new(sep.outputs['X'], uo.inputs[0])\n        fc_fl = uo.inputs[1].driver_add(\"default_value\")\n        fc_fl.driver.type = 'SCRIPTED'\n        fc_fl.driver.expression = \"floor(frame / 2.0) * 0.37\"","Target":"        v_ph = nt.nodes.new('ShaderNodeValue'); v_ph.name = \"SV_FlutterPhase\"; v_ph.outputs[0].default_value = 0.0\n        uo = nt.nodes.new('ShaderNodeMath'); uo.operation = 'ADD'; nt.links.new(sep.outputs['X'], uo.inputs[0]); nt.links.new(v_ph.outputs[0], uo.inputs[1])"}},{"name":"edit_file","args":{"Path":"D:\\项目session\\blender-supercar\\pipeline\\v6_sv_env.py","Replacement":"    # 选出六大代表奇观地标点（对齐 #32 @track 地标：1 峡谷摩天楼与赛博维修区; 2 +13.5° 爬坡火花; 3 +42m 盲坡斜拉桥与次元巨月; 4 +17.4° 巨碗霓虹高墙; 5 341km/h 激光频闪隧道; 6 海港发夹弯重刹区）\n    shots_prev = [\n        (\"v6_01_canyon_15mm_wet\", 95, 0.0, 15.0, (-5.8, -1.6, 0.28), (2.2, 0.2, 1.45), 10.0),\n        (\"v6_02_raidillon_climb_sparks\", 437, 0.0, 24.0, (-6.2, 1.8, 0.42), (3.5, -0.3, 1.15), -8.0),\n        (\"v6_03_crest_skybridge_moon\", _crest_idx, 1.0, 85.0, (-18.5, 0.6, 0.62), (12.0, 0.0, 2.35), 0.0),\n        (\"v6_04_banked_bowl_17deg\", _peak_i, 1.0, 20.0, (-6.2, 2.5, 0.85), (4.5, -2.0, 0.95), -14.0),\n        (\"v6_05_laser_strobe_tunnel_2099\", 1440, 2.0, 16.0, (-6.0, -1.3, 0.36), (5.0, 0.0, 0.78), 8.0),\n        (\"v6_06_harbor_hairpin_brake_2099\", 1640, 2.0, 28.0, (-7.2, -2.2, 0.65), (6.0, 1.2, 1.25), 6.0),\n    ]\n\n    mw_inv = rig.matrix_world.inverted()\n    for idx_shot, (sname, fi, sdim, flens, cam_rel, tgt_rel, roll_d) in enumerate(shots_prev, start=1):\n        fr = FRAMES[fi % N]\n        scene[\"sv_dimension\"] = float(sdim)\n        scene.keyframe_insert('[\"sv_dimension\"]', frame=idx_shot)\n        # 严格零误差轮胎贴地定位：car_pos == fr[\"rpos\"] (0.000 m Z 偏差)\n        car_pos = fr[\"rpos\"].copy()\n        rot_m = Matrix((\n            (fr[\"right\"].x, fr[\"fwd\"].x, fr[\"up\"].x),\n            (fr[\"right\"].y, fr[\"fwd\"].y, fr[\"up\"].y),\n            (fr[\"right\"].z, fr[\"fwd\"].z, fr[\"up\"].z),\n        )).to_4x4()\n        pb_root.matrix = mw_inv @ Matrix.Translation(car_pos)\n        bpy.context.view_layer.update()\n        pb_head.matrix = mw_inv @ (Matrix.Translation(car_pos) @ rot_m)\n        bpy.context.view_layer.update()\n        pb_root.keyframe_insert(\"location\", frame=idx_shot)\n        pb_root.keyframe_insert(\"rotation_quaternion\", frame=idx_shot)\n        pb_head.keyframe_insert(\"location\", frame=idx_shot)\n        pb_head.keyframe_insert(\"rotation_quaternion\", frame=idx_shot)\n\n        scene.frame_set(idx_shot)\n        bpy.context.view_layer.update()\n        c_loc = car_pos + fr[\"fwd\"] * cam_rel[0] + fr[\"right\"] * cam_rel[1] + fr[\"up\"] * cam_rel[2]\n        c_tgt = car_pos + fr[\"fwd\"] * tgt_rel[0] + fr[\"right\"] * tgt_rel[1] + fr[\"up\"] * tgt_rel[2]\n        q = (c_tgt - c_loc).to_track_quat('-Z', 'Y')\n        m_cam = q.to_matrix().to_4x4() @ Matrix.Rotation(radians(roll_d), 4, 'Z')\n        cam_p.matrix_world = Matrix.Translation(c_loc) @ m_cam\n        cd.lens = flens\n        scene.render.filepath = os.path.join(PREV_DIR, sname + \".jpg\")\n        t0 = time.time()\n        bpy.ops.render.render(write_still=True)\n        print(f\"PREVIEW {sname} (dim={sdim}, z={fr['pos'].z:.1f}m, pitch={math.degrees(fr['p']):.1f}deg, bank={math.degrees(fr['b_eff']):.1f}deg): {time.time() - t0:.2f} s\")","Target":"    # 选出五大代表奇观点（1: 城市峡谷贴地仰视摩天楼; 2: Eau-Rouge 盲坡次元巨月剪影; 3: 115m 斜拉天空大桥; 4: 18° 巨碗霓虹高墙; 5: 激光频闪隧道）\n    def _find_zone_mid(zname, pred=None):\n        cands = [i for i, f in enumerate(FRAMES) if (pred(f) if pred else f[\"zone\"] == zname)]\n        return cands[len(cands) // 2] if cands else 0\n\n    i_canyon = _find_zone_mid(\"canyon_grid\")\n    i_crest = _crest_idx\n    i_bridge = _find_zone_mid(\"sky_bridge\", lambda f: f[\"bridge\"])\n    i_bowl = _peak_i\n    i_tunnel = _find_zone_mid(\"strobe_tunnel_harbor\", lambda f: f[\"tunnel\"])\n\n    shots_prev = [\n        (\"v6_01_canyon_15mm_wet\", i_canyon, 0.0, 15.0, (-5.8, -1.6, 0.26), (1.8, 0.0, 1.45), 11.0),\n        (\"v6_02_eau_rouge_crest_moon\", i_crest, 0.0, 135.0, (-24.0, 0.8, 0.52), (4.0, 0.0, 1.15), 0.0),\n        (\"v6_03_skybridge_gwen_cables\", i_bridge, 1.0, 22.0, (-7.5, 2.2, 0.72), (6.0, 0.0, 3.8), -6.0),\n        (\"v6_04_banked_bowl_18deg\", i_bowl, 1.0, 20.0, (-6.2, 2.8, 0.85), (3.5, -0.8, 0.55), -14.0),\n        (\"v6_05_laser_strobe_tunnel_2099\", i_tunnel, 2.0, 16.0, (-6.0, -1.3, 0.34), (5.0, 0.0, 0.75), 8.0),\n    ]\n\n    for idx_shot, (sname, fi, sdim, flens, cam_rel, tgt_rel, roll_d) in enumerate(shots_prev, start=1):\n        fr = FRAMES[fi]\n        scene[\"sv_dimension\"] = float(sdim)\n        scene.keyframe_insert('[\"sv_dimension\"]', frame=idx_shot)\n        # 将赛车摆到该 3D 坡度+倾角姿态以检验车漆反射与 3D 特效！\n        car_pos = fr[\"rpos\"] + fr[\"up\"] * 0.012\n        # 局部 X=right, Y=fwd, Z=up (与 RIG_F1_Race +Y 车头严格一致！)\n        rot_m = Matrix((\n            (fr[\"right\"].x, fr[\"fwd\"].x, fr[\"up\"].x),\n            (fr[\"right\"].y, fr[\"fwd\"].y, fr[\"up\"].y),\n            (fr[\"right\"].z, fr[\"fwd\"].z, fr[\"up\"].z),\n        )).to_4x4()\n        pb_root.location = car_pos\n        pb_head.rotation_mode = 'XYZ'\n        pb_head.rotation_euler = rot_m.to_euler('XYZ')\n        pb_root.keyframe_insert(\"location\", frame=idx_shot)\n        pb_head.keyframe_insert(\"rotation_euler\", frame=idx_shot)\n\n        scene.frame_set(idx_shot)\n        bpy.context.view_layer.update()\n        c_loc = car_pos + fr[\"fwd\"] * cam_rel[0] + fr[\"right\"] * cam_rel[1] + fr[\"up\"] * cam_rel[2]\n        c_tgt = car_pos + fr[\"fwd\"] * tgt_rel[0] + fr[\"right\"] * tgt_rel[1] + fr[\"up\"] * tgt_rel[2]\n        q = (c_tgt - c_loc).to_track_quat('-Z', 'Y')\n        m_cam = q.to_matrix().to_4x4() @ Matrix.Rotation(radians(roll_d), 4, 'Z')\n        cam_p.matrix_world = Matrix.Translation(c_loc) @ m_cam\n        cd.lens = flens\n        scene.render.filepath = os.path.join(PREV_DIR, sname + \".jpg\")\n        t0 = time.time()\n        bpy.ops.render.render(write_still=True)\n        print(f\"PREVIEW {sname} (dim={sdim}, z={fr['pos'].z:.1f}m, bank={math.degrees(fr['b_eff']):.1f}deg): {time.time() - t0:.2f} s\")"}}]}
