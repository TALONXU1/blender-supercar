","args":{"CommandLine":"& \"D:\\APPs\\steam\\steamapps\\common\\Blender\\blender.exe\" -b \"D:\\项目session\\blender-supercar\\pipeline\\v4_stage_rig.blend\" --python-expr \"\nimport bpy\nhoop = bpy.data.objects.get('GEO_F1_Halo_Hoop')\nif hoop:\n    print('Halo_Hoop:', hoop.type, [m.name if m else None for m in hoop.data.materials])\nfor m in sorted(bpy.data.materials, key=lambda x: x.name):\n    print('--- MAT:', m.name, 'users=', m.users)\n    if m.node_tree:\n        for n in m.node_tree.nodes:\n            vals = {}\n            for inp in n.inputs:\n                if inp.is_linked:\n                    vals[inp.name] = 'LINKED(' + inp.links[0].from_node.type + '.' + inp.links[0].from_socket.name + ')'\n                else:\n                    try:\n                        v = inp.default_value\n                        vals[inp.name] = tuple(round(float(x),4) for x in v) if hasattr(v, '__len__') else round(float(v),4)\n                    except Exception:\n                        pass\n            img = getattr(n, 'image', None)\n            extra = f' img={img.name}({img.size[0]}x{img.size[1]})' if img else ''\n            print(f'  NODE {n.type} ({n.name}){extra}: {vals}')\n\"","WaitMsBeforeAsync":10000,"toolSummary":"Inspect car materials in v4_stage_rig.blend"}},{"name":"run_command","args":{"CommandLine":"python -c \"\nimport json, os, math\nfrom PIL import Image\nimport numpy as np\n\nproj = r'D:\\项目session\\blender-supercar'\ntd = json.load(open(os.path.join(proj, 'track_data', 'silverstone_track.json'), encoding='utf-8'))\nprint('META:', {k: v for k, v in td['meta'].items() if not isinstance(v, list)})\nif 'corners' in td['meta'] or 'corners' in td:\n    print('CORNERS:', td.get('corners') or td['meta'].get('corners'))\nprint('TOP KEYS:', list(td.keys()))\npts = td['points']\nprint('PT SAMPLE KEYS:', list(pts[0].keys()))\n\n# Find all velocity local minima and heavy braking zones\nN = len(pts)\nS = [p['s'] for p in pts]\nT = [p['t'] for p in pts]\nV = [p['v_mps']*3.6 for p in pts]\nK = [p['curv_1pm'] or 0.0 for p in pts]\nRO = [p['racing_offset_m'] for p in pts]\n\nprint('\\n--- VELOCITY MINIMA (CORNERS) ---')\nfor i in range(N):\n    v0 = V[i]\n    win = [V[(i+d)%N] for d in range(-18, 19)]\n    if v0 == min(win) and max(win) - v0 > 8.0:\n        # find peak speed 250m before\n        v_pre = max(V[(i-d)%N] for d in range(1, 140))\n        print(f'idx={i:4d} s={S[i]:6.1f}m t={T[i]:5.2f}s vmin={v0:5.1f}km/h v_pre={v_pre:5.1f}km/h dv={v_pre-v0:5.1f} k={K[i]:+.4f} roff={RO[i]:+.2f}m')\n\nprint('\\n--- STRAIGHTS (low curvature > 250m) ---')\nin_str = None\nfor i in range(N):\n    if abs(K[i]) < 0.0018:\n        if in_str is None: in_str = i\n    else:\n        if in_str is not None and S[i] - S[in_str] > 200:\n            vmax = max(V[in_str:i])\n            print(f'straight s={S[in_str]:6.1f}..{S[i]:6.1f}m (len={S[i]-S[in_str]:5.1f}m) t={T[in_str]:5.2f}..{T[i]:5.2f}s vmax={vmax:5.1f}km/h')\n        in_str = None\n\nprint('\\n--- TEXTURES ---')\nfor fn in ['pit_garage.png', 'ad_boards.png', 'bigscreen.png', 'brake_150.png', 'brake_100.png', 'brake_50.png', 'crowd_silverstone.png']:\n    fp = os.path.join(proj, 'textures', fn)\n    if os.path.exists(fp):\n        im = Image.open(fp)\n        arr = np.asarray(im.convert('RGB'), dtype=np.float32)/255.0\n        print(f'{fn:22s}: mode={im.mode} size={im.size} mean={arr.mean():.3f} p95={np.percentile(arr,95):.3f}')\n\nprint('\\n--- EXISTING PREVIEWS ---')\npdir = os.path.join(proj, 'renders_v5', 'preview')\nif os.path.exists(pdir):\n    for fn in sorted(os.listdir(pdir)):\n        if fn.endswith('.jpg') or fn.endswith('.png'):\n            im = Image.open(os.path.join(pdir, fn)).convert('RGB')\n            arr = np.asarray(im, dtype=np.float32)/255.0\n            lum = 0.2126*arr[:,:,0] + 0.7152*arr[:,:,1] + 0.0722*arr[:,:,2]\n            print(f'{fn:20s}: size={im.size} mean={lum.mean():.3f} p05={np.percentile(lum,5):.3f} p95={np.percentile(lum,95):.3f} clip>0.98={(lum>0.98).mean()*100:.2f}%')\n\"","WaitMsBeforeAsync":10000,"toolSummary":"Analyze track corners, straights, textures, and previews"}}]}
