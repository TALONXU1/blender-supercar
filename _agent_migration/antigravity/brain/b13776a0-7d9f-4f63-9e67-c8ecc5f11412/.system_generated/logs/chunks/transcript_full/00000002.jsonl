h, 2), round(dist, 2)))\n\nprint('LOW CAMS:', low_cams[:20])\nprint('TOTAL ENV OCCLUSION HITS (step 2):', len(hits))\nby_shot = {}\nfor f, cn, on, hd, td in hits:\n    by_shot.setdefault((cn, on), []).append(f)\nfor (cn, on), fs in sorted(by_shot.items()):\n    print(f'  OCCLUSION: {cn:24s} hit {on:25s} frames {min(fs)}..{max(fs)} ({len(fs)} hits)')\n\"","WaitMsBeforeAsync":10000,"toolSummary":"Raycast check 26 shots against V5 environment"}}]}
