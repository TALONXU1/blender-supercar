    m12 = snt.nodes.new('ShaderNodeMixRGB')\n467:         snt.links.new(sw2, m12.inputs['Factor'])\n468:         snt.links.new(sky1, m12.inputs['Color1'])\n469:         snt.links.new(sky2, m12.inputs['Color2'])\n470:         m123 = snt.nodes.new('ShaderNodeMixRGB')\n471:         snt.links.new(sw3, m123.inputs['Factor'])\n472:         snt.links.new(m12.outputs['Color'], m123.inputs['Color1'])\n473:         snt.links.new(sky3, m123.inputs['Color2'])\n474: \n475:         # 漫画阶梯太阳日冕光环 + 水彩笔触云带\n476:         sdot = snt.nodes.new('ShaderNodeVectorMath')\n477:         sdot.operation = 'DOT_PRODUCT'\n478:         sdot.inputs[1].default_value = (sun_dir.x, sun_dir.y, sun_dir.z)\n479:         snt.links.new(nrm.outputs['Vector'], sdot.inputs[0])\n480:         sun_rings = snt.nodes.new('ShaderNodeValToRGB')\n481:         sun_rings.color_ramp.interpolation = 'CONSTANT'\n482:         sun_rings.color_ramp.elements[0].position = 0.0\n483:         sun_rings.color_ramp.elements[0].color = (0.0, 0.0, 0.0, 1.0)\n484:         sr1 = sun_rings.color_ramp.elements.new(0.92)\n485:         sr1.color = (0.28, 0.14, 0.22, 1.0)\n486:         sun_rings.color_ramp.elements[-1].position = 0.982\n487:         sun_rings.color_ramp.elements[-1].color = (0.85, 0.56, 0.24, 1.0)\n488:         snt.links.new(sdot.outputs['Value'], sun_rings.inputs[0])\n489: \n490:         # 天空水彩笔触噪波（Act II 增强表现主义天幕笔刷感）\n491:         c_scale = snt.nodes.new('ShaderNodeVectorMath')\n492:         c_scale.operation = 'MULTIPLY'\n493:         c_scale.inputs[1].default_value = (3.5, 3.5, 16.0)\n494:         snt.links.new(nrm.outputs['Vector'], c_scale.inputs[0])\n495:         c_noise = snt.nodes.new('ShaderNodeTexNoise')\n496:         c_noise.inputs['Scale'].default_value = 2.8\n497:         c_noise.inputs['Detail'].default_value = 5.0\n498:         c_noise.inputs['Distortion'].default_value = 1.4\n499:         snt.links.new(c_scale.outputs['Vector'], c_noise.inputs['Vector'])\n500:         c_step = snt.nodes.new('ShaderNodeValToRGB')\n501:         c_step.color_ramp.interpolation = 'CONSTANT'\n502:         c_step.color_ramp.elements[0].position = 0.0\n503:         c_step.color_ramp.elements[0].color = (0.0, 0.0, 0.0, 1.0)\n504:         c_step.color_ramp.elements[1].position = 0.62\n505:         c_step.color_ramp.elements[1].color = (0.16, 0.12, 0.20, 1.0)\n506:         snt.links.new(c_noise.outputs['Fac'], c_step.inputs[0])\n507: \n508:         add_sun = snt.nodes.new('ShaderNodeMixRGB')\n509:         add_sun.blend_type = 'ADD'\n510:         add_sun.inputs['Factor'].default_value = 0.75\n511:         snt.links.new(m123.outputs['Color'], add_sun.inputs['Color1'])\n512:         snt.links.new(sun_rings.outputs['Color'], add_sun.inputs['Color2'])\n513: \n514:         add_cld = snt.nodes.new('ShaderNodeMixRGB')\n515:         add_cld.blend_type = 'SCREEN'\n516:         add_cld.inputs['Factor'].default_value = 0.45\n517:         snt.links.new(add_sun.outputs['Color'], add_cld.inputs['Color1'])\n518:         snt.links.new(c_step.outputs['Color'], add_cld.inputs['Color2'])\n519: \n520:         snt.links.new(add_cld.outputs['Color'], sem.inputs['Color'])\n521:         snt.links.new(sem.outputs['Emission'], sout.inputs['Surface'])\n522: \n523: \n524: upgrade_sky_and_lights()\n525: \n526: \n527: # ---------------------------------------------------------------\n528: # 3. 赛车与赛道材质全面转化为蜘蛛侠漫画着色器（严格保留动态发光动画曲线！）\n529: # ---------------------------------------------------------------\n530: def apply_comic_to_mat(mat, base_rgb=None, rim=0.85, ht_scale=96.0, ht_str=0.52, hc_str=0.50, swap_img=None):\n531:     if not mat or not mat.use_nodes:\n532:         return\n533:     nt = mat.node_tree\n534:     # 若该材质本身带有动画曲线（刹车热辉光/雨灯/换挡灯/刹车盘/卡钳），专门处理以绝不丢失关键帧\n535:     has_anim = bool(nt.animation_data and (nt.animation_data.action or nt.animation_data.drivers))\n536:     if has_anim:\n537:         return\n538: \n539:     tex_node = next((n for n in nt.nodes if n.type == 'TEX_IMAGE' and n.image), None)\n540:     saved_img = tex_node.image if tex_node else None\n541:     if swap_img:\n542:         fp = os.path.join(TEX_SV, swap_img)\n543:         if os.path.exists(fp):\n544:             saved_img = bpy.data.images.load(fp, check_existing=True)\n545: \n546:     old_bsdf = next((n for n in nt.nodes if n.type == 'BSDF_PRINCIPLED'), None)\n547:     if base_rgb is None:\n548:         if old_bsdf:\n549:             c = old_bsdf.inputs['Base Color'].default_value\n550:             base_rgb = (c[0], c[1], c[2])\n551:         else:\n552:             base_rgb = (0.25, 0.25, 0.30)\n553: \n554:     nt.nodes.clear()\n555:     out = nt.nodes.new('ShaderNodeOutputMaterial')\n556:     grp = nt.nodes.new('ShaderNodeGroup')\n557:     grp.node_tree = NG_COMIC\n558:     grp.inputs['Rim Strength'].default_value = rim\n559:     grp.inputs['Halftone Scale'].default_value = ht_scale\n560:     grp.inputs['Halftone Strength'].default_value = ht_str\n561:     grp.inputs['Hatch Strength'].default_value = hc_str\n562: \n563:     if saved_img is not None:\n564:         tn = nt.nodes.new('ShaderNodeTexImage')\n565:         tn.image = saved_img\n566:         tn.extension = 'REPEAT'\n567:         nt.links.new(tn.outputs['Color'], grp.inputs['Base Color'])\n568:         if 'Alpha' in tn.outputs and mat.name.startswith(\"Mat_DEC_\"):\n569:             try:\n570:                 mat.surface_render_method = 'DITHERED'\n571:             except Exception:\n572:                 pass\n573:             tr = nt.nodes.new('ShaderNodeBsdfTransparent')\n574:             mx = nt.nodes.new('ShaderNodeMixShader')\n575:             nt.links.new(tn.outputs['Alpha'], mx.inputs['Fac'])\n576:             nt.links.new(tr.outputs['BSDF'], mx.inputs[1])\n577:             nt.links.new(grp.outputs['Shader'], mx.inputs[2])\n578:             nt.links.new(mx.outputs['Shader'], out.inputs['Surface'])\n579:             return\n580:     else:\n581:         grp.inputs['Base Color'].default_value = (*base_rgb, 1.0)\n582: \n583:     nt.links.new(grp.outputs['Shader'], out.inputs['Surface'])\n584: \n585: \n586: # A) 替换赛道漫画贴图材质（维修车库 / 广告牌 / 大屏 / 刹车牌 / DRS 牌）\n587: _TEX_SWAPS = {\n588:     \"V5_PitGarage\": (\"sv_pit_garage.png\", 0.35),\n589:     \"V5_AdBoard\": (\"sv_ad_boards.png\", 0.55),\n590:     \"V5_BigScreen\": (\"sv_bigscreen.png\", 0.95),\n591:     \"V5_DRSBoard\": (\"sv_drs_board.png\", 0.45),\n592:     \"V5_Brake150\": (\"sv_brake_150.png\", 0.35),\n593:     \"V5_Brake100\": (\"sv_brake_100.png\", 0.35),\n594:     \"V5_Brake50\": (\"sv_brake_50.png\", 0.35),\n595: }\n596: for _mn, (_fn, _em_boost) in _TEX_SWAPS.items():\n597:     _m = bpy.data.materials.get(_mn)\n598:     _fp = os.path.join(TEX_SV, _fn)\n599:     if _m and os.path.exists(_fp):\n600:         _nt = _m.node_tree\n601:         _nt.nodes.clear()\n602:         _img = bpy.data.images.load(_fp, check_existing=True)\n603:         _tn = _nt.nodes.new('ShaderNodeTexImage')\n604:         _tn.image = _img\n605:         _tn.extension = 'REPEAT'\n606:         _grp = _nt.nodes.new('ShaderNodeGroup')\n607:         _grp.node_tree = NG_COMIC\n608:         _grp.inputs['Rim Strength'].default_value = 0.08\n609:         _grp.inputs['Halftone Strength'].default_value = 0.30\n610:         _grp.inputs['Hatch Strength'].default_value = 0.25\n611:         _nt.links.new(_tn.outputs['Color'], _grp.inputs['Base Color'])\n612:         _em = _nt.nodes.new('ShaderNodeEmission')\n613:         _em.inputs['Strength'].default_value = _em_boost\n614:         _nt.links.new(_tn.outputs['Color'], _em.inputs['Color'])\n615:         _add = _nt.nodes.new('ShaderNodeAddShader')\n616:         _nt.links.new(_grp.outputs['Shader'], _add.inputs[0])\n617:         _nt.links.new(_em.outputs['Emission'], _add.inputs[1])\n618:         _out = _nt.nodes.new('ShaderNodeOutputMaterial')\n619:         _nt.links.new(_add.outputs['Shader'], _out.inputs['Surface'])\n620: "}
