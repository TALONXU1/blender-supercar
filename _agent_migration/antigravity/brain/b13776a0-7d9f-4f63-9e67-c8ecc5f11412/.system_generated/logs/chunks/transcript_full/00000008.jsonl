e.inputs['From Max'].default_value = max_dist\n777:     dfade.inputs['To Min'].default_value = 1.0\n778:     dfade.inputs['To Max'].default_value = 0.15\n779:     nt.links.new(camd.outputs['View Z Depth'], dfade.inputs['Value'])\n780: \n781:     fac = nt.nodes.new('ShaderNodeMath')\n782:     fac.operation = 'MULTIPLY'\n783:     fac.use_clamp = True\n784:     nt.links.new(brush.outputs['Result'], fac.inputs[0])\n785:     nt.links.new(dfade.outputs['Result'], fac.inputs[1])\n786: \n787:     mx = nt.nodes.new('ShaderNodeMixShader')\n788:     nt.links.new(fac.outputs[0], mx.inputs['Fac'])\n789:     nt.links.new(tr.outputs['BSDF'], mx.inputs[1])\n790:     nt.links.new(em.outputs['Emission'], mx.inputs[2])\n791:     nt.links.new(mx.outputs['Shader'], out.inputs['Surface'])\n792:     return m\n793: \n794: \n795: MAT_INK_HERO = build_ink_outline_mat(\"MAT_SV_InkOutline\", max_dist=130.0)\n796: MAT_INK_THIN = build_ink_outline_mat(\"MAT_SV_InkOutline_Thin\", max_dist=42.0)\n797: \n798: # 仅对主车身、前后主翼、轮胎、轮毂、Halo 施加反向壳墨线（跳过细小螺栓/LED/贴花，use_rim=False 杜绝镜像中缝黑线）\n799: _OUTLINE_PRIMARY = (\n800:     \"GEO_F1_Monocoque_Chassis\", \"GEO_F1_Nosecone\", \"GEO_F1_EngineCowl_Body\",\n801:     \"GEO_F1_Underbody_Floor\", \"GEO_F1_Airbox_Scoop\", \"GEO_F1_Dorsal_SharkFin\",\n802:     \"GEO_F1_Sidepod_IntakeLip_L\", \"GEO_F1_Sidepod_IntakeLip_R\",\n803:     \"GEO_F1_Tire_FL\", \"GEO_F1_Tire_FR\", \"GEO_F1_Tire_RL\", \"GEO_F1_Tire_RR\",\n804:     \"GEO_F1_Rim_FL\", \"GEO_F1_Rim_FR\", \"GEO_F1_Rim_RL\", \"GEO_F1_Rim_RR\",\n805: )\n806: _OUTLINE_THIN = (\n807:     \"GEO_F1_FrontWing_Mainplane\", \"GEO_F1_FrontWing_Endplate_L\", \"GEO_F1_FrontWing_Endplate_R\",\n808:     \"GEO_F1_RearWing_Mainplane\", \"GEO_F1_RearWing_DRSFlap\",\n809:     \"GEO_F1_RearWing_Endplate_L\", \"GEO_F1_RearWing_Endplate_R\", \"GEO_F1_RearWing_Pylon\",\n810:     \"GEO_F1_Halo_CenterPylon\", \"GEO_F1_Halo_Hoop\", \"GEO_F1_Cockpit_SteeringWheel\",\n811:     \"GEO_F1_AeroMirror_L\", \"GEO_F1_AeroMirror_R\", \"GEO_F1_Diffuser_Ramp\",\n812: )\n813: \n814: _outlined_cnt = 0\n815: for _onm, _thick, _imat in (\n816:     *[(n, 0.0085, MAT_INK_HERO) for n in _OUTLINE_PRIMARY],\n817:     *[(n, 0.0042, MAT_INK_THIN) for n in _OUTLINE_THIN],\n818: ):\n819:     _ob = bpy.data.objects.get(_onm)\n820:     if not _ob or not hasattr(_ob.data, \"materials\"):\n821:         continue\n822:     # 非均匀缩放补偿（如 GEO_F1_FrontWing_Endplate_L scale.x=0.018）\n823:     _min_sc = min(abs(_ob.scale.x), abs(_ob.scale.y), abs(_ob.scale.z))\n824:     if _min_sc < 0.15:\n825:         continue\n826:     if _imat.name not in [m.name for m in _ob.data.materials if m]:\n827:         _ob.data.materials.append(_imat)\n828:     _slot_idx = [m.name if m else \"\" for m in _ob.data.materials].index(_imat.name)\n829:     _mod = _ob.modifiers.get(\"SV_InkHull\") or _ob.modifiers.new(\"SV_InkHull\", 'SOLIDIFY')\n830:     _mod.thickness = -_thick       # offset=1.0 + 负 thickness -> 沿法线向外膨胀 _thick 米\n831:     _mod.offset = 1.0\n832:     _mod.use_flip_normals = True\n833:     _mod.use_rim = False           # 严禁在 Mirror 中轴线开口边缘生成黑墙\n834:     _mod.material_offset = _slot_idx\n835:     _outlined_cnt += 1\n836: print(\"3D Ink Outlines applied to hero car parts:\", _outlined_cnt)\n837: \n838: \n839: # ---------------------------------------------------------------\n840: # 5. 3D 漫画速度特效集合 V6_09_ComicFX（零文字、零遮挡相机视线）\n841: #    - 尾翼/前翼涡流飘带 (V6_FX_AeroRibbon_RL/RR/FL/FR -> Bone_Body)\n842: #    - 车轮高速旋转残影弧 (V6_FX_WheelSmear_FL/FR/RL/RR -> Bone_Wheel_*)\n843: #    - 排气管换挡爆燃星锥 (V6_FX_ExhaustCone -> Bone_Body)\n844: #    - 底板路肩擦地漫画火花斩 (V6_FX_KerbSparks_L/R -> Bone_Body)\n845: # ---------------------------------------------------------------\n846: fx_coll = bpy.data.collections.get(\"V6_09_ComicFX\") or bpy.data.collections.new(\"V6_09_ComicFX\")\n847: if fx_coll.name not in scene.collection.children:\n848:     scene.collection.children.link(fx_coll)\n849: \n850: rig = bpy.data.objects[\"RIG_F1_Race\"]\n851: deps = bpy.context.evaluated_depsgraph_get()\n852: rig_ev = rig.evaluated_get(deps)\n853: m_car_f1 = rig_ev.matrix_world @ rig_ev.pose.bones[\"Bone_Heading\"].matrix\n854: \n855: \n856: def parent_to_bone_at_car_coords(ob, bone_name):\n857:     \"\"\"把以车身局部坐标 (Bone_Heading 系) 建模的对象挂接到指定骨骼，精确保持第 1 帧姿态。\"\"\"\n858:     pb_mat = rig_ev.matrix_world @ rig_ev.pose.bones[bone_name].matrix\n859:     ob.matrix_world = m_car_f1\n860:     ob.parent = rig\n861:     ob.parent_type = 'BONE'\n862:     ob.parent_bone = bone_name\n863:     ob.matrix_parent_inverse = pb_mat.inverted()\n864:     ob.matrix_basis = pb_mat.inverted() @ m_car_f1\n865:     # 原点保持在车坐标系，方便 anim 直接缩放 ob.scale 开关/跳帧抖动！\n866:     try:\n867:         ob.visible_shadow = False\n868:     except Exception:\n869:         pass\n870: \n871: \n872: def make_fx_mat(name, c_core, c_edge, strength=3.8, wave_freq=6.0):\n873:     m = bpy.data.materials.get(name) or bpy.data.materials.new(name)\n874:     m.use_nodes = True\n875:     try:\n876:         m.surface_render_method = 'BLENDED'\n877:     except Exception:\n878:         pass\n879:     nt = m.node_tree\n880:     nt.nodes.clear()\n881:     out = nt.nodes.new('ShaderNodeOutputMaterial')\n882:     tr = nt.nodes.new('ShaderNodeBsdfTransparent')\n883:     em = nt.nodes.new('ShaderNodeEmission')\n884:     em.name = \"SV_FX_Emission\"\n885:     em.inputs['Strength'].default_value = strength\n886: \n887:     uv = nt.nodes.new('ShaderNodeUVMap'); uv.uv_map = \"UVMap\"\n888:     sep = nt.nodes.new('ShaderNodeSeparateXYZ'); nt.links.new(uv.outputs['UV'], sep.inputs['Vector'])\n889:     # 沿长度 U (0->1) 渐隐，沿宽度 V (0->1) 中心亮白/边缘霓虹 + 手绘锯齿切口\n890:     v_phase = nt.nodes.new('ShaderNodeValue')\n891:     v_phase.name = \"SV_FlutterPhase\"\n892:     v_phase.outputs[0].default_value = 0.0\n893: \n894:     u_off = nt.nodes.new('ShaderNodeMath'); u_off.operation = 'ADD'\n895:     nt.links.new(sep.outputs['X'], u_off.inputs[0]); nt.links.new(v_phase.outputs[0], u_off.inputs[1])\n896:     comb = nt.nodes.new('ShaderNodeCombineXYZ')\n897:     nt.links.new(u_off.outputs[0], comb.inputs['X']); nt.links.new(sep.outputs['Y'], comb.inputs['Y'])\n898:     ns = nt.nodes.new('ShaderNodeTexNoise'); ns.inputs['Scale'].default_value = wave_freq; ns.inputs['Detail'].default_value = 3.0\n899:     nt.links.new(comb.outputs['Vector'], ns.inputs['Vector'])\n900: \n901:     fade_u = nt.nodes.new('ShaderNodeMapRange')\n902:     fade_u.inputs['From Min'].default_value = 0.0\n903:     fade_u.inputs['From Max'].default_value = 1.0\n904:     fade_u.inputs['To Min'].default_value = 0.92\n905:     fade_u.inputs['To Max'].default_value = 0.0\n906:     nt.links.new(sep.outputs['X'], fade_u.inputs['Value'])\n907: \n908:     step_a = nt.nodes.new('ShaderNodeMath'); step_a.operation = 'GREATER_THAN'; step_a.inputs[1].default_value = 0.34\n909:     mul_a = nt.nodes.new('ShaderNodeMath'); mul_a.operation = 'MULTIPLY'\n910:     nt.links.new(fade_u.outputs['Result'], mul_a.inputs[0]); nt.links.new(ns.outputs['Fac'], mul_a.inputs[1])\n911:     nt.links.new(mul_a.outputs[0], step_a.inputs[0])\n912: \n913:     # 中心亮白芯 + 边缘电青/品红双色\n914:     dv = nt.nodes.new('ShaderNodeMath'); dv.operation = 'SUBTRACT'; dv.inputs[1].default_value = 0.5\n915:     nt.links.new(sep.outputs['Y'], dv.inputs[0])\n916:     abv = nt.nodes.new('ShaderNodeMath'); abv.operation = 'ABSOLUTE'; nt.links.new(dv.outputs[0], abv.inputs[0])\n917:     col_r = nt.nodes.new('ShaderNodeValToRGB'); col_r.color_ramp.interpolation = 'CONSTANT'\n918:     col_r.color_ramp.elements[0].position = 0.0; col_r.color_ramp.elements[0].color = (*c_core, 1.0)\n919:     col_r.color_ramp.elements[1].position = 0.24; col_r.color_ramp.elements[1].color = (*c_edge, 1.0)\n920:     nt.links.new(abv.outputs[0], col_r.inputs[0])\n921:     nt.links.new(col_r.outputs['Color'], em.inputs['Color'])\n922: \n923:     mx = nt.nodes.new('ShaderNodeMixShader')\n924:     mx.name = \"SV_FX_AlphaMix\"\n925:     nt.links.new(step_a.outputs[0], mx.inputs['Fac'])\n926:     nt.links.new(tr.outputs['BSDF'], mx.inputs[1])\n927:     nt.links.new(em.outputs['Emission'], mx.inputs[2])\n928:     nt.links.new(mx.outputs['Shader'], out.inputs['Surface'])\n929:     return m\n930: \n931: \n932: MAT_RIBBON_CYAN = make_fx_mat(\"MAT_SV_AeroRibbon_Cyan\", (1.0, 1.0, 1.0), (0.0, 0.92, 1.0), strength=3.6, wave_freq=5.5)\n933: MAT_RIBBON_MAG = make_fx_mat(\"MAT_SV_AeroRibbon_Mag\", (1.0, 0.96, 1.0), (1.0, 0.14, 0.58), strength=3.6, wave_freq=6.5)\n934: MAT_WHEEL_SMEAR = make_fx_mat(\"MAT_SV_WheelSmear\", (1.0, 0.96, 0.85), (0.0, 0.88, 1.0), strength=2.8, wave_freq=8.0)\n935: MAT_EXH_BURST = make_fx_mat(\"MAT_SV_ExhaustBurst\", (1.0, 0.98, 0.82), (1.0, 0.18, 0.42), strength=5.2, wave_freq=9.0)\n936: MAT_SPARK_SLASH = make_fx_mat(\"MAT_SV_SparkSlashes\", (1.0, 1.0, 0.92), (1.0, 0.76, 0.06), strength=6.0, wave_freq=11.0)\n937: \n938: \n939: def create_fx_mesh(name, verts, faces, uvs, mat):\n940:     me = bpy.data.meshes.new(name)\n941:     me.from_pydata(verts, [], faces)\n942:     me.update()\n943:     uvl = me.uv_layers.new(name=\"UVMap\")\n944:     for poly in me.polygons:\n945:         for li in poly.loop_indices:\n946:             uvl.data[li].uv = uvs[me.loops[li].vertex_index]\n947:     me.materials.append(mat)\n948:     ob = bpy.data.objects.new(name, me)\n949:     fx_coll.objects.link(ob)\n950:     return ob\n951: \n952: \n953: # 5a) 尾翼端板双螺旋漫画涡流飘带 + 前翼外侧导流涡流带\n954: def build_aero_ribbon(name, start_xyz, length, width0, side_sgn, mat, arch_z=0.14):\n955:     segs = 18\n956:     vs, fs, uvs = [], [], []\n957:     sx, sy, sz = start_xyz\n958:     for i in range(segs + 1):\n959:         u = i / float(segs)\n960:         cx = sx + side_sgn * (0.12 * (u ** 1.3) + 0.035 * sin(u * 9.0))\n961:         cy = sy - length * u\n962:         cz = sz + arch_z * (u ** 1.1) + 0.025 * cos(u * 9.0)\n963:         w = width0 * (1.0 - 0.88 * u)\n964:         twist = u * 2.4 * side_sgn\n965:         dx, dz = w * cos(twist), w * sin(twist)\n966:         vs.append((cx - dx, cy, cz - dz))\n967:         vs.append((cx + dx, cy, cz + dz))\n968:         uvs.append((u, 0.0))\n969:         uvs.append((u, 1.0))\n970:     for i in range(segs):\n971:         a = i * 2\n972:         fs.append((a, a + 1, a + 3, a + 2))\n973:     ob = create_fx_mesh(name, vs, fs, uvs, mat)\n974:     parent_to_bone_at_car_coords(ob, \"Bone_Body\")\n975:     ob[\"fx_flutter\"] = 1.0\n976:     return ob\n977: \n978: \n979: build_aero_ribbon(\"V6_FX_AeroRibbon_RL\", (-0.51, -2.47, 1.03), 3.6, 0.055, -1.0, MAT_RIBBON_CYAN, arch_z=0.14)\n980: build_aero_ribbon(\"V6_FX_AeroRibbon_RR\", (0.51, -2.47, 1.03), 3.6, 0.055, 1.0, MAT_RIBBON_MAG, arch_z=0.14)\n981: build_aero_ribbon(\"V6_FX_AeroRibbon_FL\", (-1.04, 2.62, 0.28), 1.65, 0.038, -1.0, MAT_RIBBON_MAG, arch_z=0.08)\n982: build_aero_ribbon(\"V6_FX_AeroRibbon_FR\", (1.04, 2.62, 0.28), 1.65, 0.038, 1.0, MAT_RIBBON_CYAN, arch_z=0.08)\n983: \n984: # 5b) 四轮外侧漫画旋转速度残影弧 (Wheel-Spin Comic Smear Arcs -> Bone_Wheel_*)\n985: _WHEEL_SPECS = [\n986:     (\"V6_FX_WheelSmear_FL\", \"Bone_Wheel_FL\", -1.084, 1.45, 0.351),\n987:     (\"V6_FX_WheelSmear_FR\", \"Bone_Wheel_FR\", 1.084, 1.45, 0.351),\n988:     (\"V6_FX_WheelSmear_RL\", \"Bone_Wheel_RL\", -1.080, -1.55, 0.336),\n989:     (\"V6_FX_WheelSmear_RR\", \"Bone_Wheel_RR\", 1.080, -1.55, 0.336),\n990: ]\n991: for _wnm, _wb, _wx, _wy, _wz in _WHEEL_SPECS:\n992:     vs, fs, uvs = [], [], []\n993:     # 两段不对称残影弧，旋转时产生强烈的 12fps 手绘动感残像\n994:     for a0_deg, span_deg, r_in, r_out in ((18.0, 118.0, 0.215, 0.285), (195.0, 108.0, 0.245, 0.318)):\n995:         base = len(vs)\n996:         steps = 12\n997:         for k in range(steps + 1):\n998:             u = k / float(steps)\n999:             ang = radians(a0_deg + span_deg * u)\n1000:             vs.append((_wx, _wy + cos(ang) * r_in, _wz + sin(ang) * r_in))\n1001:             vs.append((_wx, _wy + cos(ang) * r_out, _wz + sin(ang) * r_out))\n1002:             uvs.append((u, 0.0))\n1003:             uvs.append((u, 1.0))\n1004:         for k in range(steps):\n1005:             a = base + k * 2\n1006:             fs.append((a, a + 1, a + 3, a + 2))\n1007:     wob = create_fx_mesh(_wnm, vs, fs, uvs, MAT_WHEEL_SMEAR)\n1008:     parent_to_bone_at_car_coords(wob, _wb)\n1009: \n1010: # 5c) 排气管星芒漫画爆燃锥 (V6_FX_ExhaustCone) + 底板路肩火花斩 (V6_FX_KerbSparks_L/R)\n1011: def build_exhaust_and_sparks():\n1012:     # 十字交叉锯齿爆燃锥\n1013:     vs, fs, uvs = [], [], []\n1014:     for plane in (0, 1):\n1015:         b = len(vs)\n1016:         for k in range(7):\n1017:             u = k / 6.0\n1018:             y = -2.38 - 0.88 * u\n1019:             w = 0.075 * (1.0 - 0.85 * u)\n1020:             if plane == 0:\n1021:                 vs += [(-w, y, 0.436), (w, y, 0.436)]\n1022:             else:\n1023:                 vs += [(0.0, y, 0.436 - w), (0.0, y, 0.436 + w)]\n1024:             uvs += [(u, 0.0), (u, 1.0)]\n1025:         for k in range(6):\n1026:             a = b + k * 2\n1027:             fs.append((a, a + 1, a + 3, a + 2))\n1028:     ex_ob = create_fx_mesh(\"V6_FX_ExhaustCone\", vs, fs, uvs, MAT_EXH_BURST)\n1029:     parent_to_bone_at_car_coords(ex_ob, \"Bone_Body\")\n1030: \n1031:     # 左右底板擦地漫画锐角火花斩（默认微缩待命，anim 在高速触底/压路肩时 12fps 爆发缩放！）\n1032:     for sgn, snm in ((-1.0, \"V6_FX_KerbSparks_L\"), (1.0, \"V6_FX_KerbSparks_R\")):\n1033:         sv, sf, suv = [], [], []\n1034:         for si, (dx, dz_end, ln) in enumerate(((-0.04, 0.22, 1.15), (0.03, 0.14, 0.92), (0.09, 0.28, 1.30))):\n1035:             b = len(sv)\n1036:             x0 = sgn * (0.66 + dx)\n1037:             y0, z0 = -1.72, 0.055\n1038:             x1 = x0 + sgn * 0.18\n1039:             y1, z1 = y0 - ln, z0 + dz_end\n1040:             sv += [(x0 - 0.018, y0, z0), (x0 + 0.018, y0, z0), (x1 + 0.004, y1, z1), (x1 - 0.004, y1, z1)]\n1041:             suv += [(0.0, 0.0), (0.0, 1.0), (1.0, 1.0), (1.0, 0.0)]\n1042:             sf.append((b, b + 1, b + 2, b + 3))\n1043:         sp_ob = create_fx_mesh(snm, sv, sf, suv, MAT_SPARK_SLASH)\n1044:         parent_to_bone_at_car_coords(sp_ob, \"Bone_Body\")\n1045: \n1046: \n1047: build_exhaust_and_sparks()\n1048: \n1049: # ---------------------------------------------------------------\n1050: # 6. 自检：确认根 Scene Collection 为 0 对象，且 V6_09_ComicFX 零遮挡相机到 V5_CamFocus 视线\n1051: # ---------------------------------------------------------------\n1052: deps = bpy.context.evaluated_depsgraph_get()\n1053: fx_names = {o.name for o in fx_coll.objects}\n1054: mks = sorted([(m.frame, m.camera) for m in scene.timeline_markers if m.camera], key=lambda x: x[0])\n1055: cam_focus = bpy.data.objects.get(\"V5_CamFocus\")\n1056: fx_hits = []\n1057: for f_chk in range(1, 2162, 8):\n1058:     scene.frame_set(f_chk)\n1059:     deps.update()\n1060:     cam = scene.camera\n1061:     for mf, mc in mks:\n1062:         if f_chk >= mf:\n1063:             cam = mc\n1064:     cpos = cam.evaluated_get(deps).matrix_world.translation\n1065:     tpos = cam_focus.evaluated_get(deps).matrix_world.translation if cam_focus else Vector((0, 0, 0.5))\n1066:     dv = tpos - cpos\n1067:     if dv.length > 1.2:\n1068:         ok, _, _, _, hob, _ = scene.ray_cast(deps, cpos + dv.normalized() * 0.5, dv.normalized(), distance=dv.length - 0.8)\n1069:         if ok and hob and hob.name in fx_names:\n1070:             fx_hits.append((f_chk, cam.name, hob.name))\n1071: \n1072: scene.frame_set(1)\n1073: scene[\"sv_dimension\"] = 0.0\n1074: bpy.ops.wm.save_as_mainfile(filepath=OUT_BLEND)\n1075: # 清理可能生成的 .blend1\n1076: if os.path.exists(OUT_BLEND + \"1\"):\n1077:     try:\n1078:         os.remove(OUT_BLEND + \"1\")\n1079:     except Exception:\n1080:         pass\n1081: \n1082: print(\"=== V6 SPIDER-VERSE LOOKDEV BUILD SUMMARY ===\")\n1083: print(f\"Saved: {OUT_BLEND} in {time.time() - t_build_start:.2f} s\")\n1084: print(\"Total objects:\", len(bpy.data.objects), \"| Root objs:\", [o.name for o in scene.collection.objects])\n1085: print(\"V6_09_ComicFX objects:\", sorted(fx_names))\n1086: print(\"FX camera-to-focus raycast hits:\", len(fx_hits), fx_hits[:5])\n1087: \n1088: # ---------------------------------------------------------------\n1089: # 7. 可选 4 帧三幕预览渲染 (--preview) -> renders_v6/preview/\n1090: # ---------------------------------------------------------------\n1091: if \"--preview\" in ARGV:\n1092:     os.makedirs(PREV_DIR, exist_ok=True)\n1093:     scene.render.resolution_x = 1920\n1094:     scene.render.resolution_y = 1080\n1095:     scene.render.image_settings.file_format = 'JPEG'\n1096:     scene.render.image_settings.quality = 95\n1097:     # 临时关闭旧版 V5 泛光合成器以便纯粹检验三幕 3D 蜘蛛侠着色与墨线速度（anim 将在 v6_sv_comp.py 挂载完整多通道合成器）\n1098:     scene.use_nodes = False\n1099: \n1100:     preview_specs = [\n1101:         (\"sv_prev_01_act1_chase_f0068\", 68, 0.0),\n1102:         (\"sv_prev_02_act1_onboard_f0145\", 145, 0.0),\n1103:         (\"sv_prev_03_act2_gwen_f1320\", 1320, 1.0),\n1104:         (\"sv_prev_04_act3_2099_f1715\", 1715, 2.0),\n1105:     ]\n1106:     for p_name, p_frame, p_dim in preview_specs:\n1107:         scene[\"sv_dimension\"] = float(p_dim)\n1108:         scene.frame_set(p_frame)\n1109:         # 切换当前拍点对应激活相机\n1110:         act_cam = scene.camera\n1111:         for mf, mc in mks:\n1112:             if p_frame >= mf:\n1113:                 act_cam = mc\n1114:         scene.camera = act_cam\n1115:         scene.render.filepath = os.path.join(PREV_DIR, p_name + \".jpg\")\n1116:         t0 = time.time()\n1117:         bpy.ops.render.render(write_still=True)\n1118:         print(f\"RENDERED {p_name} (frame={p_frame}, cam={act_cam.name}, dim={p_dim}): {time.time() - t0:.2f} s\")\n1119:     scene[\"sv_dimension\"] = 0.0"}
{"step_index":155,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-18T07:34:01Z","input_tokens":8997,"cache_read_tokens":378986,"output_tokens":14111,"thinking":"`scene.render.motion_blur_shutter` at `0.17` with motion blur enabled explains the smearing observed in the previous versions. This suggests the specific values of `sv_prev_01` and `sv_prev_03` are artifacts of motion blur.\n\n\nscene.render.motion_blur_shutter set to 0.06 in `v6_sv_build.py` ensures crisp motion, preventing smearing of details like Ben-Day dots and crosshatching. The `NG_SV_ComicSurface` node group requires the \"SV Dimension\" property to be a group input socket, driven by a Value node within each material's node tree, along with a `scene.update_tag()` call for manual Python changes, to guarantee reliable driver evaluation across Blender versions. Linear color math needs correction for shading and material properties to fix potential inaccuracies.\n\n\nCorrected the sRGB values for Prussian-black ink to `(0, 0, 0)` in linear space for true black, instead of the previous incorrect grey value. Shadow tint values were adjusted to achieve richer, saturated comic shadow colors. Ink hatch color values were refined for sharper pen strokes in shadow and terminator regions.\n\nRefined halftone parameters were established, focusing on achieving high-contrast comic pop art, adjusting the scale and strength values. The scene's sun energy levels were modified for Act II and Act III to align with a luminous watercolor world and dynamic lighting adjustments.\n\n\n","tool_calls":[{"name":"edit_file","args":{"Path":"D:\\项目session\\blender-supercar\\pipeline\\v6_sv_build.py","Replacement":"scene[\"sv_dimension\"] = 0.0\nscene.eevee.use_raytracing = False\nscene.eevee.taa_render_samples = 16\nscene.render.motion_blur_shutter = 0.05\nscene.view_settings.view_transform = 'Standard'\nscene.view_settings.look = 'None'\n# 更新曝光曲线基准（Standard 下 0.12 保持鲜明高饱和漫画色块，片尾保留淡出）\nif scene.animation_data and scene.animation_data.action:\n    def _iter_fcs(act):\n        fcs = list(getattr(act, \"fcurves\", []) or [])\n        if fcs:\n            return fcs\n        for lay in getattr(act, \"layers\", []) or []:\n            for st in getattr(lay, \"strips\", []) or []:\n                for cb in getattr(st, \"channelbags\", []) or []:\n                    fcs.extend(cb.fcurves)\n        return fcs\n    for _fc in _iter_fcs(scene.animation_data.action):\n        if \"exposure\" in _fc.data_path:\n            for _kp in _fc.keyframe_points:\n                _kp.co.y = 0.12 if _kp.co.x < 2140 else -5.0\nscene.view_settings.exposure = 0.12\n\n\ndef add_dim_driver(id_block_or_node_socket, prop_name, expr, index=-1):\n    \"\"\"给任意属性或节点端口绑定读取 scene['sv_dimension'] (变量名 dim) 的表达式驱动器。\"\"\"\n    if index >= 0:\n        fc = id_block_or_node_socket.driver_add(prop_name, index)\n    else:\n        fc = id_block_or_node_socket.driver_add(prop_name)\n    d = fc.driver\n    d.type = 'SCRIPTED'\n    while d.variables:\n        d.variables.remove(d.variables[0])\n    v = d.variables.new()\n    v.name = \"dim\"\n    v.type = 'SINGLE_PROP'\n    v.targets[0].id_type = 'SCENE'\n    v.targets[0].id = scene\n    v.targets[0].data_path = '[\"sv_dimension\"]'\n    d.expression = expr\n    return fc\n\n\ndef act_weights_from_socket(nt, dim_out):\n    \"\"\"由输入的 dim 端口计算 w2 (Act II Gwen 权重) 与 w3 (Act III 2099 权重)。\"\"\"\n    sub1 = nt.nodes.new('ShaderNodeMath')\n    sub1.operation = 'SUBTRACT'\n    sub1.inputs[1].default_value = 1.0\n    nt.links.new(dim_out, sub1.inputs[0])\n    ab1 = nt.nodes.new('ShaderNodeMath')\n    ab1.operation = 'ABSOLUTE'\n    nt.links.new(sub1.outputs[0], ab1.inputs[0])\n    w2 = nt.nodes.new('ShaderNodeMath')\n    w2.operation = 'SUBTRACT'\n    w2.use_clamp = True\n    w2.inputs[0].default_value = 1.0\n    nt.links.new(ab1.outputs[0], w2.inputs[1])\n\n    w3 = nt.nodes.new('ShaderNodeMath')\n    w3.operation = 'SUBTRACT'\n    w3.use_clamp = True\n    w3.inputs[1].default_value = 1.0\n    nt.links.new(dim_out, w3.inputs[0])\n    return w2.outputs[0], w3.outputs[0]\n\n\ndef add_act_weights(nt):\n    \"\"\"在材质顶层节点树生成随 scene['sv_dimension'] 驱动的 Value 节点及 (w2, w3)。\"\"\"\n    v_dim = nt.nodes.new('ShaderNodeValue')\n    v_dim.name = \"SV_Dimension_Input\"\n    add_dim_driver(v_dim.outputs[0], \"default_value\", \"dim\")\n    w2_o, w3_o = act_weights_from_socket(nt, v_dim.outputs[0])\n    return v_dim, w2_o, w3_o\n\n\ndef tri_color_mix(nt, c_act1, c_act2, c_act3, w2_out, w3_out):\n    \"\"\"按 Act I / II / III 插值三组色彩。\"\"\"\n    m12 = nt.nodes.new('ShaderNodeMixRGB')\n    m12.inputs['Color1'].default_value = (*c_act1, 1.0)\n    m12.inputs['Color2'].default_value = (*c_act2, 1.0)\n    nt.links.new(w2_out, m12.inputs['Factor'])\n    m123 = nt.nodes.new('ShaderNodeMixRGB')\n    m123.inputs['Color2'].default_value = (*c_act3, 1.0)\n    nt.links.new(w3_out, m123.inputs['Factor'])\n    nt.links.new(m12.outputs['Color'], m123.inputs['Color1'])\n    return m123.outputs['Color']\n\n\n# ---------------------------------------------------------------\n# 1. 核心漫画节点组 NG_SV_ComicSurface\n#    - 纯白 Diffuse BSDF -> ShaderToRGB 提取真实日照与投影辐照度\n#    - 线性空间精确校准的深邃普鲁士靛蓝(1610) / 青紫水彩(65) / 黑曜紫外光(2099) 漫画阴影\n#    - 16:9 屏幕空间 (Window) 14px 高对比双极本戴半调网点 + 45° 浓墨钢笔交叉排线\n#    - 锐利阶梯双边缘光 (Dual Rim Kick: 电青 + 品红/激光绯红)\n# ---------------------------------------------------------------\ndef build_comic_nodegroup():\n    old = bpy.data.node_groups.get(\"NG_SV_ComicSurface\")\n    if old:\n        bpy.data.node_groups.remove(old)\n    ng = bpy.data.node_groups.new(\"NG_SV_ComicSurface\", 'ShaderNodeTree')\n\n    s_col = ng.interface.new_socket(name=\"Base Color\", in_out='INPUT', socket_type='NodeSocketColor')\n    s_col.default_value = (0.5, 0.5, 0.5, 1.0)\n    s_dim = ng.interface.new_socket(name=\"SV Dimension\", in_out='INPUT', socket_type='NodeSocketFloat')\n    s_dim.default_value = 0.0\n    s_rim = ng.interface.new_socket(name=\"Rim Strength\", in_out='INPUT', socket_type='NodeSocketFloat')\n    s_rim.default_value = 0.85\n    s_ht = ng.interface.new_socket(name=\"Halftone Scale\", in_out='INPUT', socket_type='NodeSocketFloat')\n    s_ht.default_value = 72.0\n    s_hts = ng.interface.new_socket(name=\"Halftone Strength\", in_out='INPUT', socket_type='NodeSocketFloat')\n    s_hts.default_value = 0.72\n    s_hcs = ng.interface.new_socket(name=\"Hatch Strength\", in_out='INPUT', socket_type='NodeSocketFloat')\n    s_hcs.default_value = 0.75\n    s_nrm = ng.interface.new_socket(name=\"Normal\", in_out='INPUT', socket_type='NodeSocketVector')\n    ng.interface.new_socket(name=\"Shader\", in_out='OUTPUT', socket_type='NodeSocketShader')\n\n    gi = ng.nodes.new('NodeGroupInput')\n    go = ng.nodes.new('NodeGroupOutput')\n    w2, w3 = act_weights_from_socket(ng, gi.outputs['SV Dimension'])\n\n    # A) 提取纯光照亮度 irr\n    diff = ng.nodes.new('ShaderNodeBsdfDiffuse')\n    diff.inputs['Color'].default_value = (1.0, 1.0, 1.0, 1.0)\n    ng.links.new(gi.outputs['Normal'], diff.inputs['Normal'])\n    s2r = ng.nodes.new('ShaderNodeShaderToRGB')\n    ng.links.new(diff.outputs['BSDF'], s2r.inputs['Shader'])\n    rgb2bw = ng.nodes.new('ShaderNodeRGBToBW')\n    ng.links.new(s2r.outputs['Color'], rgb2bw.inputs['Color'])\n    irr = rgb2bw.outputs['Val']\n\n    # B) 三阶硬边卡通明暗量化 (0.0=暗部, 0.5=中调, 1.0=高光块)\n    band_ramp = ng.nodes.new('ShaderNodeValToRGB')\n    band_ramp.color_ramp.interpolation = 'CONSTANT'\n    band_ramp.color_ramp.elements[0].position = 0.0\n    band_ramp.color_ramp.elements[0].color = (0.0, 0.0, 0.0, 1.0)\n    e_mid = band_ramp.color_ramp.elements.new(0.28)\n    e_mid.color = (0.5, 0.5, 0.5, 1.0)\n    band_ramp.color_ramp.elements[-1].position = 0.68\n    band_ramp.color_ramp.elements[-1].color = (1.0, 1.0, 1.0, 1.0)\n    ng.links.new(irr, band_ramp.inputs[0])\n\n    # 线性色值校准：深邃高饱和普鲁士靛蓝(Act1) / 水彩青梅紫(Act2) / 赛博深紫外(Act3)\n    sh_tint = tri_color_mix(ng, (0.005, 0.003, 0.028), (0.006, 0.028, 0.048), (0.010, 0.002, 0.038), w2, w3)\n    mid_tint = tri_color_mix(ng, (0.012, 0.004, 0.002), (0.018, 0.028, 0.036), (0.024, 0.004, 0.032), w2, w3)\n    hi_tint = tri_color_mix(ng, (0.14, 0.07, 0.015), (0.16, 0.05, 0.14), (0.02, 0.14, 0.24), w2, w3)\n\n    sh_mul = ng.nodes.new('ShaderNodeMixRGB')\n    sh_mul.blend_type = 'MULTIPLY'\n    sh_mul.inputs['Factor'].default_value = 1.0\n    sh_mul.inputs['Color2'].default_value = (0.24, 0.22, 0.34, 1.0)\n    ng.links.new(gi.outputs['Base Color'], sh_mul.inputs['Color1'])\n    sh_col = ng.nodes.new('ShaderNodeMixRGB')\n    sh_col.blend_type = 'ADD'\n    sh_col.inputs['Factor'].default_value = 1.0\n    ng.links.new(sh_mul.outputs['Color'], sh_col.inputs['Color1'])\n    ng.links.new(sh_tint, sh_col.inputs['Color2'])\n\n    mid_mul = ng.nodes.new('ShaderNodeMixRGB')\n    mid_mul.blend_type = 'MULTIPLY'\n    mid_mul.inputs['Factor'].default_value = 1.0\n    mid_mul.inputs['Color2'].default_value = (1.22, 1.18, 1.20, 1.0)\n    ng.links.new(gi.outputs['Base Color'], mid_mul.inputs['Color1'])\n    mid_col = ng.nodes.new('ShaderNodeMixRGB')\n    mid_col.blend_type = 'ADD'\n    mid_col.inputs['Factor'].default_value = 1.0\n    ng.links.new(mid_mul.outputs['Color'], mid_col.inputs['Color1'])\n    ng.links.new(mid_tint, mid_col.inputs['Color2'])\n\n    hi_mul = ng.nodes.new('ShaderNodeMixRGB')\n    hi_mul.blend_type = 'MULTIPLY'\n    hi_mul.inputs['Factor'].default_value = 1.0\n    hi_mul.inputs['Color2'].default_value = (1.75, 1.65, 1.58, 1.0)\n    ng.links.new(gi.outputs['Base Color'], hi_mul.inputs['Color1'])\n    hi_col = ng.nodes.new('ShaderNodeMixRGB')\n    hi_col.blend_type = 'ADD'\n    hi_col.inputs['Factor'].default_value = 1.0\n    ng.links.new(hi_mul.outputs['Color'], hi_col.inputs['Color1'])\n    ng.links.new(hi_tint, hi_col.inputs['Color2'])\n\n    is_mid = ng.nodes.new('ShaderNodeMath'); is_mid.operation = 'GREATER_THAN'; is_mid.inputs[1].default_value = 0.25\n    ng.links.new(band_ramp.outputs[0], is_mid.inputs[0])\n    is_hi = ng.nodes.ne