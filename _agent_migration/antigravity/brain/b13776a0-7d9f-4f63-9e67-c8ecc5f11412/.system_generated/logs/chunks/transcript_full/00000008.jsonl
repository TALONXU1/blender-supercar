rther investigation.\n\n\nThe target values for color adjustments are now defined: linear ink at (0.002, 0.002, 0.012), motion blur shutter at 0.06, and scene updates after changes to the scene dimension. The plan involves modifying the code to ensure Blender's dependency graph evaluates the scene dimension on every shader through a node socket input. Expected PIL output after fixing should reflect the updated color and saturation goals.\n\n\n","tool_calls":[{"name":"read_file","args":{"EndLine":390,"Path":"D:\\项目session\\blender-supercar\\pipeline\\v6_sv_build.py","StartLine":40}},{"name":"read_file","args":{"EndLine":620,"Path":"D:\\项目session\\blender-supercar\\pipeline\\v6_sv_build.py","StartLine":391}}]}
{"step_index":151,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-18T07:33:51Z","content":"Created At: 2026-11-18T15:33:51+08:00\nCompleted At: 2026-11-18T15:33:51+08:00\nShowing lines 40-390 of 1119\n40: scene[\"sv_dimension\"] = 0.0\n41: scene.eevee.use_raytracing = False\n42: scene.eevee.taa_render_samples = 24\n43: scene.view_settings.view_transform = 'Standard'\n44: scene.view_settings.look = 'None'\n45: # 更新曝光曲线基准（Standard 下 0.05 保持鲜明高饱和漫画色块，片尾保留淡出）\n46: if scene.animation_data and scene.animation_data.action:\n47:     def _iter_fcs(act):\n48:         fcs = list(getattr(act, \"fcurves\", []) or [])\n49:         if fcs:\n50:             return fcs\n51:         for lay in getattr(act, \"layers\", []) or []:\n52:             for st in getattr(lay, \"strips\", []) or []:\n53:                 for cb in getattr(st, \"channelbags\", []) or []:\n54:                     fcs.extend(cb.fcurves)\n55:         return fcs\n56:     for _fc in _iter_fcs(scene.animation_data.action):\n57:         if \"exposure\" in _fc.data_path:\n58:             for _kp in _fc.keyframe_points:\n59:                 _kp.co.y = 0.05 if _kp.co.x < 2140 else -5.0\n60: scene.view_settings.exposure = 0.05\n61: \n62: \n63: def add_dim_driver(id_block_or_node_socket, prop_name, expr, index=-1):\n64:     \"\"\"给任意属性或节点端口绑定读取 scene['sv_dimension'] (变量名 dim) 的表达式驱动器。\"\"\"\n65:     if index >= 0:\n66:         fc = id_block_or_node_socket.driver_add(prop_name, index)\n67:     else:\n68:         fc = id_block_or_node_socket.driver_add(prop_name)\n69:     d = fc.driver\n70:     d.type = 'SCRIPTED'\n71:     while d.variables:\n72:         d.variables.remove(d.variables[0])\n73:     v = d.variables.new()\n74:     v.name = \"dim\"\n75:     v.type = 'SINGLE_PROP'\n76:     v.targets[0].id_type = 'SCENE'\n77:     v.targets[0].id = scene\n78:     v.targets[0].data_path = '[\"sv_dimension\"]'\n79:     d.expression = expr\n80:     return fc\n81: \n82: \n83: def add_act_weights(nt):\n84:     \"\"\"在节点树内生成随 scene['sv_dimension'] 变化的 w2 (Act II 权重) 与 w3 (Act III 权重)。\"\"\"\n85:     v_dim = nt.nodes.new('ShaderNodeValue')\n86:     v_dim.name = \"SV_Dimension_Input\"\n87:     add_dim_driver(v_dim.outputs[0], \"default_value\", \"dim\")\n88:     # w2 = clamp(1 - |dim - 1.0|, 0..1)\n89:     sub1 = nt.nodes.new('ShaderNodeMath')\n90:     sub1.operation = 'SUBTRACT'\n91:     sub1.inputs[1].default_value = 1.0\n92:     nt.links.new(v_dim.outputs[0], sub1.inputs[0])\n93:     ab1 = nt.nodes.new('ShaderNodeMath')\n94:     ab1.operation = 'ABSOLUTE'\n95:     nt.links.new(sub1.outputs[0], ab1.inputs[0])\n96:     w2 = nt.nodes.new('ShaderNodeMath')\n97:     w2.operation = 'SUBTRACT'\n98:     w2.use_clamp = True\n99:     w2.inputs[0].default_value = 1.0\n100:     nt.links.new(ab1.outputs[0], w2.inputs[1])\n101:     # w3 = clamp(dim - 1.0, 0..1)\n102:     w3 = nt.nodes.new('ShaderNodeMath')\n103:     w3.operation = 'SUBTRACT'\n104:     w3.use_clamp = True\n105:     w3.inputs[1].default_value = 1.0\n106:     nt.links.new(v_dim.outputs[0], w3.inputs[0])\n107:     return v_dim, w2.outputs[0], w3.outputs[0]\n108: \n109: \n110: def tri_color_mix(nt, c_act1, c_act2, c_act3, w2_out, w3_out):\n111:     \"\"\"按 Act I / II / III 插值三组色彩。\"\"\"\n112:     m12 = nt.nodes.new('ShaderNodeMixRGB')\n113:     m12.inputs['Color1'].default_value = (*c_act1, 1.0)\n114:     m12.inputs['Color2'].default_value = (*c_act2, 1.0)\n115:     nt.links.new(w2_out, m12.inputs['Factor'])\n116:     m123 = nt.nodes.new('ShaderNodeMixRGB')\n117:     m123.inputs['Color2'].default_value = (*c_act3, 1.0)\n118:     nt.links.new(w3_out, m123.inputs['Factor'])\n119:     nt.links.new(m12.outputs['Color'], m123.inputs['Color1'])\n120:     return m123.outputs['Color']\n121: \n122: \n123: # ---------------------------------------------------------------\n124: # 1. 核心漫画节点组 NG_SV_ComicSurface\n125: #    - 纯白 Diffuse BSDF -> ShaderToRGB 提取真实日照与投影辐照度（深浅色物体统一命中三阶色带）\n126: #    - 阴影色偏：普鲁士靛蓝(1610) / 青紫水彩(65) / 黑曜紫外光(2099)，绝不死黑\n127: #    - 16:9 屏幕空间 (Window) 10px 醒目本戴半调网点 (Ben-Day Dots) + 45° 钢笔排线阴影 (Crosshatch)\n128: #    - 锐利阶梯双边缘光 (Dual Rim Kick: 电青 + 品红/激光绯红)\n129: # ---------------------------------------------------------------\n130: def build_comic_nodegroup():\n131:     old = bpy.data.node_groups.get(\"NG_SV_ComicSurface\")\n132:     if old:\n133:         bpy.data.node_groups.remove(old)\n134:     ng = bpy.data.node_groups.new(\"NG_SV_ComicSurface\", 'ShaderNodeTree')\n135: \n136:     s_col = ng.interface.new_socket(name=\"Base Color\", in_out='INPUT', socket_type='NodeSocketColor')\n137:     s_col.default_value = (0.5, 0.5, 0.5, 1.0)\n138:     s_rim = ng.interface.new_socket(name=\"Rim Strength\", in_out='INPUT', socket_type='NodeSocketFloat')\n139:     s_rim.default_value = 0.85\n140:     s_ht = ng.interface.new_socket(name=\"Halftone Scale\", in_out='INPUT', socket_type='NodeSocketFloat')\n141:     s_ht.default_value = 96.0\n142:     s_hts = ng.interface.new_socket(name=\"Halftone Strength\", in_out='INPUT', socket_type='NodeSocketFloat')\n143:     s_hts.default_value = 0.55\n144:     s_hcs = ng.interface.new_socket(name=\"Hatch Strength\", in_out='INPUT', socket_type='NodeSocketFloat')\n145:     s_hcs.default_value = 0.52\n146:     s_nrm = ng.interface.new_socket(name=\"Normal\", in_out='INPUT', socket_type='NodeSocketVector')\n147:     ng.interface.new_socket(name=\"Shader\", in_out='OUTPUT', socket_type='NodeSocketShader')\n148: \n149:     gi = ng.nodes.new('NodeGroupInput')\n150:     go = ng.nodes.new('NodeGroupOutput')\n151:     _, w2, w3 = add_act_weights(ng)\n152: \n153:     # A) 提取纯光照亮度 irr\n154:     diff = ng.nodes.new('ShaderNodeBsdfDiffuse')\n155:     diff.inputs['Color'].default_value = (1.0, 1.0, 1.0, 1.0)\n156:     ng.links.new(gi.outputs['Normal'], diff.inputs['Normal'])\n157:     s2r = ng.nodes.new('ShaderNodeShaderToRGB')\n158:     ng.links.new(diff.outputs['BSDF'], s2r.inputs['Shader'])\n159:     rgb2bw = ng.nodes.new('ShaderNodeRGBToBW')\n160:     ng.links.new(s2r.outputs['Color'], rgb2bw.inputs['Color'])\n161:     irr = rgb2bw.outputs['Val']\n162: \n163:     # B) 三阶硬边卡通明暗量化 (0.0=暗部, 0.5=中调, 1.0=高光块)\n164:     band_ramp = ng.nodes.new('ShaderNodeValToRGB')\n165:     band_ramp.color_ramp.interpolation = 'CONSTANT'\n166:     band_ramp.color_ramp.elements[0].position = 0.0\n167:     band_ramp.color_ramp.elements[0].color = (0.0, 0.0, 0.0, 1.0)\n168:     e_mid = band_ramp.color_ramp.elements.new(0.24)\n169:     e_mid.color = (0.5, 0.5, 0.5, 1.0)\n170:     band_ramp.color_ramp.elements[-1].position = 0.66\n171:     band_ramp.color_ramp.elements[-1].color = (1.0, 1.0, 1.0, 1.0)\n172:     ng.links.new(irr, band_ramp.inputs[0])\n173: \n174:     # 计算三档配色：Shadow (Base*0.42 + ActShadowTint), Mid (Base*1.12), Hi (Base*1.58 + ActHiTint)\n175:     sh_tint = tri_color_mix(ng, (0.055, 0.038, 0.165), (0.035, 0.125, 0.185), (0.048, 0.015, 0.135), w2, w3)\n176:     hi_tint = tri_color_mix(ng, (0.18, 0.13, 0.06), (0.18, 0.10, 0.15), (0.08, 0.16, 0.24), w2, w3)\n177: \n178:     sh_mul = ng.nodes.new('ShaderNodeMixRGB')\n179:     sh_mul.blend_type = 'MULTIPLY'\n180:     sh_mul.inputs['Factor'].default_value = 1.0\n181:     sh_mul.inputs['Color2'].default_value = (0.42, 0.40, 0.48, 1.0)\n182:     ng.links.new(gi.outputs['Base Color'], sh_mul.inputs['Color1'])\n183:     sh_col = ng.nodes.new('ShaderNodeMixRGB')\n184:     sh_col.blend_type = 'ADD'\n185:     sh_col.inputs['Factor'].default_value = 1.0\n186:     ng.links.new(sh_mul.outputs['Color'], sh_col.inputs['Color1'])\n187:     ng.links.new(sh_tint, sh_col.inputs['Color2'])\n188: \n189:     mid_col = ng.nodes.new('ShaderNodeMixRGB')\n190:     mid_col.blend_type = 'MULTIPLY'\n191:     mid_col.inputs['Factor'].default_value = 1.0\n192:     mid_col.inputs['Color2'].default_value = (1.14, 1.12, 1.14, 1.0)\n193:     ng.links.new(gi.outputs['Base Color'], mid_col.inputs['Color1'])\n194: \n195:     hi_mul = ng.nodes.new('ShaderNodeMixRGB')\n196:     hi_mul.blend_type = 'MULTIPLY'\n197:     hi_mul.inputs['Factor'].default_value = 1.0\n198:     hi_mul.inputs['Color2'].default_value = (1.52, 1.48, 1.44, 1.0)\n199:     ng.links.new(gi.outputs['Base Color'], hi_mul.inputs['Color1'])\n200:     hi_col = ng.nodes.new('ShaderNodeMixRGB')\n201:     hi_col.blend_type = 'ADD'\n202:     hi_col.inputs['Factor'].default_value = 1.0\n203:     ng.links.new(hi_mul.outputs['Color'], hi_col.inputs['Color1'])\n204:     ng.links.new(hi_tint, hi_col.inputs['Color2'])\n205: \n206:     # 按阶梯合并 Shadow / Mid / Hi\n207:     is_mid = ng.nodes.new('ShaderNodeMath')\n208:     is_mid.operation = 'GREATER_THAN'\n209:     is_mid.inputs[1].default_value = 0.25\n210:     ng.links.new(band_ramp.outputs[0], is_mid.inputs[0])\n211:     is_hi = ng.nodes.new('ShaderNodeMath')\n212:     is_hi.operation = 'GREATER_THAN'\n213:     is_hi.inputs[1].default_value = 0.75\n214:     ng.links.new(band_ramp.outputs[0], is_hi.inputs[0])\n215: \n216:     mix_sm = ng.nodes.new('ShaderNodeMixRGB')\n217:     ng.links.new(is_mid.outputs[0], mix_sm.inputs['Factor'])\n218:     ng.links.new(sh_col.outputs['Color'], mix_sm.inputs['Color1'])\n219:     ng.links.new(mid_col.outputs['Color'], mix_sm.inputs['Color2'])\n220: \n221:     mix_smh = ng.nodes.new('ShaderNodeMixRGB')\n222:     ng.links.new(is_hi.outputs[0], mix_smh.inputs['Factor'])\n223:     ng.links.new(mix_sm.outputs['Color'], mix_smh.inputs['Color1'])\n224:     ng.links.new(hi_col.outputs['Color'], mix_smh.inputs['Color2'])\n225: \n226:     # C) 16:9 屏幕空间本戴半调网点 (Ben-Day Halftone Dots) 与 45° 钢笔交叉排线 (Crosshatch)\n227:     tc = ng.nodes.new('ShaderNodeTexCoord')\n228:     sep_w = ng.nodes.new('ShaderNodeSeparateXYZ')\n229:     ng.links.new(tc.outputs['Window'], sep_w.inputs['Vector'])\n230:     wx_asp = ng.nodes.new('ShaderNodeMath')\n231:     wx_asp.operation = 'MULTIPLY'\n232:     wx_asp.inputs[1].default_value = 16.0 / 9.0\n233:     ng.links.new(sep_w.outputs['X'], wx_asp.inputs[0])\n234: \n235:     # 旋转 22.5° 网点网格：u = (wx*cos22.5 - wy*sin22.5)*scale, v = (wx*sin22.5 + wy*cos22.5)*scale\n236:     c22, s22 = cos(radians(22.5)), sin(radians(22.5))\n237:     ux1 = ng.nodes.new('ShaderNodeMath'); ux1.operation = 'MULTIPLY'; ux1.inputs[1].default_value = c22\n238:     uy1 = ng.nodes.new('ShaderNodeMath'); uy1.operation = 'MULTIPLY'; uy1.inputs[1].default_value = s22\n239:     ng.links.new(wx_asp.outputs[0], ux1.inputs[0]); ng.links.new(sep_w.outputs['Y'], uy1.inputs[0])\n240:     u_rot = ng.nodes.new('ShaderNodeMath'); u_rot.operation = 'SUBTRACT'\n241:     ng.links.new(ux1.outputs[0], u_rot.inputs[0]); ng.links.new(uy1.outputs[0], u_rot.inputs[1])\n242: \n243:     vx1 = ng.nodes.new('ShaderNodeMath'); vx1.operation = 'MULTIPLY'; vx1.inputs[1].default_value = s22\n244:     vy1 = ng.nodes.new('ShaderNodeMath'); vy1.operation = 'MULTIPLY'; vy1.inputs[1].default_value = c22\n245:     ng.links.new(wx_asp.outputs[0], vx1.inputs[0]); ng.links.new(sep_w.outputs['Y'], vy1.inputs[0])\n246:     v_rot = ng.nodes.new('ShaderNodeMath'); v_rot.operation = 'ADD'\n247:     ng.links.new(vx1.outputs[0], v_rot.inputs[0]); ng.links.new(vy1.outputs[0], v_rot.inputs[1])\n248: \n249:     u_sc = ng.nodes.new('ShaderNodeMath'); u_sc.operation = 'MULTIPLY'\n250:     v_sc = ng.nodes.new('ShaderNodeMath'); v_sc.operation = 'MULTIPLY'\n251:     ng.links.new(u_rot.outputs[0], u_sc.inputs[0]); ng.links.new(gi.outputs['Halftone Scale'], u_sc.inputs[1])\n252:     ng.links.new(v_rot.outputs[0], v_sc.inputs[0]); ng.links.new(gi.outputs['Halftone Scale'], v_sc.inputs[1])\n253: \n254:     u_fr = ng.nodes.new('ShaderNodeMath'); u_fr.operation = 'FRACT'; ng.links.new(u_sc.outputs[0], u_fr.inputs[0])\n255:     v_fr = ng.nodes.new('ShaderNodeMath'); v_fr.operation = 'FRACT'; ng.links.new(v_sc.outputs[0], v_fr.inputs[0])\n256:     du = ng.nodes.new('ShaderNodeMath'); du.operation = 'SUBTRACT'; du.inputs[1].default_value = 0.5; ng.links.new(u_fr.outputs[0], du.inputs[0])\n257:     dv = ng.nodes.new('ShaderNodeMath'); dv.operation = 'SUBTRACT'; dv.inputs[1].default_value = 0.5; ng.links.new(v_fr.outputs[0], dv.inputs[0])\n258:     du2 = ng.nodes.new('ShaderNodeMath'); du2.operation = 'MULTIPLY'; ng.links.new(du.outputs[0], du2.inputs[0]); ng.links.new(du.outputs[0], du2.inputs[1])\n259:     dv2 = ng.nodes.new('ShaderNodeMath'); dv2.operation = 'MULTIPLY'; ng.links.new(dv.outputs[0], dv2.inputs[0]); ng.links.new(dv.outputs[0], dv2.inputs[1])\n260:     dsum = ng.nodes.new('ShaderNodeMath'); dsum.operation = 'ADD'; ng.links.new(du2.outputs[0], dsum.inputs[0]); ng.links.new(dv2.outputs[0], dsum.inputs[1])\n261:     drad = ng.nodes.new('ShaderNodeMath'); drad.operation = 'SQRT'; ng.links.new(dsum.outputs[0], drad.inputs[0])\n262: \n263:     # 在中调与高光过渡带 (0.20 < irr < 0.86) 生成随明暗渐变半径的本戴圆点\n264:     ht_zone = ng.nodes.new('ShaderNodeValToRGB')\n265:     ht_zone.color_ramp.interpolation = 'LINEAR'\n266:     ht_zone.color_ramp.elements[0].position = 0.16\n267:     ht_zone.color_ramp.elements[0].color = (0.0, 0.0, 0.0, 1.0)\n268:     hz1 = ht_zone.color_ramp.elements.new(0.46)\n269:     hz1.color = (0.44, 0.44, 0.44, 1.0)\n270:     ht_zone.color_ramp.elements[-1].position = 0.86\n271:     ht_zone.color_ramp.elements[-1].color = (0.0, 0.0, 0.0, 1.0)\n272:     ng.links.new(irr, ht_zone.inputs[0])\n273: \n274:     dot_hit = ng.nodes.new('ShaderNodeMath')\n275:     dot_hit.operation = 'LESS_THAN'\n276:     ng.links.new(drad.outputs[0], dot_hit.inputs[0])\n277:     ng.links.new(ht_zone.outputs[0], dot_hit.inputs[1])\n278: \n279:     ht_fac = ng.nodes.new('ShaderNodeMath')\n280:     ht_fac.operation = 'MULTIPLY'\n281:     ng.links.new(dot_hit.outputs[0], ht_fac.inputs[0])\n282:     ng.links.new(gi.outputs['Halftone Strength'], ht_fac.inputs[1])\n283: \n284:     ht_pop_col = tri_color_mix(ng, (0.06, 0.78, 0.96), (0.98, 0.30, 0.72), (0.98, 0.12, 0.32), w2, w3)\n285:     ht_tint = ng.nodes.new('ShaderNodeMixRGB')\n286:     ht_tint.blend_type = 'SCREEN'\n287:     ht_tint.inputs['Factor'].default_value = 0.62\n288:     ng.links.new(mix_smh.outputs['Color'], ht_tint.inputs['Color1'])\n289:     ng.links.new(ht_pop_col, ht_tint.inputs['Color2'])\n290: \n291:     after_ht = ng.nodes.new('ShaderNodeMixRGB')\n292:     ng.links.new(ht_fac.outputs[0], after_ht.inputs['Factor'])\n293:     ng.links.new(mix_smh.outputs['Color'], after_ht.inputs['Color1'])\n294:     ng.links.new(ht_tint.outputs['Color'], after_ht.inputs['Color2'])\n295: \n296:     # D) 45° 钢笔排线阴影 (Pen Crosshatching in Terminator & Core Shadow: irr < 0.38)\n297:     h_sum = ng.nodes.new('ShaderNodeMath'); h_sum.operation = 'ADD'\n298:     ng.links.new(wx_asp.outputs[0], h_sum.inputs[0]); ng.links.new(sep_w.outputs['Y'], h_sum.inputs[1])\n299:     h_sc1 = ng.nodes.new('ShaderNodeMath'); h_sc1.operation = 'MULTIPLY'; h_sc1.inputs[1].default_value = 122.0\n300:     ng.links.new(h_sum.outputs[0], h_sc1.inputs[0])\n301:     h_fr1 = ng.nodes.new('ShaderNodeMath'); h_fr1.operation = 'FRACT'; ng.links.new(h_sc1.outputs[0], h_fr1.inputs[0])\n302:     h_ln1 = ng.nodes.new('ShaderNodeMath'); h_ln1.operation = 'LESS_THAN'; h_ln1.inputs[1].default_value = 0.28\n303:     ng.links.new(h_fr1.outputs[0], h_ln1.inputs[0])\n304: \n305:     # 反向 -45° 第二层交叉排线（仅最深暗部 irr < 0.18）\n306:     h_dif = ng.nodes.new('ShaderNodeMath'); h_dif.operation = 'SUBTRACT'\n307:     ng.links.new(wx_asp.outputs[0], h_dif.inputs[0]); ng.links.new(sep_w.outputs['Y'], h_dif.inputs[1])\n308:     h_sc2 = ng.nodes.new('ShaderNodeMath'); h_sc2.operation = 'MULTIPLY'; h_sc2.inputs[1].default_value = 122.0\n309:     ng.links.new(h_dif.outputs[0], h_sc2.inputs[0])\n310:     h_fr2 = ng.nodes.new('ShaderNodeMath'); h_fr2.operation = 'FRACT'; ng.links.new(h_sc2.outputs[0], h_fr2.inputs[0])\n311:     h_ln2 = ng.nodes.new('ShaderNodeMath'); h_ln2.operation = 'LESS_THAN'; h_ln2.inputs[1].default_value = 0.26\n312:     ng.links.new(h_fr2.outputs[0], h_ln2.inputs[0])\n313: \n314:     sh_m1 = ng.nodes.new('ShaderNodeMath'); sh_m1.operation = 'LESS_THAN'; sh_m1.inputs[1].default_value = 0.38\n315:     ng.links.new(irr, sh_m1.inputs[0])\n316:     sh_m2 = ng.nodes.new('ShaderNodeMath'); sh_m2.operation = 'LESS_THAN'; sh_m2.inputs[1].default_value = 0.18\n317:     ng.links.new(irr, sh_m2.inputs[0])\n318: \n319:     hm1 = ng.nodes.new('ShaderNodeMath'); hm1.operation = 'MULTIPLY'\n320:     ng.links.new(h_ln1.outputs[0], hm1.inputs[0]); ng.links.new(sh_m1.outputs[0], hm1.inputs[1])\n321:     hm2 = ng.nodes.new('ShaderNodeMath'); hm2.operation = 'MULTIPLY'\n322:     ng.links.new(h_ln2.outputs[0], hm2.inputs[0]); ng.links.new(sh_m2.outputs[0], hm2.inputs[1])\n323:     h_any = ng.nodes.new('ShaderNodeMath'); h_any.operation = 'MAXIMUM'\n324:     ng.links.new(hm1.outputs[0], h_any.inputs[0]); ng.links.new(hm2.outputs[0], h_any.inputs[1])\n325:     h_fac = ng.nodes.new('ShaderNodeMath'); h_fac.operation = 'MULTIPLY'\n326:     ng.links.new(h_any.outputs[0], h_fac.inputs[0]); ng.links.new(gi.outputs['Hatch Strength'], h_fac.inputs[1])\n327: \n328:     ink_hatch_col = tri_color_mix(ng, (0.016, 0.012, 0.055), (0.014, 0.045, 0.082), (0.018, 0.006, 0.052), w2, w3)\n329:     after_hatch = ng.nodes.new('ShaderNodeMixRGB')\n330:     ng.links.new(h_fac.outputs[0], after_hatch.inputs['Factor'])\n331:     ng.links.new(after_ht.outputs['Color'], after_hatch.inputs['Color1'])\n332:     ng.links.new(ink_hatch_col, after_hatch.inputs['Color2'])\n333: \n334:     # E) 阶梯双色漫画边缘光 (Dual Rim Kick: 电青主轮廓光 + 品红/绯红对侧轮廓光)\n335:     lw = ng.nodes.new('ShaderNodeLayerWeight')\n336:     lw.inputs['Blend'].default_value = 0.32\n337:     ng.links.new(gi.outputs['Normal'], lw.inputs['Normal'])\n338:     rim_step = ng.nodes.new('ShaderNodeValToRGB')\n339:     rim_step.color_ramp.interpolation = 'CONSTANT'\n340:     rim_step.color_ramp.elements[0].position = 0.0\n341:     rim_step.color_ramp.elements[0].color = (0.0, 0.0, 0.0, 1.0)\n342:     rim_step.color_ramp.elements[1].position = 0.66\n343:     rim_step.color_ramp.elements[1].color = (1.0, 1.0, 1.0, 1.0)\n344:     ng.links.new(lw.outputs['Facing'], rim_step.inputs[0])\n345: \n346:     # 用世界法线 X 分量区分左右双色边缘光（左电青/薄荷，右品红/绯红）\n347:     geo = ng.nodes.new('ShaderNodeNewGeometry')\n348:     sep_n = ng.nodes.new('ShaderNodeSeparateXYZ')\n349:     ng.links.new(geo.outputs['Normal'], sep_n.inputs['Vector'])\n350:     n_side = ng.nodes.new('ShaderNodeMapRange')\n351:     n_side.inputs['From Min'].default_value = -0.25\n352:     n_side.inputs['From Max'].default_value = 0.25\n353:     ng.links.new(sep_n.outputs['X'], n_side.inputs['Value'])\n354: \n355:     rim_c1 = tri_color_mix(ng, (0.0, 0.90, 1.0), (0.08, 0.98, 0.82), (0.0, 0.82, 1.0), w2, w3)\n356:     rim_c2 = tri_color_mix(ng, (1.0, 0.12, 0.48), (1.0, 0.24, 0.72), (1.0, 0.04, 0.14), w2, w3)\n357:     rim_dual = ng.nodes.new('ShaderNodeMixRGB')\n358:     ng.links.new(n_side.outputs['Result'], rim_dual.inputs['Factor'])\n359:     ng.links.new(rim_c1, rim_dual.inputs['Color1'])\n360:     ng.links.new(rim_c2, rim_dual.inputs['Color2'])\n361: \n362:     rim_amt = ng.nodes.new('ShaderNodeMath')\n363:     rim_amt.operation = 'MULTIPLY'\n364:     ng.links.new(rim_step.outputs[0], rim_amt.inputs[0])\n365:     ng.links.new(gi.outputs['Rim Strength'], rim_amt.inputs[1])\n366: \n367:     final_col = ng.nodes.new('ShaderNodeMixRGB')\n368:     ng.links.new(rim_amt.outputs[0], final_col.inputs['Factor'])\n369:     ng.links.new(after_hatch.outputs['Color'], final_col.inputs['Color1'])\n370:     ng.links.new(rim_dual.outputs['Color'], final_col.inputs['Color2'])\n371: \n372:     em = ng.nodes.new('ShaderNodeEmission')\n373:     em.inputs['Strength'].default_value = 1.0\n374:     ng.links.new(final_col.outputs['Color'], em.inputs['Color'])\n375:     ng.links.new(em.outputs['Emission'], go.inputs['Shader'])\n376:     return ng\n377: \n378: \n379: NG_COMIC = build_comic_nodegroup()\n380: \n381: \n382: # ---------------------------------------------------------------\n383: # 2. 天空穹顶 V5_SkyDome + 太阳/补光/世界随 scene[\"sv_dimension\"] 三幕变色\n384: # ---------------------------------------------------------------\n385: def upgrade_sky_and_lights():\n386:     sun_ob = bpy.data.objects.get(\"LGT_V5Sun\")\n387:     sun_dir = (sun_ob.matrix_world.to_3x3() @ Vector((0.0, 0.0, 1.0))).normalized() if sun_ob else Vector((-0.57, -0.74, 0.37))\n388: \n389:     if sun_ob and sun_ob.data:\n390:         # 太阳光颜色随三幕切换：暖金(1610) -> 珊瑚粉白(65) -> 冷青紫(2099)"}
