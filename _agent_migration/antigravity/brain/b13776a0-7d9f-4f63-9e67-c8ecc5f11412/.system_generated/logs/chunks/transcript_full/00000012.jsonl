  # 隧道穹顶纵向双道引导灯带\n1102:         for sgn in (-1.0, 1.0):\n1103:             ca0 = ft0[\"pos\"] + ft0[\"right\"] * (sgn * 2.6) + ft0[\"up\"] * 8.05\n1104:             cb0 = ft0[\"pos\"] + ft0[\"right\"] * (sgn * 2.9) + ft0[\"up\"] * 8.05\n1105:             ca1 = ft1[\"pos\"] + ft1[\"right\"] * (sgn * 2.6) + ft1[\"up\"] * 8.05\n1106:             cb1 = ft1[\"pos\"] + ft1[\"right\"] * (sgn * 2.9) + ft1[\"up\"] * 8.05\n1107:             ribs_bm.add_quad(ca0, cb0, cb1, ca1, MAT_NEON_CYAN if sgn < 0 else MAT_NEON_MAG)\n1108: \n1109:         # 每 12 m (i % 6 == 0) 一座高能六角激光灯肋拱架，让 340km/h 车身与湿滑地面产生炸裂频闪流光！\n1110:         if i % 6 == 0:\n1111:             rmat = MAT_NEON_MAG if ((i // 6) % 2 == 0) else MAT_NEON_CYAN\n1112:             for vi in range(len(vault_pts) - 1):\n1113:                 ox0, oz0 = vault_pts[vi]\n1114:                 ox1, oz1 = vault_pts[vi + 1]\n1115:                 p_a = ft0[\"pos\"] + ft0[\"right\"] * (ox0 * 0.96) + ft0[\"up\"] * (oz0 * 0.97)\n1116:                 p_b = ft0[\"pos\"] + ft0[\"right\"] * (ox1 * 0.96) + ft0[\"up\"] * (oz1 * 0.97)\n1117:                 ribs_bm.add_beam(p_a, p_b, 0.16, rmat)\n1118: \n1119:     # 隧道出口耀眼门廊 + 海港重刹发夹弯 150/100/50m 刹车牌与巨幕\n1120:     if tunnel_idxs:\n1121:         t_exit_i = tunnel_idxs[-1]\n1122:         fe = FRAMES[t_exit_i]\n1123:         # 隧道出口爆发丁达尔光束片（置于赛道两侧护栏外斜照高空，零阻挡视线！）\n1124:         for k_g in range(4):\n1125:             fg = frame_at(t_exit_i + 4 + k_g * 5)\n1126:             for sgn in (-1.0, 1.0):\n1127:                 b0 = fg[\"pos\"] + fg[\"right\"] * (sgn * (BARRIER_OFF + 1.5))\n1128:                 b1 = b0 + fg[\"fwd\"] * 9.0\n1129:                 t1 = b1 + Vector((0, 0, 48.0)) - fg[\"right\"] * (sgn * 6.0)\n1130:                 t0 = b0 + Vector((0, 0, 48.0)) - fg[\"right\"] * (sgn * 6.0)\n1131:                 gray_bm.add_quad(b0, b1, t1, t0, MAT_GODRAY_B if k_g % 2 == 0 else MAT_GODRAY_A)\n1132: \n1133:     # 城市峡谷丁达尔斜射神光片（摩天楼缝隙斜切而下）\n1134:     for idx_g in range(18, N, max(1, N // 10)):\n1135:         fg = FRAMES[idx_g]\n1136:         if fg[\"tunnel\"]:\n1137:             continue\n1138:         sgn = 1.0 if (idx_g % 2 == 0) else -1.0\n1139:         b0 = fg[\"pos\"] + fg[\"right\"] * (sgn * (BARRIER_OFF + 3.5))\n1140:         b1 = b0 + fg[\"fwd\"] * 14.0\n1141:         t1 = b1 + Vector((0, 0, 75.0)) + fg[\"right\"] * (sgn * 12.0)\n1142:         t0 = b0 + Vector((0, 0, 75.0)) + fg[\"right\"] * (sgn * 12.0)\n1143:         gray_bm.add_quad(b0, b1, t1, t0, MAT_GODRAY_A if sgn > 0 else MAT_GODRAY_B)\n1144: \n1145:     # 自动寻找全圈最重刹车发夹弯（Harbor Hairpin 等），在弯前 150/100/50 m 护栏外布置正对来车的漫画刹车牌 + 大屏\n1146:     min_v_i = min(range(N), key=lambda k: FRAMES[k][\"v\"])\n1147:     s_hairpin = FRAMES[min_v_i][\"s\"]\n1148:     out_hp = -1.0 if FRAMES[min_v_i][\"curv\"] > 0 else 1.0\n1149:     for d_m, lbl in ((150.0, \"150\"), (100.0, \"100\"), (50.0, \"50\")):\n1150:         fbk = frame_at_s(s_hairpin - d_m)\n1151:         cbk = fbk[\"pos\"] + fbk[\"right\"] * (out_hp * (BARRIER_OFF + 1.1)) + fbk[\"up\"] * 2.1\n1152:         harb_bm.add_oriented_box(cbk, fbk[\"right\"], fbk[\"fwd\"], fbk[\"up\"], 1.5, 0.12, 1.0, MAT_BRAKE[lbl])\n1153:     # 发夹弯外侧巨型霓虹直播大屏 + 维修区直道侧翼漫画车库外立面\n1154:     f_scr = frame_at_s(s_hairpin + 18.0)\n1155:     c_scr = f_scr[\"pos\"] + f_scr[\"right\"] * (out_hp * (BARRIER_OFF + 7.5)) + f_scr[\"up\"] * 8.5\n1156:     harb_bm.add_oriented_box(c_scr, f_scr[\"fwd\"], f_scr[\"right\"], f_scr[\"up\"], 22.0, 0.6, 12.4, MAT_SCREEN)\n1157: \n1158:     # 沿全圈非隧道段护栏外侧布置漫画广告灯箱与 DRS 标志牌\n1159:     for idx_ad in range(12, N, 32):\n1160:         fad = FRAMES[idx_ad]\n1161:         if fad[\"tunnel\"]:\n1162:             continue\n1163:         sgn = 1.0 if ((idx_ad // 32) % 2 == 0) else -1.0\n1164:         cad = fad[\"pos\"] + fad[\"right\"] * (sgn * (BARRIER_OFF + 0.55)) + fad[\"up\"] * (BARRIER_H + 0.85)\n1165:         slot = (idx_ad // 32) % 4\n1166:         harb_bm.add_oriented_box(cad, fad[\"fwd\"], fad[\"right\"], fad[\"up\"], 9.5, 0.18, 1.65, MAT_AD,\n1167:                                  uv_tile=(0.24, 0.96), uv_off=(slot * 0.25 + 0.005, 0.02))\n1168:     for s_drs in (LAP_LEN * 0.34, LAP_LEN * 0.72):\n1169:         fd = frame_at_s(s_drs)\n1170:         cd = fd[\"pos\"] + fd[\"right\"] * (BARRIER_OFF + 1.0) + fd[\"up\"] * 2.2\n1171:         harb_bm.add_oriented_box(cd, fd[\"right\"], fd[\"fwd\"], fd[\"up\"], 1.5, 0.12, 1.0, MAT_DRS)\n1172: \n1173:     city_bm.build(cast_shadow=True)\n1174:     sign_bm.build(cast_shadow=False)\n1175:     arch_bm.build(cast_shadow=True)\n1176:     brdg_bm.build(cast_shadow=True)\n1177:     cabl_bm.build(cast_shadow=False)\n1178:     bowl_bm.build(cast_shadow=True)\n1179:     tunn_bm.build(cast_shadow=True)\n1180:     ribs_bm.build(cast_shadow=False)\n1181:     harb_bm.build(cast_shadow=False)\n1182:     gray_bm.build(cast_shadow=False)\n1183:     print(f\"Megacity towers placed: {len(placed_towers)} | Tunnel samples: {len(tunnel_idxs)} | Bridge samples: {len(bridge_idxs)}\")\n1184: \n1185: \n1186: build_five_setpieces()\n1187: \n1188: \n1189: # ---------------------------------------------------------------\n1190: # 8. 英雄赛车漫画着色器 + 3D 可变线宽手绘墨线 + 炸裂级 V6_09_ComicFX 特效组\n1191: #    (马赫激波环双尾焰 + 金白钛合金底板火花长束 + 尾翼螺旋涡流带 + 雨胎霓虹水雾鸡尾酒喷流 + 轮毂残影弧)\n1192: # ---------------------------------------------------------------\n1193: def style_car_and_outlines():\n1194:     car_specs = {\n1195:         \"Mat_RedBull_MatteNavy\": ((0.038, 0.058, 0.24), 0.95, 92.0, 0.68, 0.62, 0.36),\n1196:         \"Mat_RedBull_Crimson\": ((0.98, 0.04, 0.22), 0.92, 92.0, 0.62, 0.48, 0.32),\n1197:         \"Mat_RedBull_SolarYellow\": ((1.00, 0.78, 0.03), 0.88, 92.0, 0.58, 0.42, 0.30),\n1198:         \"Mat_Merc_Petronas\": ((0.0, 0.90, 0.84), 0.92, 92.0, 0.58, 0.45, 0.30),\n1199:         \"Mat_Merc_Silver\": ((0.78, 0.84, 0.96), 0.92, 92.0, 0.52, 0.42, 0.38),\n1200:         \"Mat_Forged_Carbon\": ((0.055, 0.065, 0.155), 0.88, 98.0, 0.64, 0.58, 0.24),\n1201:         \"Mat_Carbon_Satin\": ((0.065, 0.075, 0.175), 0.85, 98.0, 0.60, 0.55, 0.22),\n1202:         \"Mat_Carbon_Endplate_Matte\": ((0.050, 0.058, 0.145), 0.90, 96.0, 0.62, 0.58, 0.22),\n1203:         \"Mat_Duct_Carbon\": ((0.048, 0.055, 0.135), 0.80, 98.0, 0.58, 0.54, 0.18),\n1204:         \"Mat_Tire_Slick_Compound\": ((0.038, 0.040, 0.088), 0.92, 90.0, 0.60, 0.62, 0.28),\n1205:         \"Mat_Rim_Forged_Dark\": ((0.075, 0.088, 0.215), 0.90, 98.0, 0.58, 0.54, 0.30),\n1206:         \"Mat_Rim_Machined_Lip\": ((0.86, 0.90, 0.98), 0.92, 98.0, 0.45, 0.35, 0.40),\n1207:         \"Mat_Liquid_Titanium\": ((0.80, 0.86, 0.98), 0.95, 96.0, 0.52, 0.42, 0.42),\n1208:         \"Mat_Titanium_Hardware\": ((0.74, 0.80, 0.94), 0.85, 98.0, 0.45, 0.40, 0.35),\n1209:         \"Mat_Anodized_Gold\": ((1.00, 0.74, 0.06), 0.88, 98.0, 0.52, 0.42, 0.35),\n1210:         \"Mat_CenterLock_Cyan\": ((0.0, 0.92, 0.98), 0.92, 98.0, 0.50, 0.40, 0.35),\n1211:         \"Mat_Inconel_GoldHeatShield\": ((1.00, 0.72, 0.08), 0.88, 98.0, 0.52, 0.42, 0.35),\n1212:         \"Mat_Exhaust_Titanium\": ((0.42, 0.48, 0.74), 0.90, 98.0, 0.52, 0.48, 0.35),\n1213:         \"Mat_Radiator_Mesh\": ((0.12, 0.14, 0.26), 0.60, 102.0, 0.50, 0.55, 0.10),\n1214:         \"Mat_Seatbelt_Webbing\": ((0.96, 0.06, 0.24), 0.75, 98.0, 0.50, 0.45, 0.05),\n1215:         \"Mat_PZero_White\": ((0.94, 0.95, 0.98), 0.75, 98.0, 0.35, 0.30, 0.10),\n1216:     }\n1217:     for mn, (rgb, rm, hs, hts, hcs, ct) in car_specs.items():\n1218:         if bpy.data.materials.get(mn):\n1219:             make_comic_mat(mn, rgb, rim=rm, ht_sc=hs, ht_s=hts, hc_s=hcs, coat=ct)\n1220: \n1221:     # 保留贴花 Alpha 与轮胎侧壁贴图的漫画转化\n1222:     for mn in (\"Mat_DEC_Engine_RedBull\", \"Mat_DEC_Halo_Oracle\", \"Mat_DEC_Nose_Livery\",\n1223:                \"Mat_DEC_Sidepod_Oracle\", \"Mat_PZero_Pirelli_Sidewall\"):\n1224:         m = bpy.data.materials.get(mn)\n1225:         if m and m.node_tree:\n1226:             tn_old = next((n for n in m.node_tree.nodes if n.type == 'TEX_IMAGE' and n.image), None)\n1227:             if tn_old:\n1228:                 img = tn_old.image\n1229:                 nt = m.node_tree; nt.nodes.clear()\n1230:                 out = nt.nodes.new('ShaderNodeOutputMaterial')\n1231:                 tn = nt.nodes.new('ShaderNodeTexImage'); tn.image = img\n1232:                 grp = nt.nodes.new('ShaderNodeGroup'); grp.node_tree = NG_COMIC\n1233:                 add_dim_driver(grp.inputs['SV Dimension'], \"default_value\", \"dim\")\n1234:                 grp.inputs['Rim Strength'].default_value = 0.65\n1235:                 grp.inputs['Neon Coat'].default_value = 0.25\n1236:                 nt.links.new(tn.outputs['Color'], grp.inputs['Base Color'])\n1237:                 if mn.startswith(\"Mat_DEC_\"):\n1238:                     try:\n1239:                         m.surface_render_method = 'DITHERED'\n1240:                     except Exception:\n1241:                         pass\n1242:                     tr = nt.nodes.new('ShaderNodeBsdfTransparent')\n1243:                     mx = nt.nodes.new('ShaderNodeMixShader')\n1244:                     nt.links.new(tn.outputs['Alpha'], mx.inputs['Fac'])\n1245:                     nt.links.new(tr.outputs['BSDF'], mx.inputs[1])\n1246:                     nt.links.new(grp.outputs['Shader'], mx.inputs[2])\n1247:                     nt.links.new(mx.outputs['Shader'], out.inputs['Surface'])\n1248:                 else:\n1249:                     nt.links.new(grp.outputs['Shader'], out.inputs['Surface'])\n1250: \n1251:     # 车身自带青色 LED 灯带随三幕变色增强（倒映在湿滑路面上！）\n1252:     m_nc = bpy.data.materials.get(\"Mat_Neon_Cyan\")\n1253:     if m_nc:\n1254:         make_neon_mat(\"Mat_Neon_Cyan\", (0.0, 0.96, 1.0), (0.12, 1.0, 0.86), (1.0, 0.03, 0.18), strength=10.5)\n1255: \n1256:     # 独立 FIA 尾部雨灯 Mat_FIA_RainLight + 径向热辐射碳陶刹车盘 Mat_BrakeDisc_CarbonCeramic + 卡钳\n1257:     rl_ob = bpy.data.objects.get(\"GEO_F1_FIA_RainLight\")\n1258:     if rl_ob and hasattr(rl_ob.data, \"materials\"):\n1259:         m_fia = bpy.data.materials.get(\"Mat_FIA_RainLight\") or bpy.data.materials.new(\"Mat_FIA_RainLight\")\n1260:         m_fia.use_nodes = True\n1261:         fnt = m_fia.node_tree; fnt.nodes.clear()\n1262:         fb = fnt.nodes.new(\"ShaderNodeBsdfPrincipled\")\n1263:         fb.inputs['Base Color'].default_value = (0.12, 0.005, 0.01, 1.0)\n1264:         fb.inputs['Roughness'].default_value = 0.18\n1265:         fb.inputs['Emission Color'].default_value = (1.0, 0.02, 0.04, 1.0)\n1266:         fb.inputs['Emission Strength'].default_value = 4.5\n1267:         fout = fnt.nodes.new(\"ShaderNodeOutputMaterial\")\n1268:         fnt.links.new(fb.outputs['BSDF'], fout.inputs['Surface'])\n1269:         if rl_ob.data.materials:\n1270:             rl_ob.data.materials[0] = m_fia\n1271:         else:\n1272:             rl_ob.data.materials.append(m_fia)\n1273: \n1274:     mdisc = bpy.data.materials.get(\"Mat_BrakeDisc_CarbonCeramic\")\n1275:     if mdisc and mdisc.node_tree:\n1276:         dnt = mdisc.node_tree\n1277:         db = next((n for n in dnt.nodes if n.type == 'BSDF_PRINCIPLED'), None)\n1278:         if db:\n1279:             dtc = next((n for n in dnt.nodes if n.type == 'TEX_COORD'), None) or dnt.nodes.new('ShaderNodeTexCoord')\n1280:             dsub = dnt.nodes.new('ShaderNodeVectorMath'); dsub.operation = 'MULTIPLY'; dsub.inputs[1].default_value = (0.0, 1.0, 1.0)\n1281:             dlen = dnt.nodes.new('ShaderNodeVectorMath'); dlen.operation = 'LENGTH'\n1282:             drmp = dnt.nodes.new('ShaderNodeValToRGB')\n1283:             drmp.color_ramp.elements[0].position = 0.085; drmp.color_ramp.elements[0].color = (0.02, 0.0, 0.01, 1.0)\n1284:             de1 = drmp.color_ramp.elements.new(0.138); de1.color = (1.0, 0.24, 0.03, 1.0)\n1285:             drmp.color_ramp.elements[-1].position = 0.186; drmp.color_ramp.elements[-1].color = (0.65, 0.04, 0.08, 1.0)\n1286:             dnt.links.new(dtc.outputs['Object'], dsub.inputs[0])\n1287:             dnt.links.new(dsub.outputs['Vector'], dlen.inputs[0])\n1288:             dnt.links.new(dlen.outputs['Value'], drmp.inputs['Fac'])\n1289:             dnt.links.new(drmp.outputs['Color'], db.inputs['Emission Color'])\n1290:             db.inputs['Emission Strength'].default_value = 0.0\n1291: \n1292:     # 3D 可变线宽手绘墨线轮廓 (Solidify Inverted-Hull, use_rim=False, 距离自适应收敛)\n1293:     def _ink_mat(nm, max_d):\n1294:         m = bpy.data.materials.get(nm) or bpy.data.materials.new(nm)\n1295:         m.use_nodes = True\n1296:         m.use_backface_culling = True\n1297:         try:\n1298:             m.use_backface_culling_shadow = True\n1299:             m.surface_render_method = 'DITHERED'\n1300:         except Exception:\n1301:             pass\n1302:         nt = m.node_tree; nt.nodes.clear()\n1303:         out = nt.nodes.new('ShaderNodeOutputMaterial')\n1304:         tr = nt.nodes.new('ShaderNodeBsdfTransparent')\n1305:         em = nt.nodes.new('ShaderNodeEmission')\n1306:         em.inputs['Color'].default_value = (0.0008, 0.0005, 0.0038, 1.0)\n1307:         em.inputs['Strength'].default_value = 1.0\n1308:         camd = nt.nodes.new('ShaderNodeCameraData')\n1309:         df = nt.nodes.new('ShaderNodeMapRange')\n1310:         df.inputs['From Min'].default_value = max_d * 0.45\n1311:         df.inputs['From Max'].default_value = max_d\n1312:         df.inputs['To Min'].default_value = 1.0\n1313:         df.inputs['To Max'].default_value = 0.12\n1314:         nt.links.new(camd.outputs['View Z Depth'], df.inputs['Value'])\n1315:         mx = nt.nodes.new('ShaderNodeMixShader')\n1316:         nt.links.new(df.outputs['Result'], mx.inputs['Fac'])\n1317:         nt.links.new(tr.outputs['BSDF'], mx.inputs[1])\n1318:         nt.links.new(em.outputs['Emission'], mx.inputs[2])\n1319:         nt.links.new(mx.outputs['Shader'], out.inputs['Surface'])\n1320:         return m\n1321: \n1322:     ink_hero = _ink_mat(\"MAT_SV_InkOutline\", 135.0)\n1323:     ink_thin = _ink_mat(\"MAT_SV_InkOutline_Thin\", 42.0)\n1324:     pri = (\n1325:         \"GEO_F1_Monocoque_Chassis\", \"GEO_F1_Nosecone\", \"GEO_F1_EngineCowl_Body\",\n1326:         \"GEO_F1_Underbody_Floor\", \"GEO_F1_Airbox_Scoop\", \"GEO_F1_Dorsal_SharkFin\",\n1327:         \"GEO_F1_Sidepod_IntakeLip_L\", \"GEO_F1_Sidepod_IntakeLip_R\",\n1328:         \"GEO_F1_Tire_FL\", \"GEO_F1_Tire_FR\", \"GEO_F1_Tire_RL\", \"GEO_F1_Tire_RR\",\n1329:         \"GEO_F1_Rim_FL\", \"GEO_F1_Rim_FR\", \"GEO_F1_Rim_RL\", \"GEO_F1_Rim_RR\",\n1330:     )\n1331:     thn = (\n1332:         \"GEO_F1_FrontWing_Mainplane\", \"GEO_F1_RearWing_Mainplane\", \"GEO_F1_RearWing_DRSFlap\",\n1333:         \"GEO_F1_RearWing_Endplate_L\", \"GEO_F1_RearWing_Endplate_R\", \"GEO_F1_RearWing_Pylon\",\n1334:         \"GEO_F1_Halo_CenterPylon\", \"GEO_F1_Halo_Hoop\", \"GEO_F1_Cockpit_SteeringWheel\",\n1335:         \"GEO_F1_AeroMirror_L\", \"GEO_F1_AeroMirror_R\", \"GEO_F1_Diffuser_Ramp\",\n1336:     )\n1337:     for onm, thk, imat in (*[(n, 0.0085, ink_hero) for n in pri], *[(n, 0.0042, ink_thin) for n in thn]):\n1338:         ob = bpy.data.objects.get(onm)\n1339:         if not ob or not hasattr(ob.data, \"materials\"):\n1340:             continue\n1341:         if min(abs(ob.scale.x), abs(ob.scale.y), abs(ob.scale.z)) < 0.15:\n1342:             continue\n1343:         if imat.name not in [m.name for m in ob.data.materials if m]:\n1344:             ob.data.materials.append(imat)\n1345:         idx_s = [m.name if m else \"\" for m in ob.data.materials].index(imat.name)\n1346:         mod = ob.modifiers.get(\"SV_InkHull\") or ob.modifiers.new(\"SV_InkHull\", 'SOLIDIFY')\n1347:         mod.thickness = -thk; mod.offset = 1.0; mod.use_flip_normals = True; mod.use_rim = False; mod.material_offset = idx_s\n1348: \n1349: \n1350: style_car_and_outlines()\n1351: \n1352: \n1353: def build_high_impact_car_fx():\n1354:     fx_coll = COLLS[\"V6_09_ComicFX\"]\n1355:     bpy.context.view_layer.update()\n1356:     deps = bpy.context.evaluated_depsgraph_get()\n1357:     rig_ev = rig.evaluated_get(deps)\n1358:     m_car0 = rig_ev.matrix_world @ rig_ev.pose.bones[\"Bone_Heading\"].matrix\n1359: \n1360:     def _bind_bone(ob, bname):\n1361:         pb_m = rig_ev.matrix_world @ rig_ev.pose.bones[bname].matrix\n1362:         ob.matrix_world = m_car0\n1363:         ob.parent = rig\n1364:         ob.parent_type = 'BONE'\n1365:         ob.parent_bone = bname\n1366:         ob.matrix_parent_inverse = pb_m.inverted()\n1367:         ob.matrix_basis = pb_m.inverted() @ m_car0\n1368:         ob.visible_shadow = False\n1369: \n1370:     def _fx_mat(name, c_core, c_edge, strength=5.0, freq=6.5, cut_thresh=0.30):\n1371:         m = bpy.data.materials.get(name) or bpy.data.materials.new(name)\n1372:         m.use_nodes = True\n1373:         try:\n1374:             m.surface_render_method = 'BLENDED'\n1375:         except Exception:\n1376:             pass\n1377:         nt = m.node_tree; nt.nodes.clear()\n1378:         out = nt.nodes.new('ShaderNodeOutputMaterial')\n1379:         tr = nt.nodes.new('ShaderNodeBsdfTransparent')\n1380:         em = nt.nodes.new('ShaderNodeEmission'); em.name = \"SV_FX_Emission\"; em.inputs['Strength'].default_value = strength\n1381:         uv = nt.nodes.new('ShaderNodeUVMap'); uv.uv_map = \"UVMap\"\n1382:         sep = nt.nodes.new('ShaderNodeSeparateXYZ'); nt.links.new(uv.outputs['UV'], sep.inputs['Vector'])\n1383:         v_ph = nt.nodes.new('ShaderNodeValue'); v_ph.name = \"SV_FlutterPhase\"; v_ph.outputs[0].default_value = 0.0\n1384:         uo = nt.nodes.new('ShaderNodeMath'); uo.operation = 'ADD'; nt.links.new(sep.outputs['X'], uo.inputs[0]); nt.links.new(v_ph.outputs[0], uo.inputs[1])\n1385:         cb = nt.nodes.new('ShaderNodeCombineXYZ'); nt.links.new(uo.outputs[0], cb.inputs['X']); nt.links.new(sep.outputs['Y'], cb.inputs['Y'])\n1386:         ns = nt.nodes.new('ShaderNodeTexNoise'); ns.inputs['Scale'].default_value = freq; ns.inputs['Detail'].default_value = 3.0; nt.links.new(cb.outputs['Vector'], ns.inputs['Vector'])\n1387:         fu = nt.nodes.new('ShaderNodeMapRange'); fu.inputs['To Min'].default_value = 0.96; fu.inputs['To Max'].default_value = 0.0; nt.links.new(sep.outputs['X'], fu.inputs['Value'])\n1388:         ma = nt.nodes.new('ShaderNodeMath'); ma.operation = 'MULTIPLY'; nt.links.new(fu.outputs['Result'], ma.inputs[0]); nt.links.new(ns.outputs['Fac'], ma.inputs[1])\n1389:         st = nt.nodes.new('ShaderNodeMath'); st.operation = 'GREATER_THAN'; st.inputs[1].default_value = cut_thresh; nt.links.new(ma.outputs[0], st.inputs[0])\n1390:         dv = nt.nodes.new('ShaderNodeMat