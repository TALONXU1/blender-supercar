links.new(mst.outputs[0], mmx.inputs['Factor']); mnt.links.new(mc_a, mmx.inputs['Color1']); mnt.links.new(mc_b, mmx.inputs['Color2'])\n756:     mnt.links.new(mmx.outputs['Color'], mem.inputs['Color'])\n757:     mnt.links.new(mem.outputs['Emission'], mout.inputs['Surface'])\n758: \n759:     mbm = bmesh.new()\n760:     bmesh.ops.create_circle(mbm, cap_ends=True, cap_tris=False, segments=64, radius=1.0)\n761:     mme = bpy.data.meshes.new(\"V6_HorizonMoonPortal\")\n762:     mbm.to_mesh(mme); mbm.free()\n763:     mme.materials.append(moon_mat)\n764:     mob = bpy.data.objects.new(\"V6_HorizonMoonPortal\", mme)\n765:     fwd_xy = Vector((_crest_f[\"fwd\"].x, _crest_f[\"fwd\"].y, 0.0)).normalized()\n766:     moon_pos = _crest_f[\"pos\"] + fwd_xy * 1180.0 + Vector((0.0, 0.0, 165.0))\n767:     mob.location = moon_pos\n768:     mob.rotation_euler = (-fwd_xy).to_track_quat('Z', 'Y').to_euler()\n769:     mob.scale = (195.0, 195.0, 195.0)\n770:     mob.visible_shadow = False\n771:     COLLS[\"V6_05_Atmosphere_GodRays\"].objects.link(mob)\n772: \n773:     # Z = -5.0 m 巨型暗黑海港反光水面\n774:     w_sz = 2800.0\n775:     w_me = bpy.data.meshes.new(\"V6_HarborWater\")\n776:     w_me.from_pydata([\n777:         (_cx - w_sz, _cy - w_sz, -5.0), (_cx + w_sz, _cy - w_sz, -5.0),\n778:         (_cx + w_sz, _cy + w_sz, -5.0), (_cx - w_sz, _cy + w_sz, -5.0),\n779:     ], [], [(0, 1, 2, 3)])\n780:     w_me.update()\n781:     w_me.materials.append(MAT_WATER)\n782:     w_ob = bpy.data.objects.new(\"V6_HarborWater\", w_me)\n783:     COLLS[\"V6_03_SkyBridge_Bowl\"].objects.link(w_ob)\n784: \n785: \n786: build_skydome_and_moon()\n787: \n788: \n789: # ---------------------------------------------------------------\n790: # 6. 3D 倾角赛道主体 + 贴身 ±8.2m 赛博护栏 + 霓虹路肩（彻底告别 33m 空旷草坪！）\n791: # ---------------------------------------------------------------\n792: BARRIER_OFF = HALF_W + 1.2     # ±8.2 m 紧贴赛道，强烈摩纳哥街道/2099 速度压迫感！\n793: BARRIER_H = 1.18\n794: \n795: \n796: def build_3d_track_and_barriers():\n797:     # A) 主路面厚板（上表面 5 段湿滑镜面沥青 + 下腹板钢箱梁包边，仰拍/航拍绝不穿帮薄片！）\n798:     cols = (-HALF_W - 1.25, -HALF_W, -3.5, 0.0, 3.5, HALF_W, HALF_W + 1.25)\n799:     nc = len(cols)\n800:     tv, tfc, tuv, tmat = [], [], [], []\n801:     idxs = list(range(N)) + [0]\n802:     for k_i, idx in enumerate(idxs):\n803:         fr = FRAMES[idx]\n804:         p, r, u = fr[\"pos\"], fr[\"right\"], fr[\"up\"]\n805:         s_uv = (fr[\"s\"] if k_i < N else LAP_LEN) / 10.0\n806:         for ci, off in enumerate(cols):\n807:             pt3 = p + r * off + u * 0.010\n808:             tv.append((pt3.x, pt3.y, pt3.z))\n809:             tuv.append((ci / float(nc - 1), s_uv))\n810:         # 下腹板底边两列（厚 0.95 m）\n811:         b_l = p - r * (HALF_W + 1.25) - u * 0.95\n812:         b_r = p + r * (HALF_W + 1.25) - u * 0.95\n813:         tv.append((b_l.x, b_l.y, b_l.z)); tuv.append((0.0, s_uv))\n814:         tv.append((b_r.x, b_r.y, b_r.z)); tuv.append((1.0, s_uv))\n815: \n816:     stride = nc + 2\n817:     for j in range(len(idxs) - 1):\n818:         b0 = j * stride\n819:         b1 = (j + 1) * stride\n820:         for ci in range(nc - 1):\n821:             tfc.append((b0 + ci, b0 + ci + 1, b1 + ci + 1, b1 + ci))\n822:             tmat.append(0)\n823:         # 左侧壁、右侧壁、底面（材质槽 1: MAT_STEEL）\n824:         tfc.append((b0 + nc, b0 + 0, b1 + 0, b1 + nc)); tmat.append(1)\n825:         tfc.append((b0 + nc - 1, b0 + nc + 1, b1 + nc + 1, b1 + nc - 1)); tmat.append(1)\n826:         tfc.append((b0 + nc + 1, b0 + nc, b1 + nc, b1 + nc + 1)); tmat.append(1)\n827: \n828:     me_tr = bpy.data.meshes.new(\"V6_TrackDeck\")\n829:     me_tr.from_pydata(tv, [], tfc)\n830:     me_tr.validate(); me_tr.update()\n831:     me_tr.materials.append(MAT_WET_ROAD)\n832:     me_tr.materials.append(MAT_STEEL)\n833:     uvl = me_tr.uv_layers.new(name=\"UVMap\")\n834:     for pi, poly in enumerate(me_tr.polygons):\n835:         poly.material_index = tmat[pi]\n836:         poly.use_smooth = (tmat[pi] == 0)\n837:         for li in poly.loop_indices:\n838:             uvl.data[li].uv = tuv[me_tr.loops[li].vertex_index]\n839:     ob_tr = bpy.data.objects.new(\"V6_TrackDeck\", me_tr)\n840:     COLLS[\"V6_01_Track3D\"].objects.link(ob_tr)\n841: \n842:     # B) 赛道两侧发光边界白线 & 3D 弯道红白霓虹路肩 & ±8.2m 赛博混凝土护栏 + 顶部霓虹光带\n843:     lines_bm = BatchMesh(\"V6_TrackLines_3D\", \"V6_01_Track3D\")\n844:     kerbs_bm = BatchMesh(\"V6_Kerbs_3D\", \"V6_01_Track3D\")\n845:     barr_bm = BatchMesh(\"V6_Barriers_3D\", \"V6_01_Track3D\")\n846: \n847:     for i in range(N):\n848:         f0 = FRAMES[i]\n849:         f1 = FRAMES[(i + 1) % N]\n850:         for sgn in (-1.0, 1.0):\n851:             # 发光边线\n852:             la0 = f0[\"pos\"] + f0[\"right\"] * (sgn * (HALF_W - 0.22)) + f0[\"up\"] * 0.018\n853:             lb0 = f0[\"pos\"] + f0[\"right\"] * (sgn * (HALF_W - 0.06)) + f0[\"up\"] * 0.018\n854:             la1 = f1[\"pos\"] + f1[\"right\"] * (sgn * (HALF_W - 0.22)) + f1[\"up\"] * 0.018\n855:             lb1 = f1[\"pos\"] + f1[\"right\"] * (sgn * (HALF_W - 0.06)) + f1[\"up\"] * 0.018\n856:             lines_bm.add_quad(la0, lb0, lb1, la1, MAT_WHITE_LINE)\n857: \n858:             # 弯道路肩 (|curv| > 0.0038)\n859:             if abs(f0[\"curv\"]) > 0.0038:\n860:                 km = MAT_KERB_A if (int(f0[\"s\"] / 2.8) % 2 == 0) else MAT_KERB_B\n861:                 ka0 = f0[\"pos\"] + f0[\"right\"] * (sgn * HALF_W) + f0[\"up\"] * 0.016\n862:                 kb0 = f0[\"pos\"] + f0[\"right\"] * (sgn * (HALF_W + 1.05)) + f0[\"up\"] * 0.075\n863:                 ka1 = f1[\"pos\"] + f1[\"right\"] * (sgn * HALF_W) + f1[\"up\"] * 0.016\n864:                 kb1 = f1[\"pos\"] + f1[\"right\"] * (sgn * (HALF_W + 1.05)) + f1[\"up\"] * 0.075\n865:                 kerbs_bm.add_quad(ka0, kb0, kb1, ka1, km)\n866: \n867:             # ±8.2m 紧贴护栏内表面 + 顶面 + 顶部连续霓虹灯带\n868:             wa0 = f0[\"pos\"] + f0[\"right\"] * (sgn * BARRIER_OFF)\n869:             wt0 = wa0 + f0[\"up\"] * BARRIER_H\n870:             wa1 = f1[\"pos\"] + f1[\"right\"] * (sgn * BARRIER