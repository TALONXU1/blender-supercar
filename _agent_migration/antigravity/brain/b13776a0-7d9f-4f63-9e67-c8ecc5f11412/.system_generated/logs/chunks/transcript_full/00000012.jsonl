8: \n909: def build_five_setpieces():\n910:     city_bm = BatchMesh(\"V6_Megacity_Skyscrapers\", \"V6_02_Megacity\")\n911:     sign_bm = BatchMesh(\"V6_Megacity_NeonSigns\", \"V6_02_Megacity\")\n912:     arch_bm = BatchMesh(\"V6_Canyon_ViaductArches\", \"V6_02_Megacity\")\n913:     brdg_bm = BatchMesh(\"V6_SkyBridge_Structure\", \"V6_03_SkyBridge_Bowl\")\n914:     cabl_bm = BatchMesh(\"V6_SkyBridge_StayCables\", \"V6_03_SkyBridge_Bowl\")\n915:     bowl_bm = BatchMesh(\"V6_BankedBowl_NeonWall\", \"V6_03_SkyBridge_Bowl\")\n916:     tunn_bm = BatchMesh(\"V6_StrobeTunnel_Vault\", \"V6_04_StrobeTunnel_Harbor\")\n917:     ribs_bm = BatchMesh(\"V6_StrobeTunnel_LaserRibs\", \"V6_04_StrobeTunnel_Harbor\")\n918:     harb_bm = BatchMesh(\"V6_Harbor_PropsGantries\", \"V6_04_StrobeTunnel_Harbor\")\n919:     gray_bm = BatchMesh(\"V6_FauxVolumetric_GodRays\", \"V6_05_Atmosphere_GodRays\")\n920: \n921:     rng = random.Random(2099)\n922: \n923:     # ① 起终点赛博龙门架 (s ~ 24m) + 起跑方格光带\n924:     f_sf = frame_at_s(24.0)\n925:     for sgn in (-1.0, 1.0):\n926:         c_leg = f_sf[\"pos\"] + f_sf[\"right\"] * (sgn * (BARRIER_OFF + 0.8)) + f_sf[\"up\"] * 4.2\n927:         arch_bm.add_oriented_box(c_leg, f_sf[\"fwd\"], f_sf[\"right\"], f_sf[\"up\"], 0.7, 0.7, 8.4, MAT_STEEL)\n928:     c_beam = f_sf[\"pos\"] + f_sf[\"up\"] * 8.2\n929:     arch_bm.add_oriented_box(c_beam, f_sf[\"right\"], f_sf[\"fwd\"], f_sf[\"up\"], (BARRIER_OFF + 1.2) * 2.0, 0.9, 1.2, MAT_STEEL)\n930:     arch_bm.add_oriented_box(c_beam - f_sf[\"fwd\"] * 0.52, f_sf[\"right\"], f_sf[\"fwd\"], f_sf[\"up\"], HALF_W * 2.0, 0.10, 0.95, MAT_AD)\n931: \n932:     # ② 峡谷摩天楼群 & Eau-Rouge 爬坡天际线（紧贴护栏外 14..46m，高 55..225m，严格验证绝不侵入任何赛段！）\n933:     placed_towers = []\n934:     for idx in range(0, N, 14):   # 每 28 m 沿线两侧尝试生成紧贴峡谷的摩天楼\n935:         fr = FRAMES[idx]\n936:         if fr[\"bridge\"]:\n937:             continue\n938:         for sgn in (-1.0, 1.0):\n939:             w = rng.uniform(18.0, 30.0)\n940:             d = rng.uniform(18.0, 30.0)\n941:             half_diag = 0.5 * hypot(w, d)\n942:             dist_out = BARRIER_OFF + half_diag + rng.uniform(4.5, 18.0)\n943:             bx = fr[\"pos\"].x + fr[\"right\"].x * (sgn * dist_out)\n944:             by = fr[\"pos\"].y + fr[\"right\"].y * (sgn * dist_out)\n945:             # 安全净距检查：距全圈任意赛道中心线 XY >= BARRIER_OFF + half_diag + 3.0m，且不与已放塔楼重叠\n946:             if min_xy_dist_to_track(bx, by, step=2) < (BARRIER_OFF + half_diag + 3.0):\n947:                 continue\n948:             if any(hypot(bx - ox, by - oy) < (half_diag + odiag - 2.0) for ox, oy, odiag in placed_towers):\n949:                 continue\n950:             placed_towers.append((bx, by, half_diag))\n951: \n952:             hgt = rng.uniform(75.0, 225.0) if fr[\"zone\"] in (\"canyon_grid\", \"eau_rouge_climb\") else rng.uniform(55.0, 165.0)\n953:             base_z = -5.0\n954:             total_h = (fr[\"pos\"].z + hgt) - base_z\n955:             center_b = Vector((bx, by, base_z + total_h * 0.5))\n956:             ax_f = Vector((cos(fr[\"h\"]), sin(fr[\"h\"]), 0.0))\n957:             ax_r = Vector((sin(fr[\"h\"]), -cos(fr[\"h\"]), 0.0))\n958:             ax_u = Vector((0.0, 0.0, 1.0))\n959: \n960:             city_bm.add_oriented_box(center_b, ax_f, ax_r, ax_u, w, d, total_h, MAT_FACADE,\n961:                                      uv_tile=(max(1.0, round(w / 18.0)), max(1.0, round(total_h / 55.0))))\n962:             # 塔冠退台霓虹边框\n963:             crown_c = Vector((bx, by, base_z + total_h + 1.2))\n964:             n_mat = MAT_NEON_CYAN if (len(placed_towers) % 3 == 0) else (MAT_NEON_MAG if len(placed_towers) % 3 == 1 else MAT_NEON_GOLD)\n965:             city_bm.add_oriented_box(crown_c, ax_f, ax_r, ax_u, w * 0.92, d * 0.92, 0.65, n_mat)\n966: \n967:             # 面向赛道的巨幅竖向赛博漫画霓虹招牌\n968:             sign_h = min(46.0, hgt * 0.52)\n969:             sign_c = Vector((\n970:                 bx - fr[\"right\"].x * (sgn * (d * 0.5 + 0.45)),\n971:                 by - fr[\"right\"].y * (sgn * (d * 0.5 + 0.45)),\n972:                 fr[\"pos\"].z + 8.0 + sign_h * 0.5,\n973:             ))\n974:             slot = len(placed_towers) % 4\n975:             sign_bm.add_oriented_box(sign_c, ax_f, ax_r, ax_u, 4.4, 0.35, sign_h, MAT_SIGNS,\n976:                                      uv_tile=(0.24, 0.96), uv_off=(slot * 0.25 + 0.005, 0.02))\n977: \n978:     # 外围远景天际线环（填满 360° 视野，任何高空/回望机位都有层次丰富的蜘蛛侠大都会剪影）\n979:     for k_ring in range(44):\n980:         ang = 2.0 * pi * k_ring / 44.0 + rng.uniform(-0.04, 0.04)\n981:         rad = rng.uniform(520.0, 880.0)\n982:         rx = _cx + cos(ang) * rad\n983:         ry = _cy + sin(ang) * rad\n984:         if min_xy_dist_to_track(rx, ry, step=4) < 95.0:\n985:             continue\n986:         rw, rd = rng.uniform(36.0, 68.0), rng.uniform(36.0, 68.0)\n987:         rh = rng.uniform(95.0, 260.0)\n988:         ax_f = Vector((-sin(ang), cos(ang), 0.0))\n989:         ax_r = Vector((cos(ang), sin(ang), 0.0))\n990:         city_bm.add_oriented_box(Vector((rx, ry, -5.0 + rh * 0.5)), ax_f, ax_r, Vector((0, 0, 1)),\n991:                                  rw, rd, rh, MAT_FACADE, uv_tile=(2.0, max(1.0, round(rh / 65.0))))\n992: \n993:     # 城市峡谷段跨街赛博过街天桥拱门（净高 8.8 m，绝不挡任何镜头）\n994:     canyon_idxs = [i for i, f in enumerate(FRAMES) if f[\"zone\"] == \"canyon_grid\"]\n995:     for step_a in canyon_idxs[::55][:3]:\n996:         fa = FRAMES[step_a]\n997:         for sgn in (-1.0, 1.0):\n998:             pl = fa[\"pos\"] + fa[\"right\"] * (sgn * (BARRIER_OFF + 1.1)) + fa[\"up\"] * 4.6\n999:             arch_bm.add_oriented_box(pl, fa[\"fwd\"], fa[\"right\"], fa[\"up\"], 1.8, 0.9, 9.2, MAT_CONCRETE)\n1000:         top_a = fa[\"pos\"] + fa[\"up\"] * 9.0\n1001:         arch_bm.add_oriented_box(top_a, fa[\"right\"], fa[\"fwd\"], fa[\"up\"], (BARRIER_OFF + 1.6) * 2.0, 2.2, 1.1, MAT_STEEL)\n1002:         arch_bm.add_oriented_box(top_a - fa[\"up\"] * 0.62, fa[\"right\"], fa[\"fwd\"], fa[\"up\"], HALF_W * 2.1, 0.25, 0.16, MAT_NEON_CYAN)\n1003: \n1004:     # ③ 跨海斜拉天空大桥 (sky_bridge)：双 115m 巨型 H 型索塔 + 发光青/金扇形斜拉索网 + 桥下钢箱梁桥墩\n1005:     bridge_idxs = [i for i, f in enumerate(FRAMES) if f[\"bridge\"] or f[\"zone\"] == \"sky_bridge\"]\n1006:     for idx in range(0, N, 20):\n1007:         fb = FRAMES[idx]\n1008:         if fb[\"pos\"].z > 6.5 and not fb[\"tunnel\"]:\n1009:             # 高架混凝土双柱桥墩直插海面 Z=-5m\n1010:             pier_top = fb[\"pos\"] - fb[\"up\"] * 1.1\n1011:             pier_h = pier_top.z - (-5.0)\n1012:             if pier_h > 2.0:\n1013:                 for sgn in (-1.0, 1.0):\n1014:                     pxy = pier_top + fb[\"right\"] * (sgn * 4.8)\n1015:                     brdg_bm.add_oriented_box(Vector((pxy.x, pxy.y, -5.0 + pier_h * 0.5)),\n1016:                                              Vector((cos(fb[\"h\"]), sin(fb[\"h\"]), 0.0)),\n1017:                                              Vector((sin(fb[\"h\"]), -cos(fb[\"h\"]), 0.0)),\n1018:                                              Vector((0, 0, 1)), 1.6, 1.6, pier_h, MAT_CONCRETE)\n1019: \n1020:     if len(bridge_idxs) >= 20:\n1021:         t1_i = bridge_idxs[int(len(bridge_idxs) * 0.28)]\n1022:         t2_i = bridge_idxs[int(len(bridge_idxs) * 0.72)]\n1023:         for t_ord, ti in enumerate((t1_i, t2_i)):\n1024:             ft = FRAMES[ti]\n1025:             tower_off = BARRIER_OFF + 4.8     # ±13.0 m 巨型双立柱\n1026:             tower_top_z = ft[\"pos\"].z + 115.0\n1027:             tower_h = tower_top_z - (-5.0)\n1028:             ax_f = Vector((cos(ft[\"h\"]), sin(ft[\"h\"]), 0.0))\n1029:             ax_r = Vector((sin(ft[\"h\"]), -cos(ft[\"h\"]), 0.0))\n1030:             ax_u = Vector((0.0, 0.0, 1.0))\n1031:             for sgn in (-1.0, 1.0):\n1032:                 leg_xy = ft[\"pos\"] + ax_r * (sgn * tower_off)\n1033:                 brdg_bm.add_oriented_box(Vector((leg_xy.x, leg_xy.y, -5.0 + tower_h * 0.5)),\n1034:                                          ax_f, ax_r, ax_u, 3.8, 3.2, tower_h, MAT_STEEL)\n1035:                 # 索塔