ixRGB'); ng.links.new(n_side.outputs['Result'], rim_dual.inputs['Factor']); ng.links.new(rim_c1, rim_dual.inputs['Color1']); ng.links.new(rim_c2, rim_dual.inputs['Color2'])\n418:     rim_amt = ng.nodes.new('ShaderNodeMath'); rim_amt.operation = 'MULTIPLY'; ng.links.new(rim_step.outputs[0], rim_amt.inputs[0]); ng.links.new(gi.outputs['Rim Strength'], rim_amt.inputs[1])\n419:     final_col = ng.nodes.new('ShaderNodeMixRGB'); ng.links.new(rim_amt.outputs[0], final_col.inputs['Factor']); ng.links.new(after_hatch.outputs['Color'], final_col.inputs['Color1']); ng.links.new(rim_dual.outputs['Color'], final_col.inputs['Color2'])\n420: \n421:     em = ng.nodes.new('ShaderNodeEmission'); em.inputs['Strength'].default_value = 1.0\n422:     ng.links.new(final_col.outputs['Color'], em.inputs['Color'])\n423: \n424:     # 可选清漆镜面流光层（捕捉摩天楼霓虹窗与隧道激光肋反射）\n425:     coat_bsdf = ng.nodes.new('ShaderNodeBsdfPrincipled')\n426:     coat_bsdf.inputs['Base Color'].default_value = (0.0, 0.0, 0.0, 1.0)\n427:     coat_bsdf.inputs['Metallic'].default_value = 0.0\n428:     coat_bsdf.inputs['Roughness'].default_value = 0.075\n429:     ng.links.new(gi.outputs['Neon Coat'], coat_bsdf.inputs['Specular IOR Level'])\n430:     add_sh = ng.nodes.new('ShaderNodeAddShader')\n431:     ng.links.new(em.outputs['Emission'], add_sh.inputs[0])\n432:     ng.links.new(coat_bsdf.outputs['BSDF'], add_sh.inputs[1])\n433:     ng.links.new(add_sh.outputs['Shader'], go.inputs['Shader'])\n434:     return ng\n435: \n436: \n437: NG_COMIC = build_comic_nodegroup()\n438: \n439: \n440: def make_comic_mat(name, rgb, rim=0.5, ht_sc=78.0, ht_s=0.65, hc_s=0.65, coat=0.0):\n441:     m = bpy.data.materials.get(name) or bpy.data.materials.new(name)\n442:     m.use_nodes = True\n443:     nt = m.node_tree\n444:     nt.nodes.clear()\n445:     out = nt.nodes.new('ShaderNodeOutputMaterial')\n446:     grp = nt.nodes.new('ShaderNodeGroup'); grp.node_tree = NG_COMIC\n447:     add_dim_driver(grp.inputs['SV Dimension'], \"default_value\", \"dim\")\n448:     grp.inputs['Base Color'].default_value = (*rgb, 1.0)\n449:     grp.inputs['Rim Strength'].default_value = rim\n450:     grp.inputs['Halftone Scale'].default_value = ht_sc\n451:     grp.inputs['Halftone Strength'].default_value = ht_s\n452:     grp.inputs['Hatch Strength'].default_value = hc_s\n453:     grp.inputs['Neon Coat'].default_value = coat\n454:     nt.links.new(grp.outputs['Shader'], out.inputs['Surface'])\n455:     return m\n456: \n457: \n458: def make_neon_mat(name, c1, c2, c3, strength=12.0):\n459:     m = bpy.data.materials.get(name) or bpy.data.materials.new(name)\n460:     m.use_nodes = True\n461:     nt = m.node_tree\n462:     nt.nodes.clear()\n463:     out = nt.nodes.new('ShaderNodeOutputMaterial')\n464:     em = nt.nodes.new('ShaderNodeEmission')\n465:     em.inputs['Strength'].default_value = strength\n466:     w2, w3 = add_act_weights(nt)\n467:     col = tri_color_mix(nt, c1, c2, c3, w2, w3)\n468:     nt.links.new(col, em.inputs['Color'])\n469:     nt.links.new(em.outputs['Emission'], out.inputs['Surface'])\n470:     return m\n471: \n472: \n473: def make_tex_emit_mat(name, img_file, emit_strength=1.8, rough=0.35, spec=0.15):\n474:     m = bpy.data.materials.get(name) or bpy.data.materials.new(name)\n475:     m.use_nodes = True\n476:     nt = m.node_tree\n477:     nt.nodes.clear()\n478:     out = nt.nodes.new('ShaderNodeOutputMaterial')\n479:     bsdf = nt.nodes.new('ShaderNodeBsdfPrincipled')\n480:     bsdf.inputs['Roughness'].default_value = rough\n481:     bsdf.inputs['Specular IOR Level'].default_value = spec\n482:     tn = nt.nodes.new('ShaderNodeTexImage')\n483:     tn.image = bpy.data.images.load(os.path.join(TEX_SV, img_file), check_existing=True)\n484:     tn.extension = 'REPEAT'\n485:     nt.links.new(tn.outputs['Color'], bsdf.inputs['Base Color'])\n486:     nt.links.new(tn.outputs['Color'], bsdf.inputs['Emission Color'])\n487:     bsdf.inputs['Emission Strength'].default_value = emit_strength\n488:     nt.links.new(bsdf.outputs['BSDF'], out.inputs['Surface'])\n489:     return m\n490: \n491: \n492: # ---------------------------------------------------------------\n493: # 4. 湿滑镜面黑曜霓虹沥青 + 港湾反光水面 + 伪体积丁达尔神光片 + 天空与零镜面太阳\n494: # ---------------------------------------------------------------\n495: def build_wet_asphalt_mat():\n496:     m = bpy.data.materials.get(\"MAT_V6_WetAsphalt\") or bpy.data.materials.new(\"MAT_V6_WetAsphalt\")\n497:     m.use_nodes = True\n498:     nt = m.node_tree\n499:     nt.nodes.clear()\n500:     out = nt.nodes.new('ShaderNodeOutputMaterial')\n501:     bsdf = nt.nodes.new('ShaderNodeBsdfPrincipled')\n502:     bsdf.inputs['Metallic'].default_value = 0.08\n503:     bsdf.inputs['Specular IOR Level'].default_value = 0.68\n504:     w2, w3 = add_act_weights(nt)\n505: \n506:     geo = nt.nodes.new('ShaderNodeNewGeometry')\n507:     uv = nt.nodes.new('ShaderNodeUVMap'); uv.uv_map = \"UVMap\"\n508:     sep = nt.nodes.new('ShaderNodeSeparateXYZ'); nt.links.new(uv.outputs['UV'], sep.inputs['Vector'])\n509: \n510:     # 积水镜面掩膜：世界尺度水洼噪波 -> Roughness 0.065 (镜面水洼) .. 0.25 (潮湿赛车线)\n511:     ns_pud = nt.nodes.new('ShaderNodeTexNoise')\n512:     ns_pud.inputs['Scale'].default_value = 0.085\n513:     ns_pud.inputs['Detail'].default_value = 6.0\n514:     ns_pud.inputs['Roughness'].default_value = 0.65\n515:     nt.links.new(geo.outputs['Position'], ns_pud.inputs['Vector'])\n516: \n517:     r_ramp = nt.nodes.new('ShaderNodeValToRGB')\n518:     r_ramp.color_ramp.elements[0].position = 0.38; r_ramp.color_ramp.elements[0].color = (0.065, 0.065, 0.065, 1.0)\n519:     r_ramp.color_ramp.elements[1].position = 0.64; r_ramp.color_ramp.elements[1].color = (0.255, 0.255, 0.255, 1.0)\n520:     nt.links.new(ns_pud.outputs['Fac'], r_ramp.inputs[0])\n521:     nt.links.new(r_ramp.outputs['Color'], bsdf.inputs['Roughness'])\n522: \n523:     # 细微雨夜水波纹凹凸（让倒映的摩天楼霓虹与斜拉索呈现真实湿滑拉伸感）\n524:     ns_rip = nt.nodes.new('ShaderNodeTexNoise')\n525:     ns_rip.inputs['Scale'].default_value = 42.0\n526:     ns_rip.inputs['Detail'].default_value = 8.0\n527:     nt.links.new(geo.outputs['Position'], ns_rip.inputs['Vector'])\n528:     bmp = nt.nodes.new('ShaderNodeBump')\n529:     bmp.inputs['Strength'].default_value = 0.045\n530:     bmp.inputs['Distance'].default_value = 0.01\n531:     nt.links.new(ns_rip.outputs['Fac'], bmp.inputs['Height'])\n532:     nt.links.new(bmp.outputs['Normal'], bsdf.inputs['Normal'])\n533: \n534:     # 深邃黑曜靛蓝漫画底色 + 纵向高速笔刷流线\n535:     comb = nt.nodes.new('ShaderNodeCombineXYZ')\n536:     mx = nt.nodes.new('ShaderNodeMath'); mx.operation = 'MULTIPLY'; mx.inputs[1].default_value = 24.0; ng_u = sep.outputs['X']\n537:     my = nt.nodes.new('ShaderNodeMath'); my.operation = 'MULTIPLY'; my.inputs[1].default_value = 0.35\n538:     nt.links.new(ng_u, mx.inputs[0]); nt.links.new(sep.outputs['Y'], my.inputs[0])\n539:     nt.links.new(mx.outputs['Value'], comb.inputs['X']); nt.links.new(my.outputs['Value'], comb.inputs['Y'])\n540:     ns_str = nt.nodes.new('ShaderNodeTexNoise'); ns_str.inputs['Scale'].default_value = 3.5; nt.links.new(comb.outputs['Vector'], ns_str.inputs['Vector'])\n541:     c_lo = tri_color_mix(nt, (0.006, 0.007, 0.020), (0.010, 0.024, 0.038), (0.008, 0.003, 0.026), w2, w3)\n542:     c_hi = tri_color_mix(nt, (0.018, 0.022, 0.052), (0.036, 0.022, 0.055), (0.028, 0.006, 0.052), w2, w3)\n543:     st_s = nt.nodes.new('ShaderNodeMath'); st_s.operation = 'GREATER_THAN'; st_s.inputs[1].default_value = 0.56; nt.links.new(ns_str.outputs['Fac'], st_s.inputs[0])\n544:     cmix = nt.nodes.new('ShaderNodeMixRGB'); ng_f = st_s.outputs[0]\n545:     nt.links.new(ng_f, cmix.inputs['Factor']); nt.links.new(c_lo, cmix.inputs['Color1']); nt.links.new(c_hi, cmix.inputs['Color2'])\n546:     nt.links.new(cmix.outputs['Color'], bsdf.inputs['Base Color'])\n547:     nt.links.new(bsdf.outputs['BSDF'], out.inputs['Surface'])\n548:     return m\n549: \n550: \n551: def build_harbor_water_mat():\n552:     m = bpy.data.materials.get(\"MAT_V6_HarborWater\") or bpy.data.materials.new(\"MAT_V6_HarborWater\")\n553:     m.use_nodes = True\n554:     nt = m.node_tree\n555:     nt.nodes.clear()\n556:     out = nt.nodes.new('ShaderNodeOutputMaterial')\n557:     bsdf = nt.nodes.new('ShaderNodeBsdfPrincipled')\n558:     bsdf.inputs['Base Color'].default_value = (0.004, 0.012, 0.028, 1.0)\n559:     bsdf.inputs['Metallic'].default_value = 0.15\n560:     bsdf.inputs['Roughness'].default_value = 0.085\n561:     bsdf.inputs['Specular IOR Level'].default_value = 0.75\n562:     geo = nt.nodes.new('ShaderNodeNewGeometry')\n563:     wv = nt.nodes.new('ShaderNodeTexNoise')\n564:     wv.inputs['Scale'].default_value = 0.28\n565:     wv.inputs['Detail'].default_value = 7.0\n566:     wv.inputs['Distortion'].default_value = 0.8\n567:     nt.links.new(geo.outputs['Position'], wv.inputs['Vector'])\n568:     bmp = nt.nodes.new('ShaderNodeBump')\n569:     bmp.inputs['Strength'].default_value = 0.14\n570:     nt.links.new(wv.outputs['Fac'], bmp.inputs['Height'])\n571:     nt.links.new(bmp.outputs['Normal'], bsdf.inputs['Normal'])\n572:     nt.links.new(bsdf.outputs['BSDF'], out.inputs['Surface'])\n573:     return m\n574: \n575: \n576: def build_godray_mat(name, c1, c2, c3, strength=1.35):\n577:     m = bpy.data.materials.get(name) or bpy.data.materials.new(name)\n578:     m.use_nodes = True\n579:     try:\n580:         m.surface_render_method = 'BLENDED'\n581:     except Exception:\n582:         pass\n583:     nt = m.node_tree\n584:     nt.nodes.clear()\n585:     out = nt.nodes.new('ShaderNodeOutputMaterial')\n586:     tr = nt.nodes.new('ShaderNodeBsdfTransparent')\n587:     em = nt.nodes.new('ShaderNodeEmission')\n588:     em.inputs['Strength'].default_value = strength\n589:     w2, w3 = add_act_weights(nt)\n590:     col = tri_color_mix(nt, c1, c2, c3, w2, w3)\n591:     nt.links.new(col, em.inputs['Color'])\n592: \n593:     # UV 边缘柔和衰减 + 视角边缘消隐（绝不出现硬多边形穿帮线！）\n594:     uv = nt.nodes.new('ShaderNodeUVMap'); uv.uv_map = \"UVMap\"\n595:     sep = nt.nodes.new('ShaderN