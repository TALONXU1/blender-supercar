{"step_index":90,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-18T06:05:07Z","content":"Created At: 2026-11-18T14:05:07+08:00\nCompleted At: 2026-11-18T14:05:07+08:00\nShowing lines 925-1460 of 1676\n925: mesh_from(\"V5_Ground\", [(_cx - GR, _cy - GR, -0.035), (_cx + GR, _cy - GR, -0.035),\r\n926:                         (_cx + GR, _cy + GR, -0.035), (_cx - GR, _cy + GR, -0.035)],\r\n927:           [(0, 1, 2, 3)], M_GRASS)\r\n928: \r\n929: # ---------------------------------------------------------------\r\n930: # 5. 路面 / 赛车线 / 边线\r\n931: # ---------------------------------------------------------------\r\n932: def ribbon(off_a, off_b, z, mat, name, step=1, ups=True, uv_scale=None):\r\n933:     \"\"\"沿中心线生成带状网格；off 为右向偏移（m），可为常数或 f(i)；首尾自动闭合\"\"\"\r\n934:     v, fc, uv = [], [], []\r\n935:     idxs = list(range(0, N, step))\r\n936:     if idxs[-1] != N - 1:\r\n937:         idxs.append(N - 1)\r\n938:     idxs.append(N)                              # at(N) -> 第 0 点，闭环\r\n939:     fa = off_a if callable(off_a) else (lambda i: off_a)\r\n940:     fb = off_b if callable(off_b) else (lambda i: off_b)\r\n941:     for i in idxs:\r\n942:         p, h, r, k = at(i)\r\n943:         a, b = fa(i), fb(i)\r\n944:         v.append((p.x + r.x * a, p.y + r.y * a, z))\r\n945:         v.append((p.x + r.x * b, p.y + r.y * b, z))\r\n946:         if uv_scale:\r\n947:             uv.append((0.0, S[i % N] / uv_scale))\r\n948:             uv.append((1.0, S[i % N] / uv_scale))\r\n949:     for j in range(len(idxs) - 1):\r\n950:         a = j * 2\r\n951:         fc.append((a, a + 1, a + 3, a + 2))\r\n952:     return mesh_from(name, v, fc, mat, uvs=uv if uv_scale else None, up=ups)\r\n953: \r\n954: \r\n955: # 主路面\r\n956: ribbon(-HALF_W, HALF_W, 0.010, M_ASPHALT, \"V5_Track\", uv_scale=8.0)\r\n957: # 边线（白实线）\r\n958: ribbon(-HALF_W + 0.05, -HALF_W + 0.20, 0.014, M_WHITE, \"V5_Line_L\")\r\n959: ribbon(HALF_W - 0.20, HALF_W - 0.05, 0.014, M_WHITE, \"V5_Line_R\")\r\n960: \r\n961: # 赛车线橡胶带（沿 racing_xy，宽 3.4 m）\r\n962: def _rl(i):\r\n963:     return ROFF[i % N] - 1.7\r\n964: \r\n965: \r\n966: def _rr(i):\r\n967:     return ROFF[i % N] + 1.7\r\n968: \r\n969: \r\n970: ribbon(_rl, _rr, 0.013, M_RUBBER, \"V5_RacingLine\", step=1)\r\n971: \r\n972: # ---------------------------------------------------------------\r\n973: # 6. 路肩（弯道）\r\n974: # ---------------------------------------------------------------\r\n975: def corner_runs(thresh=0.0045, min_len=18.0, gap=8.0):\r\n976:     runs, cur = [], None\r\n977:     for i in range(N):\r\n978:         if KAPPA[i] > thresh:\r\n979:             if cur is None:\r\n980:                 cur = [i, i]\r\n981:             else:\r\n982:                 cur[1] = i\r\n983:         else:\r\n984:             if cur and S[cur[1]] - S[cur[0]] >= min_len:\r\n985:                 runs.append(tuple(cur))\r\n986:             cur = None\r\n987:     if cur and LAP_LEN - S[cur[0]] + S[cur[1]] >= min_len:\r\n988:         runs.append((cur[0], cur[1]))\r\n989:     # 合并近邻（同一弯的碎段）\r\n990:     merged = []\r\n991:     for r in runs:\r\n992:         if merged and S[r[0]] - S[merged[-1][1]] < gap:\r\n993:             merged[-1] = (merged[-1][0], r[1])\r\n994:         else:\r\n995:             merged.append(list(r))\r\n996:     return [(a, b) for a, b in merged]\r\n997: \r\n998: \r\n999: KERB_IN_W = 1.35\r\n1000: KERB_Z_IN = 0.012\r\n1001: KERB_Z_OUT = 0.075\r\n1002: BLOCK_M = 3.2\r\n1003: \r\n1004: _runs = corner_runs()\r\n1005: print(\"corner runs:\", len(_runs))\r\n1006: \r\n1007: \r\n1008: def build_kerb(i0, i1, side, mat, phase, name):\r\n1009:     \"\"\"沿弯道内侧/外侧生成路肩块（红白交替，按全局弧长对齐）\"\"\"\r\n1010:     s0, s1 = S[i0], S[i1]\r\n1011:     v, fc = [], []\r\n1012:     s = s0 - ((s0 / BLOCK_M) % 1.0) * BLOCK_M\r\n1013:     while s < s1 - 0.3:\r\n1014:         kb = int(round(s / BLOCK_M))\r\n1015:         if kb % 2 == phase:\r\n1016:             a0 = max(s0, s)\r\n1017:             a1 = min(s1, s + BLOCK_M)\r\n1018:             if a1 - a0 > 0.5:\r\n1019:                 base = len(v)\r\n1020:                 for ss in (a0, a1):\r\n1021:                     p, h, r, k = at_s(ss)\r\n1022:                     o0 = side * HALF_W\r\n1023:                     o1 = side * (HALF_W + KERB_IN_W)\r\n1024:                     v.append((p.x + r.x * o0, p.y + r.y * o0, KERB_Z_IN))\r\n1025:                     v.append((p.x + r.x * o1, p.y + r.y * o1, KERB_Z_OUT))\r\n1026:                 fc.append((base, base + 1, base + 3, base + 2))\r\n1027:         s += BLOCK_M\r\n1028:     if fc:\r\n1029:         return mesh_from(name, v, fc, mat)\r\n1030: \r\n1031: \r\n1032: for ki, (a, b) in enumerate(_runs):\r\n1033:     # 内外侧都铺（真实赛道：apex 内侧 + 出弯外侧）\r\n1034:     for side, nm in ((-1, \"L\"), (1, \"R\")):\r\n1035:         build_kerb(a, b, side, M_CURB_R, 0, f\"V5_Kerb_{ki}_{nm}_R\")\r\n1036:         build_kerb(a, b, side, M_CURB_W, 1, f\"V5_Kerb_{ki}_{nm}_W\")\r\n1037: \r\n1038: # ---------------------------------------------------------------\r\n1039: # 7. 缓冲带（草地 / 砾石）\r\n1040: # ---------------------------------------------------------------\r\n1041: VERGE_W = 26.0\r\n1042: ribbon(-HALF_W - KERB_IN_W, -HALF_W - VERGE_W, 0.004, M_GRASS, \"V5_Verge_L\", step=2)\r\n1043: ribbon(HALF_W + KERB_IN_W, HALF_W + VERGE_W, 0.004, M_GRASS, \"V5_Verge_R\", step=2)\r\n1044: \r\n1045: # 砾石坑：慢弯外侧\r\n1046: GRAV_OUT = 22.0\r\n1047: \r\n1048: \r\n1049: def build_gravel(i0, i1, side, name):\r\n1050:     v, fc = [], []\r\n1051:     step = 2\r\n1052:     idxs = list(range(i0, i1, step))\r\n1053:     for i in idxs:\r\n1054:         p, h, r, k = at(i)\r\n1055:         for o, z in ((side * (HALF_W + KERB_IN_W), 0.006), (side * GRAV_OUT, 0.006)):\r\n1056:             v.append((p.x + r.x * o, p.y + r.y * o, z))\r\n1057:     for j in range(len(idxs) - 1):\r\n1058:         a = j * 2\r\n1059:         fc.append((a, a + 1, a + 3, a + 2))\r\n1060:     if fc:\r\n1061:         return mesh_from(name, v, fc, M_GRAVEL)\r\n1062: \r\n1063: \r\n1064: _gi = 0\r\n1065: for (a, b) in _runs:\r\n1066:     vmin = min(VEL[a:b + 1]) * 3.6\r\n1067:     if vmin < 180 and (b - a) > 12:\r\n1068:         side = 1 if SIGNED_K[a] > 0 else -1    # 弯外侧 = 转向的反侧\r\n1069:         build_gravel(a, b, side, f\"V5_Gravel_{_gi}\")\r\n1070:         _gi += 1\r\n1071: print(\"gravel traps:\", _gi)\r\n1072: \r\n1073: # ---------------------------------------------------------------\r\n1074: # 8. 护栏 + 灯带 + 防护网\r\n1075: # ---------------------------------------------------------------\r\n1076: WALL_OFF = HALF_W + VERGE_W            # 33 m\r\n1077: WALL_H = 1.05\r\n1078: BASE_H = 0.24\r\n1079: \r\n1080: \r\n1081: def _wall_band(z0, z1, off, mat, name):\r\n1082:     wv, wf = [], []\r\n1083:     for side in (-1, 1):\r\n1084:         base = len(wv)\r\n1085:         for i in range(N):\r\n1086:             p, h, r, k = at(i)\r\n1087:             o = side * off\r\n1088:             px, py = p.x + r.x * o, p.y + r.y * o\r\n1089:             wv.append((px, py, z0))\r\n1090:             wv.append((px, py, z1))\r\n1091:         for j in range(N):\r\n1092:             aa = base + j * 2\r\n1093:             bb = base + ((j + 1) % N) * 2\r\n1094:             wf.append((aa, aa + 1, bb + 1, bb))\r\n1095:             wf.append((bb, bb + 1, aa + 1, aa))\r\n1096:     return mesh_from(name, wv, wf, mat, up=False)\r\n1097: \r\n1098: \r\n1099: _wall_band(0.0, BASE_H, WALL_OFF, M_CONC, \"V5_BarrierBase\")\r\n1100: _wall_band(BASE_H, WALL_H, WALL_OFF + 0.04, M_BARRIER, \"V5_Barrier\")\r\n1101: \r\n1102: # 顶部灯带\r\n1103: _sv, _sf = [], []\r\n1104: for side in (-1, 1):\r\n1105:     base = len(_sv)\r\n1106:     for i in range(N):\r\n1107:         p, h, r, k = at(i)\r\n1108:         o = side * (WALL_OFF - 0.02)\r\n1109:         px, py = p.x + r.x * o, p.y + r.y * o\r\n1110:         _sv.append((px, py, WALL_H - 0.10))\r\n1111:         _sv.append((px, py, WALL_H - 0.02))\r\n1112:     for j in range(N):\r\n1113:         a = base + j * 2\r\n1114:         b = base + ((j + 1) % N) * 2\r\n1115:         _sf.append((a, a + 1, b + 1, b))\r\n1116:         _sf.append((b, b + 1, a + 1, a))\r\n1117: mesh_from(\"V5_BarrierStrip\", _sv, _sf, M_STRIP, up=False)\r\n1118: \r\n1119: # 防护网立柱（每 12 m 一根薄板柱：沿切线 ±0.07 m 宽 0.14 m，高 3.4 m；全部在一个网格里）\r\n1120: _pv, _pf = [], []\r\n1121: POST_STEP = 12.0\r\n1122: for side in (-1, 1):\r\n1123:     s = 0.0\r\n1124:     while s < LAP_LEN:\r\n1125:         p, h, r, k = at_s(s)\r\n1126:         o = side * (WALL_OFF + 0.35)\r\n1127:         px, py = p.x + r.x * o, p.y + r.y * o\r\n1128:         tx, ty = cos(h), sin(h)                    # 切线方向\r\n1129:         base = len(_pv)\r\n1130:         for d in (-0.07, 0.07):\r\n1131:             _pv.append((px + tx * d, py + ty * d, WALL_H))\r\n1132:             _pv.append((px + tx * d, py + ty * d, WALL_H + 3.4))\r\n1133:         _pf.append((base, base + 1, base + 3, base + 2))\r\n1134:         s += POST_STEP\r\n1135: mesh_from(\"V5_FencePosts\", _pv, _pf, M_STEEL, up=False)\r\n1136: \r\n1137: # ---------------------------------------------------------------\r\n1138: # 9. 起跑龙门架 + 发车灯 + 起跑线\r\n1139: # ---------------------------------------------------------------\r\n1140: SF_S = 40.0                     # 起终点位置（沿中心线弧长）\r\n1141: gp, gh, gr, gk = at_s(SF_S)\r\n1142: \r\n1143: # 路面方格线\r\n1144: _gv, _gf = [], []\r\n1145: for k in range(2):\r\n1146:     _gv.append((gp.x + gr.x * (-HALF_W), gp.y + gr.y * (-HALF_W), 0.016))\r\n1147:     _gv.append((gp.x + gr.x * (HALF_W), gp.y + gr.y * (HALF_W), 0.016))\r\n1148:     gp2, gh2, gr2, _ = at_s(SF_S + (k + 1) * 0.6)\r\n1149:     _gv.append((gp2.x + gr2.x * (-HALF_W), gp2.y + gr2.y * (-HALF_W), 0.016))\r\n1150:     _gv.append((gp2.x + gr2.x * (HALF_W), gp2.y + gr2.y * (HALF_W), 0.016))\r\n1151: for k in range(2):\r\n1152:     a = k * 4\r\n1153:     _gf.append((a, a + 1, a + 3, a + 2))\r\n1154: mesh_from(\"V5_StartLine\", _gv, _gf, M_WHITE)\r\n1155: \r\n1156: # 门架（组件 Empty: V5_Gantry，含立柱/横梁/横幅/5 盏发车灯）\r\n1157: GANT_H = 7.2\r\n1158: _gant_parts = []\r\n1159: for sd, nm in ((-1, \"L\"), (1, \"R\")):\r\n1160:     px = gp.x + gr.x * sd * (HALF_W + 1.6)\r\n1161:     py = gp.y + gr.y * sd * (HALF_W + 1.6)\r\n1162:     _gant_parts.append(box(f\"V5_Gantry_Post_{nm}\", (px, py, GANT_H / 2), (0.45, 0.45, GANT_H), M_STEEL, rot_z=gh))\r\n1163: _gant_parts.append(box(\"V5_Gantry_Beam\", (gp.x, gp.y, GANT_H), (HALF_W * 2 + 3.6, 0.55, 0.85), M_STEEL, rot_z=gh))\r\n1164: _gant_parts.append(box(\"V5_Gantry_Banner\", (gp.x - sin(gh) * 0.32, gp.y + cos(gh) * 0.32, GANT_H),\r\n1165:                        (HALF_W * 2 + 2.2, 0.06, 0.6), M_ADPANEL, rot_z=gh))\r\n1166: \r\n1167: # 5 盏发车灯（红灯；v5_anim 里把材质发光压到 0 = 常暗）\r\n1168: M_SLIGHT = new_mat(\"V5_StartLight\", (0.06, 0.004, 0.003), 0.3,\r\n1169:                    emission=(1.0, 0.05, 0.02), estrength=18.0)\r\n1170: for i in range(5):\r\n1171:     ox = -1.6 + i * 0.8\r\n1172:     px = gp.x + gr.x * ox\r\n1173:     py = gp.y + gr.y * ox\r\n1174:     bm = bmesh.new()\r\n1175:     bmesh.ops.create_uvsphere(bm, u_segments=16, v_segments=10, radius=0.18)\r\n1176:     me = bpy.data.meshes.new(f\"V5_StartLight_{i}\")\r\n1177:     bm.to_mesh(me)\r\n1178:     bm.free()\r\n1179:     ob = bpy.data.objects.new(f\"V5_StartLight_{i}\", me)\r\n1180:     COLL.objects.link(ob)\r\n1181:     ob.location = (px, py, GANT_H - 0.62)\r\n1182:     me.materials.append(M_SLIGHT)\r\n1183:     _gant_parts.append(ob)\r\n1184: assembly(\"V5_Gantry\", (gp.x, gp.y, 0.0), gh, _gant_parts, size=6.0)\r\n1185: \r\n1186: # ---------------------------------------------------------------\r\n1187: # 10. 看台（含人群贴图）\r\n1188: # ---------------------------------------------------------------\r\n1189: def grandstand(s_center, side, length, rows=11, dist=30.0, name=\"Stand\"):\r\n1190:     \"\"\"一座看台 = 一个 Empty(name) + 子物体:\r\n1191:        _Tier{i} 阶梯块 / _Back 后墙 / _VIP 玻璃带 / _Roof 顶棚 / _RoofStrip 灯带 / _Rail 前沿围栏\r\n1192:        _Columns 后支撑柱(合并) / _Trusses 顶棚横向钢梁(合并) / _FrontPosts 前立柱(合并)\r\n1193:        _Flagpoles 旗杆(合并) / _Flags 旗(合并, 多材质)\"\"\"\r\n1194:     p, h, r, k = at_s(s_center)\r\n1195:     fwd = Vector((cos(h), sin(h), 0.0))\r\n1196:     out = Vector((r.x, r.y, 0.0)) * side\r\n1197:     row_d = 0.92\r\n1198:     row_h = 0.58\r\n1199:     L = length / 2.0\r\n1200:     parts = []\r\n1201: \r\n1202:     # ---- 阶梯分块（每 28 m 一块，块间 2 m 通道，避免一整条）----\r\n1203:     block, gap = 28.0, 2.0\r\n1204:     spans, x0 = [], -L\r\n1205:     while x0 < L - 4:\r\n1206:         x1 = min(x0 + block, L)\r\n1207:         spans.append((x0, x1))\r\n1208:         x0 = x1 + gap\r\n1209:     for bi, (x0, x1) in enumerate(spans):\r\n1210:         bl = x1 - x0\r\n1211:         v, fc, uv = [], [], []\r\n1212:         for rr in range(rows + 1):\r\n1213:             d0 = dist + rr * row_d\r\n1214:             z = rr * row_h\r\n1215:             for sd, xs in ((-1, x0), (1, x1)):\r\n1216:                 c = p + out * d0 + fwd * xs\r\n1217:                 v.append((c.x, c.y, z))\r\n1218:                 uv.append((sd * bl / 7.5 + 0.5, rr / float(rows)))\r\n1219:         for rr in range(rows):\r\n1220:             a = rr * 2\r\n1221:             b = (rr + 1) * 2\r\n1222:             fc.append((a, a + 1, b + 1, b))     # 座面\r\n1223:             fc.append((a, b, b + 1, a + 1))     # 立面\r\n1224:         parts.append(mesh_from(f\"{name}_Tier{bi}\", v, fc, M_CROWD, uvs=uv, up=False))\r\n1225: \r\n1226:     # ---- 后墙 + VIP 玻璃带 ----\r\n1227:     back = dist + rows * row_d\r\n1228:     parts.append(box(name + \"_Back\", (p.x + out.x * back, p.y + out.y * back, rows * row_h / 2),\r\n1229:                      (length, 0.5, rows * row_h), M_CONC, rot_z=h))\r\n1230:     gz = (rows - 1) * row_h\r\n1231:     parts.append(box(name + \"_VIP\", (p.x + out.x * (back - 0.3), p.y + out.y * (back - 0.3), gz + 0.9),\r\n1232:                      (length - 4, 0.12, 1.2), M_STRIP, rot_z=h))\r\n1233: \r\n1234:     # ---- 斜顶棚（前低后高）+ 支撑 ----\r\n1235:     zf = rows * row_h + 3.0\r\n1236:     zb = rows * row_h + 5.8\r\n1237:     rf = dist - 0.6\r\n1238:     rb = back + 1.6\r\n1239:     rv = []\r\n1240:     for sd in (-1, 1):\r\n1241:         cf = p + out * rf + fwd * (L * sd)\r\n1242:         cb = p + out * rb + fwd * (L * sd)\r\n1243:         rv += [(cf.x, cf.y, zf), (cb.x, cb.y, zb)]\r\n1244:     parts.append(mesh_from(name + \"_Roof\", rv, [(0, 1, 3, 2)], M_ROOF, up=False))\r\n1245:     # 顶棚下沿灯带\r\n1246:     lp = p + out * (rf + 0.1)\r\n1247:     parts.append(box(name + \"_RoofStrip\", (lp.x, lp.y, zf - 0.3), (length * 0.96, 0.10, 0.10), M_STRIP, rot_z=h))\r\n1248:     # 后支撑柱（每 14 m）-> 一个网格\r\n1249:     cols = Parts(name + \"_Columns\")\r\n1250:     _n = int(length / 14)\r\n1251:     for i in range(_n + 1):\r\n1252:         xs = -L + i * 14.0\r\n1253:         cph = p + out * rb + fwd * xs\r\n1254:         cols.box((cph.x, cph.y, zb / 2), (0.24, 0.24, zb), M_STEEL, rot_z=h)\r\n1255:     parts.append(cols.build())\r\n1256:     # 顶棚横向钢梁（每 8 m 一根，从顶棚前沿斜拉到后沿，贴在顶棚下 0.12 m）-> 一个网格\r\n1257:     trs = Parts(name + \"_Trusses\")\r\n1258:     _m = int(length / 8)\r\n1259:     for i in range(_m + 1):\r\n1260:         xs = -L + i * 8.0\r\n1261:         bf = p + out * rf + fwd * xs\r\n1262:         bb = p + out * rb + fwd * xs\r\n1263:         trs.beam((bf.x, bf.y, zf - 0.12), (bb.x, bb.y, zb - 0.12), fwd, 0.16, 0.16, M_STEEL)\r\n1264:     parts.append(trs.build())\r\n1265: \r\n1266:     # ---- 前立柱 + 前沿围栏 ----\r\n1267:     fps = Parts(name + \"_FrontPosts\")\r\n1268:     for sd in (-1, 1):\r\n1269:         cp = p + out * (dist + 0.4) + fwd * (L * sd * 0.92)\r\n1270:         fps.box((cp.x, cp.y, zf / 2), (0.28, 0.28, zf), M_STEEL, rot_z=h)\r\n1271:     parts.append(fps.build())\r\n1272:     rail = p + out * (dist - 1.5)\r\n1273:     parts.append(box(name + \"_Rail\", (rail.x, rail.y, 0.55), (length, 0.06, 0.06), M_STEEL, rot_z=h))\r\n1274:     # 旗杆 + 旗（沿前沿，每 40 m）-> 旗杆一个网格、旗一个网格（多材质）\r\n1275:     poles = Parts(name + \"_Flagpoles\")\r\n1276:     flags = Parts(name + \"_Flags\")\r\n1277:     _n = int(length / 40)\r\n1278:     for i in range(_n + 1):\r\n1279:         xs = -L + i * 40.0\r\n1280:         fp = p + out * (dist - 2.2) + fwd * xs\r\n1281:         poles.box((fp.x, fp.y, 3.0), (0.08, 0.08, 6.0), M_STEEL, rot_z=h)\r\n1282:         col = random.choice(M_FLAGS)\r\n1283:         fv = [(fp.x, fp.y, 6.0),\r\n1284:               (fp.x + out.x * 1.5, fp.y + out.y * 1.5, 5.65),\r\n1285:               (fp.x, fp.y, 5.3)]\r\n1286:         flags.poly(fv, [(0, 1, 2)], col)\r\n1287:     parts.append(poles.build())\r\n1288:     parts.append(flags.build())\r\n1289: \r\n1290:     # ---- 组件 Empty：放在看台占地中心（地面），X 轴沿赛道 ----\r\n1291:     mid = p + out * ((dist - 2.2 + rb) / 2.0)\r\n1292:     assembly(name, (mid.x, mid.y, 0.0), h, parts, size=8.0)\r\n1293:     return name\r\n1294: \r\n1295: \r\n1296: STANDS = [\r\n1297:     (120.0, 1, 150.0, 13, 26.0, \"V5_Stand_Main\"),\r\n1298:     (1120.0, -1, 90.0, 11, 30.0, \"V5_Stand_T1\"),\r\n1299:     (2600.0, 1, 110.0, 12, 30.0, \"V5_Stand_Mid\"),\r\n1300:     (3540.0, -1, 120.0, 12, 30.0, \"V5_Stand_Complex\"),\r\n1301:     (4370.0, 1, 95.0, 11, 32.0, \"V5_Stand_South\"),\r\n1302:     (5560.0, -1, 100.0, 11, 28.0, \"V5_Stand_Club\"),\r\n1303: ]\r\n1304: M_FLAGS = [new_mat(f\"V5_Flag_{i}\", c, 0.6, 0.0)\r\n1305:            for i, c in enumerate(((200, 30, 30), (20, 60, 200), (240, 240, 240),\r\n1306:                                   (255, 160, 0), (20, 140, 90)))]\r\n1307: random.seed(11)                     # 旗色可复现（以前未设种子，每次构建旗色都不同）\r\n1308: for args in STANDS:\r\n1309:     grandstand(*args)\r\n1310: print(\"stands:\", len(STANDS))\r\n1311: \r\n1312: # ---------------------------------------------------------------\r\n1313: # 11. 维修区（主直道内侧）：pit wall + pit lane + pit box + garage 楼\r\n1314: # ---------------------------------------------------------------\r\n1315: PIT_S0, PIT_S1 = 60.0, 420.0\r\n1316: _p, _h, _r, _k = at_s((PIT_S0 + PIT_S1) / 2)\r\n1317: _pit_fwd = Vector((cos(_h), sin(_h), 0.0))\r\n1318: _pit_out = Vector((- _r.x, - _r.y, 0.0))      # 内侧（-right），与 Stand_Main 错开\r\n1319: PIT_WALL = -(HALF_W + 3.0)                     # -10 m 处维修墙\r\n1320: PIT_LANE = -(HALF_W + 3.0 + 9.0)               # -19 m 处车道内边\r\n1321: PIT_FACE = -(HALF_W + 3.0 + 12.0)              # -22 m 处车库楼正面\r\n1322: PIT_BACK = -(HALF_W + 3.0 + 26.0)              # -36 m 楼背\r\n1323: GAR_H = 8.0\r\n1324: PIT_LEN = PIT_S1 - PIT_S0\r\n1325: \r\n1326: \r\n1327: def strip_uv(s0, s1, off_a, off_b, z, mat, name, u_repeat, v_repeat=1.0, step=2.0, up=True):\r\n1328:     \"\"\"局部带状（非闭环），u 沿弧长 / v 沿横向\"\"\"\r\n1329:     v, fc, uv = [], [], []\r\n1330:     ss, s = [], s0\r\n1331:     while s <= s1 + 1e-6:\r\n1332:         ss.append(s)\r\n1333:         s += step\r\n1334:     if ss[-1] < s1:\r\n1335:         ss.append(s1)\r\n1336:     for s in ss:\r\n1337:         p, h, r, k = at_s(s)\r\n1338:         for (o, vv) in ((off_a, 0.0), (off_b, 1.0)):\r\n1339:             v.append((p.x + r.x * o, p.y + r.y * o, z))\r\n1340:             uv.append(((s - s0) / u_repeat, vv * v_repeat))\r\n1341:     for j in range(len(ss) - 1):\r\n1342:         a = j * 2\r\n1343:         fc.append((a, a + 1, a + 3, a + 2))\r\n1344:     return mesh_from(name, v, fc, mat, uvs=uv, up=up)\r\n1345: \r\n1346: \r\n1347: def wall_uv(s0, s1, off, z0, z1, mat, name, u_repeat, v_repeat=1.0, step=2.0):\r\n1348:     \"\"\"局部竖直墙（garage 正面 / 维修墙），u 沿弧长 / v 沿高度\"\"\"\r\n1349:     v, fc, uv = [], [], []\r\n1350:     ss, s = [], s0\r\n1351:     while s <= s1 + 1e-6:\r\n1352:         ss.append(s)\r\n1353:         s += step\r\n1354:     if ss[-1] < s1:\r\n1355:         ss.append(s1)\r\n1356:     for s in ss:\r\n1357:         p, h, r, k = at_s(s)\r\n1358:         px, py = p.x + r.x * off, p.y + r.y * off\r\n1359:         v.append((px, py, z0))\r\n1360:         v.append((px, py, z1))\r\n1361:         uv.append(((s - s0) / u_repeat, 0.0))\r\n1362:         uv.append(((s - s0) / u_repeat, v_repeat))\r\n1363:     for j in range(len(ss) - 1):\r\n1364:         a = j * 2\r\n1365:         fc.append((a, a + 1, a + 3, a + 2))\r\n1366:     return mesh_from(name, v, fc, mat, uvs=uv, up=False)\r\n1367: \r\n1368: \r\n1369: # ① pit lane 沥青车道（覆盖掉草地缓冲带）\r\n1370: strip_uv(PIT_S0, PIT_S1, PIT_WALL, PIT_LANE, 0.010, M_ASPHALT, \"V5_PitLane\", PIT_LEN)\r\n1371: # ② pit lane 两条白线\r\n1372: strip_uv(PIT_S0, PIT_S1, PIT_WALL - 0.25, PIT_WALL - 0.02, 0.014, M_WHITE, \"V5_PitLineIn\", PIT_LEN)\r\n1373: strip_uv(PIT_S0, PIT_S1, PIT_LANE + 0.02, PIT_LANE + 0.25, 0.014, M_WHITE, \"V5_PitLineOut\", PIT_LEN)\r\n1374: # ③ 维修墙（分段矮墙）+ 顶部队名灯牌\r\n1375: wall_uv(PIT_S0, PIT_S1, PIT_WALL, 0.0, 1.10, M_CONC, \"V5_PitWall\", PIT_LEN)\r\n1376: strip_uv(PIT_S0, PIT_S1, PIT_WALL - 0.08, PIT_WALL + 0.08, 1.12, M_STRIP, \"V5_PitWallStrip\", PIT_LEN)\r\n1377: # ④ pit box 划线：每 6 m 一条横向白线（garage 分格）-> 全部在一个网格 V5_PitBoxLines\r\n1378: _bk = 0\r\n1379: _s = PIT_S0 + 3.0\r\n1380: _pbl = Parts(\"V5_PitBoxLines\")\r\n1381: while _s < PIT_S1 - 1.0:\r\n1382:     p, h, r, k = at_s(_s)\r\n1383:     fwd = Vector((cos(h), sin(h), 0.0))\r\n1384:     v = []\r\n1385:     for (o, sd) in ((PIT_WALL, -1), (PIT_WALL, 1), (PIT_LANE, 1), (PIT_LANE, -1)):\r\n1386:         c = p + r * o + fwd * sd * 0.06\r\n1387:         v.append((c.x, c.y, 0.015))\r\n1388:     _pbl.poly(v, [(0, 1, 2, 3)], M_WHITE)\r\n1389:     _bk += 1\r\n1390:     _s += 6.0\r\n1391: _pbl.build(up=True)\r\n1392: print(\"pit box lines:\", _bk)\r\n1393: # ⑤ garage 楼体（混凝土）+ 正面贴图面板\r\n1394: _c = _p + _pit_out * ((abs(PIT_FACE) + abs(PIT_BACK)) / 2)\r\n1395: _dep = abs(PIT_BACK - PIT_FACE)\r\n1396: box(\"V5_PitGarage\", (_c.x, _c.y, GAR_H / 2), (PIT_LEN, _dep, GAR_H), M_CONC, rot_z=_h)\r\n1397: wall_uv(PIT_S0, PIT_S1, PIT_FACE, 0.0, GAR_H, M_GARAGE, \"V5_PitGarageFront\", PIT_LEN, v_repeat=GAR_H / 4.0)\r\n1398: # ⑥ garage 楼顶赞助灯箱（发光）\r\n1399: strip_uv(PIT_S0, PIT_S1, PIT_FACE + 1.0, PIT_BACK - 1.0, GAR_H + 0.05, M_AD, \"V5_PitRoofBanner\", PIT_LEN, up=True)\r\n1400: # ⑦ garage 楼顶主看台（4 排小阶梯，用人群贴图）\r\n1401: for _rr in range(4):\r\n1402:     _o0 = PIT_BACK - 1.5 + _rr * 1.2\r\n1403:     _o1 = _o0 + 1.2\r\n1404:     _z = GAR_H + 0.06 + _rr * 0.55\r\n1405:     strip_uv(PIT_S0, PIT_S1, _o0, _o1, _z, M_CROWD, f\"V5_PitTopTier_{_rr}\", PIT_LEN, up=True)\r\n1406: # 楼顶围栏（发光细条）\r\n1407: strip_uv(PIT_S0, PIT_S1, PIT_BACK + 0.3, PIT_BACK + 0.5, GAR_H + 2.4, M_STRIP, \"V5_PitTopRail\", PIT_LEN)\r\n1408: \r\n1409: # ---------------------------------------------------------------\r\n1410: # 11b. 赛道道具：广告板 / 刹车牌 / 大屏 / 天桥 / 裁判点\r\n1411: # ---------------------------------------------------------------\r\n1412: def ad_board(s, side, w=11.0, hgt=3.6, off=WALL_OFF + 2.5, name=\"\"):\r\n1413:     p, h, r, k = at_s(s)\r\n1414:     base = p + r * (side * off)\r\n1415:     box(name, (base.x, base.y, 1.0 + hgt / 2), (w, 0.12, hgt), M_AD, rot_z=h)\r\n1416: \r\n1417: \r\n1418: def brake_board(s, side, num, poles, off=HALF_W + 2.4, name=\"\"):\r\n1419:     \"\"\"一块刹车牌；两根细杆加进 poles (Parts，整组共用一个网格)。返回 (牌子对象, 底部中心, 航向)\"\"\"\r\n1420:     p, h, r, k = at_s(s)\r\n1421:     base = p + r * (side * off)\r\n1422:     ob = box(name, (base.x, base.y, 1.05), (1.0, 0.08, 1.25), M_BRAKE[num], rot_z=h)\r\n1423:     # 两根细杆：沿切线 ±0.32 m（牌子宽 1.0 m 沿切线）\r\n1424:     tx, ty = cos(h), sin(h)\r\n1425:     for d in (-0.32, 0.32):\r\n1426:         poles.box((base.x + tx * d, base.y + ty * d, 0.5), (0.05, 0.05, 1.0), M_STEEL, rot_z=h)\r\n1427:     return ob, base, h\r\n1428: \r\n1429: \r\n1430: def bigscreen(s, side, off=WALL_OFF + 8.0, w=22.0, hgt=9.0, name=\"V5_Screen\"):\r\n1431:     \"\"\"组件 Empty(name) + _Panel 屏幕 + _Legs 两条腿（一个网格）\"\"\"\r\n1432:     p, h, r, k = at_s(s)\r\n1433:     base = p + r * (side * off)\r\n1434:     panel = box(name + \"_Panel\", (base.x, base.y, 5.5), (w, 0.45, hgt), M_SCREEN, rot_z=h)\r\n1435:     legs = Parts(name + \"_Legs\")\r\n1436:     for dx in (-w / 2 + 0.5, w / 2 - 0.5):\r\n1437:         legs.box((base.x + cos(h) * dx, base.y + sin(h) * dx, 2.0), (0.5, 0.5, 4.0), M_STEEL, rot_z=h)\r\n1438:     assembly(name, (base.x, base.y, 0.0), h, [panel, legs.build()], size=5.0)\r\n1439: \r\n1440: \r\n1441: def footbridge(s, name=\"V5_Bridge\"):\r\n1442:     \"\"\"组件 Empty(name) + _Deck 桥面 + _Piers 两座桥墩（一个网格）+ _Rails 两条发光栏杆（一个网格）\"\"\"\r\n1443:     p, h, r, k = at_s(s)\r\n1444:     fwd = Vector((cos(h), sin(h), 0.0))\r\n1445:     off = HALF_W + 7.0\r\n1446:     # 桥面：横跨赛道，宽（沿 fwd）4.5 m，高 6.0 m\r\n1447:     a = p - r * off - fwd * 2.25\r\n1448:     b = p + r * off - fwd * 2.25\r\n1449:     c = p + r * off + fwd * 2.25\r\n1450:     d = p - r * off + fwd * 2.25\r\n1451:     v = [(a.x, a.y, 6.0), (b.x, b.y, 6.0), (c.x, c.y, 6.0), (d.x, d.y, 6.0),\r\n1452:          (a.x, a.y, 5.4), (b.x, b.y, 5.4), (c.x, c.y, 5.4), (d.x, d.y, 5.4)]\r\n1453:     fc = [(0, 1, 2, 3), (4, 5, 6, 7), (0, 4, 5, 1), (1, 5, 6, 2),\r\n1454:           (2, 6, 7, 3), (3, 7, 4, 0)]\r\n1455:     deck = mesh_from(name + \"_Deck\", v, fc, M_STEEL, up=False)\r\n1456:     # 桥墩\r\n1457:     piers = Parts(name + \"_Piers\")\r\n1458:     for sd in (-1, 1):\r\n1459:         bp = p + r * (sd * off)\r\n1460:         piers.box((bp.x, bp.y, 2.8), (0.6, 0.6, 5.6), M_CONC)\r"}
{"step_index":91,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-18T06:05:07Z","input_tokens":12581,"cache_read_tokens":246339,"output_tokens":2600,"thinking":"Examining the remaining lines of the file to understand the `V5_Track` upgrade. The code defines a 5-slice transverse road mesh with specific offsets. The new mesh construction likely impacts how the environment handles road data and visualization.\n\n\nExamining the file further, the code incorporates vertex attributes for off-line visuals like rubber and dust. New meshes, `V5_SkidMarks`, cover braking zones with UV maps and fading effects. Additionally, raised kerbs, `V5_Kerb_Sausage`, are implemented for slow corners.\n\n\n","tool_calls":[{"name":"read_file","args":{"EndLine":1676,"Path":"D:\\项目session\\blender-supercar\\pipeline\\v5_env.py","StartLine":1461}},{"name":"edit_file","args":{"Path":"D:\\项目session\\blender-supercar\\pipeline\\v5_env.py","Replacement":"# 主路面（横向 5 列顶点，写入 OffLine 顶点属性以呈现线外浮尘与橡胶碎粒 marbles）\ndef _build_main_track():\n    cols_off = (-HALF_W, -3.5, 0.0, 3.5, HALF_W)\n    nc = len(cols_off)\n    tv, tfc, tuv, toff = [], [], [], []\n    idxs = list(range(0, N)) + [N]\n    for i in idxs:\n        p, h, r, k = at(i)\n        ro = ROFF[i % N]\n        kp = min(1.0, KAPPA[i % N] / 0.012)\n        for ci, o in enumerate(cols_off):\n            tv.append((p.x + r.x * o, p.y + r.y * o, 0.010))\n            tuv.append((ci / float(nc - 1), S[i % N] / 8.0))\n            d_rl = abs(o - ro)\n            marb = max(0.0, min(1.0, (d_rl - 2.1) / 3.2)) * (0.35 + 0.55 * kp)\n            toff.append(marb)\n    for j in range(len(idxs) - 1):\n        b0 = j * nc\n        b1 = (j + 1) * nc\n        for ci in range(nc - 1):\n            tfc.append((b0 + ci, b0 + ci + 1, b1 + ci + 1, b1 + ci))\n    ob = mesh_from(\"V5_Track\", tv, tfc, M_ASPHALT, uvs=tuv, up=True)\n    attr = ob.data.attributes.new(name=\"OffLine\", type='FLOAT', domain='POINT')\n    for vi, val in enumerate(toff):\n        attr.data[vi].value = val\n    return ob\n\n\n_build_main_track()\n# 边线（白实线）\nribbon(-HALF_W + 0.05, -HALF_W + 0.20, 0.014, M_WHITE, \"V5_Line_L\")\nribbon(HALF_W - 0.20, HALF_W - 0.05, 0.014, M_WHITE, \"V5_Line_R\")\n\n\n# 赛车线橡胶带（沿 racing_xy，宽 3.4 m）\ndef _rl(i):\n    return ROFF[i % N] - 1.7\n\n\ndef _rr(i):\n    return ROFF[i % N] + 1.7\n\n\nribbon(_rl, _rr, 0.013, M_RUBBER, \"V5_RacingLine\", step=1)\n\n\n# 重刹区轮胎橡胶压痕（Village/Loop、Brooklands/Luffield、Stowe、Vale/Club 等全部重刹点，合并为单个 V5_SkidMarks）\ndef _build_braking_skids():\n    decel = [0.0] * N\n    for i in range(1, N - 1):\n        dt_loc = max(1e-4, PTS[i + 1][\"t\"] - PTS[i - 1][\"t\"])\n        acc = (VEL[i + 1] - VEL[i - 1]) / dt_loc\n        decel[i] = max(0.0, -acc)\n    # 找出减速度 > 8.5 m/s^2 的连续重刹段，前后各外扩 7 点做平滑羽化\n    zones, cur = [], None\n    for i in range(N):\n        if decel[i] > 8.5:\n            cur = [i, i] if cur is None else [cur[0], i]\n        else:\n            if cur and (S[cur[1]] - S[cur[0]] >= 22.0):\n                zones.append((max(0, cur[0] - 7), min(N - 1, cur[1] + 7)))\n            cur = None\n    sv, sfc, suv, sfade = [], [], [], []\n    half_skid = 2.05\n    for (i0, i1) in zones:\n        span = max(1, i1 - i0)\n        base = len(sv)\n        cnt = 0\n        for idx in range(i0, i1 + 1):\n            p, h, r, k = at(idx)\n            ro = ROFF[idx]\n            u_long = (idx - i0) / float(span)\n            env = sin(pi * u_long) ** 0.75\n            inten = min(1.0, max(0.25, decel[idx] / 42.0)) * env\n            for side_u, off in ((0.0, ro - half_skid), (1.0, ro + half_skid)):\n                o_clamped = max(-HALF_W + 0.35, min(HALF_W - 0.35, off))\n                sv.append((p.x + r.x * o_clamped, p.y + r.y * o_clamped, 0.0136))\n                suv.append((side_u, S[idx] / 12.0))\n                sfade.append(inten)\n            cnt += 1\n        for j in range(cnt - 1):\n            a = base + j * 2\n            sfc.append((a, a + 1, a + 3, a + 2))\n    if sfc:\n        ob = mesh_from(\"V5_SkidMarks\", sv, sfc, M_SKID, uvs=suv, up=True)\n        fa = ob.data.attributes.new(name=\"SkidFade\", type='FLOAT', domain='POINT')\n        for vi, val in enumerate(sfade):\n            fa.data[vi].value = val\n        print(\"heavy braking skid zones:\", len(zones))\n\n\n_build_braking_skids()","Target":"# 主路面\nribbon(-HALF_W, HALF_W, 0.010, M_ASPHALT, \"V5_Track\", uv_scale=8.0)\n# 边线（白实线）\nribbon(-HALF_W + 0.05, -HALF_W + 0.20, 0.014, M_WHITE, \"V5_Line_L\")\nribbon(HALF_W - 0.20, HALF_W - 0.05, 0.014, M_WHITE, \"V5_Line_R\")\n\n# 赛车线橡胶带（沿 racing_xy，宽 3.4 m）\ndef _rl(i):\n    return ROFF[i % N] - 1.7\n\n\ndef _rr(i):\n    return ROFF[i % N] + 1.7\n\n\nribbon(_rl, _rr, 0.013, M_RUBBER, \"V5_RacingLine\", step=1)"}}]}
