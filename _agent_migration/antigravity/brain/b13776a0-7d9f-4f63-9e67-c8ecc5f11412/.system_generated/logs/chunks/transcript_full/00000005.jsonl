r\n1583:     \"V5_01_Road\": (\"V5_Track\", \"V5_RacingLine\", \"V5_Line_\", \"V5_Kerb_\",\r\n1584:                    \"V5_StartLine\", \"V5_PitLane\", \"V5_PitLine\", \"V5_PitBoxLine\"),\r\n1585:     \"V5_02_Terrain\": (\"V5_Ground\", \"V5_Verge_\", \"V5_Gravel_\", \"V5_HedgeRing\", \"V5_SkyDome\"),\r\n1586:     \"V5_03_Barriers\": (\"V5_Barrier\", \"V5_FencePosts\"),\r\n1587:     \"V5_04_Stands\": (\"V5_Stand_\",),\r\n1588:     \"V5_05_Pit\": (\"V5_PitWall\", \"V5_PitGarage\", \"V5_PitRoof\", \"V5_PitTop\"),\r\n1589:     \"V5_06_Props\": (\"V5_Ad_\", \"V5_Brake_\", \"V5_Screen_\", \"V5_Bridge_\",\r\n1590:                     \"V5_Marshal_\", \"V5_FieldMasts\", \"V5_Hangar_\",\r\n1591:                     \"V5_Gantry\", \"V5_StartLight\"),\r\n1592:     \"V5_07_Lighting\": (\"LGT_V5\",),\r\n1593: }\r\n1594: \r\n1595: # 13a. 原点归位：只处理\"网格烘焙在世界坐标里\"的对象（location/rotation 为 0、scale 为 1）。\r\n1596: #      box()/球体等本来就以自身中心为原点（location 已是世界位置），不动。\r\n1597: #      注意：新建对象在 depsgraph 更新前 matrix_world 是单位阵——旧版就是读了它，\r\n1598: #      把 441 个 box 对象的 location 改成了 (0,0,0)，全堆在世界原点。这里先 update，\r\n1599: #      并且只用 matrix_basis（不依赖 depsgraph）判断。\r\n1600: bpy.context.view_layer.update()\r\n1601: _moved = 0\r\n1602: _I4 = Matrix.Identity(4)\r\n1603: for _ob in list(bpy.data.objects):\r\n1604:     if _ob.type != 'MESH' or not _ob.name.startswith(\"V5_\") or _ob.parent is not None:\r\n1605:         continue\r\n1606:     if not _ob.data.vertices:\r\n1607:         continue\r\n1608:     _mb = _ob.matrix_basis\r\n1609:     if any(abs(_mb[i][j] - _I4[i][j]) > 1e-9 for i in range(4) for j in range(4)):\r\n1610:         continue                                   # 已有自身变换 = 已以几何中心为原点\r\n1611:     _xs = [_v.co.x for _v in _ob.data.vertices]\r\n1612:     _ys = [_v.co.y for _v in _ob.data.vertices]\r\n1613:     _zs = [_v.co.z for _v in _ob.data.vertices]\r\n1614:     _c = Vector(((min(_xs) + max(_xs)) / 2, (min(_ys) + max(_ys)) / 2, (min(_zs) + max(_zs)) / 2))\r\n1615:     _ob.data.transform(Matrix.Translation(-_c))\r\n1616:     _ob.data.update()\r\n1617:     _ob.location = _c\r\n1618:     _moved += 1\r\n1619: bpy.context.view_layer.update()\r\n1620: \r\n1621: # 13b. 组件 Empty 父子：保持世界变换（child.matrix_basis = parent⁻¹ · child_world，parent_inverse = I），\r\n1622: #      这样子物体的 location 直接读作\"相对组件中心\"的坐标，移动/旋转 Empty 整个组件跟着走。\r\n1623: _parented = 0\r\n1624: for _em, _parts in ASSEMBLIES:\r\n1625:     _inv = _em.matrix_basis.inverted()\r\n1626:     for _ob in _parts:\r\n1627:         _mw = _ob.matrix_basis.copy()             # 未挂父时 matrix_basis == 世界变换\r\n1628:         _ob.parent = _em\r\n1629:         _ob.matrix_parent_inverse = Matrix.Identity(4)\r\n1630:         _ob.matrix_basis = _inv @ _mw\r\n1631:         _parented += 1\r\n1632: bpy.context.view_layer.update()\r\n1633: print(\"assemblies: %d empties, %d parented parts\" % (len(ASSEMBLIES), _parented))\r\n1634: \r\n1635: _root = scene.collection\r\n1636: _cols = {}\r\n1637: for _g in _GROUPS:\r\n1638:     _cc = bpy.data.collections.get(_g) or bpy.data.collections.new(_g)\r\n1639:     if _cc.name not in _root.children:\r\n1640:         _root.children.link(_cc)\r\n1641:     _cols[_g] = _cc\r\n1642: \r\n1643: \r\n1644: def _bucket(nm):\r\n1645:     for _g, _ps in _GROUPS.items():\r\n1646:         for _p in _ps:\r\n1647:             if nm.startswith(_p):\r\n1648:                 return _g\r\n1649:     return None\r\n1650: \r\n1651: \r\n1652: _reg = 0\r\n1653: for _ob in list(bpy.data.objects):\r\n1654:     _g = _bucket(_ob.name)\r\n1655:     if not _g:\r\n1656:         continue\r\n1657:     for _c in list(_ob.users_collection):\r\n1658:         _c.objects.unlink(_ob)\r\n1659:     _cols[_g].objects.link(_ob)\r\n1660:     _reg += 1\r\n1661: print(\"organize: origin_to_geometry=%d  regrouped=%d\" % (_moved, _reg))\r\n1662: \r\n1663: # 13c. 清掉空的杂乱集合（v4 遗留：09_Studio_Stage_Rig、WheelSpokes_*，都是 0 对象 0 子集合）\r\n1664: _dropped = []\r\n1665: for _c in list(bpy.data.collections):\r\n1666:     if (_c.name == \"09_Studio_Stage_R