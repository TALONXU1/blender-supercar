 Contrast', 'AgX - High Contrast', 'Medium High Contrast'):\r\n628:     try:\r\n629:         scene.view_settings.look = look\r\n630:         break\r\n631:     except Exception:\r\n632:         continue\r\n633: scene.view_settings.exposure = 0.50\r\n634: scene.view_settings.gamma = 1.0\r\n635: \r\n636: # 泛光\r\n637: try:\r\n638:     ng = bpy.data.node_groups.new(\"Comp_V5\", 'CompositorNodeTree')\r\n639:     rl = ng.nodes.new(\"CompositorNodeRLayers\")\r\n640:     glare = ng.nodes.new(\"CompositorNodeGlare\")\r\n641:     for val in (\"Bloom\", \"BLOOM\", \"bloom\"):\r\n642:         try:\r\n643:             glare.inputs['Type'].default_value = val\r\n644:             break\r\n645:         except Exception:\r\n646:             continue\r\n647:     for nm, v in ((\"Threshold\", 2.0), (\"Strength\", 0.16), (\"Size\", 6)):\r\n648:         if nm in glare.inputs:\r\n649:             try:\r\n650:                 glare.inputs[nm].default_value = v\r\n651:             except Exception:\r\n652:                 pass\r\n653:     try:\r\n654:         comp = ng.nodes.new(\"CompositorNodeComposite\")\r\n655:     except Exception:\r\n656:         comp = ng.nodes.new(\"NodeGroupOutput\")\r\n657:         if not any(s.name == \"Image\" for s in ng.interface.items_tree):\r\n658:             ng.interface.new_socket(name=\"Image\", in_out='OUTPUT', socket_type='NodeSocketColor')\r\n659:     ng.links.new(rl.outputs['Image'], glare.inputs['Image'])\r\n660:     ng.links.new(glare.outputs['Image'], comp.inputs['Image'])\r\n661:     scene.compositing_node_group = ng\r\n662:     scene.use_nodes = True\r\n663:     print(\"COMPOSITOR OK\")\r\n664: except Exception as e:\r\n665:     print(\"COMPOSITOR FAILED:\", e)\r\n666: \r\n667: bpy.ops.wm.save_as_mainfile(filepath=OUT)\r\n668: print(\"ANIM SAVED:\", OUT)\r\n669: \r\n670: # ---------------------------------------------------------------\r\n671: # 7. 测试渲染\r\n672: # ---------------------------------------------------------------\r\n673: def render_