{"step_index":14,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-18T05:26:24Z","content":"Created At: 2026-11-18T13:26:24+08:00\nCompleted At: 2026-11-18T13:26:26+08:00\nShowing lines 1-696 of 696\n1: # -*- coding: utf-8 -*-\r\n2: \"\"\"\r\n3: V5 ANIM — 真实赛道整圈（Silverstone / 90.34 s / 162 拍 / 2161 帧）\r\n4: 输入: LATEST/v5_stage_env.blend\r\n5: 输出: LATEST/v5_stage_anim.blend\r\n6: 运行:\r\n7:   blender -b -P pipeline/v5_anim.py -- --test 60,300,700,1500\r\n8:   blender -b -P pipeline/v5_anim.py -- --render\r\n9: \r\n10: 五条硬规则（来自 track_data/TRACK_SPEC.md）\r\n11:   1. 位置按 t 插值，不按帧均分\r\n12:   2. 朝向取 heading_deg，不用位移差反推\r\n13:   3. 位置走 racing_xy，不是 xy\r\n14:   4. 关键帧 LINEAR，禁 Bezier\r\n15:   5. v^2 * curv 不得超过 15.0 + 0.00714 v^2\r\n16: \"\"\"\r\n17: import bpy, json, math, os, sys, random\r\n18: from mathutils import Vector, Matrix, Euler\r\n19: from math import sin, cos, pi, radians, degrees, sqrt\r\n20: \r\n21: PROJ = r\"D:\\项目session\\blender-supercar\"\r\n22: IN = os.path.join(PROJ, \"LATEST\", \"v5_stage_env.blend\")\r\n23: OUT = os.path.join(PROJ, \"LATEST\", \"v5_stage_anim.blend\")\r\n24: TRACK = os.path.join(PROJ, \"track_data\", \"silverstone_track.json\")\r\n25: FRAMES_DIR = os.path.join(PROJ, \"renders_v5\", \"frames\")\r\n26: STILLS_DIR = os.path.join(PROJ, \"renders_v5\", \"stills\")\r\n27: \r\n28: ARGV = sys.argv[sys.argv.index(\"--\") + 1:] if \"--\" in sys.argv else []\r\n29: \r\n30: \r\n31: def argval(flag, default=None):\r\n32:     if flag in ARGV:\r\n33:         i = ARGV.index(flag)\r\n34:         if i + 1 < len(ARGV) and not ARGV[i + 1].startswith(\"--\"):\r\n35:             return ARGV[i + 1]\r\n36:         return True\r\n37:     return default\r\n38: \r\n39: \r\n40: # ---------------------------------------------------------------\r\n41: # 0. 参数\r\n42: # ---------------------------------------------------------------\r\n43: FPS = 24\r\n44: BEAT = 60.0 / 108.0                 # After Hours 108 BPM -> 0.5556 s\r\n45: BEAT_F = BEAT * FPS                 # 13.3333 帧\r\n46: TOTAL_BEATS = 162\r\n47: FRAME_END = int(round(1 + TOTAL_BEATS * BEAT_F))    # 2161\r\n48: R_TIRE = 0.357\r\n49: WHEELBASE = 3.6\r\n50: \r\n51: data = json.load(open(TRACK, encoding=\"utf-8\"))\r\n52: META = data[\"meta\"]\r\n53: P = data[\"points\"]\r\n54: N = len(P)\r\n55: LAP_S = META[\"sim_lap_s\"]           # 90.34\r\n56: DT = LAP_S / (FRAME_END - 1)        # 每帧时间步（保证整圈正好铺满）\r\n57: \r\n58: T_ARR = [p[\"t\"] for p in P]\r\n59: RX_ARR = [Vector((p[\"racing_xy\"][0], p[\"racing_xy\"][1], 0.0)) for p in P]\r\n60: HD_ARR = [p[\"heading_deg\"] for p in P]\r\n61: V_ARR = [p[\"v_mps\"] for p in P]\r\n62: K_ARR = [abs(p[\"curv_1pm\"] or 0.0) for p in P]\r\n63: \r\n64: \r\n65: def _unwrap(deg_list):\r\n66:     out = [deg_list[0]]\r\n67:     for a in deg_list[1:]:\r\n68:         d = (a - out[-1] + 180.0) % 360.0 - 180.0\r\n69:         out.append(out[-1] + d)\r\n70:     return out\r\n71: \r\n72: \r\n73: _HD_UN = _unwrap(HD_ARR)\r\n74: _SPAN = 4\r\n75: _SDS = 2 * _SPAN * (META[\"measured_length_km\"] * 1000.0 / N)\r\n76: \r\n77: \r\n78: def _ssign(i):\r\n79:     a = _HD_UN[(i - _SPAN) % N]\r\n80:     b = _HD_UN[(i + _SPAN) % N]\r\n81:     return 1.0 if (b - a) >= 0 else -1.0\r\n82: \r\n83: \r\n84: KS_ARR = [_ssign(i) * K_ARR[i] for i in range(N)]\r\n85: \r\n86: \r\n87: def sample(t):\r\n88:     \"\"\"t -> (位置, 航向[rad, CCW from +X], 速度 m/s, 有符号曲率)\"\"\"\r\n89:     t = max(0.0, min(LAP_S - 1e-6, t))\r\n90:     lo, hi = 0, N - 1\r\n91:     while hi - lo > 1:\r\n92:         m = (lo + hi) // 2\r\n93:         if T_ARR[m] <= t:\r\n94:             lo = m\r\n95:         else:\r\n96:             hi = m\r\n97:     span = max(T_ARR[lo + 1] - T_ARR[lo], 1e-9)\r\n98:     f = (t - T_ARR[lo]) / span\r\n99:     pos = RX_ARR[lo].lerp(RX_ARR[lo + 1], f)\r\n100:     a = radians(HD_ARR[lo])\r\n101:     b = radians(HD_ARR[lo + 1])\r\n102:     d = (b - a + pi) % (2 * pi) - pi\r\n103:     return pos, a + d * f, V_ARR[lo] + (V_ARR[lo + 1] - V_ARR[lo]) * f, \\\r\n104:         KS_ARR[lo] + (KS_ARR[lo + 1] - KS_ARR[lo]) * f\r\n105: \r\n106: \r\n107: # ---------------------------------------------------------------\r\n108: # 1. 每帧姿态\r\n109: # ---------------------------------------------------------------\r\n110: frame_data = {}\r\n111: dist = 0.0\r\n112: prev_pos = None\r\n113: for f in range(1, FRAME_END + 1):\r\n114:     t = (f - 1) * DT\r\n115:     pos, h, v, k = sample(t)\r\n116:     if prev_pos is not None:\r\n117:         dist += (pos - prev_pos).length\r\n118:     prev_pos = pos\r\n119:     fwd = Vector((cos(h), sin(h), 0.0))\r\n120:     right = Vector((sin(h), -cos(h), 0.0))\r\n121:     frame_data[f] = dict(t=t, pos=pos, heading=h, v=v, k=k, dist=dist, fwd=fwd, right=right)\r\n122: \r\n123: # 纵向加速度 / 横向加速度\r\n124: for f in range(1, FRAME_END + 1):\r\n125:     f0 = max(1, f - 2)\r\n126:     f1 = min(FRAME_END, f + 2)\r\n127:     dv = frame_data[f1]['v'] - frame_data[f0]['v']\r\n128:     accel = dv / ((f1 - f0) * DT)\r\n129:     v = frame_data[f]['v']\r\n130:     k = frame_data[f]['k']\r\n131:     frame_data[f]['accel'] = accel\r\n132:     frame_data[f]['lat'] = v * v * abs(k) / 9.81          # g\r\n133:     frame_data[f]['gear'] = min(8, max(1, int((v * 3.6 - 60) / 40.0) + 1))\r\n134: \r\n135: # ---------------------------------------------------------------\r\n136: # 2. 打开场景\r\n137: # ---------------------------------------------------------------\r\n138: bpy.ops.wm.open_mainfile(filepath=IN)\r\n139: scene = bpy.context.scene\r\n140: rig = bpy.data.objects[\"RIG_F1_Race\"]\r\n141: \r\n142: # 发车灯常暗（这圈是飞驰圈，不是发车）\r\n143: _sl = bpy.data.materials.get(\"V5_StartLight\")\r\n144: if _sl:\r\n145:     for n in _sl.node_tree.nodes:\r\n146:         if n.type == 'BSDF_PRINCIPLED' and 'Emission Strength' in n.inputs:\r\n147:             n.inputs['Emission Strength'].default_value = 0.0\r\n148: \r\n149: bone_root = rig.pose.bones[\"Bone_Root\"]\r\n150: bone_heading = rig.pose.bones[\"Bone_Heading\"]\r\n151: bone_body = rig.pose.bones[\"Bone_Body\"]\r\n152: \r\n153: # 尾部雨灯（刹车时增亮）\r\n154: brake_light = None\r\n155: _rl = bpy.data.objects.get(\"GEO_F1_FIA_RainLight\")\r\n156: if _rl and _rl.data.materials:\r\n157:     _m = _rl.data.materials[0]\r\n158:     if _m and _m.node_tree:\r\n159:         for _n in _m.node_tree.nodes:\r\n160:             if _n.type == 'BSDF_PRINCIPLED' and 'Emission Strength' in _n.inputs:\r\n161:                 brake_light = _n\r\n162:                 break\r\n163:             if _n.type == 'EMISSION':\r\n164:                 brake_light = _n\r\n165:                 break\r\n166: \r\n167: # 随车柔光\r\n168: # 随车三点补光：左前冷光 / 右前暖光 / 后方轮廓光\r\n169: _FILL = [\r\n170:     dict(ahead=5.5, side=-6.0, up=4.0, energy=260.0, size=18.0, color=(0.60, 0.74, 1.0)),\r\n171:     dict(ahead=5.5, side=6.0, up=4.0, energy=260.0, size=18.0, color=(1.0, 0.90, 0.78)),\r\n172:     dict(ahead=-7.0, side=2.4, up=2.4, energy=320.0, size=10.0, color=(0.85, 0.92, 1.0)),\r\n173: ]\r\n174: # 只照车的补光：用 light linking 把地面/环境排除在接收端之外\r\n175: _car_coll = bpy.data.collections.new(\"V5_CarLightReceivers\")\r\n176: for _ob in bpy.data.objects:\r\n177:     if _ob.type == 'MESH' and not _ob.name.startswith((\"V5_\", \"GEO_\")):\r\n178:         _car_coll.objects.link(_ob)\r\n179: \r\n180: fill_lights = []\r\n181: for i, spec in enumerate(_FILL):\r\n182:     fd_l = bpy.data.lights.new(f\"LGT_V5Car_{i}\", 'AREA')\r\n183:     fd_l.energy = spec['energy']\r\n184:     fd_l.size = spec['size']\r\n185:     fd_l.color = spec['color']\r\n186:     fo = bpy.data.objects.new(f\"LGT_V5Car_{i}\", fd_l)\r\n187:     scene.collection.objects.link(fo)\r\n188:     try:\r\n189:         fo.light_linking.receiver_collection = _car_coll\r\n190:         fo.light_linking.link_state = 'INCLUDE'\r\n191:     except Exception as _e:\r\n192:         print(\"light linking unavailable:\", _e)\r\n193:     fill_lights.append((fo, spec))\r\n194: \r\n195: # ---------------------------------------------------------------\r\n196: # 3. 逐帧烘焙\r\n197: # ---------------------------------------------------------------\r\n198: cum_spin = 0.0\r\n199: prev_dist = 0.0\r\n200: prev_gear = 1\r\n201: shift_flash = 0.0\r\n202: \r\n203: print(\"BAKE START: %d frames, dt=%.5f s, lap=%.2f s\" % (FRAME_END, DT, LAP_S))\r\n204: for f in range(1, FRAME_END + 1):\r\n205:     fd = frame_data[f]\r\n206:     v, acc, lat, k = fd['v'], fd['accel'], fd['lat'], fd['k']\r\n207:     v_kmh = v * 3.6\r\n208: \r\n209:     # --- 位置 / 偏航（车模型前方 = 局部 +Y → rotation_z = heading - 90°）---\r\n210:     yaw = fd['heading'] - pi / 2\r\n211:     bone_root.location = (fd['pos'].x, fd['pos'].y, 0.012)   # 轮胎落在沥青面上\r\n212:     bone_heading.rotation_euler = (0.0, 0.0, yaw)\r\n213:     bone_root.keyframe_insert(\"location\", frame=f)\r\n214:     bone_heading.keyframe_insert(\"rotation_euler\", frame=f)\r\n215: \r\n216:     # --- 车身姿态：俯仰 / 侧倾 / 升沉 ---\r\n217:     gear = fd['gear']\r\n218:     if gear != prev_gear:\r\n219:         shift_flash = 1.0\r\n220:         prev_gear = gear\r\n221:     else:\r\n222:         shift_flash *= 0.72\r\n223: \r\n224:     pitch = max(-1.9, min(1.4, acc * 0.085)) - 0.16 * shift_flash\r\n225:     roll = max(-2.2, min(2.2, -lat * 0.26))\r\n226:     heave = -0.006 + 0.0016 * sin(f * 1.31) + 0.0009 * sin(f * 2.77)\r\n227:     bone_body.location = (0.0, 0.0, heave)\r\n228:     bone_body.rotation_euler = (radians(pitch), radians(roll), 0.0)\r\n229:     bone_body.keyframe_insert(\"location\", frame=f)\r\n230:     bone_body.keyframe_insert(\"rotation_euler\", frame=f)\r\n231: \r\n232:     # --- 机械驱动 ---\r\n233:     cum_spin += (fd['dist'] - prev_dist) / R_TIRE\r\n234:     prev_dist = fd['dist']\r\n235:     rig[\"wheel_spin\"] = cum_spin\r\n236: \r\n237:     steer_deg = degrees(k * WHEELBASE)                   # 阿克曼转角\r\n238:     rig[\"steer\"] = max(-26.0, min(26.0, steer_deg))\r\n239: \r\n240:     straight = abs(k) < 0.0016\r\n241:     rig[\"drs\"] = 1.0 if (straight and v_kmh > 240) else (0.0 if abs(k) > 0.004 else 0.5)\r\n242:     rig[\"brake_heat\"] = max(0.0, min(1.3, -acc * 0.11))\r\n243:     rig[\"rear_slip\"] = 1.0\r\n244:     rig[\"susp_f\"] = -0.004 - 0.014 * max(0.0, -acc) / 12.0\r\n245:     rig[\"susp_r\"] = -0.004 - 0.016 * max(0.0, acc) / 12.0\r\n246:     for kk in (\"wheel_spin\", \"steer\", \"drs\", \"brake_heat\", \"rear_slip\", \"susp_f\", \"susp_r\"):\r\n247:         rig.keyframe_insert(f'[\"{kk}\"]', frame=f)\r\n248: \r\n249:     if brake_light and 'Strength' in brake_light.inputs:\r\n250:         brake_light.inputs['Strength'].default_value = 1.0 + rig[\"brake_heat\"] * 12.0\r\n251:         brake_light.inputs['Strength'].keyframe_insert(\"default_value\", frame=f)\r\n252: \r\n253:     # 随车柔光\r\n254:     for fo, spec in fill_lights:\r\n255:         lp = fd['pos'] + fd['fwd'] * spec['ahead'] + fd['right'] * spec['side']             + Vector((0, 0, spec['up']))\r\n256:         fo.location = lp\r\n257:         aim = (fd['pos'] + Vector((0, 0, 0.45))) - lp\r\n258:         fo.rotation_euler = aim.to_track_quat('-Z', 'Y').to_euler()\r\n259:         fo.keyframe_insert(\"location\", frame=f)\r\n260:         fo.keyframe_insert(\"rotation_euler\", frame=f)\r\n261: \r\n262: print(\"BAKE DONE\")\r\n263: \r\n264: \r\n265: def iter_fcurves(action):\r\n266:     \"\"\"Blender 5.x: Action 有 layered/slotted 结构，fcurves 在 channelbag 里\"\"\"\r\n267:     fcs = list(getattr(action, \"fcurves\", []) or [])\r\n268:     if fcs:\r\n269:         return fcs\r\n270:     for layer in getattr(action, \"layers\", []) or []:\r\n271:         for strip in getattr(layer, \"strips\", []) or []:\r\n272:             for cb in getattr(strip, \"channelbags\", []) or []:\r\n273:                 fcs.extend(cb.fcurves)\r\n274:     return fcs\r\n275: \r\n276: \r\n277: # 所有关键帧 LINEAR\r\n278: ad = rig.animation_data\r\n279: if ad and ad.action:\r\n280:     _n = 0\r\n281:     for fc in iter_fcurves(ad.action):\r\n282:         for kp in fc.keyframe_points:\r\n283:             kp.interpolation = 'LINEAR'\r\n284:             _n += 1\r\n285:     print(\"LINEAR keyframes:\", _n)\r\n286: \r\n287: # ---------------------------------------------------------------\r\n288: # 4. 物理自检（横向加速度上限 + 赛道内 + 航向连续）\r\n289: # ---------------------------------------------------------------\r\n290: VMAX = META[\"limits\"][\"v_max_mps\"]\r\n291: LIM = 15.0 + 0.00714 * VMAX ** 2\r\n292: worst = max(frame_data.values(), key=lambda d: d['v'] ** 2 * abs(d['k']))\r\n293: over = [f for f, d in frame_data.items() if d['v'] ** 2 * abs(d['k']) > LIM + 0.5]\r\n294: jumps = []\r\n295: for f in range(2, FRAME_END + 1):\r\n296:     d0, d1 = frame_data[f - 1], frame_data[f]\r\n297:     dh = abs((d1['heading'] - d0['heading'] + pi) % (2 * pi) - pi)\r\n298:     if dh > 0.12:\r\n299:         jumps.append((f, degrees(dh)))\r\n300: print(\"[check] 最坏横向 %.2f m/s^2 (%.2f g) @ frame %d, t=%.1f s\"\r\n301:       % (worst['v'] ** 2 * abs(worst['k']), worst['v'] ** 2 * abs(worst['k']) / 9.81,\r\n302:          int(round(worst['t'] / DT)) + 1, worst['t']))\r\n303: print(\"[check] 超限帧 %d -> %s\" % (len(over), \"PASS\" if not over else \"FAIL\"))\r\n304: print(\"[check] 航向跳变帧(>6.9deg) %d -> %s\" % (len(jumps), \"PASS\" if not jumps else str(jumps[:6])))\r\n305: print(\"[check] v_max %.1f km/h, lap %.2f s, 帧数 %d\" % (max(d['v'] for d in frame_data.values()) * 3.6, LAP_S, FRAME_END))\r\n306: \r\n307: # ---------------------------------------------------------------\r\n308: # 5. 机位\r\n309: # ---------------------------------------------------------------\r\n310: def make_cam(name, lens=50, fstop=4.0):\r\n311:     cd = bpy.data.cameras.new(name + \"_DATA\")\r\n312:     cd.lens = lens\r\n313:     cd.clip_start = 0.5\r\n314:     cd.clip_end = 9000\r\n315:     cd.sensor_width = 36\r\n316:     cd.dof.use_dof = True\r\n317:     cd.dof.aperture_fstop = fstop\r\n318:     cd.dof.aperture_blades = 9\r\n319:     ob = bpy.data.objects.new(name, cd)\r\n320:     scene.collection.objects.link(ob)\r\n321:     return ob\r\n322: \r\n323: \r\n324: def cam_look(ob, loc, target, roll_deg=0.0, fstop=None, lens=None):\r\n325:     loc = Vector(loc)\r\n326:     tgt = Vector(target)\r\n327:     d = tgt - loc\r\n328:     q = d.to_track_quat('-Z', 'Y')\r\n329:     m = q.to_matrix().to_4x4()\r\n330:     if abs(roll_deg) > 1e-6:\r\n331:         m = m @ Matrix.Rotation(radians(roll_deg), 4, 'Z')\r\n332:     ob.matrix_world = Matrix.Translation(loc) @ m\r\n333:     if fstop is not None:\r\n334:         ob.data.dof.aperture_fstop = fstop\r\n335:         ob.data.dof.focus_distance = d.length\r\n336:     if lens is not None:\r\n337:         ob.data.lens = lens\r\n338: \r\n339: \r\n340: def noise(t, seed=0.0, amp=1.0):\r\n341:     return (sin(t * 2.3 + seed) * 0.55 + sin(t * 5.7 + seed * 2.3) * 0.3\r\n342:             + sin(t * 11.3 + seed * 4.1) * 0.15) * amp\r\n343: \r\n344: \r\n345: def smooth(t):\r\n346:     t = max(0.0, min(1.0, t))\r\n347:     return t * t * (3 - 2 * t)\r\n348: \r\n349: \r\n350: def key_cam(cam, f, loc, tgt, roll=0.0, fstop=4.0, lens=50, lens_key=True):\r\n351:     cam_look(cam, loc, tgt, roll_deg=roll, fstop=fstop, lens=lens)\r\n352:     cam.keyframe_insert(\"location\", frame=f)\r\n353:     cam.keyframe_insert(\"rotation_euler\", frame=f)\r\n354:     cam.data.dof.keyframe_insert(\"focus_distance\", frame=f)\r\n355:     cam.data.dof.keyframe_insert(\"aperture_fstop\", frame=f)\r\n356:     if lens_key:\r\n357:         cam.data.keyframe_insert(\"lens\", frame=f)\r\n358: \r\n359: \r\n360: def F(beat):\r\n361:     return 1 + int(round(beat * BEAT_F))\r\n362: \r\n363: \r\n364: # 车体坐标系里的机位\r\n365: def C(fd, back=0.0, side=0.0, h=0.5):\r\n366:     return fd['pos'] - fd['fwd'] * back + fd['right'] * side + Vector((0, 0, h))\r\n367: \r\n368: \r\n369: def T(fd, ahead=0.0, side=0.0, h=0.45):\r\n370:     return fd['pos'] + fd['fwd'] * ahead + fd['right'] * side + Vector((0, 0, h))\r\n371: \r\n372: \r\n373: def fixed_point(f, back=0.0, side=0.0, h=0.5):\r\n374:     \"\"\"以某帧车体为参考，固定在世界的机位\"\"\"\r\n375:     fd = frame_data[f]\r\n376:     return C(fd, back, side, h)\r\n377: \r\n378: \r\n379: CAR_LEN = 4.7          # 定焦用：让车在画面里的宽度占比稳定（侧面投影 = 车长）\r\n380: CAR_W = 2.2            # 正面投影 = 车宽\r\n381: SENSOR_W = 36.0\r\n382: \r\n383: \r\n384: def lens_for_framing(dist, frac, cos_a=0.0):\r\n385:     \"\"\"cos_a: 1=正对车头/车尾, 0=正侧面。按投影宽度算焦距\"\"\"\r\n386:     w_eff = CAR_W + (CAR_LEN - CAR_W) * (1.0 - abs(cos_a))\r\n387:     return max(20.0, min(320.0, frac * SENSOR_W * max(dist, 1.0) / max(w_eff, 0.5)))\r\n388: \r\n389: \r\n390: SHOTS = [\r\n391:     # (名字, t0, t1, 类型, 参数)  —— t 为赛道时间（秒），切点吸附 108 BPM 拍点\r\n392:     (\"Cam_S01_RearChase\", 0.0, 4.6, \"chase\",\r\n393:      dict(back0=8.0, back1=11.5, side0=1.1, side1=-1.1, h0=0.45, h1=1.15,\r\n394:           aim0=2.4, aim1=3.6, lens0=38, lens1=31, fstop=4.0, roll1=1.5)),\r\n395:     (\"Cam_S02_Onboard\", 4.6, 8.4, \"onboard\", dict(fwd=2.55, h=0.50, lens=17, fstop=5.6)),\r\n396:     (\"Cam_S03_ChaseRise\", 8.4, 12.4, \"chase\",\r\n397:      dict(back0=8.8, back1=6.9, side0=-1.2, side1=3.2, h0=1.30, h1=4.20,\r\n398:           aim0=4.4, aim1=3.0, lens0=30, lens1=29, fstop=4.0, roll1=4.0)),\r\n399:     (\"Cam_S04_Hairpin\", 12.4, 16.6, \"fixed\",\r\n400:      dict(t_pass=16.00, lead=-14.0, side=-8.6, h=0.80,\r\n401:           framing=0.34, fstop=5.0, aim_lerp=0.66, roll=-1.5)),\r\n402:     (\"Cam_S05_ChaseAintree\", 16.6, 20.0, \"chase\",\r\n403:      dict(back0=7.2, back1=9.0, side0=0.6, side1=-1.2, h0=0.60, h1=1.05,\r\n404:           aim0=3.0, aim1=4.0, lens0=36, lens1=32, fstop=4.0, roll1=-1.5)),\r\n405:     (\"Cam_S06_Orbit1\", 20.0, 23.4, \"orbit\",\r\n406:      dict(a0=104, a1=52, r0=10.5, r1=8.0, h0=1.35, h1=1.05,\r\n407:           lens=44, fstop=3.6, roll=-5.0, roll_end=4.0)),\r\n408:     (\"Cam_S07_ChaseAccel\", 23.4, 26.6, \"chase\",\r\n409:      dict(back0=9.4, back1=7.8, side0=-1.0, side1=1.2, h0=0.80, h1=0.55,\r\n410:           aim0=4.4, aim1=3.6, lens0=32, lens1=34, fstop=4.0, roll1=1.0)),\r\n411:     (\"Cam_S08_FastPan\", 26.6, 30.6, \"fixed\",\r\n412:      dict(t_pass=29.50, lead=0.0, side=14.0, h=0.85,\r\n413:           framing=0.26, fstop=5.6, aim_lerp=0.74, roll=-2.0)),\r\n414:     (\"Cam_S09_WheelMacro\", 30.6, 32.8, \"wheel\",\r\n415:      dict(side0=4.20, side1=3.90, back0=-1.20, back1=-0.45, h0=0.48, h1=0.62,\r\n416:           lens0=34, lens1=30, fstop=3.2)),\r\n417:     (\"Cam_S09b_ChaseFast\", 32.8, 35.2, \"chase\",\r\n418:      dict(back0=6.4, back1=8.2, side0=-1.4, side1=1.0, h0=0.50, h1=0.85,\r\n419:           aim0=3.6, aim1=4.6, lens0=30, lens1=27, fstop=3.0, roll1=2.2)),\r\n420:     (\"Cam_S10_OrbitBrooklands\", 34.0, 37.4, \"orbit\",\r\n421:      dict(a0=98, a1=44, r0=9.2, r1=7.0, h0=1.15, h1=0.95,\r\n422:           lens=42, fstop=3.4, roll=3.0, roll_end=-2.5)),\r\n423:     (\"Cam_S11_Luffield\", 37.4, 41.8, \"fixed\",\r\n424:      dict(t_pass=41.40, lead=-9.0, side=10.5, h=1.0,\r\n425:           framing=0.32, fstop=4.5, aim_lerp=0.66, roll=1.2)),\r\n426:     (\"Cam_S12_ChaseWoodcote\", 41.8, 45.0, \"chase\",\r\n427:      dict(back0=7.6, back1=9.4, side0=-0.8, side1=1.4, h0=0.75, h1=1.35,\r\n428:           aim0=3.4, aim1=4.4, lens0=34, lens1=30, fstop=4.0, roll1=2.0)),\r\n429:     (\"Cam_S13_WoodcoteTele\", 45.0, 48.4, \"fixed\",\r\n430:      dict(t_pass=47.40, lead=-95.0, side=12.0, h=2.4,\r\n431:           framing=0.24, fstop=8.0, aim_lerp=0.55, roll=0.0)),\r\n432:     (\"Cam_S14_HeliDrop\", 48.4, 52.0, \"heli\", dict(h0=30.0, h1=12.0, back=24.0, lens=85, fstop=7.0)),\r\n433:     (\"Cam_S15_OrbitCopse\", 52.0, 55.6, \"orbit\",\r\n434:      dict(a0=108, a1=48, r0=11.0, r1=7.8, h0=1.5, h1=1.05,\r\n435:           lens=40, fstop=3.4, roll=-6.0, roll_end=3.0)),\r\n436:     (\"Cam_S16_ChaseCopse\", 55.6, 59.2, \"chase\",\r\n437:      dict(back0=7.0, back1=8.4, side0=0.5, side1=-1.1, h0=0.55, h1=1.05,\r\n438:           aim0=3.4, aim1=4.4, lens0=36, lens1=32, fstop=4.0, roll1=-2.0)),\r\n439:     (\"Cam_S17_Maggotts\", 59.2, 63.2, \"fixed\",\r\n440:      dict(t_pass=62.50, lead=2.0, side=11.5, h=1.35,\r\n441:           framing=0.28, fstop=4.5, aim_lerp=0.66, roll=-1.0)),\r\n442:     (\"Cam_S18_ChaseRise2\", 63.2, 66.8, \"chase\",\r\n443:      dict(back0=9.0, back1=6.6, side0=-1.4, side1=3.8, h0=1.30, h1=4.6,\r\n444:           aim0=4.6, aim1=2.8, lens0=30, lens1=28, fstop=4.0, roll1=5.0)),\r\n445:     (\"Cam_S19_Onboard3\", 66.8, 70.4, \"onboard\", dict(fwd=2.48, h=0.48, lens=20, fstop=5.6)),\r\n446:     (\"Cam_S20_StoweTele\", 70.4, 74.8, \"fixed\",\r\n447:      dict(t_pass=74.60, lead=-130.0, side=-13.0, h=2.8,\r\n448:           framing=0.22, fstop=8.0, aim_lerp=0.55, roll=0.0)),\r\n449:     (\"Cam_S21_OrbitStowe\", 74.8, 78.4, \"orbit\",\r\n450:      dict(a0=112, a1=50, r0=11.5, r1=8.0, h0=1.6, h1=1.1,\r\n451:           lens=38, fstop=3.4, roll=5.0, roll_end=-3.0)),\r\n452:     (\"Cam_S22_ChaseLow\", 78.4, 82.0, \"chase\",\r\n453:      dict(back0=6.6, back1=9.6, side0=1.1, side1=-1.5, h0=0.52, h1=1.45,\r\n454:           aim0=3.0, aim1=4.4, lens0=38, lens1=31, fstop=3.2, roll1=-3.0)),\r\n455:     (\"Cam_S23_HeliReveal\", 82.0, 85.6, \"heli\", dict(h0=22.0, h1=44.0, back=32.0, lens=70, fstop=8.0)),\r\n456:     (\"Cam_S24_Club\", 85.6, 88.4, \"fixed\",\r\n457:      dict(t_pass=87.30, lead=-8.0, side=-9.0, h=1.2,\r\n458:           framing=0.30, fstop=4.5, aim_lerp=0.66, roll=-1.0)),\r\n459:     (\"Cam_S25_AerialOut\", 88.4, 90.34, \"aerial\",\r\n460:      dict(back0=9.0, back1=17.0, side0=2.5, side1=9.0, h0=3.0, h1=11.0,\r\n461:           lens0=56, lens1=46, fstop=4.5)),\r\n462: ]\r\n463: \r\n464: \r\n465: def TF(t):\r\n466:     \"\"\"赛道时间 -> 帧号，吸附到最近拍点\"\"\"\r\n467:     f = 1.0 + t / DT\r\n468:     k = round((f - 1) / BEAT_F)\r\n469:     return max(1, min(FRAME_END, int(round(1 + k * BEAT_F))))\r\n470: \r\n471: \r\n472: _windows = []\r\n473: for name, t0, t1, typ, pr in SHOTS:\r\n474:     _windows.append([name, TF(t0), TF(t1), typ, pr])\r\n475: \r\n476: # 顺序修正：严格递增、不许为负长度\r\n477: for i in range(len(_windows)):\r\n478:     _windows[i][1] = max(_windows[i][1], 1)\r\n479:     _windows[i][2] = min(FRAME_END, max(_windows[i][2], _windows[i][1] + 2))\r\n480:     if i and _windows[i][1] <= _windows[i - 1][2]:\r\n481:         _windows[i][1] = _windows[i - 1][2] + 1\r\n482:         _windows[i][2] = max(_windows[i][2], _windows[i][1] + 2)\r\n483: _windows[-1][2] = FRAME_END\r\n484: \r\n485: _cams = {}\r\n486: _markers = []\r\n487: for name, f0, f1, typ, pr in _windows:\r\n488:     cam = make_cam(name, pr.get('lens', pr.get('lens0', 50)), pr.get('fstop', 4.0))\r\n489:     _cams[name] = cam\r\n490:     _markers.append((name, f0))\r\n491:     span = max(1, f1 - f0)\r\n492: \r\n493:     if typ == \"chase\":\r\n494:         for f in range(f0, f1 + 1):\r\n495:             e = smooth((f - f0) / span)\r\n496:             fd = frame_data[f]\r\n497:             loc = C(fd, pr['back0'] + (pr['back1'] - pr['back0']) * e,\r\n498:                     pr['side0'] + (pr['side1'] - pr['side0']) * e,\r\n499:                     pr['h0'] + (pr['h1'] - pr['h0']) * e)\r\n500:             loc += Vector((noise(f * 0.06, 11.0, 0.026), noise(f * 0.06, 12.0, 0.026),\r\n501:                            noise(f * 0.09, 13.0, 0.018)))\r\n502:             tgt = T(fd, pr['aim0'] + (pr['aim1'] - pr['aim0']) * e, 0, 0.52)\r\n503:             key_cam(cam, f, loc, tgt,\r\n504:                     roll=pr.get('roll0', 0.0) + (pr.get('roll1', 0.0) - pr.get('roll0', 0.0)) * e\r\n505:                     + noise(f * 0.05, 14.0, 0.5),\r\n506:                     fstop=pr['fstop'],\r\n507:                     lens=pr['lens0'] + (pr['lens1'] - pr['lens0']) * e)\r\n508: \r\n509:     elif typ == \"fixed\":\r\n510:         fr = max(f0, min(f1, int(round(1 + pr['t_pass'] / DT))))\r\n511:         loc = C(frame_data[fr], pr['lead'], pr['side'], pr['h'])\r\n512:         aim = None\r\n513:         for f in range(f0, f1 + 1):\r\n514:             fd = frame_data[f]\r\n515:             tgt = fd['pos'] + Vector((0, 0, 0.34))\r\n516:             aim = tgt if aim is None else aim.lerp(tgt, pr.get('aim_lerp', 0.7))\r\n517:             dv = loc - fd['pos']\r\n518:             d = max(2.0, dv.length)\r\n519:             cos_a = abs(fd['fwd'].dot(dv.normalized()))\r\n520:             key_cam(cam, f, loc, aim, roll=pr.get('roll', 0.0), fstop=pr['fstop'],\r\n521:                     lens=lens_for_framing(d, pr['framing'], cos_a), lens_key=True)\r\n522: \r\n523:     elif typ == \"wheel\":\r\n524:         for f in range(f0, f1 + 1):\r\n525:             e = smooth((f - f0) / span)\r\n526:             fd = frame_data[f]\r\n527:             loc = C(fd, pr['back0'] + (pr['back1'] - pr['back0']) * e,\r\n528:                     pr['side0'] + (pr['side1'] - pr['side0']) * e,\r\n529:                     pr['h0'] + (pr['h1'] - pr['h0']) * e)\r\n530:             loc += Vector((noise(f * 0.17, 81.0, 0.010), noise(f * 0.17, 82.0, 0.010),\r\n531:                            noise(f * 0.21, 83.0, 0.007)))\r\n532:             tgt = fd['pos'] + fd['right'] * 0.72 + fd['fwd'] * (1.35 - 0.5 * e) + Vector((0, 0, 0.34))\r\n533:             key_cam(cam, f, loc, tgt, roll=1.2 - 2.4 * e, fstop=pr['fstop'],\r\n534:                     lens=pr['lens0'] + (pr['lens1'] - pr['lens0']) * e)\r\n535: \r\n536:     elif typ == \"onboard\":\r\n537:         for f in range(f0, f1 + 1):\r\n538:             fd = frame_data[f]\r\n539:             vib = 0.005 + 0.004 * (fd['v'] / 90.0)\r\n540:             loc = fd['pos'] + fd['fwd'] * pr['fwd'] + Vector((0, 0, pr['h']))\r\n541:             loc += Vector((noise(f * 0.95, 31.0, vib), noise(f * 0.95, 32.0, vib),\r\n542:                            noise(f * 1.15, 33.0, vib * 0.6)))\r\n543:             tgt = loc + fd['fwd'] * 22.0 + Vector((0, 0, -0.34))\r\n544:             key_cam(cam, f, loc, tgt, roll=noise(f * 0.3, 34.0, 0.8), fstop=pr['fstop'],\r\n545:                     lens=pr['lens'], lens_key=False)\r\n546: \r\n547:     elif typ == \"orbit\":\r\n548:         for f in range(f0, f1 + 1):\r\n549:             e = smooth((f - f0) / span)\r\n550:             fd = frame_data[f]\r\n551:             ang = radians(pr['a0'] + (pr['a1'] - pr['a0']) * e)\r\n552:             rad = pr['r0'] + (pr['r1'] - pr['r0']) * e\r\n553:             ox = fd['fwd'].x * cos(ang) - fd['right'].x * sin(ang)\r\n554:             oy = fd['fwd'].y * cos(ang) - fd['right'].y * sin(ang)\r\n555:             loc = fd['pos'] + Vector((ox, oy, 0)) * rad + Vector(\r\n556:                 (0, 0, pr['h0'] + (pr['h1'] - pr['h0']) * e))\r\n557:             loc += Vector((noise(f * 0.07, 51.0, 0.035), noise(f * 0.07, 52.0, 0.035),\r\n558:                            noise(f * 0.09, 53.0, 0.018)))\r\n559:             tgt = fd['pos'] + Vector((0, 0, 0.42))\r\n560:             key_cam(cam, f, loc, tgt, roll=pr['roll'] + (pr['roll_end'] - pr['roll']) * e,\r\n561:                     fstop=pr['fstop'], lens=pr['lens'], lens_key=False)\r\n562: \r\n563:     elif typ == \"heli\":\r\n564:         for f in range(f0, f1 + 1):\r\n565:             e = smooth((f - f0) / span)\r\n566:             fd = frame_data[f]\r\n567:             loc = C(fd, pr['back'], 0.0, pr['h0'] + (pr['h1'] - pr['h0']) * e)\r\n568:             loc += Vector((noise(f * 0.03, 71.0, 0.09), noise(f * 0.03, 72.0, 0.09), 0))\r\n569:             tgt = fd['pos'] + fd['fwd'] * 2.0 + Vector((0, 0, 0.6))\r\n570:             key_cam(cam, f, loc, tgt, roll=noise(f * 0.02, 73.0, 1.1), fstop=pr['fstop'],\r\n571:                     lens=pr['lens'], lens_key=False)\r\n572: \r\n573:     elif typ == \"aerial\":\r\n574:         for f in range(f0, f1 + 1):\r\n575:             e = smooth((f - f0) / span)\r\n576:             fd = frame_data[f]\r\n577:             loc = C(fd, pr['back0'] + (pr['back1'] - pr['back0']) * e,\r\n578:                     pr['side0'] + (pr['side1'] - pr['side0']) * e,\r\n579:                     pr['h0'] + (pr['h1'] - pr['h0']) * e)\r\n580:             loc += Vector((noise(f * 0.04, 91.0, 0.03 * (1 - e)), noise(f * 0.04, 92.0, 0.03 * (1 - e)),\r\n581:                          