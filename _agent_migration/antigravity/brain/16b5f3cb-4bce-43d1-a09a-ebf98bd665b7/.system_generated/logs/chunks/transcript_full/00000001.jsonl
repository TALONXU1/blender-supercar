1020: _lv, _lf = [], []\r\n1021: for i in range(12):\r\n1022:     sp = LAP_LEN * i / 12.0\r\n1023:     p, h, r, k = at_s(sp)\r\n1024:     side = 1 if i % 2 == 0 else -1\r\n1025:     o = side * (HALF_W + 42.0)\r\n1026:     px, py = p.x + r.x * o, p.y + r.y * o\r\n1027:     base = len(_lv)\r\n1028:     _lv += [(px - 0.12, py - 0.12, 0), (px + 0.12, py - 0.12, 0), (px + 0.12, py + 0.12, 0),\r\n1029:             (px - 0.12, py + 0.12, 0), (px - 0.12, py - 0.12, 16), (px + 0.12, py - 0.12, 16),\r\n1030:             (px + 0.12, py + 0.12, 16), (px - 0.12, py + 0.12, 16)]\r\n1031:     _lf += [(0, 1, 5, 4), (1, 2, 6, 5), (2, 3, 7, 6), (3, 0, 4, 7)]\r\n1032:     # 灯头\r\n1033:     hb = len(_lv)\r\n1034:     _lv += [(px - 0.9, py - 0.25, 15.6), (px + 0.9, py - 0.25, 15.6),\r\n1035:             (px + 0.9, py + 0.25, 15.6), (px - 0.9, py + 0.25, 15.6)]\r\n1036:     _lf += [(hb, hb + 1, hb + 2, hb + 3)]\r\n1037: mesh_from(\"V5_FieldMasts\", _lv, _lf, M_STEEL, up=False)\r\n1038: \r\n1039: print(\"ENV BUILD DONE\")\r\n1040: print(\"objects:\", len(bpy.data.objects), \"materials:\", len(bpy.data.materials))\r\n1041: \r\n1042: \r\n1043: # ---------------------------------------------------------------\r\n1044: # 13. 工程整理：原点归位 + 集合分组（让场景在 Blender 里能手工编辑）\r\n1045: # ---------------------------------------------------------------\r\n1046: _GROUPS = {\r\n1047:     \"V5_01_Road\": (\"V5_Track\", \"V5_RacingLine\", \"V5_Line_\", \"V5_Kerb_\",\r\n1048:                    \"V5_StartLine\", \"V5_PitLane\", \"V5_PitLine\", \"V5_PitBoxLine\"),\r\n1049:     \"V5_02_Terrain\": (\"V5_Ground\", \"V5_Verge_\", \"V5_Gravel_\", \"V5_HedgeRing\", \"V5_SkyDome\"),\r\n1050:     \"V5_03_Barriers\": (\"V5_Barrier\", \"V5_FencePosts\"),\r\n1051:     \"V5_04_Stands\": (\"V5_Stand_\", \"V5_Flag_\"),\r\n1052:     \"V5_05_Pit\": (\"V5_PitWall\", \"V5_PitGarage\", \"V5_PitRoof\", \"V5_PitTop\"),\r\n1053:     \"V5_06_Props\": (\"V5_Ad_\", \"V5_Brake_\", \"V5_Screen_\", \"V5_Bridge_\",\r\n1054:                     \"V5_Marshal_\", \"V5_FieldMasts\", \"V5_Hangar_\",\r\n1055:                     \"V5_Gantry\", \"V5_StartLight\"),\r\n1056:     \"V5_07_Lighting\": (\"LGT_V5\",),\r\n1057: }\r\n1058: \r\n1059: _moved = 0\r\n1060: for _ob in list(bpy.data.objects):\r\n1061:     if _ob.type != 'MESH' or not _ob.name.startswith((\"V5_\", \"GEO_Race\")):\r\n1062:         continue\r\n1063:     if not _ob.data.vertices:\r\n1064:         continue\r\n1065:     _bb = [_ob.matrix_world @ Vector(c) for c in _ob.bound_box]\r\n1066:     _c = Vector((sum(v.x for v in _bb) / 8.0, sum(v.y for v in _bb) / 8.0, sum(v.z for v in _bb) / 8.0))\r\n1067:     _lc = _ob.matrix_world.inverted() @ _c\r\n1068:     for _v in _ob.data.vertices:\r\n1069:         _v.co -= _lc\r\n1070:     _ob.location = _c\r\n1071:     _ob.data.update()\r\n1072:     _moved += 1\r\n1073: \r\n1074: _root = scene.collection\r\n1075: _cols = {}\r\n1076: for _g in _GROUPS:\r\n1077:     _cc = bpy.data.collections.get(_g) or bpy.data.collections.new(_g)\r\n1078:     if _cc.name not in _root.children:\r\n1079:         _root.children.link(_cc)\r\n1080:     _cols[_g] = _cc\r\n1081: \r\n1082: \r\n1083: def _bucket(nm):\r\n1084:     for _g, _ps in _GROUPS.items():\r\n1085:         for _p in _ps:\r\n1086:             if nm.startswith(_p):\r\n1087:                 return _g\r\n1088:     return None\r\n1089: \r\n1090: \r\n1091: _reg = 0\r\n1092: for _ob in list(bpy.data.objects):\r\n1093:     _g = _bucket(_ob.name)\r\n1094:     if not _g:\r\n1095:         continue\r\n1096:     for _c in list(_ob.users_collection):\r\n1097:         _c.objects.unlink(_ob)\r\n1098:     _cols[_g].objects.link(_ob)\r\n1099:     _reg += 1\r\n1100: print(\"organize: origin_to_geometry=%d  regrouped=%d\" % (_moved, _reg))\r\n1101: \r\n1102: bpy.ops.wm.save_as_mainfile(filepath=OUT)\r\n1103: print(\"ENV SAVED:\", OUT)\r"}
