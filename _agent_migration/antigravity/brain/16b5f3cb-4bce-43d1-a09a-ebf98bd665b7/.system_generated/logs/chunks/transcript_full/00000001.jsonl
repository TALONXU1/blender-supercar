ks.new(_tc.outputs['Object'], _n2.inputs['Vector'])\r\n232: _am.links.new(_n2.outputs['Fac'], _mix.inputs['Fac'])\r\n233: _am.links.new(_mix.outputs['Color'], _ab.inputs['Base Color'])\r\n234: \r\n235: # 所有路面相关材质压掉镜面（防低角度太阳反光）\r\n236: for _mn in (\"V5_RubberLine\", \"V5_WhiteLine\", \"V5_CurbRed\", \"V5_CurbWhite\", \"V5_Gravel\"):\r\n237:     _mm = bpy.data.materials.get(_mn)\r\n238:     if _mm and _mm.node_tree:\r\n239:         _bb = _bsdf(_mm)\r\n240:         if _bb and 'Specular IOR Level' in _bb.inputs:\r\n241:             _bb.inputs['Specular IOR Level'].default_value = 0.03\r\n242: \r\n243: # 草地：噪波色差\r\n244: _gm = M_GRASS.node_tree\r\n245: _gb = _bsdf(_gm)\r\n246: _gb.inputs['Specular IOR Level'].default_value = 0.15\r\n247: _gtc = _gm.nodes.new('ShaderNodeTexCoord')\r\n248: _gn = _gm.nodes.new('ShaderNodeTexNoise')\r\n249: _gn.inputs['Scale'].default_value = 2.2\r\n250: _gn.inputs['Detail'].default_value = 9.0\r\n251: _gmix = _gm.nodes.new('ShaderNodeMixRGB')\r\n252: _gmix.inputs['Color1'].default_value = (0.036, 0.056, 0.024, 1)\r\n253: _gmix.inputs['Color2'].default_value = (0.062, 0.086, 0.036, 1)\r\n254: _gmix.inputs['Fac'].default_value = 0.5\r\n255: _gm.links.new(_gtc.outputs['Object'], _gn.inputs['Vector'])\r\n256: _gm.links.new(_gn.outputs['Fac'], _gmix.inputs['Fac'])\r\n257: # 割草条纹（机场草坪特征）：沿世界 X 的方波，8 m 一条\r\n258: _gtc2 = _gm.nodes.new('ShaderNodeTexCoord')\r\n259: _gsep = _gm.nodes.new('ShaderNodeSeparateXYZ')\r\n260: _gm.links.new(_gtc2.outputs['Object'], _gsep.inputs['Vector'])\r\n261: _gmul = _gm.nodes.new('ShaderNodeMath')\r\n262: _gmul.operation = 'MULTIPLY'\r\n263: _gmul.inputs[1].default_value = 6.28318 / 16.0\r\n264: _gm.links.new(_gsep.outputs['X'], _gmul.inputs[0])\r\n265: _gsin = _gm.nodes.new('ShaderNodeMath')\r\n266: _gsin.operation = 'SINE'\r\n267: _gm.links.new(_gmul.outputs['Value'], _gsin.inputs[0])\r\n268: _gstripe = _gm.nodes.new('ShaderNodeMath')\r\n269: _gstripe.operation = 'MULTIPLY'\r\n270: _gstripe.inputs[1].default_value = 0.55\r\n271: _gm.links.new(_gsin.outputs['Value'], _gstripe.inputs[0])\r\n272: _gadd = _gm.nodes.new('ShaderNodeMath')\r\n273: _gadd.operation = 'ADD'\r\n274: _gadd.inputs[1].default_value = 1.0\r\n275: _gm.links.new(_gstripe.outputs['Value'], _gadd.inputs[0])\r\n276: _gmul2 = _gm.nodes.new('ShaderNodeMixRGB')\r\n277: _gmul2.blend_type = 'MULTIPLY'\r\n278: _gmul2.inputs['Fac'].default_value = 1.0\r\n279: _gm.links.new(_gmix.outputs['Color'], _gmul2.inputs['Color1'])\r\n280: _gm.links.new(_gadd.outputs['Value'], _gmul2.inputs['Color2'])\r\n281: _gm.links.new(_gmul2.outputs['Color'], _gb.inputs['Base Color'])\r\n282: _gbump = _gm.nodes.new('ShaderNodeBump')\r\n283: _gbump.inputs['Strength'].default_value = 0.25\r\n284: _gm.links.new(_gn.outputs['Fac'], _gbump.inputs['Height'])\r\n285: _gm.links.new(_gbump.outputs['Normal'], _gb.inputs['Normal'])\r\n286: \r\n287: # 看台人群贴图\r\n288: _crowd_img = None\r\n289: _p = os.path.join(TEX, \"crowd_silverstone.png\")\r\n290: if os.path.exists(_p):\r\n291:     _crowd_img = bpy.data.images.load(_p, check_existing=True)\r\n292:     _cm = M_CROWD.node_tree\r\n293:     _cb = _bsdf(_cm)\r\n294:     _ctex = _cm.nodes.new('ShaderNodeTexImage')\r\n295:     _ctex.image = _crowd_img\r\n296:     _ctex.extension = 'REPEAT'\r\n297:     _cm.links.new(_ctex.outputs['Color'], _cb.inputs['Base Color'])\r\n298:     _cm.links.new(_ctex.outputs['Color'], _cb.inputs['Emission Color'])\r\n299:     _cb.inputs['Emission Strength'].default_value = 0.55\r\n300: \r\n301: \r\n302: # ---------------------------------------------------------------\r\n303: # 2b. 贴图材质（维修区 / 广告板 / 刹车牌 / 大屏）\r\n304: # ---------------------------------------------------------------\r\n305: def tex_mat(name, img_file, emission=0.0, spec=0.0, rough=0.7):\r\n306:     m = bpy.data.materials.get(name) or bpy.data.materials.new(name)\r\n307:     m.use_nodes = True\r\n308:     nt = m.node_tree\r\n309:     nt.nodes.clear()\r\n310:     b = nt.nodes.new(\"ShaderNodeBsdfPrincipled\")\r\n311:     b.inputs['Specular IOR Level'].default_value = spec\r\n312:     b.inputs['Roughness'].default_value = rough\r\n313:     tex = nt.nodes.new('ShaderNodeTexImage')\r\n314:     img = bpy.data.images.load(os.path.join(TEX, img_file), check_existing=True)\r\n315:     tex.image = img\r\n316:     tex.extension = 'REPEAT'\r\n317:     nt.links.new(tex.outputs['Color'], b.inputs['Base Color'])\r\n318:     if emission > 0:\r\n319:         nt.links.new(tex.outputs['Color'], b.inputs['Emission Color'])\r\n320:         b.inputs['Emission Strength'].default_value = emission\r\n321:     out = nt.nodes.new('ShaderNodeOutputMaterial')\r\n322:     nt.links.new(b.outputs['BSDF'], out.inputs['Surface'])\r\n323:     return m, img\r\n324: \r\n325: \r\n326: M_GARAGE, _garage_img = tex_mat(\"V5_PitGarage\", \"pit_garage.png\", emission=0.18, spec=0.05, rough=0.6)\r\n327: M_AD, _ad_img = tex_mat(\"V5_AdBoard\", \"ad_boards.png\", emission=0.75, spec=0.05, rough=0.55)\r\n328: M_SCREEN, _screen_img = tex_mat(\"V5_BigScreen\", \"bigscreen.png\", emission=1.6, spec=0.05, rough=0.4)\r\n329: M_BRAKE = {}\r\n330: for _n in (\"150\", \"100\", \"50\"):\r\n331:     M_BRAKE[_n], _ = tex_mat(f\"V5_Brake{_n}\", f\"brake_{_n}.png\", emission=0.12, spec=0.1, rough=0.5)\r\n332: \r\n333: # ---------------------------------------------------------------\r\n334: # 3. 天空 / 太阳（重做对比度）\r\n335: # ---------------------------------------------------------------\r\n336: world = bpy.data.worlds.get(\"World_V5Dusk\") or bpy.data.worlds.new(\"World_V5Dusk\")\r\n337: scene.world = world\r\n338: world.use_nodes = True\r\n339: _nt = world.node_tree\r\n340: _nt.nodes.clear()\r\n341: _bg = _nt.nodes.new('ShaderNodeBackground')\r\n342: _bg.inputs['Color'].default_value = (0.055, 0.075, 0.130, 1)\r\n343: _bg.inputs['Strength'].default_value = 1.15\r\n344: _wo = _nt.nodes.new('ShaderNodeOutputWorld')\r\n345: _nt.links.new(_bg.outputs[0], _wo.inputs[0])\r\n346: \r\n347: _sl = bpy.data.lights.new(\"LGT_V5Sun\", 'SUN')\r\n348: _sl.energy = 5.6\r\n349: _sl.angle = radians(1.4)\r\n350: _sl.color = (1.0, 0.86, 0.70)\r\n351: _sl.use_shadow = True\r\n352: _sun = bpy.data.objects.new(\"LGT_V5Sun\", _sl)\r\n353: COLL.objects.link(_sun)\r\n354: # 与天空 sun_rotation 对齐：方位 232° → 光从西南低角入射\r\n355: _az = radians(232.0)\r\n356: _sun.rotation_euler = Euler((radians(90.0 - 22.0), 0.0, _az - pi / 2), 'XYZ')\r\n357: \r\n358: # 冷补光（天空反向，抬暗部，避免死黑）\r\n359: _fill = bpy.data.lights.new(\"LGT_V5SkyFill\", 'SUN')\r\n360: _fill.energy = 0.45\r\n361: _fill.angle = radians(25.0)\r\n362: _fill.color = (0.55, 0.70, 1.0)\r\n363: _fill.use_shadow = False\r\n364: _fo = bpy.data.objects.new(\"LGT_V5SkyFill\", _fill)\r\n365: COLL.objects.link(_fo)\r\n366: _fo.rotation_euler = Euler((radians(52.0), 0.0, _az + pi / 2), 'XYZ')\r\n367: \r\n368: # ---------------------------------------------------------------\r\n369: # ---------------------------------------------------------------\r\n370: # 3b. 天空穹顶：黄昏渐变（顶点色自发光）\r\n371: # ---------------------------------------------------------------\r\n372: _sky_mat = bpy.data.materials.new(\"V5_SkyDome\")\r\n373: _sky_mat.use_nodes = True\r\n374: _snt = _sky_mat.node_tree\r\n375: _snt.nodes.clear()\r\n376: _sout = _snt.nodes.new('ShaderNodeOutputMaterial')\r\n377: _sem = _snt.nodes.new('ShaderNodeEmission')\r\n378: _sem.inputs['Strength'].default_value = 1.0\r\n379: _svc = _snt.nodes.new('ShaderNodeVertexColor')\r\n380: _svc.layer_name = \"Col\"\r\n381: _snt.links.new(_svc.outputs['Color'], _sem.inputs['Color'])\r\n382: _snt.links.new(_sem.outputs['Emission'], _sout.inputs['Surface'])\r\n383: \r\n384: _bm = bmesh.new()\r\n385: try:\r\n386:     bmesh.ops.create_uvsphere(_bm, u_segments=64, v_segments=32, radius=1.0)\r\n387: except TypeError:\r\n388:     bmesh.ops.create_uvsphere(_bm, u_segments=64, v_segments=32, diameter=1.0)\r\n389: _mesh = bpy.data.meshes.new(\"V5_SkyDome\")\r\n390: _bm.to_mesh(_mesh)\r\n391: _bm.free()\r\n392: _ca = _mesh.color_attributes.new(name=\"Col\", type='FLOAT_COLOR', domain='POINT')\r\n393: \r\n394: \r\n395: def _sky_color(z):\r\n396:     stops = [(-0.10, (0.030, 0.026, 0.024)),\r\n397:              (0.000, (0.60, 0.30, 0.16)),\r\n398:              (0.030, (0.33, 0.19, 0.20)),\r\n399:              (0.110, (0.13, 0.17, 0.30)),\r\n400:              (0.300, (0.045, 0.085, 0.200)),\r\n401:              (0.650, (0.016, 0.038, 0.115)),\r\n402:              (1.000, (0.008, 0.020, 0.070))]\r\n403:     if z <= stops[0][0]:\r\n404:         return stops[0][1]\r\n405:     for _k in range(len(stops) - 1):\r\n406:         z0, c0 = stops[_k]\r\n407:         z1, c1 = stops[_k + 1]\r\n408:         if z0 <= z <= z1:\r\n409:             f = (z - z0) / max(z1 - z0, 1e-9)\r\n410:             f = f * f * (3 - 2 * f)\r\n411:             return tuple(c0[j] + (c1[j] - c0[j]) * f for j in range(3))\r\n412:     return stops[-1][1]\r\n413: \r\n414: \r\n415: for _i, _v in enumerate(_mesh.vertices):\r\n416:     _r, _g, _b = _sky_color(_v.co.z)\r\n417:     _ca.data[_i].color = (_r, _g, _b, 1.0)\r\n418: \r\n419: _skyob = bpy.data.objects.new(\"V5_SkyDome\", _mesh)\r\n420: COLL.objects.link(_skyob)\r\n421: _skyob.location = (_cx, _cy, 0.0)\r\n422: _skyob.scale = (4200.0, 4200.0, 4200.0)\r\n423: _skyob.visible_shadow = False\r\n424: _mesh.materials.append(_sky_mat)\r\n425: \r\n426: # 4. 地面\r\n427: # ---------------------------------------------------------------\r\n428: GR = 2600.0\r\n429: mesh_from(\"V5_Ground\", [(_cx - GR, _cy - GR, -0.004), (_cx + GR, _cy - GR, -0.004),\r\n430:                         (_cx + GR, _cy + GR, -0.004), (_cx - GR, _cy + GR, -0.004)],\r\n431:           [(0, 1, 2, 3)], M_GRASS)\r\n432: \r\n433: # ---------------------------------------------------------------\r\n434: # 5. 路面 / 赛车线 / 边线\r\n435: # ---------------------------------------------------------------\r\n436: def ribbon(off_a, off_b, z, mat, name, step=1, ups=True, uv_scale=None):\r\n437:     \"\"\"沿中心线生成带状网格；off 为右向偏移（m），可为常数或 f(i)；首尾自动闭合\"\"\"\r\n438:     v, fc, uv = [], [], []\r\n439:     idxs = list(range(0, N, step))\r\n440:     if idxs[-1] != N - 1:\r\n441:         idxs.append(N - 1)\r\n442:     idxs.append(N)                              # at(N) -> 第 0 点，闭环\r\n443:     fa = off_a if callable(off_a) else (lambda i: off_a)\r\n444:     fb = off_b if callable(off_b) else (lambda i: off_b)\r\n445:     for i in idxs:\r\n446:         p, h, r, k = at(i)\r\n447:         a, b = fa(i), fb(i)\r\n448:         v.append((p.x + r.x * a, p.y + r.y * a, z))\r\n449:         v.append((p.x + r.x * b, p.y + r.y * b, z))\r\n450:         if uv_scale:\r\n451:             uv.append((0.0, S[i % N] / uv_scale))\r\n452:             uv.append((1.0, S[i % N] / uv_scale))\r\n453:     for j in range(len(idxs) - 1):\r\n454:         a = j * 2\r\n455:         fc.append((a, a + 1, a + 3, a + 2))\r\n456:     return mesh_from(name, v, fc, mat, uvs=uv if uv_scale else None, up=ups)\r\n457: \r\n458: \r\n459: # 主路面\r\n460: ribbon(-HALF_W, HALF_W, 0.010, M_ASPHALT, \"V5_Track\", uv_scale=8.0)\r\n461: # 边线（白实线）\r\n462: ribbon(-HALF_W + 0.05, -HALF_W + 0.20, 0.014, M_WHITE, \"V5_Line_L\")\r\n463: ribbon(HALF_W - 0.20, HALF_W - 0.05, 0.014, M_WHITE, \"V5_Line_R\")\r\n464: \r\n465: # 赛车线橡胶带（沿 racing_xy，宽 3.4 m）\r\n466: def _rl(i):\r\n467:     return ROFF[i % N] - 1.7\r\n468: \r\n469: \r\n470: def _rr(i):\r\n471:     return ROFF[i % N] + 1.7\r\n472: \r\n473: \r\n474: ribbon(_rl, _rr, 0.013, M_RUBBER, \"V5_RacingLine\", step=1)\r\n475: \r\n476: # ---------------------------------------------------------------\r\n477: # 6. 路肩（弯道）\r\n478: # ---------------------------------------------------------------\r\n479: def corner_runs(thresh=0.0045, min_len=18.0, gap=8.0):\r\n480:     runs, cur = [], None\r\n481:     for i in range(N):\r\n482:         if KAPPA[i] > thresh:\r\n483:             if cur is None:\r\n484:                 cur = [i, i]\r\n485:             else:\r\n486:                 cur[1] = i\r\n487:         else:\r\n488:             if cur and S[cur[1]] - S[cur[0]] >= min_len:\r\n489:                 runs.append(tuple(cur))\r\n490:             cur = None\r\n491:     if cur and LAP_LEN - S[cur[0]] + S[cur[1]] >= min_len:\r\n492:         runs.append((cur[0], cur[1]))\r\n493:     # 合并近邻（同一弯的碎段）\r\n494:     merged = []\r\n495:     for r in runs:\r\n496:         if merged and S[r[0]] - S[merged[-1][1]] < gap:\r\n497:             merged[-1] = (merged[-1][0], r[1])\r\n498:         else:\r\n499:             merged.append(list(r))\r\n500:     return [(a, b) for a, b in merged]\r\n501: \r\n502: \r\n503: KERB_IN_W = 1.35\r\n504: KERB_Z_IN = 0.012\r\n505: KERB_Z_OUT = 0.075\r\n506: BLOCK_M = 3.2\r\n507: \r\n508: _runs = corner_runs()\r\n509: print(\"corner runs:\", len(_runs))\r\n510: \r\n511: \r\n512: def build_kerb(i0, i1, side, mat, phase, name):\r\n513:     \"\"\"沿弯道内侧/外侧生成路肩块（红白交替，按全局弧长对齐）\"\"\"\r\n514:     s0, s1 = S[i0], S[i1]\r\n515:     v, fc = [], []\r\n516:     s = s0 - ((s0 / BLOCK_M) % 1.0) * BLOCK_M\r\n517:     while s < s1 - 0.3:\r\n518:         kb = int(round(s / BLOCK_M))\r\n519:         if kb % 2 == phase:\r\n520:             a0 = max(s0, s)\r\n521:             a1 = min(s1, s + BLOCK_M)\r\n522:             if a1 - a0 > 0.5:\r\n523:                 base = len(v)\r\n524:                 for ss in (a0, a1):\r\n525:                     p, h, r, k = at_s(ss)\r\n526:                     o0 = side * HALF_W\r\n527:                     o1 = side * (HALF_W + KERB_IN_W)\r\n528:                     v.append((p.x + r.x * o0, p.y + r.y * o0, KERB_Z_IN))\r\n529:                     v.append((p.x + r.x * o1, p.y + r.y * o1, KERB_Z_OUT))\r\n530:                 fc.append((base, base + 1, base + 3, base + 2))\r\n531:         s += BLOCK_M\r\n532:     if fc:\r\n533:         return mesh_from(name, v, fc, mat)\r\n534: \r\n535: \r\n536: for ki, (a, b) in enumerate(_runs):\r\n537:     # 内外侧都铺（真实赛道：apex 内侧 + 出弯外侧）\r\n538:     for side, nm in ((-1, \"L\"), (1, \"R\")):\r\n539:         build_kerb(a, b, side, M_CURB_R, 0, f\"V5_Kerb_{ki}_{nm}_R\")\r\n540:         build_kerb(a, b, side, M_CURB_W, 1, f\"V5_Kerb_{ki}_{nm}_W\")\r\n541: \r\n542: # ---------------------------------------------------------------\r\n543: # 7. 缓冲带（草地 / 砾石）\r\n544: # ---------------------------------------------------------------\r\n545: VERGE_W = 26.0\r\n546: ribbon(-HALF_W - KERB_IN_W, -HALF_W - VERGE_W, 0.004, M_GRASS, \"V5_Verge_L\", step=2)\r\n547: ribbon(HALF_W + KERB_IN_W, HALF_W + VERGE_W, 0.004, M_GRASS, \"V5_Verge_R\", step=2)\r\n548: \r\n549: # 砾石坑：慢弯外侧\r\n550: GRAV_OUT = 22.0\r\n551: \r\n552: \r\n553: def build_gravel(i0, i1, side, name):\r\n554:     v, fc = [], []\r\n555:     step = 2\r\n556:     idxs = list(range(i0, i1, step))\r\n557:     for i in idxs:\r\n558:         p, h, r, k = at(i)\r\n559:         for o, z in ((side * (HALF_W + KERB_IN_W), 0.006), (side * GRAV_OUT, 0.006)):\r\n560:             v.append((p.x + r.x * o, p.y + r.y * o, z))\r\n561:     for j in range(len(idxs) - 1):\r\n562:         a = j * 2\r\n563:         fc.append((a, a + 1, a + 3, a + 2))\r\n564:     if fc:\r\n565:         return mesh_from(name, v, fc, M_GRAVEL)\r\n566: \r\n567: \r\n568: _gi = 0\r\n569: for (a, b) in _runs:\r\n570:     vmin = min(VEL[a:b + 1]) * 3.6\r\n571:     if vmin < 180 and (b - a) > 12:\r\n572:         side = 1 if SIGNED_K[a] > 0 else -1    # 弯外侧 = 转向的反侧\r\n573:         build_gravel(a, b, side, f\"V5_Gravel_{_gi}\")\r\n574:         _gi += 1\r\n575: print(\"gravel traps:\", _gi)\r\n576: \r\n577: # ---------------------------------------------------------------\r\n578: # 8. 护栏 + 灯带 + 防护网\r\n579: # ---------------------------------------------------------------\r\n580: WALL_OFF = HALF_W + VERGE_W            # 33 m\r\n581: WALL_H = 1.05\r\n582: BASE_H = 0.24\r\n583: \r\n584: \r\n585: def _wall_band(z0, z1, off, mat, name):\r\n586:     wv, wf = [], []\r\n587:     for side in (-1, 1):\r\n588:         base = len(wv)\r\n589:         for i in range(N):\r\n590:             p, h, r, k = at(i)\r\n591:             o = side * off\r\n592:             px, py = p.x + r.x * o, p.y + r.y * o\r\n593:             wv.append((px, py, z0))\r\n594:             wv.append((px, py, z1))\r\n595:         for j in range(N):\r\n596:             aa = base + j * 2\r\n597:             bb = base + ((j + 1) % N) * 2\r\n598:             wf.append((aa, aa + 1, bb + 1, bb))\r\n599:             wf.append((bb, bb + 1, aa + 1, aa))\r\n600:     return mesh_from(name, wv, wf, mat, up=False)\r\n601: \r\n602: \r\n603: _wall_band(0.0, BASE_H, WALL_OFF, M_CONC, \"V5_BarrierBase\")\r\n604: _wall_band(BASE_H, WALL_H, WALL_OFF + 0.04, M_BARRIER, \"V5_Barrier\")\r\n605: \r\n606: # 顶部灯带\r\n607: _sv, _sf = [], []\r\n608: for side in (-1, 1):\r\n609:     base = len(_sv)\r\n610:     for i in range(N):\r\n611:         p, h, r, k = at(i)\r\n612:         o = side * (WALL_OFF - 0.02)\r\n613:         px, py = p.x + r.x * o, p.y + r.y * o\r\n614:         _sv.append((px, py, WALL_H - 0.10))\r\n615:         _sv.append((px, py, WALL_H - 0.02))\r\n616:     for j in range(N):\r\n617:         a = base + j * 2\r\n618:         b = base + ((j + 1) % N) * 2\r\n619:         _sf.append((a, a + 1, b + 1, b))\r\n620:         _sf.append((b, b + 1, a + 1, a))\r\n621: mesh_from(\"V5_BarrierStrip\", _sv, _sf, M_STRIP, up=False)\r\n622: \r\n623: # 防护网立柱（每 12 m 一根，简化：只建柱子顶点 + 稀疏网面）\r\n624: _pv, _pf = [], []\r\n625: POST_STEP = 12.0\r\n626: for side in (-1, 1):\r\n627:     s = 0.0\r\n628:     while s < LAP_LEN:\r\n629:         p, h, r, k = at_s(s)\r\n630:         o = side * (WALL_OFF + 0.35)\r\n631:         px, py = p.x + r.x * o, p.y + r.y * o\r\n632:         base = len(_pv)\r\n633:         for dx, dy in ((-0.07, 0), (0.07, 0)):\r\n634:             _pv.append((px, py, WALL_H))\r\n635:             _pv.append((px, py, WALL_H + 3.4))\r\n636:         _pf.append((base, base + 1, base + 3, base + 2))\r\n637:         s += POST_STEP\r\n638: mesh_from(\"V5_FencePosts\", _pv, _pf, M_STEEL, up=False)\r\n639: \r\n640: # ---------------------------------------------------------------\r\n641: # 9. 起跑龙门架 + 发车灯 + 起跑线\r\n642: # ---------------------------------------------------------------\r\n643: SF_S = 40.0                     # 起终点位置（沿中心线弧长）\r\n644: gp, gh, gr, gk = at_s(SF_S)\r\n645: \r\n646: # 路面方格线\r\n647: _gv, _gf = [], []\r\n648: for k in range(2):\r\n649:     _gv.append((gp.x + gr.x * (-HALF_W), gp.y + gr.y * (-HALF_W), 0.016))\r\n650:     _gv.append((gp.x + gr.x * (HALF_W), gp.y + gr.y * (HALF_W), 0.016))\r\n651:     gp2, gh2, gr2, _ = at_s(SF_S + (k + 1) * 0.6)\r\n652:     _gv.append((gp2.x + gr2.x * (-HALF_W), gp2.y + gr2.y * (-HALF_W), 0.016))\r\n653:     _gv.append((gp2.x + gr2.x * (HALF_W), gp2.y + gr2.y * (HALF_W), 0.016))\r\n654: for k in range(2):\r\n655:     a = k * 4\r\n656:     _gf.append((a, a + 1, a + 3, a + 2))\r\n657: mesh_from(\"V5_StartLine\", _gv, _gf, M_WHITE)\r\n658: \r\n659: # 门架\r\n660: GANT_H = 7.2\r\n661: for sd in (-1, 1):\r\n662:     px = gp.x + gr.x * sd * (HALF_W + 1.6)\r\n663:     py = gp.y + gr.y * sd * (HALF_W + 1.6)\r\n664:     box(f\"V5_Gantry_Post_{sd}\", (px, py, GANT_H / 2), (0.45, 0.45, GANT_H), M_STEEL, rot_z=gh)\r\n665: beam = box(\"V5_Gantry_Beam\", (gp.x, gp.y, GANT_H), (HALF_W * 2 + 3.6, 0.55, 0.85), M_STEEL, rot_z=gh)\r\n666: ban = box(\"V5_Gantry_Banner\", (gp.x - sin(gh) * 0.32, gp.y + cos(gh) * 0.32, GANT_H),\r\n667:           (HALF_W * 2 + 2.2, 0.06, 0.6), M_ADPANEL, rot_z=gh)\r\n668: \r\n669: # 5 盏发车灯（红灯，随动画熄灭）\r\n670: M_SLIGHT = new_mat(\"V5_StartLight\", (0.06, 0.004, 0.003), 0.3,\r\n671:                    emission=(1.0, 0.05, 0.02), estrength=18.0)\r\n672: for i in range(5):\r\n673:     ox = -1.6 + i * 0.8\r\n674:     px = gp.x + gr.x * ox\r\n675:     py = gp.y + gr.y * ox\r\n676:     bm = bmesh.new()\r\n677:     bmesh.ops.create_uvsphere(bm, u_segments=16, v_segments=10, radius=0.18)\r\n678:     me = bpy.data.meshes.new(f\"V5_StartLight_{i}\")\r\n679:     bm.to_mesh(me)\r\n680:     bm.free()\r\n681:     ob = bpy.data.objects.new(f\"V5_StartLight_{i}\", me)\r\n682:     COLL.objects.link(ob)\r\n683:     ob.location = (px, py, GANT_H - 0.62)\r\n684:     me.materials.append(M_SLIGHT)\r\n685: \r\n686: # ---------------------------------------------------------------\r\n687: # 10. 看台（含人群贴图）\r\n688: # ---------------------------------------------------------------\r\n689: def grandstand(s_center, side, length, rows=11, dist=30.0, name=\"Stand\"):\r\n690:     p, h, r, k = at_s(s_center)\r\n691:     fwd = Vector((cos(h), sin(h), 0.0))\r\n692:     out = Vector((r.x, r.y, 0.0)) * side\r\n693:     row_d = 0.92\r\n694:     row_h = 0.58\r\n695:     L = length / 2.0\r\n696: \r\n697:     # ---- 阶梯分块（每 28 m 一块，块间 2 m 通道，避免一整条）----\r\n698:     block, gap = 28.0, 2.0\r\n699:     spans, x0 = [], -L\r\n700:     while x0 < L - 4:\r\n701:         x1 = min(x0 + block, L)\r\n702:         spans.append((x0, x1))\r\n703:         x0 = x1 + gap\r\n704:     for bi, (x0, x1) in enumerate(spans):\r\n705:         bl = x1 - x0\r\n706:         v, fc, uv = [], [], []\r\n707:         for rr in range(rows + 1):\r\n708:             d0 = dist + rr * row_d\r\n709:             z = rr * row_h\r\n710:             for sd, xs in ((-1, x0), (1, x1)):\r\n711:                 c = p + out * d0 + fwd * xs\r\n712:                 v.append((c.x, c.y, z))\r\n713:                 uv.append((sd * bl / 7.5 + 0.5, rr / float(rows)))\r\n714:         for rr in range(rows):\r\n715:             a = rr * 2\r\n716:             b = (rr + 1) * 2\r\n717:             fc.append((a, a + 1, b + 1, b))     # 座面\r\n718:             fc.append((a, b, b + 1, a + 1))     # 立面\r\n719:         mesh_from(f\"{name}_{bi}\", v, fc, M_CROWD, uvs=uv, up=False)\r\n720: \r\n721:     # ---- 后墙 + VIP 玻璃带 ----\r\n722:     back = dist + rows * row_d\r\n723:     box(name + \"_Back\", (p.x + out.x * back, p.y + out.y * back, rows * row_h / 2),\r\n724:         (length, 0.5, rows * row_h), M_CONC, rot_z=h)\r\n725:     gz = (rows - 1) * row_h\r\n726:     box(name + \"_VIP\", (p.x + out.x * (back - 0.3), p.y + out.y * (back - 0.3), gz + 0.9),\r\n727:         (length - 4, 0.12, 1.2), M_STRIP, rot_z=h)\r\n728: \r\n729:     # ---- 斜顶棚（前低后高）+ 支撑 ----\r\n730:     zf = rows * row_h + 3.0\r\n731:     zb = rows * row_h + 5.8\r\n732:     rf = dist - 0.6\r\n733:     rb = back + 1.6\r\n734:     rv = []\r\n735:     for sd in (-1, 1):\r\n736:         cf = p + out * rf + fwd * (L * sd)\r\n737:         cb = p + out * rb + fwd * (L * sd)\r\n738:         rv += [(cf.x, cf.y, zf), (cb.x, cb.y, zb)]\r\n739:     mesh_from(name + \"_Roof\", rv, [(0, 1, 3, 2)], M_ROOF, up=False)\r\n740:     # 顶棚下沿灯带\r\n741:     lp = p + out * (rf + 0.1)\r\n742:     box(name + \"_RoofStrip\", (lp.x, lp.y, zf - 0.3), (length * 0.96, 0.10, 0.10), M_STRIP, rot_z=h)\r\n743:     # 后支撑柱（每 8 m）\r\n744:     _n = int(length / 14)\r\n745:     for i in range(_n + 1):\r\n746:         xs = -L + i * 14.0\r\n747:         cph = p + out * rb + fwd * xs\r\n748:         box(name + f\"_Col{i}\", (cph.x, cph.y, zb / 2), (0.24, 0.24, zb), M_STEEL, rot_z=h)\r\n749:     # 横向钢梁（每 4 m 一根）\r\n750:     _m = int(length / 8)\r\n751:     for i in range(_m + 1):\r\n752:         xs = -L + i * 8.0\r\n753:         bf = p + out * rf + fwd * xs\r\n754:         bb = p + out * rb + fwd * xs\r\n755:         box(name + f\"_Truss{i}\", (bf.x, bf.y, zf - 0.12), (0.16, 0.16, 0.16), M_STEEL, rot_z=h)\r\n756:         box(name + f\"_TrussB{i}\", (bb.x, bb.y, zb - 0.12), (0.16, 0.16, 0.16), M_STEEL, rot_z=h)\r\n757: \r\n758:     # ---- 前立柱 + 前沿围栏 ----\r\n759:     for sd in (-1, 1):\r\n760:         cp = p + out * (dist + 0.4) + fwd * (L * sd * 0.92)\r\n761:         box(name + f\"_Post{sd}\", (cp.x, cp.y, zf / 2), (0.28, 0.28, zf), M_STEEL, rot_z=h)\r\n762:     rail = p + out * (dist - 1.5)\r\n763:     box(name + \"_Rail\", (rail.x, rail.y, 0.55), (length, 0.06, 0.06), M_STEEL, rot_z=h)\r\n764:     # 旗杆 + 旗（沿前沿，每 24 m）\r\n765:     _n = int(length / 40)\r\n766:     for i in range(_n + 1):\r\n767:         xs = -L + i * 40.0\r\n768:         fp = p + out * (dist - 2.2) + fwd * xs\r\n769:         box(name + f\"_Flagpole{i}\", (fp.x, fp.y, 3.0), (0.08, 0.08, 6.0), M_STEEL, rot_z=h)\r\n770:         col = random.choice(M_FLAGS)\r\n771:         fv = [(fp.x, fp.y, 6.0),\r\n772:               (fp.x + out.x * 1.5, fp.y + out.y * 1.5, 5.65),\r\n773:               (fp.x, fp.y, 5.3)]\r\n774:         mesh_from(f\"V5_Flag_{name}_{i}\", fv, [(0, 1, 2)], col, up=False)\r\n775:     return name\r\n776: \r\n777: \r\n778: STANDS = [\r\n779:     (120.0, 1, 150.0, 13, 26.0, \"V5_Stand_Main\"),\r\n780:     (1120.0, -1, 90.0, 11, 30.0, \"V5_Stand_T1\"),\r\n781:     (2600.0, 1, 110.0, 12, 30.0, \"V5_Stand_Mid\"),\r\n782:     (3540.0, -1, 120.0, 12, 30.0, \"V5_Stand_Complex\"),\r\n783:     (4370.0, 1, 95.0, 11, 32.0, \"V5_Stand_South\"),\r\n784:     (5560.0, -1, 100.0, 11, 28.0, \"V5_Stand_Club\"),\r\n785: ]\r\n786: M_FLAGS = [new_mat(f\"V5_Flag_{i}\", c, 0.6, 0.0)\r\n787:            for i, c in enumerate(((200, 30, 30), (20, 60, 200), (240, 240, 240),\r\n788:                                   (255, 160, 0), (20, 140, 90)))]\r\n789: for args in STANDS:\r\n790:     grandstand(*args)\r\n791: print(\"stands:\", len(STANDS))\r\n792: \r\n793: # ---------------------------------------------------------------\r\n794: # 11. 维修区（主直道内侧）：pit wall + pit lane + pit box + garage 楼\r\n795: # ---------------------------------------------------------------\r\n796: PIT_S0, PIT_S1 = 60.0, 420.0\r\n797: _p, _h, _r, _k = at_s((PIT_S0 + PIT_S1) / 2)\r\n798: _pit_fwd = Vector((cos(_h), sin(_h), 0.0))\r\n799: _pit_out = Vector((- _r.x, - _r.y, 0.0))      # 内侧（-right），与 Stand_Main 错开\r\n800: PIT_WALL = -(HALF_W + 3.0)                     # -10 m 处维修墙\r"}
{"step_index":20,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-18T04:47:42Z","content":"Created At: 2026-11-18T12:47:42+08:00\nCompleted At: 2026-11-18T12:47:43+08:00\nShowing lines 1-707 of 707\n1: # -*- coding: utf-8 -*-\r\n2: \"\"\"\r\n3: V5 ANIM — 真实赛道整圈（Silverstone / 90.34 s / 162 拍 / 2161 帧）\r\n4: 输入: pipeline/v5_stage_env.blend\r\n5: 输出: pipeline/v5_stage_anim.blend\r\n6: 运行:\r\n7:   blender -b -P pipeline/v5_anim.py -- --test 60,300,700,1500\r\n8:   blender -b -P pipeline/v5_anim.py -- --render\r\n9: \r\n10: 五条硬规则（来自 track_data/TRACK_SPEC.md）\r\n11:   1. 位置按 t 插值，不按帧均分\r\n12:   2. 朝向取 heading_deg，不用位移差反推\r\n13:   3. 位置走 racing_xy，不是 xy\r\n14:   4. 关键帧 LINEAR，禁 Bezier\r\n15:   5. v^2 * curv 不得超过 15.0 + 0.00714 v^2\r\n16: \"\"\"\r\n17: import bpy, json, math, os, sys, random\r\n18: from mathutils import Vector, Matrix, Euler\r\n19: from math import sin, cos, pi, radians, degrees, sqrt\r\n20: \r\n21: PROJ = r\"D:\\项目session\\blender-supercar\"\r\n22: IN = os.path.join(PROJ, \"LATEST\", \"v5_stage_env.blend\")\r\n23: OUT = os.path.join(PROJ, \"LATEST\", \"v5_stage_anim.blend\")\r\n24: TRACK = os.path.join(PROJ, \"track_data\", \"silverstone_track.json\")\r\n25: FRAMES_DIR = os.path.join(PROJ, \"renders_v5\", \"frames\")\r\n26: STILLS_DIR = os.path.join(PROJ, \"renders_v5\", \"stills\")\r\n27: \r\n28: ARGV = sys.argv[sys.argv.index(\"--\") + 1:] if \"--\" in sys.argv else []\r\n29: \r\n30: \r\n31: def argval(flag, default=None):\r\n32:     if flag in ARGV:\r\n33:         i = ARGV.index(flag)\r\n34:         if i + 1 < len(ARGV) and not ARGV[i + 1].startswith(\"--\"):\r\n35:             return ARGV[i + 1]\r\n36:         return True\r\n37:     return default\r\n38: \r\n39: \r\n40: # ---------------------------------------------------------------\r\n41: # 0. 参数\r\n42: # ---------------------------------------------------------------\r\n43: FPS = 24\r\n44: BEAT = 60.0 / 108.0                 # After Hours 108 BPM -> 0.5556 s\r\n45: BEAT_F = BEAT * FPS                 # 13.3333 帧\r\n46: TOTAL_BEATS = 162\r\n47: FRAME_END = int(round(1 + TOTAL_BEATS * BEAT_F))    # 2161\r\n48: R_TIRE = 0.357\r\n49: WHEELBASE = 3.6\r\n50: \r\n51: data = json.load(open(TRACK, encoding=\"utf-8\"))\r\n52: META = data[\"meta\"]\r\n53: P = data[\"points\"]\r\n54: N = len(P)\r\n55: LAP_S = META[\"sim_lap_s\"]           # 90.34\r\n56: DT = LAP_S / (FRAME_END - 1)        # 每帧时间步（保证整圈正好铺满）\r\n57: \r\n58: T_ARR = [p[\"t\"] for p in P]\r\n59: RX_ARR = [Vector((p[\"racing_xy\"][0], p[\"racing_xy\"][1], 0.0)) for p in P]\r\n60: HD_ARR = [p[\"heading_deg\"] for p in P]\r\n61: V_ARR = [p[\"v_mps\"] for p in P]\r\n62: K_ARR = [abs(p[\"curv_1pm\"] or 0.0) for p in P]\r\n63: \r\n64: \r\n65: def _unwrap(deg_list):\r\n66:     out = [deg_list[0]]\r\n67:     for a in deg_list[1:]:\r\n68:         d = (a - out[-1] + 180.0) % 360.0 - 180.0\r\n69:         out.append(out[-1] + d)\r\n70:     return out\r\n71: \r\n72: \r\n73: _HD_UN = _unwrap(HD_ARR)\r\n74: _SPAN = 4\r\n75: _SDS = 2 * _SPAN * (META[\"measured_length_km\"] * 1000.0 / N)\r\n76: \r\n77: \r\n78: def _ssign(i):\r\n79:     a = _HD_UN[(i - _SPAN) % N]\r\n80:     b = _HD_UN[(i + _SPAN) % N]\r\n81:     return 1.0 if (b - a) >= 0 else -1.0\r\n82: \r\n83: \r\n84: KS_ARR = [_ssign(i) * K_ARR[i] for i in range(N)]\r\n85: \r\n86: \r\n87: def sample(t):\r\n88:     \"\"\"t -> (位置, 航向[rad, CCW from +X], 速度 m/s, 有符号曲率)\"\"\"\r\n89:     t = max(0.0, min(LAP_S - 1e-6, t))\r\n90:     lo, hi = 0, N - 1\r\n91:     while hi - lo > 1:\r\n92:         m = (lo + hi) // 2\r\n93:         if T_ARR[m] <= t:\r\n94:             lo = m\r\n95:         else:\r\n96:             hi = m\r\n97:     span = max(T_ARR[lo + 1] - T_ARR[lo], 1e-9)\r\n98:     f = (t - T_ARR[lo]) / span\r\n99:     pos = RX_ARR[lo].lerp(RX_ARR[lo + 1], f)\r\n100:     a = radians(HD_ARR[lo])\r\n101:     b = radians(HD_ARR[lo + 1])\r\n102:     d = (b - a + pi) % (2 * pi) - pi\r\n103:     return pos, a + d * f, V_ARR[lo] + (V_ARR[lo + 1] - V_ARR[lo]) * f, \\\r\n104:         KS_ARR[lo] + (KS_ARR[lo + 1] - KS_ARR[lo]) * f\r\n105: \r\n106: \r\n107: # ---------------------------------------------------------------\r\n108: # 1. 每帧姿态\r\n109: # ---------------------------------------------------------------\r\n110: frame_data = {}\r\n111: dist = 0.0\r\n112: prev_pos = None\r\n113: for f in range(1, FRAME_END + 1):\r\n114:     t = (f - 1) * DT\r\n115:     pos, h, v, k = sample(t)\r\n116:     if prev_pos is not None:\r\n117:         dist += (pos - prev_pos).length\r\n118:     prev_pos = pos\r\n119:     fwd = Vector((cos(h), sin(h), 0.0))\r\n120:     right = Vector((sin(h), -cos(h), 0.0))\r\n121:     frame_data[f] = dict(t=t, pos=pos, heading=h, v=v, k=k, dist=dist, fwd=fwd, right=right)\r\n122: \r\n123: # 纵向加速度 / 横向加速度\r\n124: for f in range(1, FRAME_END + 1):\r\n125:     f0 = max(1, f - 2)\r\n126:     f1 = min(FRAME_END, f + 2)\r\n127:     dv = frame_data[f1]['v'] - frame_data[f0]['v']\r\n128:     accel = dv / ((f1 - f0) * DT)\r\n129:     v = frame_data[f]['v']\r\n130:     k = frame_data[f]['k']\r\n131:     frame_data[f]['accel'] = accel\r\n132:     frame_data[f]['lat'] = v * v * abs(k) / 9.81          # g\r\n133:     frame_data[f]['gear'] = min(8, max(1, int((v * 3.6 - 60) / 40.0) + 1))\r\n134: \r\n135: # ---------------------------------------------------------------\r\n136: # 2. 打开场景\r\n137: # ---------------------------------------------------------------\r\n138: bpy.ops.wm.open_mainfile(filepath=IN)\r\n139: scene = bpy.context.scene\r\n140: rig = bpy.data.objects[\"RIG_F1_Race\"]\r\n141: \r\n142: # 发车灯常暗（这圈是飞驰圈，不是发车）\r\n143: _sl = bpy.data.materials.get(\"V5_StartLight\")\r\n144: if _sl:\r\n145:     for n in _sl.node_tree.nodes:\r\n146:         if n.type == 'BSDF_PRINCIPLED' and 'Emission Strength' in n.inputs:\r\n147:             n.inputs['Emission Strength'].default_value = 0.0\r\n148: \r\n149: bone_root = rig.pose.bones[\"Bone_Root\"]\r\n150: bone_heading = rig.pose.bones[\"Bone_Heading\"]\r\n151: bone_body = rig.pose.bones[\"Bone_Body\"]\r\n152: \r\n153: # 尾部雨灯（刹车时增亮）\r\n154: brake_light = None\r\n155: _rl = bpy.data.objects.get(\"GEO_F1_FIA_RainLight\")\r\n156: if _rl and _rl.data.materials:\r\n157:     _m = _rl.data.materials[0]\r\n158:     if _m and _m.node_tree:\r\n159:         for _n in _m.node_tree.nodes:\r\n160:             if _n.type == 'BSDF_PRINCIPLED' and 'Emission Strength' in _n.inputs:\r\n161:                 brake_light = _n\r\n162:                 break\r\n163:             if _n.type == 'EMISSION':\r\n164:                 brake_light = _n\r\n165:                 break\r\n166: \r\n167: # 随车柔光\r\n168: # 随车三点补光：左前冷光 / 右前暖光 / 后方轮廓光\r\n169: _FILL = [\r\n170:     dict(ahead=5.5, side=-6.0, up=4.0, energy=260.0, size=18.0, color=(0.60, 0.74, 1.0)),\r\n171:     dict(ahead=5.5, side=6.0, up=4.0, energy=260.0, size=18.0, color=(1.0, 0.90, 0.78)),\r\n172:     dict(ahead=-7.0, side=2.4, up=2.4, energy=320.0, size=10.0, color=(0.85, 0.92, 1.0)),\r\n173: ]\r\n174: # 只照车的补光：用 light linking 把地面/环境排除在接收端之外\r\n175: _car_coll = bpy.data.collections.new(\"V5_CarLightReceivers\")\r\n176: for _ob in bpy.data.objects:\r\n177:     if _ob.type == 'MESH' and not _ob.name.startswith((\"V5_\", \"GEO_\")):\r\n178:         _car_coll.objects.link(_ob)\r\n179: \r\n180: fill_lights = []\r\n181: for i, spec in enumerate(_FILL):\r\n182:     fd_l = bpy.data.lights.new(f\"LGT_V5Car_{i}\", 'AREA')\r\n183:     fd_l.energy = spec['energy']\r\n184:     fd_l.size = spec['size']\r\n185:     fd_l.color = spec['color']\r\n186:     fo = bpy.data.objects.new(f\"LGT_V5Car_{i}\", fd_l)\r\n187:     scene.collection.objects.link(fo)\r\n188:     try:\r\n189:         fo.light_linking.receiver_collection = _car_coll\r\n190:         fo.light_linking.link_state = 'INCLUDE'\r\n191:     except Exception as _e:\r\n192:         print(\"light linking unavailable:\", _e)\r\n193:     fill_lights.append((fo, spec))\r\n194: \r\n195: # ---------------------------------------------------------------\r\n196: # 3. 逐帧烘焙\r\n197: # ---------------------------------------------------------------\r\n198: cum_spin = 0.0\r\n199: prev_dist = 0.0\r\n200: prev_gear = 1\r\n201: shift_flash = 0.0\r\n202: \r\n203: print(\"BAKE START: %d frames, dt=%.5f s, lap=%.2f s\" % (FRAME_END, DT, LAP_S))\r\n204: for f in range(1, FRAME_END + 1):\r\n205:     fd = frame_data[f]\r\n206:     v, acc, lat, k = fd['v'], fd['accel'], fd['lat'], fd['k']\r\n207:     v_kmh = v * 3.6\r\n208: \r\n209:     # --- 位置 / 偏航（车模型前方 = 局部 +Y → rotation_z = heading - 90°）---\r\n210:     yaw = fd['heading'] - pi / 2\r\n211:     bone_root.location = (fd['pos'].x, fd['pos'].y, 0.012)   # 轮胎落在沥青面上\r\n212:     bone_heading.rotation_euler = (0.0, 0.0, yaw)\r\n213:     bone_root.keyframe_insert(\"location\", frame=f)\r\n214:     bone_heading.keyframe_insert(\"rotation_euler\", frame=f)\r\n215: \r\n216:     # --- 车身姿态：俯仰 / 侧倾 / 升沉 ---\r\n217:     gear = fd['gear']\r\n218:     if gear != prev_gear:\r\n219:         shift_flash = 1.0\r\n220:         prev_gear = gear\r\n221:     else:\r\n222:         shift_flash *= 0.72\r\n223: \r\n224:     pitch = max(-1.9, min(1.4, acc * 0.085)) - 0.16 * shift_flash\r\n225:     roll = max(-2.2, min(2.2, -lat * 0.26))\r\n226:     heave = -0.006 + 0.0016 * sin(f * 1.31) + 0.0009 * sin(f * 2.77)\r\n227:     bone_body.location = (0.0, 0.0, heave)\r\n228:     bone_body.rotation_euler = (radians(pitch), radians(roll), 0.0)\r\n229:     bone_body.keyframe_insert(\"location\", frame=f)\r\n230:     bone_body.keyframe_insert(\"rotation_euler\", frame=f)\r\n231: \r\n232:     # --- 机械驱动 ---\r\n233:     cum_spin += (fd['dist'] - prev_dist) / R_TIRE\r\n234:     prev_dist = fd['dist']\r\n235:     rig[\"wheel_spin\"] = cum_spin\r\n236: \r\n237:     steer_deg = degrees(k * WHEELBASE)                   # 阿克曼转角\r\n238:     rig[\"steer\"] = max(-26.0, min(26.0, steer_deg))\r\n239: \r\n240:     straight = abs(k) < 0.0016\r\n241:     rig[\"drs\"] = 1.0 if (straight and v_kmh > 240) else (0.0 if abs(k) > 0.004 else 0.5)\r\n242:     rig[\"brake_heat\"] = max(0.0, min(1.3, -acc * 0.11))\r\n243:     rig[\"rear_slip\"] = 1.0\r\n244:     rig[\"susp_f\"] = -0.004 - 0.014 * max(0.0, -acc) / 12.0\r\n245:     rig[\"susp_r\"] = -0.004 - 0.016 * max(0.0, acc) / 12.0\r\n246:     for kk in (\"wheel_spin\", \"steer\", \"drs\", \"brake_heat\", \"rear_slip\", \"susp_f\", \"susp_r\"):\r\n247:         rig.keyframe_insert(f'[\"{kk}\"]', frame=f)\r\n248: \r\n249:     if brake_light and 'Strength' in brake_light.inputs:\r\n250:         brake_light.inputs['Strength'].default_value = 1.0 + rig[\"brake_heat\"] * 12.0\r\n251:         brake_light.inputs['Strength'].keyframe_insert(\"default_value\", frame=f)\r\n252: \r\n253:     # 随车柔光\r\n254:     for fo, spec in fill_lights:\r\n255:         lp = fd['pos'] + fd['fwd'] * spec['ahead'] + fd['right'] * spec['side']             + Vector((0, 0, spec['up']))\r\n256:         fo.location = lp\r\n257:         aim = (fd['pos'] + Vector((0, 0, 0.45))) - lp\r\n258:         fo.rotation_euler = aim.to_track_quat('-Z', 'Y').to_euler()\r\n259:         fo.keyframe_insert(\"location\", frame=f)\r\n260:         fo.keyframe_insert(\"rotation_euler\", frame=f)\r\n261: \r\n262: print(\"BAKE DONE\")\r\n263: \r\n264: \r\n265: def iter_fcurves(action):\r\n266:     \"\"\"Blender 5.x: Action 有 layered/slotted 结构，fcurves 在 channelbag 里\"\"\"\r\n267:     fcs = list(getattr(action, \"fcurves\", []) or [])\r\n268:     if fcs:\r\n269:         return fcs\r\n270:     for layer in getattr(action, \"layers\", []) or []:\r\n271:         for strip in getattr(layer, \"strips\", []) or []:\r\n272:             for cb in getattr(strip, \"channelbags\", []) or []:\r\n273:                 fcs.extend(cb.fcurves)\r\n274:     return fcs\r\n275: \r\n276: \r\n277: # 所有关键帧 LINEAR\r\n278: ad = rig.animation_data\r\n279: if ad and ad.action:\r\n280:     _n = 0\r\n281:     for fc in iter_fcurves(ad.action):\r\n282:         for kp in fc.keyframe_points:\r\n283:             kp.interpolation = 'LINEAR'\r\n284:             _n += 1\r\n285:     print(\"LINEAR keyframes:\", _n)\r\n286: \r\n287: # ---------------------------------------------------------------\r\n288: # 4. 物理自检（横向加速度上限 + 赛道内 + 航向连续）\r\n289: # ---------------------------------------------------------------\r\n290: VMAX = META[\"limits\"][\"v_max_mps\"]\r\n291: LIM = 15.0 + 0.00714 * VMAX ** 2\r\n292: worst = max(frame_data.values(), key=lambda d: d['v'] ** 2 * abs(d['k']))\r\n293: over = [f for f, d in frame_data.items() if d['v'] ** 2 * abs(d['k']) > LIM + 0.5]\r\n294: jumps = []\r\n295: for f in range(2, FRAME_END + 1):\r\n296:     d0, d1 = frame_data[f - 1], frame_data[f]\r\n297:     dh = abs((d1['heading'] - d0['heading'] + pi) % (2 * pi) - pi)\r\n298:     if dh > 0.12:\r\n299:         jumps.append((f, degrees(dh)))\r\n300: print(\"[check] 最坏横向 %.2f m/s^2 (%.2f g) @ frame %d, t=%.1f s\"\r\n301:       % (worst['v'] ** 2 * abs(worst['k']), worst['v'] ** 2 * abs(worst['k']) / 9.81,\r\n302:          int(round(worst['t'] / DT)) + 1, worst['t']))\r\n303: print(\"[check] 超限帧 %d -> %s\" % (len(over), \"PASS\" if not over else \"FAIL\"))\r\n304: print(\"[check] 航向跳变帧(>6.9deg) %d -> %s\" % (len(jumps), \"PASS\" if not jumps else str(jumps[:6])))\r\n305: print(\"[check] v_max %.1f km/h, lap %.2f s, 帧数 %d\" % (max(d['v'] for d in frame_data.values()) * 3.6, LAP_S, FRAME_END))\r\n306: \r\n307: # ---------------------------------------------------------------\r\n308: # 5. 机位\r\n309: # ---------------------------------------------------------------\r\n310: def make_cam(name, lens=50, fstop=4.0):\r\n311:     cd = bpy.data.cameras.new(name + \"_DATA\")\r\n312:     cd.lens = lens\r\n313:     cd.clip_start = 0.5\r\n314:     cd.clip_end = 9000\r\n315:     cd.sensor_width = 36\r\n316:     cd.dof.use_dof = True\r\n317:     cd.dof.aperture_fstop = fstop\r\n318:     cd.dof.aperture_blades = 9\r\n319:     ob = bpy.data.objects.new(name, cd)\r\n320:     scene.collection.objects.link(ob)\r\n321:     return ob\r\n322: \r\n323: \r\n324: def cam_look(ob, loc, target, roll_deg=0.0, fstop=None, lens=None):\r\n325:     loc = Vector(loc)\r\n326:     tgt = Vector(target)\r\n327:     d = tgt - loc\r\n328:     q = d.to_track_quat('-Z', 'Y')\r\n329:     m = q.to_matrix().to_4x4()\r\n330:     if abs(roll_deg) > 1e-6:\r\n331:         m = m @ Matrix.Rotation(radians(roll_deg), 4, 'Z')\r\n332:     ob.matrix_world = Matrix.Translation(loc) @ m\r\n333:     if fstop is not None:\r\n334:         ob.data.dof.aperture_fstop = fstop\r\n335:         ob.data.dof.focus_distance = d.length\r\n336:     if lens is not None:\r\n337:         ob.data.lens = lens\r\n338: \r\n339: \r\n340: def noise(t, seed=0.0, amp=1.0):\r\n341:     return (sin(t * 2.3 + seed) * 0.55 + sin(t * 5.7 + seed * 2.3) * 0.3\r\n342:             + sin(t * 11.3 + seed * 4.1) * 0.15) * amp\r\n343: \r\n344: \r\n345: def smooth(t):\r\n346:     t = max(0.0, min(1.0, t))\r\n347:     return t * t * (3 - 2 * t)\r\n348: \r\n349: \r\n350: def key_cam(cam, f, loc, tgt, roll=0.0, fstop=4.0, lens=50, lens_key=True):\r\n351:     cam_look(cam, loc, tgt, roll_deg=roll, fstop=fstop, lens=lens)\r\n352:     cam.keyframe_insert(\"location\", frame=f)\r\n353:     cam.keyframe_insert(\"rotation_euler\", frame=f)\r\n354:     cam.data.dof.keyframe_insert(\"focus_distance\", frame=f)\r\n355:     cam.data.dof.keyframe_insert(\"aperture_fstop\", frame=f)\r\n356:     if lens_key:\r\n357:         cam.data.keyframe_insert(\"lens\", frame=f)\r\n358: \r\n359: \r\n360: def F(beat):\r\n361:     return 1 + int(round(beat * BEAT_F))\r\n362: \r\n363: \r\n364: # 车体坐标系里的机位\r\n365: def C(fd, back=0.0, side=0.0, h=0.5):\r\n366:     return fd['pos'] - fd['fwd'] * back + fd['right'] * side + Vector((0, 0, h))\r\n367: \r\n368: \r\n369: def T(fd, ahead=0.0, side=0.0, h=0.45):\r\n370:     return fd['pos'] + fd['fwd'] * ahead + fd['right'] * side + Vector((0, 0, h))\r\n371: \r\n372: \r\n373: def fixed_point(f, back=0.0, side=0.0, h=0.5):\r\n374:     \"\"\"以某帧车体为参考，固定在世界的机位\"\"\"\r\n375:     fd = frame_data[f]\r\n376:     return C(fd, back, side, h)\r\n377: \r\n378: \r\n379: CAR_LEN = 4.7          # 用于定焦：让车在画面里占固定比例\r\n380: SENSOR_W = 36.0\r\n381: \r\n382: \r\n383: def lens_for_framing(dist, frac):\r\n384:     \"\"\"给定距离与目标占比，算焦距\"\"\"\r\n385:     return max(20.0, min(320.0, frac * SENSOR_W * max(dist, 1.0) / CAR_LEN))\r\n386: \r\n387: \r\n388: CAR_LEN = 4.7          # 定焦用：让车在画面里的宽度占比稳定\r\n389: SENSOR_W = 36.0\r\n390: \r\n391: \r\n392: CAR_W = 2.2\r\n393: \r\n394: \r\n395: def lens_for_framing(dist, frac, cos_a=0.0):\r\n396:     \"\"\"cos_a: 1=正对车头/车尾, 0=正侧面。按投影宽度算焦距\"\"\"\r\n397:     w_eff = CAR_W + (CAR_LEN - CAR_W) * (1.0 - abs(cos_a))\r\n398:     return max(20.0, min(320.0, frac * SENSOR_W * max(dist, 1.0) / max(w_eff, 0.5)))\r\n399: \r\n400: \r\n401: SHOTS = [\r\n402:     # (名字, t0, t1, 类型, 参数)  —— t 为赛道时间（秒），切点吸附 108 BPM 拍点\r\n403:     (\"Cam_S01_RearChase\", 0.0, 4.6, \"chase\",\r\n404:      dict(back0=8.0, back1=11.5, side0=1.1, side1=-1.1, h0=0.45, h1=1.15,\r\n405:           aim0=2.4, aim1=3.6, lens0=38, lens1=31, fstop=4.0, roll1=1.5)),\r\n406:     (\"Cam_S02_Onboard\", 4.6, 8.4, \"onboard\", dict(fwd=2.55, h=0.50, lens=17, fstop=5.6)),\r\n407:     (\"Cam_S03_ChaseRise\", 8.4, 12.4, \"chase\",\r\n408:      dict(back0=8.8, back1=6.9, side0=-1.2, side1=3.2, h0=1.30, h1=4.20,\r\n409:           aim0=4.4, aim1=3.0, lens0=30, lens1=29, fstop=4.0, roll1=4.0)),\r\n410:     (\"Cam_S04_Hairpin\", 12.4, 16.6, \"fixed\",\r\n411:      dict(t_pass=16.00, lead=-14.0, side=-8.6, h=0.80,\r\n412:           framing=0.34, fstop=5.0, aim_lerp=0.66, roll=-1.5)),\r\n413:     (\"Cam_S05_ChaseAintree\", 16.6, 20.0, \"chase\",\r\n414:      dict(back0=7.2, back1=9.0, side0=0.6, side1=-1.2, h0=0.60, h1=1.05,\r\n415:           aim0=3.0, aim1=4.0, lens0=36, lens1=32, fstop=4.0, roll1=-1.5)),\r\n416:     (\"Cam_S06_Orbit1\", 20.0, 23.4, \"orbit\",\r\n417:      dict(a0=104, a1=52, r0=10.5, r1=8.0, h0=1.35, h1=1.05,\r\n418:           lens=44, fstop=3.6, roll=-5.0, roll_end=4.0)),\r\n419:     (\"Cam_S07_ChaseAccel\", 23.4, 26.6, \"chase\",\r\n420:      dict(back0=9.4, back1=7.8, side0=-1.0, side1=1.2, h0=0.80, h1=0.55,\r\n421:           aim0=4.4, aim1=3.6, lens0=32, lens1=34, fstop=4.0, roll1=1.0)),\r\n422:     (\"Cam_S08_FastPan\", 26.6, 30.6, \"fixed\",\r\n423:      dict(t_pass=29.50, lead=0.0, side=14.0, h=0.85,\r\n424:           framing=0.26, fstop=5.6, aim_lerp=0.74, roll=-2.0)),\r\n425:     (\"Cam_S09_WheelMacro\", 30.6, 32.8, \"wheel\",\r\n426:      dict(side0=4.20, side1=3.90, back0=-1.20, back1=-0.45, h0=0.48, h1=0.62,\r\n427:           lens0=34, lens1=30, fstop=3.2)),\r\n428:     (\"Cam_S09b_ChaseFast\", 32.8, 35.2, \"chase\",\r\n429:      dict(back0=6.4, back1=8.2, side0=-1.4, side1=1.0, h0=0.50, h1=0.85,\r\n430:           aim0=3.6, aim1=4.6, lens0=30, lens1=27, fstop=3.0, roll1=2.2)),\r\n431:     (\"Cam_S10_OrbitBrooklands\", 34.0, 37.4, \"orbit\",\r\n432:      dict(a0=98, a1=44, r0=9.2, r1=7.0, h0=1.15, h1=0.95,\r\n433:           lens=42, fstop=3.4, roll=3.0, roll_end=-2.5)),\r\n434:     (\"Cam_S11_Luffield\", 37.4, 41.8, \"fixed\",\r\n435:      dict(t_pass=41.40, lead=-9.0, side=10.5, h=1.0,\r\n436:           framing=0.32, fstop=4.5, aim_lerp=0.66, roll=1.2)),\r\n437:     (\"Cam_S12_ChaseWoodcote\", 41.8, 45.0, \"chase\",\r\n438:      dict(back0=7.6, back1=9.4, side0=-0.8, side1=1.4, h0=0.75, h1=1.35,\r\n439:           aim0=3.4, aim1=4.4, lens0=34, lens1=30, fstop=4.0, roll1=2.0)),\r\n440:     (\"Cam_S13_WoodcoteTele\", 45.0, 48.4, \"fixed\",\r\n441:      dict(t_pass=47.40, lead=-95.0, side=12.0, h=2.4,\r\n442:           framing=0.24, fstop=8.0, aim_lerp=0.55, roll=0.0)),\r\n443:     (\"Cam_S14_HeliDrop\", 48.4, 52.0, \"heli\", dict(h0=30.0, h1=12.0, back=24.0, lens=85, fstop=7.0)),\r\n444:     (\"Cam_S15_OrbitCopse\", 52.0, 55.6, \"orbit\",\r\n445:      dict(a0=108, a1=48, r0=11.0, r1=7.8, h0=1.5, h1=1.05,\r\n446:           lens=40, fstop=3.4, roll=-6.0, roll_end=3.0)),\r\n447:     (\"Cam_S16_ChaseCopse\", 55.6, 59.2, \"chase\",\r\n448:      dict(back0=7.0, back1=8.4, side0=0.5, side1=-1.1, h0=0.55, h1=1.05,\r\n449:           aim0=3.4, aim1=4.4, lens0=36, lens1=32, fstop=4.0, roll1=-2.0)),\r\n450:     (\"Cam_S17_Maggotts\", 59.2, 63.2, \"fixed\",\r\n451:      dict(t_pass=62.50, lead=2.0, side=11.5, h=1.35,\r\n452:           framing=0.28, fstop=4.5, aim_lerp=0.66, roll=-1.0)),\r\n453:     (\"Cam_S18_ChaseRise2\", 63.2, 66.8, \"chase\",\r\n454:      dict(back0=9.0, back1=6.6, side0=-1.4, side1=3.8, h0=1.30, h1=4.6,\r\n455:           aim0=4.6, aim1=2.8, lens0=30, lens1=28, fstop=4.0, roll1=5.0)),\r\n456:     (\"Cam_S19_Onboard3\", 66.8, 70.4, \"onboard\", dict(fwd=2.48, h=0.48, lens=20, fstop=5.6)),\r\n457:     (\"Cam_S20_StoweTele\", 70.4, 74.8, \"fixed\",\r\n458:      dict(t_pass=74.60, lead=-130.0, side=-13.0, h=2.8,\r\n459:           framing=0.22, fstop=8.0, aim_lerp=0.55, roll=0.0)),\r\n460:     (\"Cam_S21_OrbitStowe\", 74.8, 78.4, \"orbit\",\r\n461:      dict(a0=112, a1=50, r0=11.5, r1=8.0, h0=1.6, h1=1.1,\r\n462:           lens=38, fstop=3.4, roll=5.0, roll_end=-3.0)),\r\n463:     (\"Cam_S22_ChaseLow\", 78.4, 82.0, \"chase\",\r\n464:      dict(back0=6.6, back1=9.6, side0=1.1, side1=-1.5, h0=0.52, h1=1.45,\r\n465:           aim0=3.0, aim1=4.4, lens0=38, lens1=31, fstop=3.2, roll1=-3.0)),\r\n466:     (\"Cam_S23_HeliReveal\", 82.0, 85.6, \"heli\", dict(h0=22.0, h1=44.0, back=32.0, lens=70, fstop=8.0)),\r\n467:     (\"Cam_S24_Club\", 85.6, 88.4, \"fixed\",\r\n468:      dict(t_pass=87.30, lead=-8.0, side=-9.0, h=1.2,\r\n469:           framing=0.30, fstop=4.5, aim_lerp=0.66, roll=-1.0)),\r\n470:     (\"Cam_S25_AerialOut\", 88.4, 90.34, \"aerial\",\r\n471:      dict(back0=9.0, back1=17.0, side0=2.5, side1=9.0, h0=3.0, h1=11.0,\r\n472:           lens0=56, lens1=46, fstop=4.5)),\r\n473: ]\r\n474: \r\n475: \r\n476: def TF(t):\r\n477:     \"\"\"赛道时间 -> 帧号，吸附到最近拍点\"\"\"\r\n478:     f = 1.0 + t / DT\r\n479:     k = round((f - 1) / BEAT_F)\r\n480:     return max(1, min(FRAME_END, int(round(1 + k * BEAT_F))))\r\n481: \r\n482: \r\n483: _windows = []\r\n484: for name, t0, t1, typ, pr in SHOTS:\r\n485:     _windows.append([name, TF(t0), TF(t1), typ, pr])\r\n486: \r\n487: # 顺序修正：严格递增、不许为负长度\r\n488: for i in range(len(_windows)):\r\n489:     _windows[i][1] = max(_windows[i][1], 1)\r\n490:     _windows[i][2] = min(FRAME_END, max(_windows[i][2], _windows[i][1] + 2))\r\n491:     if i and _windows[i][1] <= _windows[i - 1][2]:\r\n492:         _windows[i][1] = _windows[i - 1][2] + 1\r\n493:         _windows[i][2] = max(_windows[i][2], _windows[i][1] + 2)\r\n494: _windows[-1][2] = FRAME_END\r\n495: \r\n496: _cams = {}\r\n497: _markers = []\r\n498: for name, f0, f1, typ, pr in _windows:\r\n499:     cam = make_cam(name, pr.get('lens', pr.get('lens0', 50)), pr.get('fstop', 4.0))\r\n500:     _cams[name] = cam\r\n501:     _markers.append((name, f0))\r\n502:     span = max(1, f1 - f0)\r\n503: \r\n504:     if typ == \"chase\":\r\n505:         for f in range(f0, f1 + 1):\r\n506:             e = smooth((f - f0) / span)\r\n507:             fd = frame_data[f]\r\n508:             loc = C(fd, pr['back0'] + (pr['back1'] - pr['back0']) * e,\r\n509:                     pr['side0'] + (pr['side1'] - pr['side0']) * e,\r\n510:                     pr['h0'] + (pr['h1'] - pr['h0']) * e)\r\n511:             loc += Vector((noise(f * 0.06, 11.0, 0.026), noise(f * 0.06, 12.0, 0.026),\r\n512:                            noise(f * 0.09, 13.0, 0.018)))\r\n513:             tgt = T(fd, pr['aim0'] + (pr['aim1'] - pr['aim0']) * e, 0, 0.52)\r\n514:             key_cam(cam, f, loc, tgt,\r\n515:                     roll=pr.get('roll0', 0.0) + (pr.get('roll1', 0.0) - pr.get('roll0', 0.0)) * e\r\n516:                     + noise(f * 0.05, 14.0, 0.5),\r\n517:                     fstop=pr['fstop'],\r\n518:                     lens=pr['lens0'] + (pr['lens1'] - pr['lens0']) * e)\r\n519: \r\n520:     elif typ == \"fixed\":\r\n521:         fr = max(f0, min(f1, int(round(1 + pr['t_pass'] / DT))))\r\n522:         loc = C(frame_data[fr], pr['lead'], pr['side'], pr['h'])\r\n523:         aim = None\r\n524:         for f in range(f0, f1 + 1):\r\n525:             fd = frame_data[f]\r\n526:             tgt = fd['pos'] + Vector((0, 0, 0.34))\r\n527:             aim = tgt if aim is None else aim.lerp(tgt, pr.get('aim_lerp', 0.7))\r\n528:             dv = loc - fd['pos']\r\n529:             d = max(2.0, dv.length)\r\n530:             cos_a = abs(fd['fwd'].dot(dv.normalized()))\r\n531:             key_cam(cam, f, loc, aim, roll=pr.get('roll', 0.0), fstop=pr['fstop'],\r\n532:                     lens=lens_for_framing(d, pr['framing'], cos_a), lens_key=True)\r\n533: \r\n534:     elif typ == \"wheel\":\r\n535:         for f in range(f0, f1 + 1):\r\n536:             e = smooth((f - f0) / span)\r\n537:             fd = frame_data[f]\r\n538:             loc = C(fd, pr['back0'] + (pr['back1'] - pr['back0']) * e,\r\n539:                     pr['side0'] + (pr['side1'] - pr['side0']) * e,\r\n540:                     pr['h0'] + (pr['h1'] - pr['h0']) * e)\r\n541:             loc += Vector((noise(f * 0.17, 81.0, 0.010), noise(f * 0.17, 82.0, 0.010),\r\n542:                            noise(f * 0.21, 83.0, 0.007)))\r\n543:             tgt = fd['pos'] + fd['right'] * 0.72 + fd['fwd'] * (1.35 - 0.5 * e) + Vector((0, 0, 0.34))\r\n544:             key_cam(cam, f, loc, tgt, roll=1.2 - 2.4 * e, fstop=pr['fstop'],\r\n545:                     lens=pr['lens0'] + (pr['lens1'] - pr['lens0']) * e)\r\n546: \r\n547:     elif typ == \"onboard\":\r\n548:         for f in range(f0, f1 + 1):\r\n549:             fd = frame_data[f]\r\n550:             vib = 0.005 + 0.004 * (fd['v'] / 90.0)\r\n551:             loc = fd['pos'] + fd['fwd'] * pr['fwd'] + Vector((0, 0, pr['h']))\r\n552:             loc += Vector((noise(f * 0.95, 31.0, vib), noise(f * 0.95, 32.0, vib),\r\n553:                            noise(f * 1.15, 33.0, vib * 0.6)))\r\n554:             tgt = loc + fd['fwd'] * 22.0 + Vector((0, 0, -0.34))\r\n555:             key_cam(cam, f, loc, tgt, roll=noise(f * 0.3, 34.0, 0.8), fstop=pr['fstop'],\r\n556:                     lens=pr['lens'], lens_key=False)\r\n557: \r\n558:     elif typ == \"orbit\":\r\n559:         for f in range(f0, f1 + 1):\r\n560:             e = smooth((f - f0) / span)\r\n561:             fd = frame_data[f]\r\n562:             ang = radians(pr['a0'] + (pr['a1'] - pr['a0']) * e)\r\n563:             rad = pr['r0'] + (pr['r1'] - pr['r0']) * e\r\n564:             ox = fd['fwd'].x * cos(ang) - fd['right'].x * sin(ang)\r\n565:             oy = fd['fwd'].y * cos(ang) - fd['right'].y * sin(ang)\r\n566:             loc = fd['pos'] + Vector((ox, oy, 0)) * rad + Vector(\r\n567:                 (0, 0, pr['h0'] + (pr['h1'] - pr['h0']) * e))\r\n568:             loc += Vector((noise(f * 0.07, 51.0, 0.035), noise(f * 0.07, 52.0, 0.035),\r\n569:                            noise(f * 0.09, 53.0, 0.018)))\r\n570:             tgt = fd['pos'] + Vector((0, 0, 0.42))\r\n571:             key_cam(cam, f, loc, tgt, roll=pr['roll'] + (pr['roll_end'] - pr['roll']) * e,\r\n572:                     fstop=pr['fstop'], lens=pr['lens'], lens_key=False)\r\n573: \r\n574:     elif typ == \"heli\":\r\n575:         for f in range(f0, f1 + 1):\r\n576:             e = smooth((f - f0) / span)\r\n577:             fd = frame_data[f]\r\n578:             loc = C(fd, pr['back'], 0.0, pr['h0'] + (pr['h1'] - pr['h0']) * e)\r\n579:             loc += Vector((noise(f * 0.03, 71.0, 0.09), noise(f * 0.03, 72.0, 0.09), 0))\r\n580:             tgt = fd['pos'] + fd['fwd'] * 2.0 + Vector((0, 0, 0.6))\r\n581:             key_cam(cam, f, loc, tgt, roll=noise(f * 0.02, 73.0, 1.1), fstop=pr['fstop'],\r\n582:                     lens=pr['lens'], lens_key=False)\r\n583: \r\n584:     elif typ == \"aerial\":\r\n585:         for f in range(f0, f1 + 1):\r\n586:             e = smooth((f - f0) / span)\r\n587:             fd = frame_data[f]\r\n588:             loc = C(fd, pr['back0'] + (pr['back1'] - pr['back0']) * e,\r\n589:                     pr['side0'] + (pr['side1'] - pr['side0']) * e,\r\n590:                     pr['h0'] + (pr['h1'] - pr['h0']) * e)\r\n591:             loc += Vector((noise(f * 0.04, 91.0, 0.03 * (1 - e)), noise(f * 0.04, 92.0, 0.03 * (1 - e)),\r\n592:                            noise(f * 0.05, 93.0, 0.02)))\r\n593:             tgt = fd['pos'] + fd['fwd'] * 1.2 + Vector((0, 0, 0.55))\r\n594:             key_cam(cam, f, loc, tgt, roll=-1.0 + 2.0 * e, fstop=pr['fstop'],\r\n595:                     lens=pr['lens0'] + (pr['lens1'] - pr['lens0']) * e)\r\n596: \r\n597:     print(\"CAM %-24s %4d-%4d  t=%5.2f..%5.2f s  %-8s\" %\r\n598:           (name, f0, f1, frame_data[f0]['t'], frame_data[f1]['t'], typ))\r\n599: \r\n600: \r\n601: # 机位切换\r\n602: scene.timeline_markers.clear()\r\n603: for name, f0 in _markers:\r\n604:     mk = scene.timeline_markers.new(name, frame=f0)\r\n605:     mk.camera = _cams[name]\r\n606: scene.camera = _cams[SHOTS[0][0]]\r\n607: \r\n608: # 收尾淡出：最后 14 帧压曝光\r\n609: scene.view_settings.exposure = 0.50\r\n610: scene.view_settings.keyframe_insert(\"exposure\", frame=FRAME_END - 16)\r\n611: scene.view_settings.exposure = -3.6\r\n612: scene.view_settings.keyframe_insert(\"exposure\", frame=FRAME_END)\r\n613: \r\n614: \r\n615: # ---------------------------------------------------------------\r\n616: # 6. 渲染设置\r\n617: # ---------------------------------------------------------------\r\n618: scene.render.engine = 'BLENDER_EEVEE'\r\n619: scene.eevee.taa_render_samples = 40\r\n620: scene.eevee.use_raytracing = True\r\n621: try:\r\n622:     scene.eevee.ray_tracing_method = 'SCREEN'\r\n623: except Exception:\r\n624:     pass\r\n625: scene.render.resolution_x = 1920\r\n626: scene.render.resolution_y = 1080\r\n627: scene.render.resolution_percentage = 100\r\n628: scene.render.fps = FPS\r\n629: scene.frame_start = 1\r\n630: scene.frame_end = FRAME_END\r\n631: scene.render.use_motion_blur = True\r\n632: scene.render.motion_blur_shutter = 0.17\r\n633: scene.render.motion_blur_position = 'CENTER'\r\n634: scene.render.image_settings.file_format = 'JPEG'\r\n635: scene.render.image_settings.quality = 95\r\n636: scene.render.filepath = os.path.join(FRAMES_DIR, \"f_\")\r\n637: scene.view_settings.view_transform = 'AgX'\r\n638: for look in ('High Contrast', 'AgX - High Contrast', 'Medium High Contrast'):\r\n639:     try:\r\n640:         scene.view_settings.look = look\r\n641:         break\r\n642:     except Exception:\r\n643:         continue\r\n644: scene.view_settings.exposure = 0.50\r\n645: scene.view_settings.gamma = 1.0\r\n646: \r\n647: # 泛光\r\n648: try:\r\n649:     ng = bpy.data.node_groups.new(\"Comp_V5\", 'CompositorNodeTree')\r\n650:     rl = ng.nodes.new(\"CompositorNodeRLayers\")\r\n651:     glare = ng.nodes.new(\"CompositorNodeGlare\")\r\n652:     for val in (\"Bloom\", \"BLOOM\", \"bloom\"):\r\n653:         try:\r\n654:             glare.inputs['Type'].default_value = val\r\n655:             break\r\n656:         except Exception:\r\n657:             continue\r\n658:     for nm, v in ((\"Threshold\", 2.0), (\"Strength\", 0.16), (\"Size\", 6)):\r\n659:         if nm in glare.inputs:\r\n660:             try:\r\n661:                 glare.inputs[nm].default_value = v\r\n662:             except Exception:\r\n663:                 pass\r\n664:     try:\r\n665:         comp = ng.nodes.new(\"CompositorNodeComposite\")\r\n666:     except Exception:\r\n667:         comp = ng.nodes.new(\"NodeGroupOutput\")\r\n668:         if not any(s.name == \"Image\" for s in ng.interface.items_tree):\r\n669:             ng.interface.new_socket(name=\"Image\", in_out='OUTPUT', socket_type='NodeSocketColor')\r\n670:     ng.links.new(rl.outputs['Image'], glare.inputs['Image'])\r\n671:     ng.links.new(glare.outputs['Image'], comp.inputs['Image'])\r\n672:     scene.compositing_node_group = ng\r\n673:     scene.use_nodes = True\r\n674:     print(\"COMPOSITOR OK\")\r\n675: except Exception as e:\r\n676:     print(\"COMPOSITOR FAILED:\", e)\r\n677: \r\n678: bpy.ops.wm.save_as_mainfile(filepath=OUT)\r\n679: print(\"ANIM SAVED:\", OUT)\r\n680: \r\n681: # ---------------------------------------------------------------\r\n682: # 7. 测试渲染\r\n683: # ---------------------------------------------------------------\r\n684: def render_frames(frames, outdir, res=1280, samples=24):\r\n685:     os.makedirs(outdir, exist_ok=True)\r\n686:     scene.render.resolution_x = res\r\n687:     scene.render.resolution_y = int(res * 9 / 16)\r\n688:     scene.eevee.taa_render_samples = samples\r\n689:     for f in frames:\r\n690:         scene.frame_set(f)\r\n691:         scene.render.filepath = os.path.join(outdir, f\"test_{f:04d}.jpg\")\r\n692:         bpy.ops.render.render(write_still=True)\r\n693:         print(\"TEST FRAME\", f)\r\n694: \r\n695: \r\n696: test = argval(\"--test\")\r\n697: if test:\r\n698:     render_frames([int(x) for x in str(test).split(\",\")], os.path.join(PROJ, \"renders_v5\", \"test\"),\r\n699:                   res=1600, samples=24)\r\n700: \r\n701: if argval(\"--render\"):\r\n702:     os.makedirs(FRAMES_DIR, exist_ok=True)\r\n703:     scene.render.resolution_x = 1920\r\n704:     scene.render.resolution_y = 1080\r\n705:     scene.render.filepath = os.path.join(FRAMES_DIR, \"f_\")\r\n706:     bpy.ops.render.render(animation=True)\r\n707:     print(\"RENDER DONE\")\r"}
{"step_index":21,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-18T04:47:42Z","content":"Created At: 2026-11-18T12:47:42+08:00\nCompleted At: 2026-11-18T12:47:43+08:00\nShowing lines 1-35 of 35\n1: # scenes/ — F1 场景库\n2: \n3: 给两条线共用的一份场景定义：**Blender 程序化渲染**（`pipeline/`）和 **AI 视频模型提示词**（Veo / Sora / Kling / Seedance）。\n4: \n5: 现在项目里只有两个赛道数据包（Silverstone、Monza），跑的是一种天气（英国午后）。这个文件夹解决\"接下来渲什么、怎么说\"——先把场景说清楚，再决定建不建。\n6: \n7: ## 文件\n8: \n9: | 文件 | 内容 | 什么时候看 |\n10: |---|---|---|\n11: | [F1_CIRCUITS_MASTER.md](F1_CIRCUITS_MASTER.md) | 历届赛历总表：2026 全 24 站 + 已退出赛道，地点/类型/气候/视觉锚点 | 想换赛道、想查某站真实长什么样 |\n12: | [SCENE_OPTIONS.md](SCENE_OPTIONS.md) | **8 个精选场景卡 + 4 个备选**，含天气/时段/光照数值/AI 提示词/落地代价 | 定下一个要拍什么 |\n13: | [weather_matrix.md](weather_matrix.md) | W1–W10 天气预设库，参数化，可直接拼进提示词 | 换天气、做同赛道多版本 |\n14: | [scene_schema.md](scene_schema.md) | 场景卡字段规范 | 要脚本批量生成 / 加新场景 |\n15: | [prompts/](prompts/) | 每个精选场景一份可整段复制的提示词包 | 直接出图 / 出视频 |\n16: \n17: ## 三条使用路径\n18: \n19: **只想出 AI 视频**：读 `SCENE_OPTIONS.md` 挑一个 → 打开 `prompts/0X_*.md` → 抄提示词 → 不用管 Blender。\n20: \n21: **要在 Blender 里真渲染**：看场景卡里\"落地\"那一节，写着这个赛道 `track_data/` 有没有数据、要新建哪些资产、EEVEE 里天气怎么实现。\n22: \n23: **要批量做多版本**：`weather_matrix.md` 选天气 × `SCENE_OPTIONS.md` 选地点，交叉组合，字段按 `scene_schema.md` 填。\n24: \n25: ## 和现有工程的关系\n26: \n27: - 现在 `track_data/` 只有 Silverstone + Monza，`build_track.py` 换 3 个参数重跑就能生成新赛道，但**街道赛（摩纳哥/新加坡/巴库/维加斯）OSM 里没有 circuit relation**，得手绘中心线或从官方赛道图拟合，代价高一个量级。场景卡里都标了。\n28: - 现有 `v5_env.py` 生成的环境是银石专用（草地缓冲带、砾石坑、6 座看台、机库）。换到斯帕要加森林；换到蒙扎要改看台为红色钢结构+直道；换到街道赛基本要重写环境层。\n29: - 天气目前只有一套太阳+补光（`V5_07_Lighting`）。`weather_matrix.md` 里 W4 之后（阴/雨/雾/夜）都需要改光照和加体积介质，属于环境层工作，不是调个参数。\n30: \n31: ## 选场景的三条硬约束\n32: \n33: 1. **这个场景在视频里能不能认出来**——观众三秒内得知道\"这是摩纳哥\"。认不出的场景不值得渲。\n34: 2. **天气是不是这站的性格**——斯帕没雨、新加坡没灯，等于换了个地方。\n35: 3. **资产能不能复用**——银石/蒙扎已有几何，改天气比重建赛道便宜十倍。"}
{"step_index":22,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-18T04:47:43Z","content":"Created At: 2026-11-18T12:47:43+08:00\nCompleted At: 2026-11-18T12:47:43+08:00\nShowing lines 1-63 of 63\n1: # scenes/prompts/ — 提示词库\n2: \n3: ## 日常只看两个文件\n4: \n5: | 文件 | 内容 |\n6: |---|---|\n7: | **[METHOD.md](METHOD.md)** | **方法论**：常驻头尾、赛道真实规则 R1–R10、填空模板、一次完整输入 |\n8: | **[STANDING.txt](STANDING.txt)** | 常驻头/尾的纯文本版，复制粘贴用 |\n9: \n10: 其余都是参考库，需要时再翻。\n11: \n12: ---\n13: \n14: 目标模型 **Sunburst**（GPT Image 2.5 写实档）出关键帧，图生视频模型出动态。三类提示词分开写、分开存、分开装配。\n15: \n16: ## 三类提示词的入口\n17: \n18: | 类型 | 回答的问题 | 长度 | 文件 |\n19: |---|---|---|---|\n20: | **画风** | 用什么眼睛看 | 20–40 词 | [style_library.md](style_library.md) ST1–ST6 |\n21: | **关键帧** | 这一帧长什么样 | 120–220 词 | [prompt_library.json](prompt_library.json) → [compiled/](compiled/) |\n22: | **视频** | 从这一帧怎么变 | 40–80 词 | [video_library.json](video_library.json) → [compiled_video/](compiled_video/) |\n23: \n24: **先看 [PROMPT_STRUCTURE.md](PROMPT_STRUCTURE.md)** —— 三类提示词的结构模板、信息分工表、交接协议、三个最常见的失败。\n25: \n26: ## 全部文件\n27: \n28: | 文件 | 内容 |\n29: |---|---|\n30: | [PROMPT_STRUCTURE.md](PROMPT_STRUCTURE.md) | **三类提示词的结构与分工**（总纲） |\n31: | [style_library.md](style_library.md) | 画风库 ST1–ST6 + 场景推荐 + 三处冲突处理 |\n32: | [negative_library.md](negative_library.md) | 限制词库：三层装配、N0–N9 十组、24 块场景专属 |\n33: | [prompt_library.json](prompt_library.json) | 24 个机位的关键帧正文 + 分层限制词 |\n34: | [video_library.json](video_library.json) | 24 个机位的 motion + Keep + Avoid |\n35: | [build_prompts.py](build_prompts.py) | 关键帧装配，core ≤65 / scene ≤50 |\n36: | [build_video_prompts.py](build_video_prompts.py) | 视频装配，motion 40–80 词 + 方向词检查 |\n37: | [compiled/](compiled/) | **成品图提示词**，直接粘 |\n38: | [compiled_video/](compiled_video/) | **成品视频提示词**，直接粘 |\n39: \n40: 人读版 8 个场景：[01](01_silverstone_after_rain.md) · [02](02_spa_fog_eau_rouge.md) · [03](03_monaco_golden_harbour.md) · [04](04_monza_midday_heat.md) · [05](05_singapore_night_rain.md) · [06](06_zandvoort_dune_overcast.md) · [07](07_vegas_neon_night.md) · [08](08_interlagos_thunderstorm.md) · [00 骨架](00_common_skeleton.md)\n41: \n42: ## 一条流水线\n43: \n44: ```\n45: 选画风(STn)  →  关键帧提示词  →  出图  →  选帧  →  视频提示词  →  出片\n46:                  compiled/              首帧       compiled_video/\n47: ```\n48: \n49: 命名：`ST2_S1_01.png`（图）、`ST2_S1_01_vid.mp4`（视频）。换画风换前缀，不覆盖。\n50: \n51: ## 重跑\n52: \n53: ```bash\n54: python scenes/prompts/build_prompts.py          # 关键帧，24 个 → compiled/\n55: python scenes/prompts/build_video_prompts.py    # 视频，24 个 → compiled_video/\n56: python scenes/prompts/build_video_prompts.py --check   # 只查\n57: ```\n58: \n59: ## 三条不能忘的\n60: \n61: 1. **画风只写一次**，抽成 ST 编号。每张重写会让 24 张之间风格漂移。\n62: 2. **视频提示词不是图提示词的扩写**，是差分量。40–80 词，一个主动作。\n63: 3. **别把图提示词粘进视频模型**，150 词里 90% 是静态描述，结果是抖动的静止图。\n(no newline at end of file)"}
