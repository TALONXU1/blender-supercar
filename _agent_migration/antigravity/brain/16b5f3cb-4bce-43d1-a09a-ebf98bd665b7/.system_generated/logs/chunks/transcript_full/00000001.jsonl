rr * 0.55\r\n883:     strip_uv(PIT_S0, PIT_S1, _o0, _o1, _z, M_CROWD, f\"V5_PitTopTier_{_rr}\", PIT_LEN, up=True)\r\n884: # 楼顶围栏（发光细条）\r\n885: strip_uv(PIT_S0, PIT_S1, PIT_BACK + 0.3, PIT_BACK + 0.5, GAR_H + 2.4, M_STRIP, \"V5_PitTopRail\", PIT_LEN)\r\n886: \r\n887: # ---------------------------------------------------------------\r\n888: # 11b. 赛道道具：广告板 / 刹车牌 / 大屏 / 天桥 / 裁判点\r\n889: # ---------------------------------------------------------------\r\n890: def ad_board(s, side, w=11.0, hgt=3.6, off=WALL_OFF + 2.5, name=\"\"):\r\n891:     p, h, r, k = at_s(s)\r\n892:     base = p + r * (side * off)\r\n893:     box(name, (base.x, base.y, 1.0 + hgt / 2), (w, 0.12, hgt), M_AD, rot_z=h)\r\n894: \r\n895: \r\n896: def brake_board(s, side, num, off=HALF_W + 2.4, name=\"\"):\r\n897:     p, h, r, k = at_s(s)\r\n898:     base = p + r * (side * off)\r\n899:     box(name, (base.x, base.y, 1.05), (1.0, 0.08, 1.25), M_BRAKE[num], rot_z=h)\r\n900:     # 两根细杆\r\n901:     for d in (-0.32, 0.32):\r\n902:         box(name + \"_pole\", (base.x, base.y, 0.5), (0.05, 0.05, 1.0), M_STEEL, rot_z=h)\r\n903: \r\n904: \r\n905: def bigscreen(s, side, off=WALL_OFF + 8.0, w=22.0, hgt=9.0, name=\"V5_Screen\"):\r\n906:     p, h, r, k = at_s(s)\r\n907:     base = p + r * (side * off)\r\n908:     box(name, (base.x, base.y, 5.5), (w, 0.45, hgt), M_SCREEN, rot_z=h)\r\n909:     for dx in (-w / 2 + 0.5, w / 2 - 0.5):\r\n910:         box(name + \"_leg\", (base.x + cos(h) * dx, base.y + sin(h) * dx, 2.0),\r\n911:             (0.5, 0.5, 4.0), M_STEEL, rot_z=h)\r\n912: \r\n913: \r\n914: def footbridge(s, name=\"V5_Bridge\"):\r\n915:     p, h, r, k = at_s(s)\r\n916:     fwd = Vector((cos(h), sin(h), 0.0))\r\n917:     off = HALF_W + 7.0\r\n918:     # 桥面：横跨赛道，宽（沿 fwd）4.5 m，高 6.0 m\r\n919:     a = p - r * off - fwd * 2.25\r\n920:     b = p + r * off - fwd * 2.25\r\n921:     c = p + r * off + fwd * 2.25\r\n922:     d = p - r * off + fwd * 2.25\r\n923:     v = [(a.x, a.y, 6.0), (b.x, b.y, 6.0), (c.x, c.y, 6.0), (d.x, d.y, 6.0),\r\n924:          (a.x, a.y, 5.4), (b.x, b.y, 5.4), (c.x, c.y, 5.4), (d.x, d.y, 5.4)]\r\n925:     fc = [(0, 1, 2, 3), (4, 5, 6, 7), (0, 4, 5, 1), (1, 5, 6, 2),\r\n926:           (2, 6, 7, 3), (3, 7, 4, 0)]\r\n927:     mesh_from(name, v, fc, M_STEEL, up=False)\r\n928:     # 桥墩\r\n929:     for sd in (-1, 1):\r\n930:         bp = p + r * (sd * off)\r\n931:         box(name + \"_pier\", (bp.x, bp.y, 2.8), (0.6, 0.6, 5.6), M_CONC)\r\n932:     # 栏杆（桥面两侧发光条）\r\n933:     for sd in (-1, 1):\r\n934:         rr = fwd * (2.25 * sd)\r\n935:         l0 = p - r * off + rr\r\n936:         l1 = p + r * off + rr\r\n937:         lv = [(l0.x, l0.y, 6.4), (l1.x, l1.y, 6.4)]\r\n938:         # 简化成两根细 box\r\n939:         mid = (l0 + l1) / 2\r\n940:         box(name + \"_rail\", (mid.x, mid.y, 6.5), (0.1, off * 2, 0.1), M_STRIP, rot_z=h)\r\n941: \r\n942: \r\n943: # ① 广告板：沿整圈每 60 m 一块（护栏外侧；跳过维修区主直道段，避免与车库楼/看台穿插）\r\n944: _ad_i = 0\r\n945: _s = 30.0\r\n946: while _s < LAP_LEN - 5:\r\n947:     side = 1 if _ad_i % 2 == 0 else -1\r\n948:     if not (PIT_S0 - 10 < _s < PIT_S1 + 10):\r\n949:         ad_board(_s, side, name=f\"V5_Ad_{_ad_i}\")\r\n950:         _ad_i += 1\r\n951:     _s += 60.0\r\n952: print(\"ad boards:\", _ad_i)\r\n953: \r\n954: # ② 刹车距离牌：慢弯（vmin<130）外侧，弯前 150/100/50 m\r\n955: _bi = 0\r\n956: for (a, b) in _runs:\r\n957:     vmin = min(VEL[a:b + 1]) * 3.6\r\n958:     if vmin < 130 and (b - a) > 15 and _bi < 3:\r\n959:         apex_s = (S[a] + S[b]) / 2\r\n960:         side = 1 if SIGNED_K[a] > 0 else -1\r\n961:         for dist_, num in ((150, \"150\"), (100, \"100\"), (50, \"50\")):\r\n962:             brake_board(apex_s - dist_, side, num, name=f\"V5_Brake_{_bi}_{num}\")\r\n963:         _bi += 1\r\n964: print(\"brake boards:\", _bi * 3)\r\n965: \r\n966: # ③ 大屏：维修区出口内侧 + 赛道中段（避开车库楼遮挡）\r\n967: bigscreen(560.0, -1, name=\"V5_Screen_A\")\r\n968: bigscreen(2600.0, -1, name=\"V5_Screen_B\")\r\n969: \r\n970: # ④ 人行天桥：两条直道\r\n971: footbridge(950.0, \"V5_Bridge_A\")\r\n972: f