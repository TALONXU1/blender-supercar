{"step_index":34,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-18T04:49:35Z","content":"Created At: 2026-11-18T12:49:35+08:00\nCompleted At: 2026-11-18T12:49:51+08:00\nShowing lines 1-87 of 87\n1: # -*- coding: utf-8 -*-\r\n2: \"\"\"V5 预览渲染 — 检查赛道几何 / 光照 / 材质（不动画）\"\"\"\r\n3: import bpy, json, os, math\r\n4: from mathutils import Vector, Matrix, Euler\r\n5: \r\n6: PROJ = r\"D:\\项目session\\blender-supercar\"\r\n7: BLEND = os.path.join(PROJ, \"LATEST\", \"v5_stage_env.blend\")\r\n8: OUT = os.path.join(PROJ, \"renders_v5\", \"preview\")\r\n9: os.makedirs(OUT, exist_ok=True)\r\n10: bpy.ops.wm.open_mainfile(filepath=BLEND)\r\n11: sc = bpy.context.scene\r\n12: P = json.load(open(os.path.join(PROJ, \"track_data\", \"silverstone_track.json\"), encoding=\"utf-8\"))[\"points\"]\r\n13: \r\n14: \r\n15: def at_s(s):\r\n16:     n = len(P)\r\n17:     s = s % P[-1][\"s\"]\r\n18:     lo, hi = 0, n - 1\r\n19:     while hi - lo > 1:\r\n20:         m = (lo + hi) // 2\r\n21:         if P[m][\"s\"] <= s:\r\n22:             lo = m\r\n23:         else:\r\n24:             hi = m\r\n25:     f = (s - P[lo][\"s\"]) / max(P[lo + 1][\"s\"] - P[lo][\"s\"], 1e-9)\r\n26:     x = P[lo][\"xy\"][0] * (1 - f) + P[lo + 1][\"xy\"][0] * f\r\n27:     y = P[lo][\"xy\"][1] * (1 - f) + P[lo + 1][\"xy\"][1] * f\r\n28:     a = math.radians(P[lo][\"heading_deg\"])\r\n29:     b = math.radians(P[lo + 1][\"heading_deg\"])\r\n30:     d = (b - a + math.pi) % (2 * math.pi) - math.pi\r\n31:     h = a + d * f\r\n32:     return Vector((x, y, 0.0)), h, Vector((math.sin(h), -math.cos(h), 0.0))\r\n33: \r\n34: \r\n35: cd = bpy.data.cameras.new(\"CAM_PREV\")\r\n36: cam = bpy.data.objects.new(\"CAM_PREV\", cd)\r\n37: sc.collection.objects.link(cam)\r\n38: sc.camera = cam\r\n39: cd.clip_start = 0.05\r\n40: cd.clip_end = 6000\r\n41: cd.dof.use_dof = False\r\n42: \r\n43: sc.render.engine = 'BLENDER_EEVEE'\r\n44: sc.eevee.taa_render_samples = 24\r\n45: sc.eevee.use_raytracing = True\r\n46: sc.render.resolution_x = 1600\r\n47: sc.render.resolution_y = 900\r\n48: sc.render.image_settings.file_format = 'JPEG'\r\n49: sc.render.image_settings.quality = 92\r\n50: sc.view_settings.view_transform = 'AgX'\r\n51: for look in ('High Contrast', 'AgX - High Contrast', 'Medium High Contrast'):\r\n52:     try:\r\n53:         sc.view_settings.look = look\r\n54:         break\r\n55:     except Exception:\r\n56:         continue\r\n57: sc.view_settings.exposure = -0.25\r\n58: \r\n59: \r\n60: def shoot(name, loc, tgt, lens):\r\n61:     loc = Vector(loc)\r\n62:     d = Vector(tgt) - loc\r\n63:     cam.location = loc\r\n64:     cam.rotation_euler = d.to_track_quat('-Z', 'Y').to_euler()\r\n65:     cd.lens = lens\r\n66:     sc.render.filepath = os.path.join(OUT, name + \".jpg\")\r\n67:     bpy.ops.render.render(write_still=True)\r\n68:     print(\"SHOT\", name)\r\n69: \r\n70: \r\n71: # 1) 俯视全场\r\n72: cx = sum(p[\"xy\"][0] for p in P) / len(P)\r\n73: cy = sum(p[\"xy\"][1] for p in P) / len(P)\r\n74: shoot(\"01_top\", (cx, cy + 10, 2100), (cx, cy, 0), 45)\r\n75: # 2) 起跑直道低机位\r\n76: p, h, r = at_s(200)\r\n77: shoot(\"02_startline\", (p + r * 9 - Vector((0, 0, -0.6))), (p + Vector((0, 0, 0.4))), 45)\r\n78: # 3) 弯道低机位（多弯复合段）\r\n79: p, h, r = at_s(5300)\r\n80: shoot(\"03_corner_low\", (p + r * 10 + Vector((0, 0, 0.55))), (p + Vector((0, 0, 0.35))), 50)\r\n81: # 4) 长焦看台 + 护栏\r\n82: p, h, r = at_s(2600)\r\n83: shoot(\"04_stand\", (p + r * 14 - Vector((0, 0, -6.0))), (p + Vector((0, 0, 1.0))), 85)\r\n84: # 5) 路面细节（俯拍路面 + 路肩）\r\n85: p, h, r = at_s(5320)\r\n86: shoot(\"05_kerb\", (p + r * 2 + Vector((0, 0, 26))), (p + Vector((0, 0, 0))), 55)\r\n87: print(\"PREVIEW DONE\")\r"}
{"step_index":35,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-18T04:49:35Z","content":"Created At: 2026-11-18T12:49:35+08:00\nCompleted At: 2026-11-18T12:49:51+08:00\nShowing lines 1-49 of 49\n1: # -*- coding: utf-8 -*-\n2: \"\"\"V5 交付整理：抽帧做剧照 + 拼一张 contact sheet\"\"\"\n3: import os, shutil, glob\n4: from PIL import Image, ImageDraw\n5: \n6: PROJ = r\"D:\\项目session\\blender-supercar\"\n7: FR = os.path.join(PROJ, \"renders_v5\", \"frames\")\n8: OUT = os.path.join(PROJ, \"renders_v5\", \"stills\")\n9: os.makedirs(OUT, exist_ok=True)\n10: \n11: SHOTS = [\n12:     (60, \"01_rear_chase\"), (160, \"02_onboard\"), (250, \"03_chase_rise\"),\n13:     (350, \"04_hairpin\"), (440, \"05_chase_aintree\"), (520, \"06_orbit1\"),\n14:     (600, \"07_chase_accel\"), (700, \"08_fast_pan\"), (760, \"09_wheel_macro\"),\n15:     (820, \"10_chase_fast\"), (870, \"11_orbit_brooklands\"), (950, \"12_luffield\"),\n16:     (1040, \"13_chase_woodcote\"), (1120, \"14_woodcote_tele\"), (1200, \"15_heli_drop\"),\n17:     (1300, \"16_orbit_copse\"), (1380, \"17_chase_copse\"), (1470, \"18_maggotts\"),\n18:     (1560, \"19_chase_rise2\"), (1640, \"20_onboard3\"), (1730, \"21_stowe_tele\"),\n19:     (1830, \"22_orbit_stowe\"), (1920, \"23_chase_low\"), (2010, \"24_heli_reveal\"),\n20:     (2090, \"25_club\"), (2145, \"26_aerial_out\"),\n21: ]\n22: \n23: made = []\n24: for f, name in SHOTS:\n25:     src = os.path.join(FR, \"f_%04d.jpg\" % f)\n26:     if not os.path.exists(src):\n27:         print(\"MISS\", f)\n28:         continue\n29:     dst = os.path.join(OUT, \"shot_%s.jpg\" % name)\n30:     shutil.copyfile(src, dst)\n31:     made.append((f, name, dst))\n32: \n33: print(\"stills:\", len(made))\n34: \n35: # contact sheet 5 x 6\n36: if made:\n37:     tw, th = 384, 216\n38:     cols, rows = 5, (len(made) + 4) // 5\n39:     sheet = Image.new(\"RGB\", (cols * tw, rows * (th + 18)), (10, 10, 12))\n40:     d = ImageDraw.Draw(sheet)\n41:     for i, (f, name, path) in enumerate(made):\n42:         im = Image.open(path).convert(\"RGB\").resize((tw, th), Image.LANCZOS)\n43:         x = (i % cols) * tw\n44:         y = (i // cols) * (th + 18)\n45:         sheet.paste(im, (x, y))\n46:         d.text((x + 6, y + th + 3), \"%s  (f%d)\" % (name, f), fill=(190, 195, 200))\n47:     out = os.path.join(OUT, \"contact_sheet.jpg\")\n48:     sheet.save(out, quality=92)\n49:     print(\"contact sheet:\", out, sheet.size)"}
