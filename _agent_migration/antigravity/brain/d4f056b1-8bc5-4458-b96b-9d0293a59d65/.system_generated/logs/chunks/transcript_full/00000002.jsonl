ch\\v_project.py"}},{"name":"run_command","args":{"CommandLine":"& \"D:\\APPs\\steam\\steamapps\\common\\Blender\\blender.exe\" -b --factory-startup -P C:\\Users\\86052\\.gemini\\antigravity\\brain\\16b5f3cb-4bce-43d1-a09a-ebf98bd665b7\\scratch\\v_project.py 2>&1 | Select-String \"FRAME|  \\(\" | Select-Object -First 80","WaitMsBeforeAsync":10000,"toolSummary":"Project tall objects into camera"}}]}
