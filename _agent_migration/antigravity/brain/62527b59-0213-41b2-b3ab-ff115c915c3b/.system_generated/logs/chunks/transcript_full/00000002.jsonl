y_bridge (0.33 .. 0.50)\n        (0.395, 0.445, a_bk,  0.44),   # Fast Sky-Bridge aero kink\n        # Zone 4: banked_bowl_plunge (0.50 .. 0.70)\n        # 0.502 .. 0.580: Tighter R~60m 188-deg Right-Hand Carousel Bowl (~215 km/h @ 17.5 deg bank!)\n        (0.502, 0.580, -188.0, 0.26),  # 188-deg Right-Hand Carousel Bowl!\n        # 0.598 .. 0.688: Authentic Laguna-Seca Corkscrew S-Plunge (~140 km/h crest -> full throttle plunge!)\n        (0.598, 0.630, +86.0, 0.34),   # Corkscrew tight blind Left drop!\n        (0.632, 0.672, -48.0, 0.38),   # Corkscrew Right sweep toward tunnel!\n        # Zone 5: strobe_tunnel_harbor (0.70 .. 1.00)\n        # 0.71 .. 0.85: Full-throttle Cyber-Strobe Tunnel accelerating 235 -> 343 km/h!\n        (0.715, 0.845, +12.0, 0.46),   # Gentle flat-out Cyber-Strobe Tunnel curve\n        (0.854, 0.878, +18.0, 0.42),   # Blinding exit cliffside sweep before heavy braking\n        # 0.896 .. 0.916: Heavy-Braking Cliffside Harbor Hairpin (342 -> 82 km/h!)\n        (0.896, 0.917, a_hp,  0.28),   # Harbor Hairpin\n        (0.945, 0.985, -34.0, 0.45),   # Fast Harbor Waterfront bend onto Finish Straight\n    ]\n    kap = np.zeros_like(u)\n    for u0, u1, ang, ef in corners:\n        kap += corner_turn(u, u0, u1, ang, ef)\n\n    theta = np.cumsum(kap) * du\n    theta -= theta[0]\n    total_dtheta = np.sum(kap) * du\n    cx = np.sum(np.cos(theta)) * du\n    cy = np.sum(np.sin(theta)) * du\n    return kap, theta, np.array([total_dtheta + 2.0 * math.pi, cx, cy])\n\nsol = root(lambda p: build_xy_unit(p)[2], x0=[-160.0, 20.0, -110.0], method='hybr', tol=1e-12)\nprint(\"Solver success:\", sol.success, \"params (deg):\", sol.x, \"residual:\", sol.fun)\n\nkap_u, theta_u, _ = build_xy_unit(sol.x)\nx_u = np.cumsum(np.cos(theta_u)) * du\ny_u = np.cumsum(np.sin(theta_u)) * du\nx_u -= x_u[0]\ny_u -= y_u[0]\n\ndef build_z_profile(u):\n    z = np.full_like(u, 0.8)\n    # Canyon Grid: 0.8m -> 3.0m\n    z += 2.2 * smooth_step_quintic((u - 0.05) / (0.16 - 0.05))\n    # Eau-Rouge Climb: 3.0m -> 42.0m (peak pitch ~ +13.4 deg)\n    z += 5.0 * smooth_step_quintic((u - 0.160) / (0.326 - 0.160))\n    z += 34.0 * smooth_step_quintic((u - 0.194) / (0.2735 - 0.194))\n    # Sky-Bridge subtle crown (+42.0 -> +42.35 -> +42.0m)\n    z += 0.35 * np.sin(np.pi * np.clip((u - 0.33) / 0.17, 0.0, 1.0))**2\n    # Bowl rim (+42.0 -> +38.8m) -> Corkscrew Plunge (+38.8 -> +1.5m, peak pitch ~ -14.3 deg)\n    z -= 4.3 * smooth_step_quintic((u - 0.525) / (0.696 - 0.525))\n    z -= 36.2 * smooth_step_quintic((u - 0.600) / (0.677 - 0.600))\n    # Tunnel (1.5m) -> Harbor Finish (0.8m)\n    z -= 0.7 * smooth_step_quintic((u - 0.860) / (0.975 - 0.860))\n    return z\n\nZ_raw = build_z_profile(u)\n\nTARGET_N = 1850\nTARGET_L3D = TARGET_N * 2.0  # 3700.0 m\n\ndef calc_l3d(L2D):\n    X = np.append(x_u * L2D, x_u[0] * L2D)\n    Y = np.append(y_u * L2D, y_u[0] * L2D)\n    Z = np.append(Z_raw, Z_raw[0])\n    ds = np.sqrt(np.diff(X)**2 + np.diff(Y)**2 + np.diff(Z)**2)\n    return float(np.sum(ds))\n\nL2D_opt = brentq(lambda L: calc_l3d(L) - TARGET_L3D, 3400.0, 3800.0, xtol=1e-10)\nX_dense = np.append(x_u * L2D_opt, x_u[0] * L2D_opt)\nY_dense = np.append(y_u * L2D_opt, y_u[0] * L2D_opt)\nZ_dense = np.append(Z_raw, Z_raw[0])\nds_dense = np.sqrt(np.diff(X_dense)**2 + np.diff(Y_dense)**2 + np.diff(Z_dense)**2)\ns_dense = np.concatenate([[0.0], np.cumsum(ds_dense)])\ns_dense[-1] = TARGET_L3D\n\ncs_x = CubicSpline(s_dense, X_dense, bc_type='periodic')\ncs_y = CubicSpline(s_dense, Y_dense, bc_type='periodic')\ncs_z = CubicSpline(s_dense, Z_dense, bc_type='periodic')\n\ns_grid = np.arange(TARGET_N, dtype=float) * 2.0\nsf = s_grid / TARGET_L3D\nX = cs_x(s_grid)\nY = cs_y(s_grid)\nZ = cs_z(s_grid)\n\ndx = cs_x(s_grid, 1)\ndy = cs_y(s_grid, 1)\ndz = cs_z(s_grid, 1)\ndxy = np.hypot(dx, dy)\npitch_cl = np.degrees(np.arctan2(dz, dxy))\nddx = cs_x(s_grid, 2)\nddy = cs_y(s_grid, 2)\nkap_cl = (dx * ddy - dy * ddx) / np.maximum(dxy**3, 1e-12)\n\nprint(f\"L3D = {TARGET_L3D:.2f} m, Z: [{Z.min():.2f}, {Z.max():.2f}] m, CL pitch: [{pitch_cl.min():.2f}, {pitch_cl.max():.2f}] deg\")\nprint(f\"Max |kap_cl|: {np.abs(kap_cl).max():.5f} (min R_cl = {1.0/np.abs(kap_cl).max():.2f} m)\")\n\nfor thresh in (120.0, 140.0, 160.0):\n    min_sep = 1e9\n    min_pair = None\n    for i in range(0, TARGET_N, 2):\n        ds_cyc = np.minimum((s_grid - s_grid[i]) % TARGET_L3D, (s_grid[i] - s_grid) % TARGET_L3D)\n        dist_xy = np.hypot(X - X[i], Y - Y[i])\n        m = dist_xy[ds_cyc >= thresh]\n        if len(m) and m.min() < min_sep:\n            j = np.where(ds_cyc >= thresh)[0][np.argmin(m)]\n            min_sep = float(m.min())\n            min_pair = (round(float(sf[i]), 3), round(float(sf[j]), 3))\n    print(f\"Min XY sep (|ds| >= {thresh:.0f}m): {min_sep:.2f} m at s_frac={min_pair}\")\n\nbank_deg = (\n    +17.4 * smooth_bump(sf, 0.498, 0.584, edge_frac=0.30)\n    - 4.0 * smooth_bump(sf, 0.162, 0.200, edge_frac=0.42)\n    + 5.8 * smooth_bump(sf, 0.198, 0.288, edge_frac=0.40)\n    - 5.5 * smooth_bump(sf, 0.598, 0.632, edge_frac=0.38)\n    + 4.5 * smooth_bump(sf, 0.632, 0.674, edge_frac=0.40)\n    + 2.2 * smooth_bump(sf, 0.895, 0.918, edge_frac=0.38)\n)\n\n# Proper wide-entry apex-clipping racing line:\n# Minimize int (kappa_race^2) via 3500 iterations of biharmonic/laplacian curvature relaxation!\nLIM = 5.05\ncl_h = np.arctan2(dy, dx)\nL0_x = -np.sin(cl_h)\nL0_y = np.cos(cl_h)\noff = np.zeros(TARGET_N)\n# Stride-4 coarse + stride-1 fine relaxation converges 16x faster across wide corner entries!\nfor stride in (4, 2, 1):\n    iters = 1200 if stride > 1 else 1500\n    for _ in range(iters):\n        rx = X + L0_x * off\n        ry = Y + L0_y * off\n        px = 0.25 * np.roll(rx, stride) + 0.50 * rx + 0.25 * np.roll(rx, -stride)\n        py = 0.25 * np.roll(ry, stride) + 0.50 * ry + 0.25 * np.roll(ry, -stride)\n        dv = (px - X) * L0_x + (py - Y) * L0_y\n        off = np.clip(dv, -LIM, LIM)\n\nkern_half = 22\nkx = np.arange(-kern_half, kern_half + 1, dtype=float)\nkw = np.exp(-0.5 * (kx / 6.5)**2)\nkw /= kw.sum()\nfor _ in range(2):\n    off_pad = np.concatenate([off[-kern_half:], off, off[:kern_half]])\n    off = np.convolve(off_pad, kw, mode='valid')\noff = np.clip(off, -5.2, 5.2)\n\nh_rad = cl_h.copy()\npt_rad = np.radians(pitch_cl).copy()\nbk_rad = np.radians(bank_deg)\ns_ext = np.append(s_grid, TARGET_L3D)\n\nfor _ in range(6):\n    R0_x, R0_y, R0_z = np.sin(h_rad), -np.cos(h_rad), np.zeros_like(h_rad)\n    U0_x = -np.sin(pt_rad) * np.cos(h_rad)\n    U0_y = -np.sin(pt_rad) * np.sin(h_rad)\n    U0_z = np.cos(pt_rad)\n    Rx = np.cos(bk_rad) * R0_x - np.sin(bk_rad) * U0_x\n    Ry = np.cos(bk_rad) * R0_y - np.sin(bk_rad) * U0_y\n    Rz = np.cos(bk_rad) * R0_z - np.sin(bk_rad) * U0_z\n    RX = X - off * Rx\n    RY = Y - off * Ry\n    RZ = Z - off * Rz\n    cs_rx = CubicSpline(s_ext, np.append(RX, RX[0]), bc_type='periodic')\n    cs_ry = CubicSpline(s_ext, np.append(RY, RY[0]), bc_type='periodic')\n    cs_rz = CubicSpline(s_ext, np.append(RZ, RZ[0]), bc_type='periodic')\n    drx = cs_rx(s_grid, 1)\n    dry = cs_ry(s_grid, 1)\n    drz = cs_rz(s_grid, 1)\n    drxy = np.hypot(drx, dry)\n    h_rad = np.arctan2(dry, drx)\n    pt_rad = np.arctan2(drz, drxy)\n\nddrx = cs_rx(s_grid, 2)\nddry = cs_ry(s_grid, 2)\ncurv_race = (drx * ddry - dry * ddrx) / np.maximum(drxy**3, 1e-12)\n\nprint(f\"off range: [{off.min():.3f}, {off.max():.3f}] m\")\nprint(f\"Race pitch range: [{np.degrees(pt_rad).min():.2f}, {np.degrees(pt_rad).max():.2f}] deg\")\nprint(f\"Race curv_1pm range: [{curv_race.min():.5f}, {curv_race.max():.5f}] (min R_race = {1.0/np.abs(curv_race).max():.2f} m)\")\n\nRX_ext = np.append(RX, RX[0])\nRY_ext = np.append(RY, RY[0])\nRZ_ext = np.append(RZ, RZ[0])\nds_race = np.sqrt(np.diff(RX_ext)**2 + np.diff(RY_ext)**2 + np.diff(RZ_ext)**2)\n\ndef solve_lap(scalar):\n    tun_boost = smooth_bump(sf, 0.705, 0.875, edge_frac=0.20)\n    vmax_arr = (91.8 + 3.4 * tun_boost) * math.sqrt(scalar)\n    vmax_arr = np.clip(vmax_arr, 88.0, 95.4)\n\n    a0_lat = 16.5 * scalar\n    c_lat = 0.0075 * scalar\n    bank_term = 9.81 * np.tan(np.abs(bk_rad)) * scalar\n\n    k_abs = np.abs(curv_race)\n    V = np.empty(TARGET_N)\n    for i in range(TARGET_N):\n        denom = k_abs[i] - c_lat\n        if denom <= 1e-6:\n            V[i] = vmax_arr[i]\n        else:\n            V[i] = min(vmax_arr[i], math.sqrt((a0_lat + bank_term[i]) / denom))\n\n    sin_pt = np.sin(pt_rad)\n    for _ in range(8):\n        for i in range(TARGET_N - 1, -1, -1):\n            vn = V[(i + 1) % TARGET_N]\n            ds = ds_race[i]\n            vi = vn\n            for _ in range(3):\n                vm = 0.5 * (vi + vn)\n                abrk = scalar * min(56.0, 21.0 + 0.0052 * vm * vm) + 9.81 * sin_pt[i]\n                abrk = max(5.0, abrk)\n                vi = math.sqrt(vn * vn + 2.0 * abrk * ds)\n            if vi < V[i]:\n                V[i] = vi\n        for i in range(TARGET_N):\n            vp = V[i]\n            ds = ds_race[i]\n            p_pow = (980.0 + 210.0 * tun_boost[i]) * scalar\n            a_tr = scalar * 16.2\n            aacc = min(a_tr, p_pow / max(vp, 12.0)) - 9.81 * sin_pt[i]\n            aacc = max(0.5, aacc)\n            vn_max = min(vmax_arr[(i + 1) % TARGET_N], math.sqrt(vp * vp + 2.0 * aacc * ds))\n            if vn_max < V[(i + 1) % TARGET_N]:\n                V[(i + 1) % TARGET_N] = vn_max\n\n    dt = ds_race / np.maximum(0.5 * (V + np.roll(V, -1)), 1.0)\n    return float(np.sum(dt)), V, dt\n\nfor sc in (0.95, 1.00, 1.05):\n    t_lap, V_test, _ = solve_lap(sc)\n    print(f\"scalar={sc:.2f} -> lap={t_lap:.4f}s, v_min={V_test.min()*3.6:.1f} km/h, v_max={V_test.max()*3.6:.1f} km/h\")\n    if sc == 1.00:\n        for zname, a, b in [\n            (\"canyon_grid\", 0.00, 0.16),\n            (\"eau_rouge_climb\", 0.16, 0.33),\n            (\"sky_bridge\", 0.33, 0.50),\n            (\"banked_bowl_plunge\", 0.50, 0.70),\n            (\"strobe_tunnel_harbor\", 0.70, 1.00),\n        ]:\n            m = (sf >= a) & (sf < b)\n            print(f\"  {zname:22s}: v=[{V_test[m].min()*3.6:5.1f}, {V_test[m].max()*3.6:5.1f}] km/h, Z=[{Z[m].min():5.1f}, {Z[m].max():5.1f}] m, pitch=[{np.degrees(pt_rad[m]).min():6.2f}, {np.degrees(pt_rad[m]).max():6.2f}], bank=[{bank_deg[m].min():5.1f}, {bank_deg[m].max():5.1f}]\")\n","Overwrite":true,"Path":"C:\\Users\\86052\\.gemini\\antigravity\\brain\\62527b59-0213-41b2-b3ab-ff115c915c3b\\scratch\\design_circuit.py"}},{"name":"run_command","args":{"CommandLine":"python \"C:\\Users\\86052\\.gemini\\antigravity\\brain\\62527b59-0213-41b2-b3ab-ff115c915c3b\\scratch\\design_circuit.py\"","WaitMsBeforeAsync":5000,"toolSummary":"Test tightened corners and per-zone speed/pitch/bank stats"}}]}
